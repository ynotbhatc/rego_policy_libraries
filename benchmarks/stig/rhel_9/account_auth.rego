# the lines of /etc/pam.d/password-auth that match ^password.*pam_unix.so (grep '^password.*pam_unix.so')
missing_rhel_09_671025 := [concat(".", p) | some p in [["pam", "password_auth", "pam_unix_password_lines"]]; not _collected(p)]

