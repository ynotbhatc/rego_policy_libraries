# SELinux enforcing at runtime (getenforce) and at boot (SELINUX= in /etc/selinux/config)
missing_rhel_09_431010 := [concat(".", p) | some p in [["selinux", "getenforce"], ["selinux", "config_selinux"]]; not _collected(p)]

default selinux_enforcing := false

selinux_enforcing if {
	count(missing_rhel_09_431010) == 0
	_kw(["selinux", "getenforce"]) == "enforcing"
	_kw(["selinux", "config_selinux"]) == "enforcing"
}

status_rhel_09_431010 := "Not_a_Finding" if selinux_enforcing

else := "Open"

detail_rhel_09_431010 := "RHEL-09-431010: Not_a_Finding" if selinux_enforcing

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-431010", concat(", ", missing_rhel_09_431010)]) if count(missing_rhel_09_431010) > 0

else := "RHEL-09-431010: check failed — getenforce must return Enforcing and /etc/selinux/config must set SELINUX=enforcing"

finding_rhel_09_431010 := {
	"vuln_id": "V-258078",
	"stig_id": "RHEL-09-431010",
	"severity": "CAT I",
	"rule_title": "RHEL 9 must use a Linux Security Module configured to enforce limits on system services.",
	"check_type": "machine",
	"status": status_rhel_09_431010,
	"detail": detail_rhel_09_431010,
	"fix_text": "Set SELINUX=enforcing in /etc/selinux/config and run setenforce 1",
}

