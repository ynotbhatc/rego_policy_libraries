package stig.rhel_9.configuration_management

# DISA STIG for RHEL 9 - Configuration Management Module
# STIG Version: V2R10 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in rhel9_rules.py (regenerate, don't hand-edit).
# Covers: System settings, kernel params, banners, SELinux, GRUB, CTL-ALT-DEL

import rego.v1

# =============================================================================
# HELPER DEFAULTS
# =============================================================================

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a whole JSON number only; undefined otherwise. A number sent as text ("900") is
# not read: the collector converts the configured text, and the finding says "evidence invalid" with the type received
# (a fraction such as 3.5 is not a value these settings can hold)
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	_whole_number(v)
}

_whole_number(v) if {
	is_number(v)
	v == floor(v)
}

# what was received where a whole JSON number is required: the JSON type, or "a fraction"
_got(v) := "a fraction" if is_number(v)

_got(v) := type_name(v) if not is_number(v)

# the "evidence invalid" entry for a fact that is collected but is not a whole JSON number
_not_a_number(fact, v) := sprintf("%s is not a number (got %s)", [fact, _got(v)]) if {
	v != null
	not _whole_number(v)
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# FIPS 140-3 hash set the crypto-policy check requires in /etc/crypto-policies/state/CURRENT.pol
fips_policy_hashes := {"SHA2-256", "SHA2-384", "SHA2-512", "SHA2-224", "SHA3-256", "SHA3-384", "SHA3-512", "SHAKE-256"}

# a hash the crypto-policy check rejects: SHA1 (or MD5), or a digest size below 224
_weak_hash(h) if not is_string(h)

_weak_hash(h) if {
	is_string(h)
	u := upper(h)
	contains(u, "SHA1")
}

_weak_hash(h) if {
	is_string(h)
	u := upper(h)
	contains(u, "MD5")
}

_weak_hash(h) if {
	is_string(h)
	m := regex.find_all_string_submatch_n(`-([0-9]+)$`, h, 1)
	bits := to_number(m[0][1])
	bits < 224
}

# the Standard Mandatory DoW Notice and Consent Banner, from the RHEL-09-211020 check text (whitespace-normalised)
dod_banner := "You are accessing a U.S. Government (USG) Information System (IS) that is provided for USG-authorized use only. By using this IS (which includes any device attached to this IS), you consent to the following conditions: -The USG routinely intercepts and monitors communications on this IS for purposes including, but not limited to, penetration testing, COMSEC monitoring, network operations and defense, personnel misconduct (PM), law enforcement (LE), and counterintelligence (CI) investigations. -At any time, the USG may inspect and seize data stored on this IS. -Communications using, or data stored on, this IS are not private, are subject to routine monitoring, interception, and search, and may be disclosed or used for any USG-authorized purpose. -This IS includes security measures (e.g., authentication and access controls) to protect USG interests--not for your personal benefit or privacy. -Notwithstanding the above, using this IS does not constitute consent to PM, LE or CI investigative searching or monitoring of the content of privileged communications, or work product, related to personal representation or services by attorneys, psychotherapists, or clergy, and their assistants. Such communications and work product are private and confidential. See User Agreement for details."

# text with every run of whitespace collapsed to one space and the ends trimmed
_squash(s) := regex.replace(trim_space(s), `\s+`, " ")

# the mount entry for a mount point; undefined unless the mount list was collected and the entry is there
_mount(point) := m if {
	mounts := input.filesystem_mounts
	is_array(mounts)
	some m in mounts
	m.mount == point
}

# a kernel module is disabled the way the check requires: an uncommented `install <mod> /bin/false` and
# `blacklist <mod>` in /etc/modprobe.conf or /etc/modprobe.d/* (input.modprobe[<mod>] = {install, blacklisted})
_module_disabled(mod) if {
	m := input.modprobe[mod]
	m.install == "/bin/false"
	m.blacklisted == true
}

# the AIDE job mails its result, or the SA attests to another notification path
_aide_notifies if {
	some l in input.aide.schedule
	_aide_check_line(l)
	regex.match(`\|\s*(\S*/)?(mail|mailx|sendmail)(\s|$)`, l)
}

# a cron line (as "<file>: <entry>") that runs the aide binary with --check, not commented out
_aide_check_line(l) if {
	is_string(l)
	not regex.match(`^[^:]*:\s*#`, l)
	regex.match(`(^|[\s:/])aide\s+(--check|-C)(\s|$)`, l)
}

_aide_notifies if _attested("rhel_09_651015_notification")

# the whitespace-separated arguments of a kernel command line
_cmdline_tokens(s) := {t | some t in regex.split(`\s+`, trim_space(s)); t != ""}

# every boot entry (input.grub.kernel_args: the args="..." value of each entry of grubby --info=ALL) carries arg
_grubby_all_have(arg) if {
	args := input.grub.kernel_args
	is_array(args)
	count(args) > 0
	every a in args {
		is_string(a)
		arg in _cmdline_tokens(a)
	}
}

# the uncommented GRUB_CMDLINE_LINUX of /etc/default/grub carries arg
_grub_default_has(arg) if {
	s := _str(["grub", "default_cmdline_linux"])
	arg in _cmdline_tokens(s)
}

# every uncommented "core" line of /etc/security/limits.conf and limits.d/*.conf (input.limits_conf.core:
# [{domain, type, value}]) sets the value 0
_core_limits_all_zero if {
	xs := input.limits_conf.core
	is_array(xs)
	every x in xs {
		sprintf("%v", [x.value]) == "0"
	}
}

# the NFS entries of /etc/fstab (input.fstab: [{mount_point, fs_type, options}], uncommented entries; fs_type nfs / nfs4)
_fstab_nfs := [e | some e in input.fstab; is_string(e.fs_type); startswith(lower(e.fs_type), "nfs")]

# an fstab entry carries the mount option (options: the comma-separated fourth field)
_fstab_has_opt(e, opt) if {
	is_string(e.options)
	opt in {trim_space(x) | some x in split(e.options, ",")}
}

# a mount the RHEL-09-231200 grep selects: device under /dev, mount point below / (not / itself)
_nonroot_dev_mount(m) if {
	is_string(m.device)
	startswith(m.device, "/dev")
	is_string(m.mount)
	regex.match(`^/\S`, m.mount)
}

# the mount entry lists the option (an entry without an options list does not)
_mount_has_option(m, opt) if {
	is_array(m.options)
	opt in m.options
}

# /boot and /boot/efi are the two file systems the check leaves out. A helper on the whole entry, because
# `not f.mount in {...}` is undefined for an entry without a mount and would drop it from the checked list.
_boot_fs(f) if f.mount in {"/boot", "/boot/efi"}

# the file system has a crypt parent block device whose cryptsetup type is LUKS (LUKS1 / LUKS2)
_luks_parent(f) if {
	some c in f.crypt
	is_string(c.type)
	startswith(upper(c.type), "LUKS")
}

# a gsettings boolean (`gsettings get` / `gsettings writable`): "true" / "false" as printed, or a JSON boolean
_gs_bool(path) := lower(s) if s := _str(path)

_gs_bool(path) := "true" if object.get(input, path, null) == true

_gs_bool(path) := "false" if object.get(input, path, null) == false

# a gsettings unsigned value: a whole JSON number, or the text `gsettings get` prints ("uint32 600"); a bare
# decimal string ("600") is neither and is read as undefined (the rule reports "evidence invalid")
_gs_uint(path) := v if {
	v := object.get(input, path, null)
	_whole_number(v)
}

_gs_uint(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	m := regex.find_all_string_submatch_n(`^\s*uint32\s+([0-9]+)\s*$`, v, 1)
	n := to_number(m[0][1])
}

# the gsettings string at path as GNOME shows it: outer quotes dropped, the literal \n sequences (formatting only)
# and every whitespace run turned into one space
_gs_text(path) := t if {
	s := _str(path)
	t := _squash(replace(trim(trim_space(s), "'\""), "\\n", " "))
}

# input.sudoers.lines: [{file, line}], the uncommented lines of /etc/sudoers and /etc/sudoers.d/*
_p4_sudoers := [e | some e in input.sudoers.lines; is_string(e.line); is_string(e.file)]

_p4_sudoers_collected if is_array(input.sudoers.lines)

# the sudoers entries whose line matches a (case-insensitive) pattern, as the check's grep -i returns them
_p4_sudoers_matching(pattern) := [e | some e in _p4_sudoers; regex.match(pattern, e.line)]

# input.pam_d[<file>]: the uncommented lines of /etc/pam.d/<file>, in file order
_p4_pam(file) := [l | some l in input.pam_d[file]; is_string(l)] if is_array(input.pam_d[file])

# a pam_faillock.so preauth line stands before every pam_unix.so line of the file
_p4_faillock_preauth_first(file) if {
	lines := _p4_pam(file)
	some i, l in lines
	contains(l, "pam_faillock.so")
	regex.match(`(^|\s)preauth(\s|$)`, l)
	every j, u in lines {
		_p4_not_unix_before(u, j, i)
	}
}

_p4_not_unix_before(u, _, _) if not contains(u, "pam_unix.so")

_p4_not_unix_before(u, j, i) if {
	contains(u, "pam_unix.so")
	j > i
}

# the rounds= values on the lines of a PAM file
_p4_rounds(file) := [v | some l in _p4_pam(file); some m in regex.find_all_string_submatch_n(`(^|\s)rounds=(\S*)`, l, -1); v := m[2]]

_p4_rounds_ok(file) if {
	some l in _p4_pam(file)
	regex.match(`^\s*password\s.*pam_unix\.so\s(.*\s)?rounds=[0-9]+(\s|$)`, l)
	every v in _p4_rounds(file) {
		regex.match(`^[0-9]+$`, v)
		to_number(v) >= 100000
	}
}

