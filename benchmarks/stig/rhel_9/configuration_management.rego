# RHEL-09-211050 | V-257785 | CAT I
# ctrl-alt-del.target load state (systemctl show -p LoadState) must be masked
missing_rhel_09_211050 := [concat(".", p) | some p in [["systemd_units", "ctrl-alt-del.target", "load_state"]]; not _collected(p)]

default ctrl_alt_del_disabled := false

ctrl_alt_del_disabled if {
	count(missing_rhel_09_211050) == 0
	_kw(["systemd_units", "ctrl-alt-del.target", "load_state"]) == "masked"
}

status_rhel_09_211050 := "Not_a_Finding" if ctrl_alt_del_disabled

else := "Open"

detail_rhel_09_211050 := "RHEL-09-211050: Not_a_Finding" if ctrl_alt_del_disabled

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-211050", concat(", ", missing_rhel_09_211050)]) if count(missing_rhel_09_211050) > 0

else := "RHEL-09-211050: check failed — ctrl-alt-del.target must be masked (systemctl status: Loaded: masked)"

finding_rhel_09_211050 := {
	"vuln_id": "V-257785",
	"stig_id": "RHEL-09-211050",
	"severity": "CAT I",
	"rule_title": "The x86 Ctrl-Alt-Delete key sequence must be disabled on RHEL 9.",
	"check_type": "machine",
	"status": status_rhel_09_211050,
	"detail": detail_rhel_09_211050,
	"fix_text": "Mask the target: systemctl disable --now ctrl-alt-del.target && systemctl mask ctrl-alt-del.target",
}

