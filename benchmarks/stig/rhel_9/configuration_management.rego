# RHEL-09-215105 | V-258241 | CAT I
# systemwide crypto policy FIPS; CURRENT.pol hash list and min_rsa_size
missing_rhel_09_215105 := [concat(".", p) | some p in [["crypto_policy"], ["crypto_policy_state", "hash"], ["crypto_policy_state", "min_rsa_size"]]; not _collected(p)]

invalid_rhel_09_215105 := [m | some p in [["crypto_policy_state", "min_rsa_size"]]; m := _not_a_number(concat(".", p), object.get(input, p, null))]

default crypto_policy_fips := false

crypto_policy_fips if {
	count(missing_rhel_09_215105) == 0
	_str(["crypto_policy"]) == "FIPS"
	hashes := input.crypto_policy_state.hash
	is_array(hashes)
	every h in fips_policy_hashes {
		h in hashes
	}
	count([h | some h in hashes; _weak_hash(h)]) == 0
	_num(["crypto_policy_state", "min_rsa_size"]) >= 2048
}

status_rhel_09_215105 := "Not_a_Finding" if crypto_policy_fips

else := "Open"

detail_rhel_09_215105 := "RHEL-09-215105: Not_a_Finding" if crypto_policy_fips

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-215105", concat(", ", missing_rhel_09_215105)]) if count(missing_rhel_09_215105) > 0

else := sprintf("%s: evidence invalid — %s", ["RHEL-09-215105", concat(", ", invalid_rhel_09_215105)]) if count(invalid_rhel_09_215105) > 0

else := "RHEL-09-215105: check failed — update-crypto-policies --show must be FIPS; CURRENT.pol hash must include SHA2-256 SHA2-384 SHA2-512 SHA2-224 SHA3-256 SHA3-384 SHA3-512 SHAKE-256, nothing with SHA1 or below 224 bits; min_rsa_size must be at least 2048"

finding_rhel_09_215105 := {
	"vuln_id": "V-258241",
	"stig_id": "RHEL-09-215105",
	"severity": "CAT I",
	"rule_title": "RHEL 9 must implement a FIPS 140-3-compliant systemwide cryptographic policy.",
	"check_type": "machine",
	"status": status_rhel_09_215105,
	"detail": detail_rhel_09_215105,
	"fix_text": "Set the FIPS policy: update-crypto-policies --set FIPS, then reboot",
}

# RHEL-09-211010 | V-257777 | CAT I
# content of /etc/redhat-release; whether that minor release is still supported is an attestation (the supported set changes over time)
missing_rhel_09_211010 := [concat(".", p) | some p in [["os_release", "redhat_release"]]; not _collected(p)]

default vendor_supported_release := false

vendor_supported_release if {
	count(missing_rhel_09_211010) == 0
	s := _str(["os_release", "redhat_release"])
	regex.match(`^Red Hat Enterprise Linux release 9\.[0-9]+`, s)
	_attested("rhel_09_211010_release_supported")
}

status_rhel_09_211010 := "Not_a_Finding" if vendor_supported_release

else := "Open"

detail_rhel_09_211010 := "RHEL-09-211010: Not_a_Finding" if vendor_supported_release

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-211010", concat(", ", missing_rhel_09_211010)]) if count(missing_rhel_09_211010) > 0

else := "RHEL-09-211010: check failed — /etc/redhat-release must name a RHEL 9 release and the SA must attest that this release is vendor supported (input.attest.rhel_09_211010_release_supported)"

finding_rhel_09_211010 := {
	"vuln_id": "V-257777",
	"stig_id": "RHEL-09-211010",
	"severity": "CAT I",
	"rule_title": "RHEL 9 must be a vendor-supported release.",
	"check_type": "machine+attestation",
	"status": status_rhel_09_211010,
	"detail": detail_rhel_09_211010,
	"fix_text": "Upgrade to a supported version of RHEL 9",
}

