cert_user_mapping if {
	count(missing_rhel_09_631015) == 0
	rules := input.sssd.certmap_rules
	is_array(rules)
	some r in rules
	is_string(r.maprule)
	trim_space(r.maprule) != ""
}

cert_user_mapping if {
	_attested("rhel_09_631015_certificate_mapping")
}

default na_rhel_09_631015 := false

na_rhel_09_631015 if {
