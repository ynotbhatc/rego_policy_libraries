package stig.rhel_9.pki_crypto

# DISA STIG for RHEL 9 - PKI and Cryptography Module
# STIG Version: V2R10 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in rhel9_rules.py (regenerate, don't hand-edit).
# Covers: FIPS 140-3, PKI/CAC authentication, certificate management, crypto policies

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a number, or a string holding a decimal integer; undefined otherwise
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# a crypto back-end in /etc/crypto-policies/back-ends/: nss.config is a regular file; every other one is a
# symlink to its own file under /usr/share/crypto-policies/FIPS/ (bind.config -> FIPS/bind.txt)
_backend_ok(b) if {
	b.name == "nss.config"
	b.is_symlink == false
}

_backend_ok(b) if {
	is_string(b.name)
	b.name != "nss.config"
	b.is_symlink == true
	base := trim_suffix(b.name, ".config")
	b.target == concat("", ["/usr/share/crypto-policies/FIPS/", base, ".txt"])
}

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# RHEL-09-672020 | V-258236 | CAT I
# update-crypto-policies --check output and the back-end symlinks (input.crypto_backends[{name, is_symlink, target}])
missing_rhel_09_672020 := [concat(".", p) | some p in [["crypto_policy_check", "output"], ["crypto_backends"]]; not _collected(p)]

default crypto_policy_not_overridden := false

crypto_policy_not_overridden if {
	count(missing_rhel_09_672020) == 0
	out := _str(["crypto_policy_check", "output"])
	contains(out, "The configured policy matches the generated policy")
	not contains(out, "does NOT match")
	backends := input.crypto_backends
	is_array(backends)
	count(backends) > 0
	count([b | some b in backends; not _backend_ok(b)]) == 0
}

status_rhel_09_672020 := "Not_a_Finding" if crypto_policy_not_overridden

else := "Open"

detail_rhel_09_672020 := "RHEL-09-672020: Not_a_Finding" if crypto_policy_not_overridden

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-672020", concat(", ", missing_rhel_09_672020)]) if count(missing_rhel_09_672020) > 0

else := "RHEL-09-672020: check failed — update-crypto-policies --check must report the configured policy matches the generated policy, and every back-end in /etc/crypto-policies/back-ends/ except nss.config must link to its file under /usr/share/crypto-policies/FIPS/"

finding_rhel_09_672020 := {
	"vuln_id": "V-258236",
	"stig_id": "RHEL-09-672020",
	"severity": "CAT I",
	"rule_title": "RHEL 9 cryptographic policy must not be overridden.",
	"check_type": "machine",
	"status": status_rhel_09_672020,
	"detail": detail_rhel_09_672020,
	"fix_text": "Remove overrides and regenerate: update-crypto-policies --set FIPS",
}

# RHEL-09-672055 | V-288833 | CAT I
# the lines of /etc/pki/tls/openssl.cnf must include the crypto-policy opensslcnf.config back-end
missing_rhel_09_672055 := [concat(".", p) | some p in [["openssl_cnf", "lines"]]; not _collected(p)]

default openssl_system_policy := false

openssl_system_policy if {
	count(missing_rhel_09_672055) == 0
	lines := input.openssl_cnf.lines
	is_array(lines)
	some l in lines
	regex.match(`^\s*\.include\s*=?\s*/etc/crypto-policies/back-ends/opensslcnf\.config\s*$`, l)
}

status_rhel_09_672055 := "Not_a_Finding" if openssl_system_policy

else := "Open"

detail_rhel_09_672055 := "RHEL-09-672055: Not_a_Finding" if openssl_system_policy

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-672055", concat(", ", missing_rhel_09_672055)]) if count(missing_rhel_09_672055) > 0

else := "RHEL-09-672055: check failed — /etc/pki/tls/openssl.cnf must include /etc/crypto-policies/back-ends/opensslcnf.config (uncommented)"

finding_rhel_09_672055 := {
	"vuln_id": "V-288833",
	"stig_id": "RHEL-09-672055",
	"severity": "CAT I",
	"rule_title": "RHEL 9 must implement DoW-approved encryption in the OpenSSL package.",
	"check_type": "machine",
	"status": status_rhel_09_672055,
	"detail": detail_rhel_09_672055,
	"fix_text": "Add .include = /etc/crypto-policies/back-ends/opensslcnf.config to /etc/pki/tls/openssl.cnf",
}

# =============================================================================
# CAT II - MEDIUM SEVERITY
# =============================================================================

# RHEL-09-611170 | V-258123 | CAT II
# Certificate revocation must be checked (OCSP/CRL)
default cert_revocation_check := false

cert_revocation_check if {
	input.pki_config.ocsp_enabled == true
}

cert_revocation_check if {
	input.pki_config.crl_checking == true
}

status_rhel_09_611170 := "Not_a_Finding" if cert_revocation_check

else := "Open"

detail_rhel_09_611170 := "RHEL-09-611170: Not_a_Finding" if cert_revocation_check

else := "RHEL-09-611170: Open — logic not yet reviewed against the V2R10 check text"

finding_rhel_09_611170 := {
	"vuln_id": "V-258123",
	"stig_id": "RHEL-09-611170",
	"severity": "CAT II",
	"rule_title": "RHEL 9 must implement certificate status checking for multifactor authentication.",
	"check_type": "machine",
	"status": status_rhel_09_611170,
	"detail": detail_rhel_09_611170,
	"fix_text": "Configure OCSP: Set ocsp_stapling=yes and enable CRL checking in SSSD",
}

# RHEL-09-631010 | V-258131 | CAT II
# The system must use a DoD-approved PKI to authenticate
default dod_ca_trusted := false

dod_ca_trusted if {
	input.certificates.dod_root_ca_installed == true
}

status_rhel_09_631010 := "Not_a_Finding" if dod_ca_trusted

else := "Open"

detail_rhel_09_631010 := "RHEL-09-631010: Not_a_Finding" if dod_ca_trusted

else := "RHEL-09-631010: Open — logic not yet reviewed against the V2R10 check text"

finding_rhel_09_631010 := {
	"vuln_id": "V-258131",
	"stig_id": "RHEL-09-631010",
	"severity": "CAT II",
	"rule_title": "RHEL 9, for PKI-based authentication, must validate certificates by constructing a certification path (which includes status information) to an accepted trust anchor.",
	"check_type": "machine",
	"status": status_rhel_09_631010,
	"detail": detail_rhel_09_631010,
	"fix_text": "Install DoD Root CA: trust anchor --store DoD_PKE_CA_chain.pem",
}

# RHEL-09-271045 | V-258019 | CAT II
# smartcard removal must lock the session
default smartcard_lock_on_removal := false

smartcard_lock_on_removal if {
	input.pam_config.smartcard_removal_lock == true
}

status_rhel_09_271045 := "Not_a_Finding" if smartcard_lock_on_removal

else := "Open"

detail_rhel_09_271045 := "RHEL-09-271045: Not_a_Finding" if smartcard_lock_on_removal

else := "RHEL-09-271045: Open — logic not yet reviewed against the V2R10 check text"

finding_rhel_09_271045 := {
	"vuln_id": "V-258019",
	"stig_id": "RHEL-09-271045",
	"severity": "CAT II",
	"rule_title": "RHEL 9 must be able to initiate directly a session lock for all connection types using smart card when the smart card is removed.",
	"check_type": "machine",
	"status": status_rhel_09_271045,
	"detail": detail_rhel_09_271045,
	"fix_text": "Configure pcscd and GNOME smart card removal action to lock session",
}

# RHEL-09-631015 | V-258132 | CAT II
# System must map certificate to user
default cert_user_mapping := false

cert_user_mapping if {
	input.sssd_config.cert_user_mapping != ""
}

cert_user_mapping if {
	input.pam_config.cert_mapping_configured == true
}

status_rhel_09_631015 := "Not_a_Finding" if cert_user_mapping

else := "Open"

detail_rhel_09_631015 := "RHEL-09-631015: Not_a_Finding" if cert_user_mapping

else := "RHEL-09-631015: Open — logic not yet reviewed against the V2R10 check text"

finding_rhel_09_631015 := {
	"vuln_id": "V-258132",
	"stig_id": "RHEL-09-631015",
	"severity": "CAT II",
	"rule_title": "RHEL 9 must map the authenticated identity to the user or group account for PKI-based authentication.",
	"check_type": "machine",
	"status": status_rhel_09_631015,
	"detail": detail_rhel_09_631015,
	"fix_text": "Configure certificate to user mapping in SSSD configuration",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

cat_i_findings := [
	finding_rhel_09_672020,
	finding_rhel_09_672055,
]

cat_ii_findings := [
	finding_rhel_09_611170,
	finding_rhel_09_631010,
	finding_rhel_09_271045,
	finding_rhel_09_631015,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III).
# `cat_i_compliant`: the former CAT-I-only meaning, for gating on the critical subset.
default cat_i_compliant := false

open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "pki_crypto",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
