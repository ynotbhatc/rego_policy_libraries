# DISA STIG for RHEL 9 - Network Configuration Module
# STIG Version: V2R10 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in rhel9_rules.py (regenerate, don't hand-edit).
# Covers: Firewall, network parameters, IPv6, ICMP redirects

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a number, or a string holding a decimal integer; undefined otherwise
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# a kernel module is disabled the way the check requires: an uncommented `install <mod> /bin/false` and
# `blacklist <mod>` in /etc/modprobe.conf or /etc/modprobe.d/* (input.modprobe[<mod>] = {install, blacklisted})
_module_disabled(mod) if {
	m := input.modprobe[mod]
	m.install == "/bin/false"
	m.blacklisted == true
}

# =============================================================================
# CAT II - MEDIUM SEVERITY
# =============================================================================

# RHEL-09-251015 | V-257936 | CAT II
# systemctl is-active firewalld
missing_rhel_09_251015 := [concat(".", p) | some p in [["services", "firewalld"]]; not _collected(p)]

default firewall_active := false

firewall_active if {
	count(missing_rhel_09_251015) == 0
	_kw(["services", "firewalld"]) == "active"
}

status_rhel_09_251015 := "Not_a_Finding" if firewall_active

else := "Open"

detail_rhel_09_251015 := "RHEL-09-251015: Not_a_Finding" if firewall_active

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-251015", concat(", ", missing_rhel_09_251015)]) if count(missing_rhel_09_251015) > 0

else := "RHEL-09-251015: check failed — firewalld must be active (systemctl is-active firewalld)"

finding_rhel_09_251015 := {
	"vuln_id": "V-257936",
	"stig_id": "RHEL-09-251015",
	"severity": "CAT II",
	"rule_title": "The firewalld service on RHEL 9 must be active.",
	"check_type": "machine",
	"status": status_rhel_09_251015,
	"detail": detail_rhel_09_251015,
	"fix_text": "Enable firewalld: systemctl enable --now firewalld",
}

