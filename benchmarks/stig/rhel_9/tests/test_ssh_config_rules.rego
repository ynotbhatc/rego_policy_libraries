package stig.rhel_9.ssh_config_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"opensshserver_config": {
		"Ciphers": "aes256-gcm@openssh.com,aes256-ctr,aes128-gcm@openssh.com,aes128-ctr",
		"MACs": "hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com,hmac-sha2-256,hmac-sha2-512",
	},
	"ssh_config": {
		"PermitEmptyPasswords": "no",
		"UsePAM": "yes",
	},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_9.ssh_config.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_rhel_09_255065_pass if {
	data.stig.rhel_9.ssh_config.status_rhel_09_255065 == "Not_a_Finding" with input as green_fixture
}

test_rhel_09_255065_fail_1 if {
	f := data.stig.rhel_9.ssh_config.finding_rhel_09_255065 with input as object.union(green_fixture, {"opensshserver_config": {"Ciphers": "aes256-gcm@openssh.com,aes256-ctr,aes128-gcm@openssh.com,aes128-ctr,aes192-ctr"}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-255065: check failed")
}

test_rhel_09_255065_fail_2 if {
	f := data.stig.rhel_9.ssh_config.finding_rhel_09_255065 with input as object.union(green_fixture, {"opensshserver_config": {"Ciphers": ""}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-255065: check failed")
}

test_rhel_09_255065_evidence_missing_1 if {
	f := data.stig.rhel_9.ssh_config.finding_rhel_09_255065 with input as json.remove(green_fixture, [["opensshserver_config", "Ciphers"]])
	f.status == "Open"
	contains(f.detail, "RHEL-09-255065: evidence missing — opensshserver_config.Ciphers")
}

test_rhel_09_255065_pass_2 if {
	data.stig.rhel_9.ssh_config.status_rhel_09_255065 == "Not_a_Finding" with input as object.union(green_fixture, {"opensshserver_config": {"Ciphers": "aes256-ctr"}})
