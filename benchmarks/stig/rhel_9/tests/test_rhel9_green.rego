test_every_rule_not_a_finding_on_green_fixture if {
	r := data.stig.rhel_9.stig_assessment with input as green_fixture
	r.summary.total_findings == 445
	r.summary.not_a_finding == 441
	r.summary.not_applicable == 4
}

test_main_compliant_on_green_fixture if {
	r := data.stig.rhel_9.main.compliance_report with input as green_fixture
	r.compliant == true
	r.violation_count == 0
}
