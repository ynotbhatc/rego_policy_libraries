package stig.rhel_9.network_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"kernel_params": {
		"net.ipv4.conf.all.accept_redirects": "0",
		"net.ipv4.conf.all.accept_source_route": "0",
		"net.ipv4.conf.all.forwarding": "0",
		"net.ipv4.conf.all.rp_filter": "1",
		"net.ipv4.conf.all.send_redirects": "0",
		"net.ipv4.icmp_ignore_bogus_error_responses": "1",
		"net.ipv4.tcp_syncookies": "1",
	},
	"modprobe": {"bluetooth": {
		"blacklisted": true,
		"install": "/bin/false",
	}},
	"promiscuous_interfaces": [],
	"services": {"firewalld": "active"},
	"wireless_interfaces": [],
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_9.network.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.rhel_9.network.compliant with input as green_fixture
}

test_rhel_09_251015_pass if {
	data.stig.rhel_9.network.status_rhel_09_251015 == "Not_a_Finding" with input as green_fixture
}

test_rhel_09_251015_fail_1 if {
	f := data.stig.rhel_9.network.finding_rhel_09_251015 with input as object.union(green_fixture, {"services": {"firewalld": "inactive"}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-251015: check failed")
}

test_rhel_09_251015_fail_2 if {
	f := data.stig.rhel_9.network.finding_rhel_09_251015 with input as object.union(green_fixture, {"services": {"firewalld": "inactive", "nftables": "active"}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-251015: check failed")
}

test_rhel_09_251015_evidence_missing_1 if {
	f := data.stig.rhel_9.network.finding_rhel_09_251015 with input as json.remove(green_fixture, [["services", "firewalld"]])
	f.status == "Open"
	contains(f.detail, "RHEL-09-251015: evidence missing — services.firewalld")
}

