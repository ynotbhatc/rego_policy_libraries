package stig.rhel_9.configuration_management_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"crypto_policy": "FIPS",
	"crypto_policy_state": {
		"hash": [
			"SHA2-256",
			"SHA2-384",
			"SHA2-512",
			"SHA2-224",
			"SHA3-256",
			"SHA3-384",
			"SHA3-512",
			"SHAKE-256",
		],
		"min_rsa_size": 2048,
	},
	"fips": {"fips_enabled": "1"},
	"selinux": {
		"config_selinux": "enforcing",
		"getenforce": "Enforcing",
	},
	"systemd_units": {"ctrl-alt-del.target": {"load_state": "masked"}},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_9.configuration_management.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_rhel_09_211050_pass if {
	data.stig.rhel_9.configuration_management.status_rhel_09_211050 == "Not_a_Finding" with input as green_fixture
}

test_rhel_09_211050_fail_1 if {
	f := data.stig.rhel_9.configuration_management.finding_rhel_09_211050 with input as object.union(green_fixture, {"systemd_units": {"ctrl-alt-del.target": {"load_state": "loaded"}}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-211050: check failed")
}

test_rhel_09_211050_evidence_missing_1 if {
	f := data.stig.rhel_9.configuration_management.finding_rhel_09_211050 with input as json.remove(green_fixture, [["systemd_units", "ctrl-alt-del.target", "load_state"]])
	f.status == "Open"
	contains(f.detail, "RHEL-09-211050: evidence missing — systemd_units.ctrl-alt-del.target.load_state")
}

