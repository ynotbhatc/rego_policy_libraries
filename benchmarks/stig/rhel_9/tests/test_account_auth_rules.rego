package stig.rhel_9.account_auth_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"duplicate_gids": [],
	"duplicate_uid_accounts": [],
	"faillock_conf": {
		"deny": 3,
		"fail_interval": 900,
	},
	"local_accounts_with_empty_passwords": [],
	"login_defs": {"ENCRYPT_METHOD": "SHA512"},
	"password_policy": {
		"dcredit": -1,
		"inactive_days": 35,
		"lcredit": -1,
		"maxdays": 180,
		"mindays": 1,
		"minlen": 15,
		"ocredit": -1,
		"ucredit": -1,
	},
	"sssd": {"pam_cert_auth": "True"},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_9.account_auth.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.rhel_9.account_auth.compliant with input as green_fixture
}

test_rhel_09_611165_pass if {
	data.stig.rhel_9.account_auth.status_rhel_09_611165 == "Not_a_Finding" with input as green_fixture
}

test_rhel_09_611165_fail_1 if {
	f := data.stig.rhel_9.account_auth.finding_rhel_09_611165 with input as object.union(green_fixture, {"sssd": {"pam_cert_auth": "False"}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-611165: check failed")
}

test_rhel_09_611165_evidence_missing_1 if {
	f := data.stig.rhel_9.account_auth.finding_rhel_09_611165 with input as json.remove(green_fixture, [["sssd", "pam_cert_auth"]])
	f.status == "Open"
	contains(f.detail, "RHEL-09-611165: evidence missing — sssd.pam_cert_auth")
}

test_rhel_09_611165_not_applicable_1 if {
	f := data.stig.rhel_9.account_auth.finding_rhel_09_611165 with input as object.union(green_fixture, {"sssd": {"pam_cert_auth": null}, "attest": {"rhel_09_611165_alternate_mfa": true}})
	f.status == "Not_Applicable"
}

