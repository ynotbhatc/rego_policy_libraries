test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_9.account_auth.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.rhel_9.account_auth.compliant with input as green_fixture
}

test_rhel_09_611165_pass if {
	data.stig.rhel_9.account_auth.status_rhel_09_611165 == "Not_a_Finding" with input as green_fixture
}

test_rhel_09_611165_fail_1 if {
	f := data.stig.rhel_9.account_auth.finding_rhel_09_611165 with input as object.union(green_fixture, {"sssd": {"pam_cert_auth": "False"}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-611165: check failed")
}

