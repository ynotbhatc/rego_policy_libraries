	f := data.stig.rhel_9.software_integrity.finding_rhel_09_214025 with input as json.remove(green_fixture, [["yum_repos"]])
	f.status == "Open"
	contains(f.detail, "RHEL-09-214025: evidence missing — yum_repos")
}

test_rhel_09_214025_pass_2 if {
	data.stig.rhel_9.software_integrity.status_rhel_09_214025 == "Not_a_Finding" with input as object.union(green_fixture, {"yum_repos": [{"name": "a", "gpgcheck": "Yes"}, {"name": "b", "gpgcheck": "TRUE"}]})
