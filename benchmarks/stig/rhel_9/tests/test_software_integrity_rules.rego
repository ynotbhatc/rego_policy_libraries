package stig.rhel_9.software_integrity_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"dnf_config": {"localpkg_gpgcheck": "1"},
	"yum_repos": [{
		"file": "/etc/yum.repos.d/redhat.repo",
		"gpgcheck": "1",
		"name": "rhel-9-for-x86_64-baseos-rpms",
	}],
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_9.software_integrity.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_rhel_09_214025_pass if {
	data.stig.rhel_9.software_integrity.status_rhel_09_214025 == "Not_a_Finding" with input as green_fixture
}

test_rhel_09_214025_fail_1 if {
	f := data.stig.rhel_9.software_integrity.finding_rhel_09_214025 with input as object.union(green_fixture, {"yum_repos": [{"file": "/etc/yum.repos.d/redhat.repo", "name": "rhel-9-for-x86_64-baseos-rpms", "gpgcheck": "0"}]})
	f.status == "Open"
	contains(f.detail, "RHEL-09-214025: check failed")
}

test_rhel_09_214025_fail_2 if {
	f := data.stig.rhel_9.software_integrity.finding_rhel_09_214025 with input as object.union(green_fixture, {"yum_repos": [{"file": "/etc/yum.repos.d/local.repo", "name": "local"}]})
	f.status == "Open"
	contains(f.detail, "RHEL-09-214025: check failed")
}

test_rhel_09_214025_fail_3 if {
	f := data.stig.rhel_9.software_integrity.finding_rhel_09_214025 with input as object.union(green_fixture, {"yum_repos": []})
	f.status == "Open"
	contains(f.detail, "RHEL-09-214025: check failed")
}

test_rhel_09_214025_evidence_missing_1 if {
	f := data.stig.rhel_9.software_integrity.finding_rhel_09_214025 with input as json.remove(green_fixture, [["yum_repos"]])
	f.status == "Open"
	contains(f.detail, "RHEL-09-214025: evidence missing — yum_repos")
}

test_rhel_09_214025_pass_2 if {
	data.stig.rhel_9.software_integrity.status_rhel_09_214025 == "Not_a_Finding" with input as object.union(green_fixture, {"yum_repos": [{"name": "a", "gpgcheck": "Yes"}, {"name": "b", "gpgcheck": "TRUE"}]})
}

test_rhel_09_214025_pass_3 if {
	data.stig.rhel_9.software_integrity.status_rhel_09_214025 == "Not_a_Finding" with input as object.union(green_fixture, {"yum_repos": [{"name": "a", "gpgcheck": "0"}], "attest": {"rhel_09_214025_gpg_process": true}})
}

test_rhel_09_214020_pass if {
	data.stig.rhel_9.software_integrity.status_rhel_09_214020 == "Not_a_Finding" with input as green_fixture
}

test_rhel_09_214020_fail_1 if {
	f := data.stig.rhel_9.software_integrity.finding_rhel_09_214020 with input as object.union(green_fixture, {"dnf_config": {"localpkg_gpgcheck": "0"}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-214020: check failed")
}

test_rhel_09_214020_fail_2 if {
	f := data.stig.rhel_9.software_integrity.finding_rhel_09_214020 with input as object.union(green_fixture, {"dnf_config": {"localpkg_gpgcheck": "False"}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-214020: check failed")
}

test_rhel_09_214020_evidence_missing_1 if {
	f := data.stig.rhel_9.software_integrity.finding_rhel_09_214020 with input as json.remove(green_fixture, [["dnf_config", "localpkg_gpgcheck"]])
	f.status == "Open"
	contains(f.detail, "RHEL-09-214020: evidence missing — dnf_config.localpkg_gpgcheck")
}

test_rhel_09_214020_pass_2 if {
	data.stig.rhel_9.software_integrity.status_rhel_09_214020 == "Not_a_Finding" with input as object.union(green_fixture, {"dnf_config": {"localpkg_gpgcheck": "True"}})
}
