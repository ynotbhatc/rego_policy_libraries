package stig.rhel_9.software_integrity_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"aide": {
		"audit_tool_lines": [
			"/usr/sbin/auditctl p+i+n+u+g+s+b+acl+xattrs+sha512",
			"/usr/sbin/auditd p+i+n+u+g+s+b+acl+xattrs+sha512",
			"/usr/sbin/ausearch p+i+n+u+g+s+b+acl+xattrs+sha512",
			"/usr/sbin/aureport p+i+n+u+g+s+b+acl+xattrs+sha512",
			"/usr/sbin/autrace p+i+n+u+g+s+b+acl+xattrs+sha512",
			"/usr/sbin/augenrules p+i+n+u+g+s+b+acl+xattrs+sha512",
		],
		"rule_lines": [
			"All=p+i+n+u+g+s+m+S+sha512+acl+xattrs+selinux",
		],
	},
	"attest": {
		"rhel_09_211015_patching_current": true,
	},
	"dnf_config": {
		"clean_requirements_on_remove": "True",
		"gpgcheck": "1",
		"localpkg_gpgcheck": "1",
	},
	"dnf_repolist": [
		{
			"id": "rhel-9-for-x86_64-appstream-rpms",
			"name": "Red Hat Enterprise Linux 9 for x86_64 - AppStream (RPMs)",
		},
		{
			"id": "rhel-9-for-x86_64-baseos-rpms",
			"name": "Red Hat Enterprise Linux 9 for x86_64 - BaseOS (RPMs)",
		},
	],
	"fapolicyd": {
		"compiled_rules": [
			"allow perm=any uid=0 : dir=/var/tmp/",
			"allow perm=open all : ftype=text/x-python trust=1",
			"deny_audit perm=any pattern=ld_so : all",
			"deny perm=any all : all",
		],
		"permissive": "0",
	},
	"kernel_params": {
		"kernel.kexec_load_disabled": "1",
	},
	"packages": {
		"aide": true,
		"fapolicyd": true,
		"postfix": true,
		"rng-tools": true,
		"rsyslog": true,
		"rsyslog-gnutls": true,
		"s-nail": true,
		"subscription-manager": true,
	},
	"redhat_release_key_file": {
		"fingerprints": [
			"567E 347A D004 4ADE 55BA  8A5F 199E 2F91 FD43 1D51",
			"7E46 2425 8C40 6535 D56D  6F13 5054 E4A4 5A63 40B3",
		],
	},
	"rpm_gpg_pubkeys": [
		"Red Hat, Inc. (release key 2) <security@redhat.com> public key",
		"Red Hat, Inc. (auxiliary key 3) <security@redhat.com> public key",
	],
	"rpm_verify": {
		"hash_mismatch_files": [],
	},
	"rsyslog": {
		"config_lines": [
			"$DefaultNetstreamDriver gtls",
			"$ActionSendStreamDriverMode 1",
			"$ActionSendStreamDriverAuthMode x509/name",
			"auth.*;authpriv.*;daemon.* /var/log/secure",
			"cron.* /var/log/cron",
			"*.* @@logserver.example.com:6514",
		],
		"listening_sockets": [],
	},
	"services": {
		"fapolicyd": "active",
		"rsyslog": "active",
	},
	"yum_repos": [
		{
			"file": "/etc/yum.repos.d/redhat.repo",
			"gpgcheck": "1",
			"name": "rhel-9-for-x86_64-baseos-rpms",
		},
	],
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_9.software_integrity.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.rhel_9.software_integrity.compliant with input as green_fixture
}

test_rhel_09_214025_pass if {
	data.stig.rhel_9.software_integrity.status_rhel_09_214025 == "Not_a_Finding" with input as green_fixture
}

test_rhel_09_214025_fail_1 if {
	f := data.stig.rhel_9.software_integrity.finding_rhel_09_214025 with input as object.union(green_fixture, {"yum_repos": [{"file": "/etc/yum.repos.d/redhat.repo", "name": "rhel-9-for-x86_64-baseos-rpms", "gpgcheck": "0"}]})
	f.status == "Open"
	contains(f.detail, "RHEL-09-214025: check failed")
}

