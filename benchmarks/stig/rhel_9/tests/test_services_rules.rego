package stig.rhel_9.services_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"packages": {
		"tftp-server": true,
		"vsftpd": false,
	},
	"tftp": {"execstart": "/usr/sbin/in.tftpd -s /var/lib/tftpboot"},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_9.services.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_rhel_09_215060_pass if {
	data.stig.rhel_9.services.status_rhel_09_215060 == "Not_a_Finding" with input as green_fixture
}

test_rhel_09_215060_fail_1 if {
	f := data.stig.rhel_9.services.finding_rhel_09_215060 with input as object.union(green_fixture, {"tftp": {"execstart": "/usr/sbin/in.tftpd /var/lib/tftpboot"}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-215060: check failed")
}

test_rhel_09_215060_fail_2 if {
	f := data.stig.rhel_9.services.finding_rhel_09_215060 with input as object.union(green_fixture, {"tftp": {"execstart": null}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-215060: check failed")
}

test_rhel_09_215060_evidence_missing_1 if {
	f := data.stig.rhel_9.services.finding_rhel_09_215060 with input as json.remove(green_fixture, [["packages", "tftp-server"]])
	f.status == "Open"
	contains(f.detail, "RHEL-09-215060: evidence missing — packages.tftp-server")
}

test_rhel_09_215060_not_applicable_1 if {
	f := data.stig.rhel_9.services.finding_rhel_09_215060 with input as object.union(green_fixture, {"packages": {"tftp-server": false}})
	f.status == "Not_Applicable"
}

test_rhel_09_215015_pass if {
	data.stig.rhel_9.services.status_rhel_09_215015 == "Not_a_Finding" with input as green_fixture
}

test_rhel_09_215015_fail_1 if {
	f := data.stig.rhel_9.services.finding_rhel_09_215015 with input as object.union(green_fixture, {"packages": {"vsftpd": true}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-215015: check failed")
}

test_rhel_09_215015_evidence_missing_1 if {
	f := data.stig.rhel_9.services.finding_rhel_09_215015 with input as json.remove(green_fixture, [["packages", "vsftpd"]])
	f.status == "Open"
	contains(f.detail, "RHEL-09-215015: evidence missing — packages.vsftpd")
}
