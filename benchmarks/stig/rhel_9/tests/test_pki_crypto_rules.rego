package stig.rhel_9.pki_crypto_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"crypto_backends": [
		{
			"is_symlink": true,
			"name": "openssh.config",
			"target": "/usr/share/crypto-policies/FIPS/openssh.txt",
		},
		{
			"is_symlink": true,
			"name": "opensslcnf.config",
			"target": "/usr/share/crypto-policies/FIPS/opensslcnf.txt",
		},
		{
			"is_symlink": false,
			"name": "nss.config",
			"target": null,
		},
	],
	"crypto_policy_check": {"output": "The configured policy matches the generated policy"},
	"openssl_cnf": {"lines": [
		"[ crypto_policy ]",
		".include = /etc/crypto-policies/back-ends/opensslcnf.config",
	]},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_9.pki_crypto.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_rhel_09_672020_pass if {
	data.stig.rhel_9.pki_crypto.status_rhel_09_672020 == "Not_a_Finding" with input as green_fixture
}

test_rhel_09_672020_fail_1 if {
	f := data.stig.rhel_9.pki_crypto.finding_rhel_09_672020 with input as object.union(green_fixture, {"crypto_policy_check": {"output": "The configured policy does NOT match the generated policy"}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-672020: check failed")
}

test_rhel_09_672020_fail_2 if {
	f := data.stig.rhel_9.pki_crypto.finding_rhel_09_672020 with input as object.union(green_fixture, {"crypto_backends": [{"name": "openssh.config", "is_symlink": true, "target": "/usr/share/crypto-policies/DEFAULT/openssh.txt"}]})
	f.status == "Open"
	contains(f.detail, "RHEL-09-672020: check failed")
}

test_rhel_09_672020_fail_3 if {
	f := data.stig.rhel_9.pki_crypto.finding_rhel_09_672020 with input as object.union(green_fixture, {"crypto_backends": [{"name": "openssh.config", "is_symlink": false, "target": null}]})
	f.status == "Open"
	contains(f.detail, "RHEL-09-672020: check failed")
}

test_rhel_09_672020_fail_4 if {
	f := data.stig.rhel_9.pki_crypto.finding_rhel_09_672020 with input as object.union(green_fixture, {"crypto_backends": [{"name": "nss.config", "is_symlink": true, "target": "/usr/share/crypto-policies/FIPS/nss.txt"}]})
	f.status == "Open"
	contains(f.detail, "RHEL-09-672020: check failed")
}

test_rhel_09_672020_fail_5 if {
	f := data.stig.rhel_9.pki_crypto.finding_rhel_09_672020 with input as object.union(green_fixture, {"crypto_backends": []})
	f.status == "Open"
	contains(f.detail, "RHEL-09-672020: check failed")
}

test_rhel_09_672020_evidence_missing_1 if {
	f := data.stig.rhel_9.pki_crypto.finding_rhel_09_672020 with input as json.remove(green_fixture, [["crypto_policy_check", "output"]])
	f.status == "Open"
	contains(f.detail, "RHEL-09-672020: evidence missing — crypto_policy_check.output")
}

test_rhel_09_672020_evidence_missing_2 if {
	f := data.stig.rhel_9.pki_crypto.finding_rhel_09_672020 with input as json.remove(green_fixture, [["crypto_backends"]])
	f.status == "Open"
	contains(f.detail, "RHEL-09-672020: evidence missing — crypto_backends")
}

test_rhel_09_672055_pass if {
	data.stig.rhel_9.pki_crypto.status_rhel_09_672055 == "Not_a_Finding" with input as green_fixture
}

test_rhel_09_672055_fail_1 if {
	f := data.stig.rhel_9.pki_crypto.finding_rhel_09_672055 with input as object.union(green_fixture, {"openssl_cnf": {"lines": ["# .include = /etc/crypto-policies/back-ends/opensslcnf.config"]}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-672055: check failed")
}

test_rhel_09_672055_fail_2 if {
	f := data.stig.rhel_9.pki_crypto.finding_rhel_09_672055 with input as object.union(green_fixture, {"openssl_cnf": {"lines": [".include = /etc/pki/tls/other.cnf"]}})
	f.status == "Open"
	contains(f.detail, "RHEL-09-672055: check failed")
}

test_rhel_09_672055_evidence_missing_1 if {
	f := data.stig.rhel_9.pki_crypto.finding_rhel_09_672055 with input as json.remove(green_fixture, [["openssl_cnf", "lines"]])
	f.status == "Open"
	contains(f.detail, "RHEL-09-672055: evidence missing — openssl_cnf.lines")
}
