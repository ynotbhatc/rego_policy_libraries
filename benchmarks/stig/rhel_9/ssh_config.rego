package stig.rhel_9.ssh_config

# DISA STIG for RHEL 9 - SSH Configuration Module
# STIG Version: V2R10 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in rhel9_rules.py (regenerate, don't hand-edit).
# Covers: SSH daemon hardening, key exchange, MACs, ciphers

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a whole JSON number only; undefined otherwise. A number sent as text ("900") is
# not read: the collector converts the configured text, and the finding says "evidence invalid" with the type received
# (a fraction such as 3.5 is not a value these settings can hold)
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	_whole_number(v)
}

_whole_number(v) if {
	is_number(v)
	v == floor(v)
}

# what was received where a whole JSON number is required: the JSON type, or "a fraction"
_got(v) := "a fraction" if is_number(v)

_got(v) := type_name(v) if not is_number(v)

# the "evidence invalid" entry for a fact that is collected but is not a whole JSON number
_not_a_number(fact, v) := sprintf("%s is not a number (got %s)", [fact, _got(v)]) if {
	v != null
	not _whole_number(v)
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# DISA's lists for the opensshserver crypto-policy back-end (RHEL-09-255065 / RHEL-09-255075)
fips_ssh_ciphers := {"aes256-gcm@openssh.com", "aes256-ctr", "aes128-gcm@openssh.com", "aes128-ctr"}

fips_ssh_macs := {"hmac-sha2-256-etm@openssh.com", "hmac-sha2-512-etm@openssh.com", "hmac-sha2-256", "hmac-sha2-512"}

# the comma-separated list at path, each entry trimmed; undefined unless a string
_csv(path) := [trim_space(x) | some x in parts] if {
	s := _str(path)
	parts := split(s, ",")
}

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# RHEL-09-255065 | V-257989 | CAT I
# Ciphers line of /etc/crypto-policies/back-ends/opensshserver.config (not sshd_config)
missing_rhel_09_255065 := [concat(".", p) | some p in [["opensshserver_config", "Ciphers"]]; not _collected(p)]

default ssh_fips_ciphers := false

ssh_fips_ciphers if {
	count(missing_rhel_09_255065) == 0
	vals := _csv(["opensshserver_config", "Ciphers"])
	count(vals) > 0
	every v in vals {
		v in fips_ssh_ciphers
	}
}

status_rhel_09_255065 := "Not_a_Finding" if ssh_fips_ciphers

else := "Open"

detail_rhel_09_255065 := "RHEL-09-255065: Not_a_Finding" if ssh_fips_ciphers

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-255065", concat(", ", missing_rhel_09_255065)]) if count(missing_rhel_09_255065) > 0

else := "RHEL-09-255065: check failed — Ciphers in /etc/crypto-policies/back-ends/opensshserver.config must list only aes256-gcm@openssh.com,aes256-ctr,aes128-gcm@openssh.com,aes128-ctr"

finding_rhel_09_255065 := {
	"vuln_id": "V-257989",
	"stig_id": "RHEL-09-255065",
	"severity": "CAT I",
	"rule_title": "The RHEL 9 SSH server must be configured to use only DoW-approved encryption ciphers employing FIPS 140-3 validated cryptographic hash algorithms to protect the confidentiality of SSH server connections.",
	"check_type": "machine",
	"status": status_rhel_09_255065,
	"detail": detail_rhel_09_255065,
	"fix_text": "Apply the FIPS crypto policy (update-crypto-policies --set FIPS) so opensshserver.config carries the DISA list",
}

