finding_rhel_09_215040 := {
	"vuln_id": "V-257831",
	"stig_id": "RHEL-09-215040",
	"severity": "CAT II",
	"rule_title": "RHEL 9 must not have the telnet-server package installed.",
	"check_type": "machine",
