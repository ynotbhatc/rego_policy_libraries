package stig.rhel_9.services

# DISA STIG for RHEL 9 - Services Module
# STIG Version: V2R10 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in rhel9_rules.py (regenerate, don't hand-edit).
# Covers: Unnecessary/insecure services that must be disabled

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a number, or a string holding a decimal integer; undefined otherwise
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# RHEL-09-215060 | V-257835 | CAT I
# if tftp-server is installed, tftp.service ExecStart must carry -s; not installed is Not Applicable
missing_rhel_09_215060 := [concat(".", p) | some p in [["packages", "tftp-server"]]; not _collected(p)]

default tftp_secure_mode := false

tftp_secure_mode if {
	count(missing_rhel_09_215060) == 0
	input.packages["tftp-server"] == true
	s := _str(["tftp", "execstart"])
	regex.match(`(^|\s)-s(\s|$)`, s)
}

default na_rhel_09_215060 := false

na_rhel_09_215060 if {
	input.packages["tftp-server"] == false
}

status_rhel_09_215060 := "Not_a_Finding" if tftp_secure_mode

else := "Not_Applicable" if na_rhel_09_215060

else := "Open"

detail_rhel_09_215060 := "RHEL-09-215060: Not_a_Finding" if tftp_secure_mode

else := "RHEL-09-215060: Not_Applicable — tftp-server is not installed" if na_rhel_09_215060

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-215060", concat(", ", missing_rhel_09_215060)]) if count(missing_rhel_09_215060) > 0

else := "RHEL-09-215060: check failed — tftp-server is installed: the ExecStart of tftp.service (input.tftp.execstart) must run in.tftpd with -s"

finding_rhel_09_215060 := {
	"vuln_id": "V-257835",
	"stig_id": "RHEL-09-215060",
	"severity": "CAT I",
	"rule_title": "The Trivial File Transfer Protocol (TFTP) server must not be installed unless it is required, and if required, the RHEL 9 TFTP daemon must be configured to operate in secure mode.",
	"check_type": "machine",
	"status": status_rhel_09_215060,
	"detail": detail_rhel_09_215060,
	"fix_text": "Remove tftp-server (dnf remove tftp-server) or set ExecStart=/usr/sbin/in.tftpd -s /var/lib/tftpboot",
}

# RHEL-09-215015 | V-257826 | CAT I
# the vsftpd package must not be installed (input.packages.vsftpd == false)
missing_rhel_09_215015 := [concat(".", p) | some p in [["packages", "vsftpd"]]; not _collected(p)]

default ftp_server_disabled := false

ftp_server_disabled if {
	count(missing_rhel_09_215015) == 0
	input.packages.vsftpd == false
}

status_rhel_09_215015 := "Not_a_Finding" if ftp_server_disabled

else := "Open"

detail_rhel_09_215015 := "RHEL-09-215015: Not_a_Finding" if ftp_server_disabled

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-215015", concat(", ", missing_rhel_09_215015)]) if count(missing_rhel_09_215015) > 0

else := "RHEL-09-215015: check failed — the vsftpd package must not be installed"

finding_rhel_09_215015 := {
	"vuln_id": "V-257826",
	"stig_id": "RHEL-09-215015",
	"severity": "CAT I",
	"rule_title": "RHEL 9 must not have a File Transfer Protocol (FTP) server package installed.",
	"check_type": "machine",
	"status": status_rhel_09_215015,
	"detail": detail_rhel_09_215015,
	"fix_text": "Remove the FTP server: dnf remove vsftpd",
}

