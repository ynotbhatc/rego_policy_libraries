# CAT I - HIGH SEVERITY
# =============================================================================

# RHEL-09-215060 | V-257835 | CAT I
# if tftp-server is installed, tftp.service ExecStart must carry -s; not installed is Not Applicable
missing_rhel_09_215060 := [concat(".", p) | some p in [["packages", "tftp-server"]]; not _collected(p)]

default tftp_secure_mode := false

tftp_secure_mode if {
	count(missing_rhel_09_215060) == 0
	input.packages["tftp-server"] == true
	s := _str(["tftp", "execstart"])
	regex.match(`(^|\s)-s(\s|$)`, s)
}

default na_rhel_09_215060 := false

na_rhel_09_215060 if {
	input.packages["tftp-server"] == false
}

status_rhel_09_215060 := "Not_a_Finding" if tftp_secure_mode

else := "Not_Applicable" if na_rhel_09_215060

else := "Open"

detail_rhel_09_215060 := "RHEL-09-215060: Not_a_Finding" if tftp_secure_mode

else := "RHEL-09-215060: Not_Applicable — tftp-server is not installed" if na_rhel_09_215060

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-215060", concat(", ", missing_rhel_09_215060)]) if count(missing_rhel_09_215060) > 0

else := "RHEL-09-215060: check failed — tftp-server is installed: the ExecStart of tftp.service (input.tftp.execstart) must run in.tftpd with -s"

finding_rhel_09_215060 := {
	"vuln_id": "V-257835",
	"stig_id": "RHEL-09-215060",
	"severity": "CAT I",
	"rule_title": "The Trivial File Transfer Protocol (TFTP) server must not be installed unless it is required, and if required, the RHEL 9 TFTP daemon must be configured to operate in secure mode.",
	"check_type": "machine",
	"status": status_rhel_09_215060,
	"detail": detail_rhel_09_215060,
	"fix_text": "Remove tftp-server (dnf remove tftp-server) or set ExecStart=/usr/sbin/in.tftpd -s /var/lib/tftpboot",
}

