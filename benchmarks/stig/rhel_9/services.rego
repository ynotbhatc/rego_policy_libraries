# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

cat_i_findings := [
	finding_rhel_09_215060,
	finding_rhel_09_215015,
]

cat_ii_findings := [
	finding_rhel_09_215040,
	finding_rhel_09_215025,
	finding_rhel_09_231040,
	finding_rhel_09_213115,
	finding_rhel_09_215020,
	finding_rhel_09_215045,
	finding_rhel_09_215050,
	finding_rhel_09_215055,
	finding_rhel_09_215070,
	finding_rhel_09_252010,
	finding_rhel_09_252015,
	finding_rhel_09_252020,
	finding_rhel_09_252050,
	finding_rhel_09_252060,
]

cat_iii_findings := [
	finding_rhel_09_211035,
	finding_rhel_09_252025,
	finding_rhel_09_252030,
]

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III).
# `cat_i_compliant`: the former CAT-I-only meaning, for gating on the critical subset.
default cat_i_compliant := false

open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "services",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
