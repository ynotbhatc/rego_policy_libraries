# METADATA
# title: "DISA STIG for RHEL 9 - Software Integrity Module"
# custom:
#   class: security
#   framework: stig_rhel_9
#   source: disa
#   domains: [linux, rhel]
#   coverage:
#     checks: 8
#     cited: 7
#     density: section
#     basis: role
#     tested: true
#     entrypoint: compliance_report
#     guard: self
#     as_of: v2.4.2
package stig.rhel_9.software_integrity

# DISA STIG for RHEL 9 - Software Integrity Module
# STIG Version: V2R10 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in rhel9_rules.py (regenerate, don't hand-edit).
# Covers: GPG signing, package verification, AIDE, kernel module restrictions

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a number, or a string holding a decimal integer; undefined otherwise
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# Red Hat RHEL 9 package-signing key fingerprints, from the RHEL-09-214010 check text
redhat_key_fingerprints := {"567E347AD0044ADE55BA8A5F199E2F91FD431D51", "7E4624258C406535D56D6F135054E4A45A6340B3"}

_fpr(s) := upper(replace(s, " ", "")) if is_string(s)

# an installed gpg-pubkey whose summary names the Red Hat key `label`
_rh_key_installed(label) if {
	some s in input.rpm_gpg_pubkeys
	is_string(s)
	contains(lower(s), "red hat")
	contains(s, label)
}

# an AIDE rule line (uncommented selection / group definition) that uses sha512
_aide_sha512(l) if {
	is_string(l)
	parts := regex.split(`[=+ ]+`, trim_space(l))
	"sha512" in parts
}

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# RHEL-09-214025 | V-257822 | CAT I
# gpgcheck as written in each /etc/yum.repos.d/*.repo section (input.yum_repos[{file, name, gpgcheck}])
missing_rhel_09_214025 := [concat(".", p) | some p in [["yum_repos"]]; not _collected(p)]

default all_repos_gpgcheck := false

all_repos_gpgcheck if {
	count(missing_rhel_09_214025) == 0
	repos := input.yum_repos
	is_array(repos)
	count(repos) > 0
	every r in repos {
		_truthy(object.get(r, "gpgcheck", null))
	}
}

all_repos_gpgcheck if {
	_attested("rhel_09_214025_gpg_process")
}

status_rhel_09_214025 := "Not_a_Finding" if all_repos_gpgcheck

else := "Open"

detail_rhel_09_214025 := "RHEL-09-214025: Not_a_Finding" if all_repos_gpgcheck

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-214025", concat(", ", missing_rhel_09_214025)]) if count(missing_rhel_09_214025) > 0

else := "RHEL-09-214025: check failed — every repository in /etc/yum.repos.d/*.repo must set gpgcheck to 1, true or yes, or an approved GPG verification process must be attested (input.attest.rhel_09_214025_gpg_process)"

finding_rhel_09_214025 := {
	"vuln_id": "V-257822",
	"stig_id": "RHEL-09-214025",
	"severity": "CAT I",
	"rule_title": "RHEL 9 must have GPG signature verification enabled for all software repositories.",
	"check_type": "machine+attestation",
	"status": status_rhel_09_214025,
	"detail": detail_rhel_09_214025,
	"fix_text": "Set gpgcheck=1 in every repository definition under /etc/yum.repos.d/",
}

# RHEL-09-214020 | V-257821 | CAT I
# localpkg_gpgcheck as written in /etc/dnf/dnf.conf
missing_rhel_09_214020 := [concat(".", p) | some p in [["dnf_config", "localpkg_gpgcheck"]]; not _collected(p)]

default localpkg_gpgcheck := false

localpkg_gpgcheck if {
	count(missing_rhel_09_214020) == 0
	_truthy(input.dnf_config.localpkg_gpgcheck)
}

localpkg_gpgcheck if {
	_attested("rhel_09_214020_gpg_process")
}

status_rhel_09_214020 := "Not_a_Finding" if localpkg_gpgcheck

else := "Open"

detail_rhel_09_214020 := "RHEL-09-214020: Not_a_Finding" if localpkg_gpgcheck

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-214020", concat(", ", missing_rhel_09_214020)]) if count(missing_rhel_09_214020) > 0

else := "RHEL-09-214020: check failed — localpkg_gpgcheck in /etc/dnf/dnf.conf must be 1, true or yes, or an approved GPG verification process must be attested (input.attest.rhel_09_214020_gpg_process)"

finding_rhel_09_214020 := {
	"vuln_id": "V-257821",
	"stig_id": "RHEL-09-214020",
	"severity": "CAT I",
	"rule_title": "RHEL 9 must check the GPG signature of locally installed software packages before installation.",
	"check_type": "machine+attestation",
	"status": status_rhel_09_214020,
	"detail": detail_rhel_09_214020,
	"fix_text": "Set localpkg_gpgcheck=1 in /etc/dnf/dnf.conf",
}

# =============================================================================
# CAT II - MEDIUM SEVERITY
# =============================================================================

# RHEL-09-214010 | V-257819 | CAT II
# installed gpg-pubkey summaries and the fingerprints in /etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release (null if the file is missing)
missing_rhel_09_214010 := [concat(".", p) | some p in [["rpm_gpg_pubkeys"], ["redhat_release_key_file", "fingerprints"]]; not _collected(p)]

default gpgcheck_global := false

gpgcheck_global if {
	count(missing_rhel_09_214010) == 0
	_rh_key_installed("(release key 2)")
	_rh_key_installed("(auxiliary key 3)")
	fps := input.redhat_release_key_file.fingerprints
	is_array(fps)
	installed := {f | some x in fps; f := _fpr(x)}
	every k in redhat_key_fingerprints {
		k in installed
	}
}

status_rhel_09_214010 := "Not_a_Finding" if gpgcheck_global

else := "Open"

detail_rhel_09_214010 := "RHEL-09-214010: Not_a_Finding" if gpgcheck_global

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-214010", concat(", ", missing_rhel_09_214010)]) if count(missing_rhel_09_214010) > 0

else := "RHEL-09-214010: check failed — Red Hat GPG keys 'release key 2' and 'auxiliary key 3' must be installed and /etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release must carry fingerprints 567E347AD0044ADE55BA8A5F199E2F91FD431D51 and 7E4624258C406535D56D6F135054E4A45A6340B3"

finding_rhel_09_214010 := {
	"vuln_id": "V-257819",
	"stig_id": "RHEL-09-214010",
	"severity": "CAT II",
	"rule_title": "RHEL 9 must ensure cryptographic verification of vendor software packages.",
	"check_type": "machine",
	"status": status_rhel_09_214010,
	"detail": detail_rhel_09_214010,
	"fix_text": "Install the Red Hat keys: rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release (from a verified redhat-release package)",
}

# RHEL-09-651020 | V-258136 | CAT II
# the uncommented rule / selection lines of /etc/aide.conf
missing_rhel_09_651020 := [concat(".", p) | some p in [["aide", "rule_lines"]]; not _collected(p)]

default aide_fips_hashes := false

aide_fips_hashes if {
	count(missing_rhel_09_651020) == 0
	lines := input.aide.rule_lines
	is_array(lines)
	count(lines) > 0
	every l in lines {
		_aide_sha512(l)
	}
}

aide_fips_hashes if {
	_attested("rhel_09_651020_other_tool")
}

status_rhel_09_651020 := "Not_a_Finding" if aide_fips_hashes

else := "Open"

detail_rhel_09_651020 := "RHEL-09-651020: Not_a_Finding" if aide_fips_hashes

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-651020", concat(", ", missing_rhel_09_651020)]) if count(missing_rhel_09_651020) > 0

else := "RHEL-09-651020: check failed — every uncommented selection line in /etc/aide.conf must use sha512, or another tool using FIPS 140-3 hashes must be attested (input.attest.rhel_09_651020_other_tool)"

finding_rhel_09_651020 := {
	"vuln_id": "V-258136",
	"stig_id": "RHEL-09-651020",
	"severity": "CAT II",
	"rule_title": "RHEL 9 must use a file integrity tool that is configured to use FIPS 140-3-approved cryptographic hashes for validating file contents and directories.",
	"check_type": "machine+attestation",
	"status": status_rhel_09_651020,
	"detail": detail_rhel_09_651020,
	"fix_text": "Add sha512 to every uncommented selection line in /etc/aide.conf",
}

# RHEL-09-213020 | V-257799 | CAT II
# runtime kernel.kexec_load_disabled (sysctl)
missing_rhel_09_213020 := [concat(".", p) | some p in [["kernel_params", "kernel.kexec_load_disabled"]]; not _collected(p)]

default kexec_disabled := false

kexec_disabled if {
	count(missing_rhel_09_213020) == 0
	_str(["kernel_params", "kernel.kexec_load_disabled"]) == "1"
}

status_rhel_09_213020 := "Not_a_Finding" if kexec_disabled

else := "Open"

detail_rhel_09_213020 := "RHEL-09-213020: Not_a_Finding" if kexec_disabled

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-213020", concat(", ", missing_rhel_09_213020)]) if count(missing_rhel_09_213020) > 0

else := "RHEL-09-213020: check failed — kernel.kexec_load_disabled must be 1"

finding_rhel_09_213020 := {
	"vuln_id": "V-257799",
	"stig_id": "RHEL-09-213020",
	"severity": "CAT II",
	"rule_title": "RHEL 9 must prevent the loading of a new kernel for later execution.",
	"check_type": "machine",
	"status": status_rhel_09_213020,
	"detail": detail_rhel_09_213020,
	"fix_text": "Set kernel.kexec_load_disabled = 1 in /etc/sysctl.d/ and run sysctl --system",
}

# RHEL-09-652010 | V-258140 | CAT II
# rsyslog package installed
missing_rhel_09_652010 := [concat(".", p) | some p in [["packages", "rsyslog"]]; not _collected(p)]

default rsyslog_installed := false

rsyslog_installed if {
	count(missing_rhel_09_652010) == 0
	input.packages.rsyslog == true
}

status_rhel_09_652010 := "Not_a_Finding" if rsyslog_installed

else := "Open"

detail_rhel_09_652010 := "RHEL-09-652010: Not_a_Finding" if rsyslog_installed

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-652010", concat(", ", missing_rhel_09_652010)]) if count(missing_rhel_09_652010) > 0

else := "RHEL-09-652010: check failed — the rsyslog package must be installed"

finding_rhel_09_652010 := {
	"vuln_id": "V-258140",
	"stig_id": "RHEL-09-652010",
	"severity": "CAT II",
	"rule_title": "RHEL 9 must have the rsyslog package installed.",
	"check_type": "machine",
	"status": status_rhel_09_652010,
	"detail": detail_rhel_09_652010,
	"fix_text": "Install rsyslog: dnf install rsyslog",
}

# RHEL-09-652020 | V-258142 | CAT II
# systemctl is-active rsyslog
missing_rhel_09_652020 := [concat(".", p) | some p in [["services", "rsyslog"]]; not _collected(p)]

default rsyslog_active := false

rsyslog_active if {
	count(missing_rhel_09_652020) == 0
	_kw(["services", "rsyslog"]) == "active"
}

status_rhel_09_652020 := "Not_a_Finding" if rsyslog_active

else := "Open"

detail_rhel_09_652020 := "RHEL-09-652020: Not_a_Finding" if rsyslog_active

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-652020", concat(", ", missing_rhel_09_652020)]) if count(missing_rhel_09_652020) > 0

else := "RHEL-09-652020: check failed — rsyslog must be active (systemctl is-active rsyslog)"

finding_rhel_09_652020 := {
	"vuln_id": "V-258142",
	"stig_id": "RHEL-09-652020",
	"severity": "CAT II",
	"rule_title": "The rsyslog service on RHEL 9 must be active.",
	"check_type": "machine",
	"status": status_rhel_09_652020,
	"detail": detail_rhel_09_652020,
	"fix_text": "Enable rsyslog: systemctl enable --now rsyslog",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

cat_i_findings := [
	finding_rhel_09_214025,
	finding_rhel_09_214020,
]

cat_ii_findings := [
	finding_rhel_09_214010,
	finding_rhel_09_651020,
	finding_rhel_09_213020,
	finding_rhel_09_652010,
	finding_rhel_09_652020,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III).
# `cat_i_compliant`: the former CAT-I-only meaning, for gating on the critical subset.
default cat_i_compliant := false

open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "software_integrity",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
