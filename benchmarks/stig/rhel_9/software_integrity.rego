package stig.rhel_9.software_integrity

# DISA STIG for RHEL 9 - Software Integrity Module
# STIG Version: V2R10 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in rhel9_rules.py (regenerate, don't hand-edit).
# Covers: GPG signing, package verification, AIDE, kernel module restrictions

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a whole JSON number only; undefined otherwise. A number sent as text ("900") is
# not read: the collector converts the configured text, and the finding says "evidence invalid" with the type received
# (a fraction such as 3.5 is not a value these settings can hold)
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	_whole_number(v)
}

_whole_number(v) if {
	is_number(v)
	v == floor(v)
}

# what was received where a whole JSON number is required: the JSON type, or "a fraction"
_got(v) := "a fraction" if is_number(v)

_got(v) := type_name(v) if not is_number(v)

# the "evidence invalid" entry for a fact that is collected but is not a whole JSON number
_not_a_number(fact, v) := sprintf("%s is not a number (got %s)", [fact, _got(v)]) if {
	v != null
	not _whole_number(v)
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# Red Hat RHEL 9 package-signing key fingerprints, from the RHEL-09-214010 check text
redhat_key_fingerprints := {"567E347AD0044ADE55BA8A5F199E2F91FD431D51", "7E4624258C406535D56D6F135054E4A45A6340B3"}

_fpr(s) := upper(replace(s, " ", "")) if is_string(s)

# an installed gpg-pubkey whose summary is exactly Red Hat's for key `label` (as the check's rpm -q output shows it)
_rh_key_installed(label) if {
	some s in input.rpm_gpg_pubkeys
	is_string(s)
	trim_space(s) == concat("", ["Red Hat, Inc. ", label, " <security@redhat.com> public key"])
}

# an AIDE rule line (uncommented selection / group definition) that uses sha512
_aide_sha512(l) if {
	is_string(l)
	parts := regex.split(`[=+ ]+`, trim_space(l))
	"sha512" in parts
}

# the audit tools the RHEL-09-651025 check lists
_p4_audit_tools := {"/usr/sbin/auditctl", "/usr/sbin/auditd", "/usr/sbin/ausearch", "/usr/sbin/aureport", "/usr/sbin/autrace", "/usr/sbin/augenrules"}

# an /etc/aide.conf selection line for exactly this path, with a rule after it
_p4_aide_selects(l, path) if {
	is_string(l)
	parts := regex.split(`\s+`, trim_space(l))
	count(parts) >= 2
	parts[0] == path
}

# an AIDE rule line (uncommented selection / group definition) that uses the given rule (acl, xattrs)
_p4_aide_uses(l, rule) if {
	is_string(l)
	parts := regex.split(`[=+ ]+`, trim_space(l))
	rule in parts
}

# input.rsyslog.config_lines: the uncommented lines of /etc/rsyslog.conf and /etc/rsyslog.d/*, a multi-line
# RainerScript statement joined into one line
_p4_rsyslog := [l | some l in input.rsyslog.config_lines; is_string(l)]

_p4_rsyslog_collected if is_array(input.rsyslog.config_lines)

# the values a pattern's last capture group takes over the rsyslog lines (group index n)
_p4_rsyslog_values(pattern, n) := [lower(m[n]) | some l in _p4_rsyslog; some m in regex.find_all_string_submatch_n(pattern, l, -1)]

# a StreamDriver setting inside a module() block (the check: a finding; it belongs in the omfwd action)
_p4_rsyslog_module_streamdriver(pattern) if {
	some l in _p4_rsyslog
	regex.match(`(?i)^\s*module\s*\(`, l)
	regex.match(pattern, l)
}

# a facility selector (auth, authpriv, daemon) logged at every priority by some rule line
_p4_rsyslog_logs(fac) if {
	some l in _p4_rsyslog
	regex.match(sprintf(`(^|[;,\s])%s\.\*`, [fac]), l)
}

