# RHEL-09-214025 | V-257822 | CAT I
# gpgcheck as written in each /etc/yum.repos.d/*.repo section (input.yum_repos[{file, name, gpgcheck}])
missing_rhel_09_214025 := [concat(".", p) | some p in [["yum_repos"]]; not _collected(p)]

default all_repos_gpgcheck := false

all_repos_gpgcheck if {
	count(missing_rhel_09_214025) == 0
	repos := input.yum_repos
	is_array(repos)
	count(repos) > 0
	every r in repos {
		_truthy(object.get(r, "gpgcheck", null))
	}
}

all_repos_gpgcheck if {
	_attested("rhel_09_214025_gpg_process")
}

status_rhel_09_214025 := "Not_a_Finding" if all_repos_gpgcheck

else := "Open"

detail_rhel_09_214025 := "RHEL-09-214025: Not_a_Finding" if all_repos_gpgcheck

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-09-214025", concat(", ", missing_rhel_09_214025)]) if count(missing_rhel_09_214025) > 0

else := "RHEL-09-214025: check failed — every repository in /etc/yum.repos.d/*.repo must set gpgcheck to 1, true or yes, or an approved GPG verification process must be attested (input.attest.rhel_09_214025_gpg_process)"

finding_rhel_09_214025 := {
	"vuln_id": "V-257822",
	"stig_id": "RHEL-09-214025",
	"severity": "CAT I",
	"rule_title": "RHEL 9 must have GPG signature verification enabled for all software repositories.",
	"check_type": "machine+attestation",
	"status": status_rhel_09_214025,
	"detail": detail_rhel_09_214025,
	"fix_text": "Set gpgcheck=1 in every repository definition under /etc/yum.repos.d/",
}

