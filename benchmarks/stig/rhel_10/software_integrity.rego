# METADATA
# title: "DISA STIG for RHEL 10 - Software Integrity Module"
# custom:
#   class: security
#   framework: stig_rhel_10
#   source: disa
#   domains: [linux, rhel]
#   coverage:
#     checks: 7
#     cited: 6
#     density: section
#     basis: role
#     tested: true
#     entrypoint: compliance_report
#     guard: self
#     as_of: v2.5.0
package stig.rhel_10.software_integrity

# DISA STIG for RHEL 10 - Software Integrity Module
# STIG Version: V1R3 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in rhel10_rules.py (regenerate, don't hand-edit).
# Covers: GPG signing, package verification, AIDE, kernel module restrictions

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a number, or a string holding a decimal integer; undefined otherwise
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

_fpr(s) := upper(replace(s, " ", "")) if is_string(s)

# an installed gpg-pubkey whose summary is exactly Red Hat's for key `label` (as the check's rpm -q output shows it)
_rh_key_installed(label) if {
	some s in input.rpm_gpg_pubkeys
	is_string(s)
	trim_space(s) == concat("", ["Red Hat, Inc. ", label, " <security@redhat.com> public key"])
}

# the RHEL 10 package-signing key fingerprints, from the RHEL-10-001020 check text (sq inspect output)
rhel10_key_fingerprints := {"567E347AD0044ADE55BA8A5F199E2F91FD431D51", "7E4624258C406535D56D6F135054E4A45A6340B3", "FCD355B305707A62DA143AB6E422397E50FE8467A2A95343D246D6276AFEDF8F"}

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# RHEL-10-001050 | V-280934 | CAT I
# gpgcheck as written in each /etc/yum.repos.d/*.repo section (input.yum_repos[{file, name, gpgcheck}])
missing_rhel_10_001050 := [concat(".", p) | some p in [["yum_repos"]]; not _collected(p)]

default all_repos_gpgcheck := false

all_repos_gpgcheck if {
	count(missing_rhel_10_001050) == 0
	repos := input.yum_repos
	is_array(repos)
	count(repos) > 0
	every r in repos {
		_truthy(object.get(r, "gpgcheck", null))
	}
}

all_repos_gpgcheck if {
	_attested("rhel_10_001050_gpg_process")
}

status_rhel_10_001050 := "Not_a_Finding" if all_repos_gpgcheck

else := "Open"

detail_rhel_10_001050 := "RHEL-10-001050: Not_a_Finding" if all_repos_gpgcheck

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-001050", concat(", ", missing_rhel_10_001050)]) if count(missing_rhel_10_001050) > 0

else := "RHEL-10-001050: check failed — every repository in /etc/yum.repos.d/*.repo must set gpgcheck to 1, true or yes, or an approved GPG verification process must be attested (input.attest.rhel_10_001050_gpg_process)"

finding_rhel_10_001050 := {
	"vuln_id": "V-280934",
	"stig_id": "RHEL-10-001050",
	"severity": "CAT I",
	"rule_title": "RHEL 10 must have GNU Privacy Guard (GPG) signature verification enabled for all software repositories.",
	"check_type": "machine+attestation",
	"status": status_rhel_10_001050,
	"detail": detail_rhel_10_001050,
	"fix_text": "Set gpgcheck=1 in every repository definition under /etc/yum.repos.d/",
}

# RHEL-10-001040 | V-280933 | CAT I
# localpkg_gpgcheck as written in /etc/dnf/dnf.conf
missing_rhel_10_001040 := [concat(".", p) | some p in [["dnf_config", "localpkg_gpgcheck"]]; not _collected(p)]

default localpkg_gpgcheck := false

localpkg_gpgcheck if {
	count(missing_rhel_10_001040) == 0
	_truthy(input.dnf_config.localpkg_gpgcheck)
}

localpkg_gpgcheck if {
	_attested("rhel_10_001040_gpg_process")
}

status_rhel_10_001040 := "Not_a_Finding" if localpkg_gpgcheck

else := "Open"

detail_rhel_10_001040 := "RHEL-10-001040: Not_a_Finding" if localpkg_gpgcheck

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-001040", concat(", ", missing_rhel_10_001040)]) if count(missing_rhel_10_001040) > 0

else := "RHEL-10-001040: check failed — localpkg_gpgcheck in /etc/dnf/dnf.conf must be 1, true or yes, or an approved GPG verification process must be attested (input.attest.rhel_10_001040_gpg_process)"

finding_rhel_10_001040 := {
	"vuln_id": "V-280933",
	"stig_id": "RHEL-10-001040",
	"severity": "CAT I",
	"rule_title": "RHEL 10 must check the GNU Privacy Guard (GPG) signature of locally installed software packages before installation.",
	"check_type": "machine+attestation",
	"status": status_rhel_10_001040,
	"detail": detail_rhel_10_001040,
	"fix_text": "Set localpkg_gpgcheck=1 in /etc/dnf/dnf.conf",
}

# RHEL-10-701050 | V-281307 | CAT I
# runtime kernel.kexec_load_disabled (sysctl)
missing_rhel_10_701050 := [concat(".", p) | some p in [["kernel_params", "kernel.kexec_load_disabled"]]; not _collected(p)]

default kexec_disabled := false

kexec_disabled if {
	count(missing_rhel_10_701050) == 0
	_str(["kernel_params", "kernel.kexec_load_disabled"]) == "1"
}

status_rhel_10_701050 := "Not_a_Finding" if kexec_disabled

else := "Open"

detail_rhel_10_701050 := "RHEL-10-701050: Not_a_Finding" if kexec_disabled

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-701050", concat(", ", missing_rhel_10_701050)]) if count(missing_rhel_10_701050) > 0

else := "RHEL-10-701050: check failed — kernel.kexec_load_disabled must be 1"

finding_rhel_10_701050 := {
	"vuln_id": "V-281307",
	"stig_id": "RHEL-10-701050",
	"severity": "CAT I",
	"rule_title": "RHEL 10 must prevent the loading of a new kernel for later execution.",
	"check_type": "machine",
	"status": status_rhel_10_701050,
	"detail": detail_rhel_10_701050,
	"fix_text": "Set kernel.kexec_load_disabled = 1 in /etc/sysctl.d/ and run sysctl --system",
}

# =============================================================================
# CAT II - MEDIUM SEVERITY
# =============================================================================

# RHEL-10-200641 | V-280984 | CAT II
# systemctl is-active rsyslog
missing_rhel_10_200641 := [concat(".", p) | some p in [["services", "rsyslog"]]; not _collected(p)]

default rsyslog_active := false

rsyslog_active if {
	count(missing_rhel_10_200641) == 0
	_kw(["services", "rsyslog"]) == "active"
}

status_rhel_10_200641 := "Not_a_Finding" if rsyslog_active

else := "Open"

detail_rhel_10_200641 := "RHEL-10-200641: Not_a_Finding" if rsyslog_active

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-200641", concat(", ", missing_rhel_10_200641)]) if count(missing_rhel_10_200641) > 0

else := "RHEL-10-200641: check failed — rsyslog must be active (systemctl is-active rsyslog)"

finding_rhel_10_200641 := {
	"vuln_id": "V-280984",
	"stig_id": "RHEL-10-200641",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must have the rsyslog service set to active.",
	"check_type": "machine",
	"status": status_rhel_10_200641,
	"detail": detail_rhel_10_200641,
	"fix_text": "Enable rsyslog: systemctl enable --now rsyslog",
}

# RHEL-10-200640 | V-280983 | CAT II
# rsyslog package installed
missing_rhel_10_200640 := [concat(".", p) | some p in [["packages", "rsyslog"]]; not _collected(p)]

default rsyslog_installed := false

rsyslog_installed if {
	count(missing_rhel_10_200640) == 0
	input.packages.rsyslog == true
}

status_rhel_10_200640 := "Not_a_Finding" if rsyslog_installed

else := "Open"

detail_rhel_10_200640 := "RHEL-10-200640: Not_a_Finding" if rsyslog_installed

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-200640", concat(", ", missing_rhel_10_200640)]) if count(missing_rhel_10_200640) > 0

else := "RHEL-10-200640: check failed — the rsyslog package must be installed"

finding_rhel_10_200640 := {
	"vuln_id": "V-280983",
	"stig_id": "RHEL-10-200640",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must have the \"rsyslog\" package installed.",
	"check_type": "machine",
	"status": status_rhel_10_200640,
	"detail": detail_rhel_10_200640,
	"fix_text": "Install rsyslog: dnf install rsyslog",
}

# RHEL-10-001020 | V-280931 | CAT II
# input.rpm_gpg_pubkeys (rpm -q gpg-pubkey summaries); input.redhat_release_key_file.fingerprints (sq inspect)
missing_rhel_10_001020 := [concat(".", p) | some p in [["rpm_gpg_pubkeys"], ["redhat_release_key_file", "fingerprints"]]; not _collected(p)]

default gpgcheck_global := false

gpgcheck_global if {
	count(missing_rhel_10_001020) == 0
	_rh_key_installed("(release key 2)")
	_rh_key_installed("(auxiliary key 3)")
	_rh_key_installed("(release key 4)")
	fps := input.redhat_release_key_file.fingerprints
	is_array(fps)
	installed := {f | some x in fps; f := _fpr(x)}
	every k in rhel10_key_fingerprints {
		k in installed
	}
}

status_rhel_10_001020 := "Not_a_Finding" if gpgcheck_global

else := "Open"

detail_rhel_10_001020 := "RHEL-10-001020: Not_a_Finding" if gpgcheck_global

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-001020", concat(", ", missing_rhel_10_001020)]) if count(missing_rhel_10_001020) > 0

else := "RHEL-10-001020: check failed — Red Hat GPG keys release key 2, auxiliary key 3 and release key 4 must be installed and /etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release must carry fingerprints 567E347AD0044ADE55BA8A5F199E2F91FD431D51, 7E4624258C406535D56D6F135054E4A45A6340B3, FCD355B305707A62DA143AB6E422397E50FE8467A2A95343D246D6276AFEDF8F"

finding_rhel_10_001020 := {
	"vuln_id": "V-280931",
	"stig_id": "RHEL-10-001020",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must ensure cryptographic verification of vendor software packages.",
	"check_type": "machine",
	"status": status_rhel_10_001020,
	"detail": detail_rhel_10_001020,
	"fix_text": "Install the Red Hat keys: rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release (from a verified redhat-release package)",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

cat_i_findings := [
	finding_rhel_10_001050,
	finding_rhel_10_001040,
	finding_rhel_10_701050,
]

cat_ii_findings := [
	finding_rhel_10_200641,
	finding_rhel_10_200640,
	finding_rhel_10_001020,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III), as in the RHEL 8/9 modules.
# `cat_i_compliant`: the CAT-I-only meaning, for gating on the critical subset.
open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

default cat_i_compliant := false

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "software_integrity",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
