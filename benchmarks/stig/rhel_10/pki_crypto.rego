# METADATA
# title: "DISA STIG for RHEL 10 - PKI and Cryptography Module"
# custom:
#   class: security
#   framework: stig_rhel_10
#   source: disa
#   domains: [linux, rhel]
#   coverage:
#     checks: 6
#     cited: 5
#     density: section
#     basis: role
#     tested: true
#     entrypoint: compliance_report
#     guard: self
#     as_of: v2.5.0
package stig.rhel_10.pki_crypto

# DISA STIG for RHEL 10 - PKI and Cryptography Module
# STIG Version: V1R3 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in rhel10_rules.py (regenerate, don't hand-edit).
# Covers: FIPS 140-3, PKI/CAC authentication, certificate management, crypto policies

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a whole number, or a string holding a decimal integer; undefined otherwise
# (a fraction such as 3.5 is not a value these settings can hold)
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# a crypto back-end in /etc/crypto-policies/back-ends/: nss.config is a regular file; every other one is a
# symlink to its own file under /usr/share/crypto-policies/FIPS/ (bind.config -> FIPS/bind.txt)
_backend_ok(b) if {
	b.name == "nss.config"
	b.is_symlink == false
}

_backend_ok(b) if {
	is_string(b.name)
	b.name != "nss.config"
	b.is_symlink == true
	base := trim_suffix(b.name, ".config")
	b.target == concat("", ["/usr/share/crypto-policies/FIPS/", base, ".txt"])
}

# the comma-separated option list at path, each entry trimmed; undefined unless a string
_csv(path) := [trim_space(x) | some x in parts] if {
	s := _str(path)
	parts := split(s, ",")
}

# a DoD root CA from /etc/sssd/pki/sssd_auth_ca_db.pem, as the RHEL-10-701270 check shows it: self-signed
# (Subject == Issuer), Issuer C = US, O = U.S. Government, OU = DoD (the check text prints DoW), OU = PKI,
# CN = DoD Root CA <n>, compared component by component; inside its validity dates.
# input.sssd_ca_db.certificates: [{issuer_rdns, subject_rdns, not_before, not_after}], RDNs as [type, value]
# pairs in certificate order, dates RFC 3339.
_dod_root_valid(c) if {
	rdns := c.issuer_rdns
	is_array(rdns)
	count(rdns) == 5
	rdns[0] == ["C", "US"]
	rdns[1] == ["O", "U.S. Government"]
	rdns[2] in {["OU", "DoD"], ["OU", "DoW"]}
	rdns[3] == ["OU", "PKI"]
	rdns[4][0] == "CN"
	is_string(rdns[4][1])
	regex.match(`^DoD Root CA [0-9]+$`, rdns[4][1])
	c.subject_rdns == rdns
	nb := time.parse_rfc3339_ns(c.not_before)
	na := time.parse_rfc3339_ns(c.not_after)
	now := time.now_ns()
	nb <= now
	now < na
}

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# RHEL-10-300090 | V-281016 | CAT I
# update-crypto-policies --check output and the back-end symlinks (input.crypto_backends[{name, is_symlink, target}])
missing_rhel_10_300090 := [concat(".", p) | some p in [["crypto_policy_check", "output"], ["crypto_backends"]]; not _collected(p)]

default crypto_policy_not_overridden := false

crypto_policy_not_overridden if {
	count(missing_rhel_10_300090) == 0
	out := _str(["crypto_policy_check", "output"])
	contains(out, "The configured policy matches the generated policy")
	not contains(out, "does NOT match")
	backends := input.crypto_backends
	is_array(backends)
	count(backends) > 0
	count([b | some b in backends; not _backend_ok(b)]) == 0
}

status_rhel_10_300090 := "Not_a_Finding" if crypto_policy_not_overridden

else := "Open"

detail_rhel_10_300090 := "RHEL-10-300090: Not_a_Finding" if crypto_policy_not_overridden

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-300090", concat(", ", missing_rhel_10_300090)]) if count(missing_rhel_10_300090) > 0

else := "RHEL-10-300090: check failed — update-crypto-policies --check must report the configured policy matches the generated policy, and every back-end in /etc/crypto-policies/back-ends/ except nss.config must link to its file under /usr/share/crypto-policies/FIPS/"

finding_rhel_10_300090 := {
	"vuln_id": "V-281016",
	"stig_id": "RHEL-10-300090",
	"severity": "CAT I",
	"rule_title": "RHEL 10 cryptographic policy must not be overridden.",
	"check_type": "machine",
	"status": status_rhel_10_300090,
	"detail": detail_rhel_10_300090,
	"fix_text": "Remove overrides and regenerate: update-crypto-policies --set FIPS",
}

# RHEL-10-300085 | V-288827 | CAT I
# the lines of /etc/pki/tls/openssl.cnf must include the crypto-policy opensslcnf.config back-end
missing_rhel_10_300085 := [concat(".", p) | some p in [["openssl_cnf", "lines"]]; not _collected(p)]

default openssl_system_policy := false

openssl_system_policy if {
	count(missing_rhel_10_300085) == 0
	lines := input.openssl_cnf.lines
	is_array(lines)
	some l in lines
	regex.match(`^\s*\.include\s*=?\s*/etc/crypto-policies/back-ends/opensslcnf\.config\s*$`, l)
}

status_rhel_10_300085 := "Not_a_Finding" if openssl_system_policy

else := "Open"

detail_rhel_10_300085 := "RHEL-10-300085: Not_a_Finding" if openssl_system_policy

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-300085", concat(", ", missing_rhel_10_300085)]) if count(missing_rhel_10_300085) > 0

else := "RHEL-10-300085: check failed — /etc/pki/tls/openssl.cnf must include /etc/crypto-policies/back-ends/opensslcnf.config (uncommented)"

finding_rhel_10_300085 := {
	"vuln_id": "V-288827",
	"stig_id": "RHEL-10-300085",
	"severity": "CAT I",
	"rule_title": "RHEL 10 must implement DoW-approved encryption in the OpenSSL package.",
	"check_type": "machine",
	"status": status_rhel_10_300085,
	"detail": detail_rhel_10_300085,
	"fix_text": "Add .include = /etc/crypto-policies/back-ends/opensslcnf.config to /etc/pki/tls/openssl.cnf",
}

# =============================================================================
# CAT II - MEDIUM SEVERITY
# =============================================================================

# RHEL-10-701270 | V-281329 | CAT II
# certificates in /etc/sssd/pki/sssd_auth_ca_db.pem: issuer / subject RDNs and validity dates
missing_rhel_10_701270 := [concat(".", p) | some p in [["sssd_ca_db", "certificates"]]; not _collected(p)]

default dod_ca_trusted := false

dod_ca_trusted if {
	count(missing_rhel_10_701270) == 0
	certs := input.sssd_ca_db.certificates
	is_array(certs)
	some c in certs
	_dod_root_valid(c)
}

default na_rhel_10_701270 := false

na_rhel_10_701270 if {
	_attested("rhel_10_701270_alternate_mfa")
}

status_rhel_10_701270 := "Not_a_Finding" if dod_ca_trusted

else := "Not_Applicable" if na_rhel_10_701270

else := "Open"

detail_rhel_10_701270 := "RHEL-10-701270: Not_a_Finding" if dod_ca_trusted

else := "RHEL-10-701270: Not_Applicable — the SA demonstrated an approved alternate multifactor authentication method" if na_rhel_10_701270

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-701270", concat(", ", missing_rhel_10_701270)]) if count(missing_rhel_10_701270) > 0

else := "RHEL-10-701270: check failed — /etc/sssd/pki/sssd_auth_ca_db.pem must hold a self-signed DoD root CA (Issuer = Subject = C=US, O=U.S. Government, OU=DoD, OU=PKI, CN=DoD Root CA <n>) within its validity dates"

finding_rhel_10_701270 := {
	"vuln_id": "V-281329",
	"stig_id": "RHEL-10-701270",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must, for PKI-based authentication, validate certificates by constructing a certification path (which includes status information) to an accepted trust anchor.",
	"check_type": "machine",
	"status": status_rhel_10_701270,
	"detail": detail_rhel_10_701270,
	"fix_text": "Install the DoD root CA bundle as /etc/sssd/pki/sssd_auth_ca_db.pem",
}

# RHEL-10-701230 | V-281325 | CAT II
# certificate_verification from the [sssd] section of sssd.conf / conf.d (uncommented)
missing_rhel_10_701230 := [concat(".", p) | some p in [["sssd", "certificate_verification"]]; not _collected(p)]

default cert_revocation_check := false

cert_revocation_check if {
	count(missing_rhel_10_701230) == 0
	opts := {o | some o in _csv(["sssd", "certificate_verification"])}
	"ocsp_dgst=sha512" in opts
	not "no_ocsp" in opts
	not "no_verification" in opts
}

cert_revocation_check if {
	_attested("rhel_10_701230_status_checking")
}

default na_rhel_10_701230 := false

na_rhel_10_701230 if {
	_attested("rhel_10_701230_alternate_mfa")
}

status_rhel_10_701230 := "Not_a_Finding" if cert_revocation_check

else := "Not_Applicable" if na_rhel_10_701230

else := "Open"

detail_rhel_10_701230 := "RHEL-10-701230: Not_a_Finding" if cert_revocation_check

else := "RHEL-10-701230: Not_Applicable — the SA demonstrated an approved alternate multifactor authentication method" if na_rhel_10_701230

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-701230", concat(", ", missing_rhel_10_701230)]) if count(missing_rhel_10_701230) > 0

else := "RHEL-10-701230: check failed — certificate_verification in the [sssd] section must carry the option ocsp_dgst=sha512 and neither no_ocsp nor no_verification, or the SA must show how certificate status checking is implemented (input.attest.rhel_10_701230_status_checking)"

finding_rhel_10_701230 := {
	"vuln_id": "V-281325",
	"stig_id": "RHEL-10-701230",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must implement certificate status checking for multifactor authentication.",
	"check_type": "machine+attestation",
	"status": status_rhel_10_701230,
	"detail": detail_rhel_10_701230,
	"fix_text": "Set certificate_verification = ocsp_dgst=sha512 in the [sssd] section of /etc/sssd/sssd.conf",
}

# RHEL-10-701280 | V-281330 | CAT II
# [certmap/...] sections of sssd.conf and conf.d: [{section, matchrule, maprule, domains}]
missing_rhel_10_701280 := [concat(".", p) | some p in [["sssd", "certmap_rules"]]; not _collected(p)]

default cert_user_mapping := false

cert_user_mapping if {
	count(missing_rhel_10_701280) == 0
	rules := input.sssd.certmap_rules
	is_array(rules)
	some r in rules
	is_string(r.maprule)
	trim_space(r.maprule) != ""
}

cert_user_mapping if {
	_attested("rhel_10_701280_certificate_mapping")
}

default na_rhel_10_701280 := false

na_rhel_10_701280 if {
	_attested("rhel_10_701280_alternate_mfa")
}

status_rhel_10_701280 := "Not_a_Finding" if cert_user_mapping

else := "Not_Applicable" if na_rhel_10_701280

else := "Open"

detail_rhel_10_701280 := "RHEL-10-701280: Not_a_Finding" if cert_user_mapping

else := "RHEL-10-701280: Not_Applicable — the SA demonstrated an approved alternate multifactor authentication method" if na_rhel_10_701280

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-701280", concat(", ", missing_rhel_10_701280)]) if count(missing_rhel_10_701280) > 0

else := "RHEL-10-701280: check failed — sssd.conf / conf.d must have a [certmap/...] section mapping certificates to accounts, or the SA must show how certificates are mapped (input.attest.rhel_10_701280_certificate_mapping)"

finding_rhel_10_701280 := {
	"vuln_id": "V-281330",
	"stig_id": "RHEL-10-701280",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must map the authenticated identity to the user or group account for public key infrastructure (PKI)-based authentication.",
	"check_type": "machine+attestation",
	"status": status_rhel_10_701280,
	"detail": detail_rhel_10_701280,
	"fix_text": "Add a [certmap/<domain>/<rule>] section with matchrule and maprule to /etc/sssd/sssd.conf",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

cat_i_findings := [
	finding_rhel_10_300090,
	finding_rhel_10_300085,
]

cat_ii_findings := [
	finding_rhel_10_701270,
	finding_rhel_10_701230,
	finding_rhel_10_701280,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III), as in the RHEL 8/9 modules.
# `cat_i_compliant`: the CAT-I-only meaning, for gating on the critical subset.
open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

default cat_i_compliant := false

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "pki_crypto",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
