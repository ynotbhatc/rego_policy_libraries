# configured wireless devices (nmcli device status, TYPE wifi); no physical radio is Not Applicable
missing_rhel_10_700870 := [concat(".", p) | some p in [["wireless_interfaces"]]; not _collected(p)]

default wireless_disabled := false

wireless_disabled if {
	count(missing_rhel_10_700870) == 0
	ifs := input.wireless_interfaces
	is_array(ifs)
	count(ifs) == 0
}

wireless_disabled if {
	_attested("rhel_10_700870_wireless_approved")
}

default na_rhel_10_700870 := false

na_rhel_10_700870 if {
	input.wireless_radios_present == false
}

status_rhel_10_700870 := "Not_a_Finding" if wireless_disabled

else := "Not_Applicable" if na_rhel_10_700870

else := "Open"

detail_rhel_10_700870 := "RHEL-10-700870: Not_a_Finding" if wireless_disabled

else := "RHEL-10-700870: Not_Applicable — the system has no physical wireless network radios" if na_rhel_10_700870

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-700870", concat(", ", missing_rhel_10_700870)]) if count(missing_rhel_10_700870) > 0

else := "RHEL-10-700870: check failed — no wireless interface may be configured unless documented and approved by the ISSO (input.attest.rhel_10_700870_wireless_approved)"

