test_every_rule_not_a_finding_on_green_fixture if {
	r := data.stig.rhel_10.stig_assessment with input as green_fixture
	r.summary.total_findings == 100
	r.summary.not_a_finding == 99
	r.summary.not_applicable == 1
}

test_main_compliant_on_green_fixture if {
	r := data.stig.rhel_10.main.compliance_report with input as green_fixture
	r.compliant == true
	r.violation_count == 0
}
