	},
	"sssd": {"pam_cert_auth": "True"},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_10.account_auth.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.rhel_10.account_auth.compliant with input as green_fixture
}

test_rhel_10_600100_pass if {
	data.stig.rhel_10.account_auth.status_rhel_10_600100 == "Not_a_Finding" with input as green_fixture
}

test_rhel_10_600100_fail_1 if {
	f := data.stig.rhel_10.account_auth.finding_rhel_10_600100 with input as object.union(green_fixture, {"password_policy": {"maxdays": 181}})
	f.status == "Open"
	contains(f.detail, "RHEL-10-600100: check failed")
}

