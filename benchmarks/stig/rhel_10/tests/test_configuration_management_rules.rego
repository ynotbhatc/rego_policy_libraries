	f := data.stig.rhel_10.configuration_management.finding_rhel_10_200632 with input as json.remove(green_fixture, [["aide", "rule_lines"]])
	f.status == "Open"
	contains(f.detail, "RHEL-10-200632: evidence missing — aide.rule_lines")
}

test_rhel_10_200632_pass_2 if {
	data.stig.rhel_10.configuration_management.status_rhel_10_200632 == "Not_a_Finding" with input as object.union(green_fixture, {"aide": {"rule_lines": []}, "attest": {"rhel_10_200632_other_tool": true}})
}
