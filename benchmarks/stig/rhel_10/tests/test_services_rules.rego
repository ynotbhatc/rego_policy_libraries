package stig.rhel_10.services_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"packages": {
		"nfs-utils": false,
		"telnet-server": false,
		"tftp-server": false,
		"vsftpd": false,
	},
	"unit_enabled": {
		"autofs": "masked",
	},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_10.services.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.rhel_10.services.compliant with input as green_fixture
}

test_rhel_10_200090_pass if {
	data.stig.rhel_10.services.status_rhel_10_200090 == "Not_a_Finding" with input as green_fixture
}

test_rhel_10_200090_fail_1 if {
	f := data.stig.rhel_10.services.finding_rhel_10_200090 with input as object.union(green_fixture, {"packages": {"vsftpd": true}})
	f.status == "Open"
	contains(f.detail, "RHEL-10-200090: check failed")
}

test_rhel_10_200090_evidence_missing_1 if {
	f := data.stig.rhel_10.services.finding_rhel_10_200090 with input as json.remove(green_fixture, [["packages", "vsftpd"]])
	f.status == "Open"
	contains(f.detail, "RHEL-10-200090: evidence missing — packages.vsftpd")
}

