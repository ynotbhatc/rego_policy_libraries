package stig.rhel_10.software_integrity_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"dnf_config": {"localpkg_gpgcheck": "1"},
	"kernel_params": {"kernel.kexec_load_disabled": "1"},
	"packages": {"rsyslog": true},
	"redhat_release_key_file": {"fingerprints": [
		"567E347AD0044ADE55BA8A5F199E2F91FD431D51",
		"7E4624258C406535D56D6F135054E4A45A6340B3",
		"FCD355B305707A62DA143AB6E422397E50FE8467A2A95343D246D6276AFEDF8F",
	]},
	"rpm_gpg_pubkeys": [
		"Red Hat, Inc. (release key 2) <security@redhat.com> public key",
		"Red Hat, Inc. (auxiliary key 3) <security@redhat.com> public key",
		"Red Hat, Inc. (release key 4) <security@redhat.com> public key",
	],
	"services": {"rsyslog": "active"},
	"yum_repos": [{
		"file": "/etc/yum.repos.d/redhat.repo",
		"gpgcheck": "1",
		"name": "rhel-9-for-x86_64-baseos-rpms",
	}],
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_10.software_integrity.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.rhel_10.software_integrity.compliant with input as green_fixture
}

test_rhel_10_001050_pass if {
	data.stig.rhel_10.software_integrity.status_rhel_10_001050 == "Not_a_Finding" with input as green_fixture
}

test_rhel_10_001050_fail_1 if {
	f := data.stig.rhel_10.software_integrity.finding_rhel_10_001050 with input as object.union(green_fixture, {"yum_repos": [{"file": "/etc/yum.repos.d/redhat.repo", "name": "rhel-9-for-x86_64-baseos-rpms", "gpgcheck": "0"}]})
	f.status == "Open"
	contains(f.detail, "RHEL-10-001050: check failed")
}

test_rhel_10_001050_fail_2 if {
	f := data.stig.rhel_10.software_integrity.finding_rhel_10_001050 with input as object.union(green_fixture, {"yum_repos": [{"file": "/etc/yum.repos.d/local.repo", "name": "local"}]})
	f.status == "Open"
	contains(f.detail, "RHEL-10-001050: check failed")
}

test_rhel_10_001050_fail_3 if {
	f := data.stig.rhel_10.software_integrity.finding_rhel_10_001050 with input as object.union(green_fixture, {"yum_repos": []})
	f.status == "Open"
	contains(f.detail, "RHEL-10-001050: check failed")
}

test_rhel_10_001050_evidence_missing_1 if {
	f := data.stig.rhel_10.software_integrity.finding_rhel_10_001050 with input as json.remove(green_fixture, [["yum_repos"]])
	f.status == "Open"
	contains(f.detail, "RHEL-10-001050: evidence missing — yum_repos")
}

test_rhel_10_001050_pass_2 if {
	data.stig.rhel_10.software_integrity.status_rhel_10_001050 == "Not_a_Finding" with input as object.union(green_fixture, {"yum_repos": [{"name": "a", "gpgcheck": "Yes"}, {"name": "b", "gpgcheck": "TRUE"}]})
}

test_rhel_10_001050_pass_3 if {
	data.stig.rhel_10.software_integrity.status_rhel_10_001050 == "Not_a_Finding" with input as object.union(green_fixture, {"yum_repos": [{"name": "a", "gpgcheck": "0"}], "attest": {"rhel_10_001050_gpg_process": true}})
}

