test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_10.audit_logging.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.rhel_10.audit_logging.compliant with input as green_fixture
}

test_rhel_10_500205_pass if {
	data.stig.rhel_10.audit_logging.status_rhel_10_500205 == "Not_a_Finding" with input as green_fixture
}

test_rhel_10_500205_fail_1 if {
	f := data.stig.rhel_10.audit_logging.finding_rhel_10_500205 with input as object.union(green_fixture, {"auditd_config": {"space_left_action": "ignore"}})
	f.status == "Open"
	contains(f.detail, "RHEL-10-500205: check failed")
}

test_rhel_10_500205_fail_2 if {
	f := data.stig.rhel_10.audit_logging.finding_rhel_10_500205 with input as object.union(green_fixture, {"auditd_config": {"space_left_action": "syslog"}})
