	f := data.stig.rhel_10.pki_crypto.finding_rhel_10_300090 with input as object.union(green_fixture, {"crypto_backends": [{"name": "openssh.config", "is_symlink": true, "target": "/usr/share/crypto-policies/DEFAULT/openssh.txt"}]})
	f.status == "Open"
	contains(f.detail, "RHEL-10-300090: check failed")
}

