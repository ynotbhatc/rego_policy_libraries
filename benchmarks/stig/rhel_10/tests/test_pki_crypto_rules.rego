package stig.rhel_10.pki_crypto_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"crypto_backends": [
		{
			"is_symlink": true,
			"name": "openssh.config",
			"target": "/usr/share/crypto-policies/FIPS/openssh.txt",
		},
		{
			"is_symlink": true,
			"name": "opensslcnf.config",
			"target": "/usr/share/crypto-policies/FIPS/opensslcnf.txt",
		},
		{
			"is_symlink": false,
			"name": "nss.config",
			"target": null,
		},
	],
	"crypto_policy_check": {"output": "The configured policy matches the generated policy"},
	"openssl_cnf": {"lines": [
		"[ crypto_policy ]",
		".include = /etc/crypto-policies/back-ends/opensslcnf.config",
	]},
	"sssd": {
		"certificate_verification": "ocsp_dgst=sha512",
		"certmap_rules": [{
			"domains": "testing.test",
			"maprule": "(userCertificate;binary={cert!bin})",
			"matchrule": "<SAN>.*EDIPI@mil",
			"section": "certmap/testing.test/rule_name",
		}],
	},
	"sssd_ca_db": {"certificates": [{
		"issuer_rdns": [
			[
				"C",
				"US",
			],
			[
				"O",
				"U.S. Government",
			],
			[
				"OU",
				"DoD",
			],
			[
				"OU",
				"PKI",
			],
			[
				"CN",
				"DoD Root CA 3",
			],
		],
		"not_after": "2099-12-30T18:46:41Z",
		"not_before": "2012-03-20T18:46:41Z",
		"subject_rdns": [
			[
				"C",
				"US",
			],
			[
				"O",
				"U.S. Government",
			],
			[
				"OU",
				"DoD",
			],
			[
				"OU",
				"PKI",
			],
			[
				"CN",
				"DoD Root CA 3",
			],
		],
	}]},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_10.pki_crypto.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.rhel_10.pki_crypto.compliant with input as green_fixture
}

test_rhel_10_300090_pass if {
	data.stig.rhel_10.pki_crypto.status_rhel_10_300090 == "Not_a_Finding" with input as green_fixture
}

test_rhel_10_300090_fail_1 if {
	f := data.stig.rhel_10.pki_crypto.finding_rhel_10_300090 with input as object.union(green_fixture, {"crypto_policy_check": {"output": "The configured policy does NOT match the generated policy"}})
	f.status == "Open"
	contains(f.detail, "RHEL-10-300090: check failed")
}

