package stig.rhel_10.file_permissions_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {"file_permissions": {
	"etc_group": {"mode": "0644"},
	"etc_gshadow": {"mode": "0000"},
	"etc_passwd": {"mode": "0644"},
	"etc_shadow": {"mode": "0000"},
	"interactive_home_dirs": [{
		"mode": "700",
		"path": "/home/disauser",
	}],
	"library_dir_files_group_or_world_writable": [],
	"library_dir_files_not_owned_by_root": [],
	"system_commands_group_or_world_writable": [],
	"ungrouped_files": [],
	"unowned_files": [],
}}

test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_10.file_permissions.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.rhel_10.file_permissions.compliant with input as green_fixture
}

test_rhel_10_400265_pass if {
	data.stig.rhel_10.file_permissions.status_rhel_10_400265 == "Not_a_Finding" with input as green_fixture
}

test_rhel_10_400265_fail_1 if {
	f := data.stig.rhel_10.file_permissions.finding_rhel_10_400265 with input as object.union(green_fixture, {"file_permissions": {"etc_passwd": {"mode": "0664"}}})
	f.status == "Open"
	contains(f.detail, "RHEL-10-400265: check failed")
}

test_rhel_10_400265_fail_2 if {
	f := data.stig.rhel_10.file_permissions.finding_rhel_10_400265 with input as object.union(green_fixture, {"file_permissions": {"etc_passwd": {"mode": "rw-r--r--"}}})
	f.status == "Open"
	contains(f.detail, "RHEL-10-400265: check failed")
}

test_rhel_10_400265_evidence_missing_1 if {
	f := data.stig.rhel_10.file_permissions.finding_rhel_10_400265 with input as json.remove(green_fixture, [["file_permissions", "etc_passwd", "mode"]])
	f.status == "Open"
	contains(f.detail, "RHEL-10-400265: evidence missing — file_permissions.etc_passwd.mode")
}

