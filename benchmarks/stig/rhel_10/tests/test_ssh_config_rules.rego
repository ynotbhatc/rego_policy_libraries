		"printlastlog": "yes",
		"strictmodes": "yes",
		"x11forwarding": "no",
	},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.rhel_10.ssh_config.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.rhel_10.ssh_config.compliant with input as green_fixture
}

test_rhel_10_600640_pass if {
	data.stig.rhel_10.ssh_config.status_rhel_10_600640 == "Not_a_Finding" with input as green_fixture
}

test_rhel_10_600640_fail_1 if {
	f := data.stig.rhel_10.ssh_config.finding_rhel_10_600640 with input as object.union(green_fixture, {"ssh_config": {"UsePAM": "no"}})
	f.status == "Open"
	contains(f.detail, "RHEL-10-600640: check failed")
}

test_rhel_10_600640_evidence_missing_1 if {
	f := data.stig.rhel_10.ssh_config.finding_rhel_10_600640 with input as json.remove(green_fixture, [["ssh_config", "UsePAM"]])
	f.status == "Open"
	contains(f.detail, "RHEL-10-600640: evidence missing — ssh_config.UsePAM")
}

