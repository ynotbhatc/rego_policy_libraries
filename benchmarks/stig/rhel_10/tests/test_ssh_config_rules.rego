		"PrintLastLog": [{
			"file": "/etc/ssh/sshd_config.d/10-stig.conf",
			"value": "yes",
		}],
		"StrictModes": [{
			"file": "/etc/ssh/sshd_config.d/10-stig.conf",
			"value": "yes",
		}],
		"X11Forwarding": [{
			"file": "/etc/ssh/sshd_config.d/10-stig.conf",
			"value": "no",
		}],
	},
	"sshd_runtime": {
		"clientalivecountmax": "1",
