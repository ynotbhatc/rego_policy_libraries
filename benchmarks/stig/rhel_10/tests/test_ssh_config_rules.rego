			"value": "yes",
		}],
		"IgnoreUserKnownHosts": [{
			"file": "/etc/ssh/sshd_config.d/10-stig.conf",
			"value": "yes",
		}],
		"PermitEmptyPasswords": [{
			"file": "/etc/ssh/sshd_config.d/10-stig.conf",
			"value": "no",
		}],
		"PermitRootLogin": [{
			"file": "/etc/ssh/sshd_config.d/10-stig.conf",
			"value": "no",
