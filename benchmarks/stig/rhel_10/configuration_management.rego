# RHEL-10-701130 | V-281315 | CAT II
# runtime value (sysctl) and every value configured in the sysctl.d / sysctl.conf files the check greps
missing_rhel_10_701130 := [concat(".", p) | some p in [["kernel_params", "kernel.randomize_va_space"], ["sysctl_config", "kernel.randomize_va_space"]]; not _collected(p)]

default aslr_enabled := false

aslr_enabled if {
	count(missing_rhel_10_701130) == 0
	_str(["kernel_params", "kernel.randomize_va_space"]) == "2"
	vals := input.sysctl_config["kernel.randomize_va_space"]
	is_array(vals)
	count(vals) > 0
	every v in vals {
		sprintf("%v", [v]) == "2"
	}
}

status_rhel_10_701130 := "Not_a_Finding" if aslr_enabled

else := "Open"

detail_rhel_10_701130 := "RHEL-10-701130: Not_a_Finding" if aslr_enabled

