else := "RHEL-10-701130: check failed — kernel.randomize_va_space must be 2 at runtime and in every sysctl configuration file that sets it (none conflicting)"

finding_rhel_10_701130 := {
	"vuln_id": "V-281315",
	"stig_id": "RHEL-10-701130",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must implement address space layout randomization (ASLR) to protect its memory from unauthorized code execution.",
	"check_type": "machine",
	"status": status_rhel_10_701130,
	"detail": detail_rhel_10_701130,
	"fix_text": "Set kernel.randomize_va_space = 2 in /etc/sysctl.d/99-kernel_randomize_va_space.conf and run sysctl --system",
}

