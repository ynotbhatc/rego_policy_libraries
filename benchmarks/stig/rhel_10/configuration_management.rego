# the audit data path is the directory of auditd.conf log_file; it must be its own mount
missing_rhel_10_000520 := [concat(".", p) | some p in [["filesystem_mounts"], ["auditd_config", "log_file"]]; not _collected(p)]

default var_log_audit_separate := false

var_log_audit_separate if {
	count(missing_rhel_10_000520) == 0
	f := _str(["auditd_config", "log_file"])
	dir := regex.replace(f, `/[^/]*$`, "")
	_mount(dir)
}

status_rhel_10_000520 := "Not_a_Finding" if var_log_audit_separate

else := "Open"

detail_rhel_10_000520 := "RHEL-10-000520: Not_a_Finding" if var_log_audit_separate

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-000520", concat(", ", missing_rhel_10_000520)]) if count(missing_rhel_10_000520) > 0

else := "RHEL-10-000520: check failed — the directory of auditd log_file (the audit data path) must be a separate mounted file system"

finding_rhel_10_000520 := {
	"vuln_id": "V-280936",
	"stig_id": "RHEL-10-000520",
	"severity": "CAT III",
	"rule_title": "RHEL 10 must use a separate file system for the system audit data path.",
	"check_type": "machine",
	"status": status_rhel_10_000520,
	"detail": detail_rhel_10_000520,
	"fix_text": "Create a separate file system for the audit data path (e.g. /var/log/audit) and mount it in /etc/fstab",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

cat_i_findings := [
	finding_rhel_10_700960,
	finding_rhel_10_000500,
	finding_rhel_10_300010,
]

cat_ii_findings := [
	finding_rhel_10_700040,
	finding_rhel_10_701030,
	finding_rhel_10_701040,
	finding_rhel_10_800030,
	finding_rhel_10_800050,
	finding_rhel_10_200633,
	finding_rhel_10_400355,
	finding_rhel_10_400360,
	finding_rhel_10_400365,
	finding_rhel_10_700400,
	finding_rhel_10_701130,
	finding_rhel_10_700850,
	finding_rhel_10_000560,
	finding_rhel_10_700420,
	finding_rhel_10_700830,
	finding_rhel_10_000540,
	finding_rhel_10_700010,
	finding_rhel_10_200630,
	finding_rhel_10_600000,
	finding_rhel_10_200632,
]

cat_iii_findings := [
	finding_rhel_10_000520,
]

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III), as in the RHEL 8/9 modules.
# `cat_i_compliant`: the CAT-I-only meaning, for gating on the critical subset.
open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

default cat_i_compliant := false

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "configuration_management",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
