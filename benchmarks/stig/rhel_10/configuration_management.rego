# RHEL-10-700960 | V-281299 | CAT I
# ctrl-alt-del.target load state (systemctl show -p LoadState) must be masked
missing_rhel_10_700960 := [concat(".", p) | some p in [["systemd_units", "ctrl-alt-del.target", "load_state"]]; not _collected(p)]

default ctrl_alt_del_disabled := false

ctrl_alt_del_disabled if {
	count(missing_rhel_10_700960) == 0
	_kw(["systemd_units", "ctrl-alt-del.target", "load_state"]) == "masked"
}

status_rhel_10_700960 := "Not_a_Finding" if ctrl_alt_del_disabled

else := "Open"

detail_rhel_10_700960 := "RHEL-10-700960: Not_a_Finding" if ctrl_alt_del_disabled

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-700960", concat(", ", missing_rhel_10_700960)]) if count(missing_rhel_10_700960) > 0

else := "RHEL-10-700960: check failed — ctrl-alt-del.target must be masked (systemctl status: Loaded: masked)"

finding_rhel_10_700960 := {
	"vuln_id": "V-281299",
	"stig_id": "RHEL-10-700960",
	"severity": "CAT I",
	"rule_title": "RHEL 10 must disable the x86 Ctrl-Alt-Delete key sequence.",
	"check_type": "machine",
	"status": status_rhel_10_700960,
	"detail": detail_rhel_10_700960,
	"fix_text": "Mask the target: systemctl disable --now ctrl-alt-del.target && systemctl mask ctrl-alt-del.target",
}

