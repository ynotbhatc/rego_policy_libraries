# RHEL-10-200632 | V-280979 | CAT II
# input.aide.rule_lines: uncommented /etc/aide.conf lines naming hashes (grep -iE 'sha|md5|rmd' /etc/aide.conf)
missing_rhel_10_200632 := [concat(".", p) | some p in [["aide", "rule_lines"]]; not _collected(p)]

default aide_sha512 := false

aide_sha512 if {
	count(missing_rhel_10_200632) == 0
	lines := input.aide.rule_lines
	is_array(lines)
	count(lines) > 0
	used := {h | some l in lines; is_string(l); hs := _aide_line_hashes(l); some h in hs}
	"sha512" in used
	used == {"sha512"}
}

aide_sha512 if {
	_attested("rhel_10_200632_other_tool")
}

status_rhel_10_200632 := "Not_a_Finding" if aide_sha512

else := "Open"

detail_rhel_10_200632 := "RHEL-10-200632: Not_a_Finding" if aide_sha512

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-200632", concat(", ", missing_rhel_10_200632)]) if count(missing_rhel_10_200632) > 0

else := "RHEL-10-200632: check failed — the uncommented hash lines of /etc/aide.conf must use sha512 and no other hash (no md5, sha1, whirlpool, tiger ...), or another FIPS-validated file integrity tool must be attested (input.attest.rhel_10_200632_other_tool)"

finding_rhel_10_200632 := {
	"vuln_id": "V-280979",
	"stig_id": "RHEL-10-200632",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must use a file integrity tool that is configured to use FIPS 140-3-approved cryptographic hashes for validating file contents and directories.",
	"check_type": "machine+attestation",
	"status": status_rhel_10_200632,
	"detail": detail_rhel_10_200632,
	"fix_text": "Use sha512 as the only hash in the /etc/aide.conf rule definitions",
}

