#   framework: stig_rhel_10
#   source: disa
#   domains: [linux, rhel]
#   coverage:
#     checks: 14
#     cited: 13
#     density: sized
#     basis: size
#     tested: true
#     entrypoint: compliance_report
#     guard: self
#     as_of: v2.4.2
package stig.rhel_10.ssh_config

# DISA STIG for RHEL 10 - SSH Configuration Module
# STIG Version: V1R3 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in rhel10_rules.py (regenerate, don't hand-edit).
# Covers: SSH daemon hardening, key exchange, MACs, ciphers

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a number, or a string holding a decimal integer; undefined otherwise
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# DISA's lists for the opensshserver crypto-policy back-end (RHEL-10-300040)
fips_ssh_ciphers := {"aes256-gcm@openssh.com", "aes256-ctr", "aes128-gcm@openssh.com", "aes128-ctr"}

# the comma-separated list at path, each entry trimmed; undefined unless a string
_csv(path) := [trim_space(x) | some x in parts] if {
	s := _str(path)
	parts := split(s, ",")
}

# input.sshd_config_files[<Keyword>]: [{file, value}] for every uncommented <Keyword> line in the files sshd reads,
# in sshd's read order (sshd -dd ... | xargs grep -iH); sshd uses the first one. The first must come from a drop-in
# under /etc/ssh/sshd_config.d/ whose name sorts before 50-redhat.conf.
_r10_ssh_first(kw) := lower(trim_space(e.value)) if {
	es := input.sshd_config_files[kw]
	is_array(es)
	count(es) > 0
	e := es[0]
	is_string(e.file)
	is_string(e.value)
	startswith(e.file, "/etc/ssh/sshd_config.d/")
	name := substring(e.file, count("/etc/ssh/sshd_config.d/"), -1)
	not contains(name, "/")
	name < "50-redhat.conf"
}

# input.sshd_runtime[<keyword lower-case>]: the value sshd -T prints
_r10_ssh_runtime(kw) := lower(trim_space(v)) if {
	k := lower(kw)
	v := input.sshd_runtime[k]
	is_string(v)
}

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# RHEL-10-600640 | V-281216 | CAT I
# effective sshd UsePAM (case-insensitive) must be yes
missing_rhel_10_600640 := [concat(".", p) | some p in [["ssh_config", "UsePAM"]]; not _collected(p)]

default ssh_use_pam := false

ssh_use_pam if {
	count(missing_rhel_10_600640) == 0
	_kw(["ssh_config", "UsePAM"]) == "yes"
}

status_rhel_10_600640 := "Not_a_Finding" if ssh_use_pam

else := "Open"

detail_rhel_10_600640 := "RHEL-10-600640: Not_a_Finding" if ssh_use_pam

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-600640", concat(", ", missing_rhel_10_600640)]) if count(missing_rhel_10_600640) > 0

else := "RHEL-10-600640: check failed — sshd UsePAM must be yes"

finding_rhel_10_600640 := {
	"vuln_id": "V-281216",
	"stig_id": "RHEL-10-600640",
	"severity": "CAT I",
	"rule_title": "RHEL 10 must enable the Pluggable Authentication Module (PAM) interface for SSHD.",
	"check_type": "machine",
	"status": status_rhel_10_600640,
	"detail": detail_rhel_10_600640,
	"fix_text": "Set UsePAM yes in /etc/ssh/sshd_config (or a drop-in) and restart sshd",
}

# RHEL-10-300040 | V-281011 | CAT I
# Ciphers line of /etc/crypto-policies/back-ends/opensshserver.config (not sshd_config)
missing_rhel_10_300040 := [concat(".", p) | some p in [["opensshserver_config", "Ciphers"]]; not _collected(p)]

default ssh_fips_ciphers := false

ssh_fips_ciphers if {
	count(missing_rhel_10_300040) == 0
	vals := _csv(["opensshserver_config", "Ciphers"])
	count(vals) > 0
	every v in vals {
		v in fips_ssh_ciphers
	}
}

status_rhel_10_300040 := "Not_a_Finding" if ssh_fips_ciphers

else := "Open"

detail_rhel_10_300040 := "RHEL-10-300040: Not_a_Finding" if ssh_fips_ciphers

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-300040", concat(", ", missing_rhel_10_300040)]) if count(missing_rhel_10_300040) > 0

else := "RHEL-10-300040: check failed — Ciphers in /etc/crypto-policies/back-ends/opensshserver.config must list only aes256-gcm@openssh.com,aes256-ctr,aes128-gcm@openssh.com,aes128-ctr"

finding_rhel_10_300040 := {
	"vuln_id": "V-281011",
	"stig_id": "RHEL-10-300040",
	"severity": "CAT I",
	"rule_title": "RHEL 10 must be configured so that Secure Shell (SSH) servers use only DoW-approved encryption ciphers employing FIPS 140-3-validated cryptographic hash algorithms to protect the confidentiality of SSH server connections.",
	"check_type": "machine",
	"status": status_rhel_10_300040,
	"detail": detail_rhel_10_300040,
	"fix_text": "Apply the FIPS crypto policy (update-crypto-policies --set FIPS) so opensshserver.config carries the DISA list",
}

# RHEL-10-300060 | V-281013 | CAT I
# RHEL 10 makes a different order a finding; the example list is the expected value (its 'other than hmac-sha2-512 and hmac-sha2-256' wording names the families of the four example entries)
missing_rhel_10_300060 := [concat(".", p) | some p in [["opensshserver_config", "MACs"]]; not _collected(p)]

default ssh_fips_macs := false

ssh_fips_macs if {
	count(missing_rhel_10_300060) == 0
	vals := _csv(["opensshserver_config", "MACs"])
	vals == ["hmac-sha2-256-etm@openssh.com", "hmac-sha2-512-etm@openssh.com", "hmac-sha2-256", "hmac-sha2-512"]
}

status_rhel_10_300060 := "Not_a_Finding" if ssh_fips_macs

else := "Open"

detail_rhel_10_300060 := "RHEL-10-300060: Not_a_Finding" if ssh_fips_macs

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-300060", concat(", ", missing_rhel_10_300060)]) if count(missing_rhel_10_300060) > 0

else := "RHEL-10-300060: check failed — MACs in /etc/crypto-policies/back-ends/opensshserver.config must be exactly hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com,hmac-sha2-256,hmac-sha2-512 in that order"

finding_rhel_10_300060 := {
	"vuln_id": "V-281013",
	"stig_id": "RHEL-10-300060",
	"severity": "CAT I",
	"rule_title": "RHEL 10 must be configured so that Secure Shell (SSH) servers use only DoW-approved Message Authentication Codes (MACs) employing FIPS 140-3-validated cryptographic hash algorithms to protect the confidentiality of SSH server connections.",
	"check_type": "machine",
	"status": status_rhel_10_300060,
	"detail": detail_rhel_10_300060,
	"fix_text": "Set the FIPS crypto policy (update-crypto-policies --set FIPS) and reboot",
}

