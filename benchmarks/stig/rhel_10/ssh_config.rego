finding_rhel_10_700660 := {
	"vuln_id": "V-281269",
	"stig_id": "RHEL-10-700660",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must be configured so that all network connections associated with Secure Shell (SSH) traffic terminate after becoming unresponsive.",
	"check_type": "machine",
	"status": status_rhel_10_700660,
	"detail": detail_rhel_10_700660,
	"fix_text": "Set ClientAliveCountMax 1 in /etc/ssh/sshd_config.d/10-stig.conf (sorting before 50-redhat.conf) and restart sshd",
}

# RHEL-10-700930 | V-281296 | CAT II
# ClientAliveInterval: first value sshd reads must come from a drop-in before 50-redhat.conf; sshd -T must agree
missing_rhel_10_700930 := [concat(".", p) | some p in [["sshd_config_files", "ClientAliveInterval"], ["sshd_runtime", "clientaliveinterval"]]; not _collected(p)]

default ssh_client_alive_interval_ok := false

ssh_client_alive_interval_ok if {
	count(missing_rhel_10_700930) == 0
	v := _r10_ssh_first("ClientAliveInterval")
	regex.match(`^[0-9]+$`, v)
	to_number(v) <= 600
	r := _r10_ssh_runtime("ClientAliveInterval")
	regex.match(`^[0-9]+$`, r)
	to_number(r) <= 600
}

status_rhel_10_700930 := "Not_a_Finding" if ssh_client_alive_interval_ok

else := "Open"

detail_rhel_10_700930 := "RHEL-10-700930: Not_a_Finding" if ssh_client_alive_interval_ok

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-700930", concat(", ", missing_rhel_10_700930)]) if count(missing_rhel_10_700930) > 0

else := "RHEL-10-700930: check failed — ClientAliveInterval must be 600 or less in a drop-in before 50-redhat.conf (the first value sshd reads) and at runtime (sshd -T)"

finding_rhel_10_700930 := {
	"vuln_id": "V-281296",
	"stig_id": "RHEL-10-700930",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must be configured with a timeout interval for the Secure Shell (SSH) daemon.",
	"check_type": "machine",
	"status": status_rhel_10_700930,
	"detail": detail_rhel_10_700930,
	"fix_text": "Set ClientAliveInterval 600 in /etc/ssh/sshd_config.d/10-stig.conf (sorting before 50-redhat.conf) and restart sshd",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

cat_i_findings := [
	finding_rhel_10_600640,
	finding_rhel_10_300040,
	finding_rhel_10_300060,
]

cat_ii_findings := [
	finding_rhel_10_700610,
	finding_rhel_10_700620,
	finding_rhel_10_700630,
	finding_rhel_10_700530,
	finding_rhel_10_700540,
	finding_rhel_10_700550,
	finding_rhel_10_700560,
	finding_rhel_10_700570,
	finding_rhel_10_700660,
	finding_rhel_10_700930,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III), as in the RHEL 8/9 modules.
# `cat_i_compliant`: the CAT-I-only meaning, for gating on the critical subset.
open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

default cat_i_compliant := false

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "ssh_config",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
