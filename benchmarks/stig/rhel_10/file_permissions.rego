# CAT II - MEDIUM SEVERITY
# =============================================================================

# RHEL-10-400265 | V-281070 | CAT II
# mode of /etc/passwd (stat -c %a) as an octal string
missing_rhel_10_400265 := [concat(".", p) | some p in [["file_permissions", "etc_passwd", "mode"]]; not _collected(p)]

default passwd_permissions_ok := false

passwd_permissions_ok if {
	count(missing_rhel_10_400265) == 0
	mode_within(input.file_permissions.etc_passwd.mode, "0644")
}

status_rhel_10_400265 := "Not_a_Finding" if passwd_permissions_ok

else := "Open"

detail_rhel_10_400265 := "RHEL-10-400265: Not_a_Finding" if passwd_permissions_ok

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-400265", concat(", ", missing_rhel_10_400265)]) if count(missing_rhel_10_400265) > 0

else := "RHEL-10-400265: check failed — /etc/passwd must have mode 0644 or less permissive"

finding_rhel_10_400265 := {
	"vuln_id": "V-281070",
	"stig_id": "RHEL-10-400265",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must enforce mode \"0644\" or less permissive for the \"/etc/passwd\" file to prevent unauthorized access.",
	"check_type": "machine",
	"status": status_rhel_10_400265,
	"detail": detail_rhel_10_400265,
	"fix_text": "chmod 0644 /etc/passwd",
}

