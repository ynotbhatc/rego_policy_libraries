package stig.rhel_10.services

# DISA STIG for RHEL 10 - Services Module
# STIG Version: V1R3 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in rhel10_rules.py (regenerate, don't hand-edit).
# Covers: Unnecessary/insecure services that must be disabled

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a whole number, or a string holding a decimal integer; undefined otherwise
# (a fraction such as 3.5 is not a value these settings can hold)
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# RHEL-10-200090 | V-280951 | CAT I
# the vsftpd package must not be installed (input.packages.vsftpd == false)
missing_rhel_10_200090 := [concat(".", p) | some p in [["packages", "vsftpd"]]; not _collected(p)]

default ftp_server_disabled := false

ftp_server_disabled if {
	count(missing_rhel_10_200090) == 0
	input.packages.vsftpd == false
}

status_rhel_10_200090 := "Not_a_Finding" if ftp_server_disabled

else := "Open"

detail_rhel_10_200090 := "RHEL-10-200090: Not_a_Finding" if ftp_server_disabled

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-200090", concat(", ", missing_rhel_10_200090)]) if count(missing_rhel_10_200090) > 0

else := "RHEL-10-200090: check failed — the vsftpd package must not be installed"

finding_rhel_10_200090 := {
	"vuln_id": "V-280951",
	"stig_id": "RHEL-10-200090",
	"severity": "CAT I",
	"rule_title": "RHEL 10 must not have a File Transfer Protocol (FTP) server package installed.",
	"check_type": "machine",
	"status": status_rhel_10_200090,
	"detail": detail_rhel_10_200090,
	"fix_text": "Remove the FTP server: dnf remove vsftpd",
}

# RHEL-10-200020 | V-280944 | CAT I
# the telnet-server package must not be installed (dnf list --installed telnet-server)
missing_rhel_10_200020 := [concat(".", p) | some p in [["packages", "telnet-server"]]; not _collected(p)]

default telnet_server_absent := false

telnet_server_absent if {
	count(missing_rhel_10_200020) == 0
	input.packages["telnet-server"] == false
}

status_rhel_10_200020 := "Not_a_Finding" if telnet_server_absent

else := "Open"

detail_rhel_10_200020 := "RHEL-10-200020: Not_a_Finding" if telnet_server_absent

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-200020", concat(", ", missing_rhel_10_200020)]) if count(missing_rhel_10_200020) > 0

else := "RHEL-10-200020: check failed — the telnet-server package must not be installed"

finding_rhel_10_200020 := {
	"vuln_id": "V-280944",
	"stig_id": "RHEL-10-200020",
	"severity": "CAT I",
	"rule_title": "RHEL 10 must not have the \"telnet-server\" package installed.",
	"check_type": "machine",
	"status": status_rhel_10_200020,
	"detail": detail_rhel_10_200020,
	"fix_text": "Remove the package: dnf remove telnet-server",
}

# =============================================================================
# CAT II - MEDIUM SEVERITY
# =============================================================================

# RHEL-10-200010 | V-280943 | CAT II
# the nfs-utils package must not be installed (dnf list --installed nfs-utils)
missing_rhel_10_200010 := [concat(".", p) | some p in [["packages", "nfs-utils"]]; not _collected(p)]

default nfs_disabled := false

nfs_disabled if {
	count(missing_rhel_10_200010) == 0
	input.packages["nfs-utils"] == false
}

status_rhel_10_200010 := "Not_a_Finding" if nfs_disabled

else := "Open"

detail_rhel_10_200010 := "RHEL-10-200010: Not_a_Finding" if nfs_disabled

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-200010", concat(", ", missing_rhel_10_200010)]) if count(missing_rhel_10_200010) > 0

else := "RHEL-10-200010: check failed — the nfs-utils package must not be installed"

finding_rhel_10_200010 := {
	"vuln_id": "V-280943",
	"stig_id": "RHEL-10-200010",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must not have the \"nfs-utils\" package installed.",
	"check_type": "machine",
	"status": status_rhel_10_200010,
	"detail": detail_rhel_10_200010,
	"fix_text": "Remove the package: dnf remove nfs-utils",
}

# RHEL-10-701210 | V-281323 | CAT II
# systemctl is-enabled autofs (input.unit_enabled[<unit>] is that command's output)
missing_rhel_10_701210 := [concat(".", p) | some p in [["unit_enabled", "autofs"]]; not _collected(p)]

default autofs_disabled := false

autofs_disabled if {
	count(missing_rhel_10_701210) == 0
	_kw(["unit_enabled", "autofs"]) in {"masked", "disabled", "not-found"}
}

default na_rhel_10_701210 := false

na_rhel_10_701210 if {
	input.packages.autofs == false
}

status_rhel_10_701210 := "Not_a_Finding" if autofs_disabled

else := "Not_Applicable" if na_rhel_10_701210

else := "Open"

detail_rhel_10_701210 := "RHEL-10-701210: Not_a_Finding" if autofs_disabled

else := "RHEL-10-701210: Not_Applicable — the autofs service is not installed" if na_rhel_10_701210

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-701210", concat(", ", missing_rhel_10_701210)]) if count(missing_rhel_10_701210) > 0

else := "RHEL-10-701210: check failed — systemctl is-enabled autofs must return masked, disabled or not-found"

finding_rhel_10_701210 := {
	"vuln_id": "V-281323",
	"stig_id": "RHEL-10-701210",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must disable file system automount function.",
	"check_type": "machine",
	"status": status_rhel_10_701210,
	"detail": detail_rhel_10_701210,
	"fix_text": "Disable and mask the automounter: systemctl mask --now autofs.service",
}

# RHEL-10-800310 | V-281363 | CAT II
# the tftp unit as systemd loads it (systemctl cat tftp | grep ExecStart); tftp-server not installed is Not Applicable
missing_rhel_10_800310 := [concat(".", p) | some p in [["packages", "tftp-server"]]; not _collected(p)]

default tftp_secure_mode := false

tftp_secure_mode if {
	count(missing_rhel_10_800310) == 0
	input.packages["tftp-server"] == true
	s := _str(["tftp", "unit_execstart"])
	regex.match(`(^|\s)-s(\s|$)`, s)
}

tftp_secure_mode if {
	_attested("rhel_10_800310_tftp_documented")
}

default na_rhel_10_800310 := false

na_rhel_10_800310 if {
	input.packages["tftp-server"] == false
}

status_rhel_10_800310 := "Not_a_Finding" if tftp_secure_mode

else := "Not_Applicable" if na_rhel_10_800310

else := "Open"

detail_rhel_10_800310 := "RHEL-10-800310: Not_a_Finding" if tftp_secure_mode

else := "RHEL-10-800310: Not_Applicable — tftp-server is not installed" if na_rhel_10_800310

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-800310", concat(", ", missing_rhel_10_800310)]) if count(missing_rhel_10_800310) > 0

else := "RHEL-10-800310: check failed — tftp-server is installed: the ExecStart line of `systemctl cat tftp.service` must carry -s, or TFTP must be documented as mission critical with the ISSO (input.attest.rhel_10_800310_tftp_documented)"

finding_rhel_10_800310 := {
	"vuln_id": "V-281363",
	"stig_id": "RHEL-10-800310",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must be configured to operate in secure mode if the Trivial File Transfer Protocol (TFTP) server service is required.",
	"check_type": "machine+attestation",
	"status": status_rhel_10_800310,
	"detail": detail_rhel_10_800310,
	"fix_text": "Add -s <directory> to the in.tftpd ExecStart line (systemctl edit tftp)",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

cat_i_findings := [
	finding_rhel_10_200090,
	finding_rhel_10_200020,
]

cat_ii_findings := [
	finding_rhel_10_200010,
	finding_rhel_10_701210,
	finding_rhel_10_800310,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III), as in the RHEL 8/9 modules.
# `cat_i_compliant`: the CAT-I-only meaning, for gating on the critical subset.
open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

default cat_i_compliant := false

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "services",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
