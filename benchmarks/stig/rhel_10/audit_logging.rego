package stig.rhel_10.audit_logging

# DISA STIG for RHEL 10 - Audit Logging Module
# STIG Version: V1R3 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in rhel10_rules.py (regenerate, don't hand-edit).
# Covers: auditd configuration, audit rules for system calls and file access

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a whole JSON number only; undefined otherwise. A number sent as text ("900") is
# not read: the collector converts the configured text, and the finding says "evidence invalid" with the type received
# (a fraction such as 3.5 is not a value these settings can hold)
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	_whole_number(v)
}

_whole_number(v) if {
	is_number(v)
	v == floor(v)
}

# what was received where a whole JSON number is required: the JSON type, or "a fraction"
_got(v) := "a fraction" if is_number(v)

_got(v) := type_name(v) if not is_number(v)

# the "evidence invalid" entry for a fact that is collected but is not a whole JSON number
_not_a_number(fact, v) := sprintf("%s is not a number (got %s)", [fact, _got(v)]) if {
	v != null
	not _whole_number(v)
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# input.audit_rules: the loaded rules, one string per line of `auditctl -l`
_audit_lines := [l | some l in input.audit_rules; is_string(l)]

_tokens(line) := [t | some t in parts; t != ""] if parts := split(line, " ")

_syscalls(toks) := {s | some i, t in toks; t == "-S"; v := toks[i + 1]; parts := split(v, ","); some s in parts}

_exit_rule(toks) if "always,exit" in toks

_exit_rule(toks) if "exit,always" in toks

# the -F / -C field tokens of a rule (arch=b64, auid>=1000, exit=-EPERM, path=..., uid!=euid, ...)
_fields(toks) := [v | some i, t in toks; t in {"-F", "-C"}; v := toks[i + 1]]

_field_ok(f, _) if startswith(f, "arch=")

_field_ok(f, _) if startswith(f, "key=")

_field_ok(f, allowed) if f in allowed

# auid != unset, as auditctl prints it (-1, 4294967295 or unset)
auid_unset := {"auid!=-1", "auid!=4294967295", "auid!=unset"}

# every syscall in `needed` is audited for `arch` by an always,exit rule that carries one value of every set in
# `required` and no other field (a rule narrowed by uid=, exe=, ... does not audit every user)
_syscalls_audited(arch, needed, required) if {
	a := concat("=", ["arch", arch])
	allowed := {f | some req in required; some f in req}
	every s in needed {
		some line in _audit_lines
		toks := _tokens(line)
		_exit_rule(toks)
		a in toks
		s in _syscalls(toks)
		fs := _fields(toks)
		every req in required {
			some f in fs
			f in req
		}
		every f in fs {
			_field_ok(f, allowed)
		}
	}
}

# a rule audits exactly `path` with at least the permission letters in `perms` (e.g. ["w", "a"]):
# `-w <path> -p <perm>`, or an always,exit rule with `-F path=<path> -F perm=<perm>` and no narrowing field
_path_audited(path, perms) if {
	some line in _audit_lines
	toks := _tokens(line)
	some i, t in toks
	t == "-w"
	toks[i + 1] == path
	some j, u in toks
	u == "-p"
	p := toks[j + 1]
	every c in perms {
		contains(p, c)
	}
}

_path_audited(path, perms) if {
	some line in _audit_lines
	toks := _tokens(line)
	_exit_rule(toks)
	fs := _fields(toks)
	concat("=", ["path", path]) in fs
	some f in fs
	startswith(f, "perm=")
	p := substring(f, 5, -1)
	every c in perms {
		contains(p, c)
	}
	every g in fs {
		_path_field_ok(g, path)
	}
}

_path_field_ok(f, path) if f == concat("=", ["path", path])

_path_field_ok(f, _) if startswith(f, "perm=")

_path_field_ok(f, _) if f in ({"auid>=1000"} | auid_unset)

_path_field_ok(f, _) if _field_ok(f, set())

# =============================================================================
# CAT II - MEDIUM SEVERITY
# =============================================================================

# RHEL-10-500205 | V-281113 | CAT II
# space_left_action as configured in /etc/audit/auditd.conf
missing_rhel_10_500205 := [concat(".", p) | some p in [["auditd_config", "space_left_action"]]; not _collected(p)]

default space_left_action_ok := false

space_left_action_ok if {
	count(missing_rhel_10_500205) == 0
	_kw(["auditd_config", "space_left_action"]) in {"email"}
}

space_left_action_ok if {
	_attested("rhel_10_500205_realtime_alerts")
}

status_rhel_10_500205 := "Not_a_Finding" if space_left_action_ok

else := "Open"

detail_rhel_10_500205 := "RHEL-10-500205: Not_a_Finding" if space_left_action_ok

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-500205", concat(", ", missing_rhel_10_500205)]) if count(missing_rhel_10_500205) > 0

else := "RHEL-10-500205: check failed — space_left_action in /etc/audit/auditd.conf must be EMAIL, or the SA must attest that real-time alerts to the SA and ISSO are configured at 75 percent of audit storage (input.attest.rhel_10_500205_realtime_alerts)"

finding_rhel_10_500205 := {
	"vuln_id": "V-281113",
	"stig_id": "RHEL-10-500205",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must notify the system administrator (SA) and information system security officer (ISSO) (at a minimum) when allocated audit record storage volume 75 percent utilization.",
	"check_type": "machine+attestation",
	"status": status_rhel_10_500205,
	"detail": detail_rhel_10_500205,
	"fix_text": "Set space_left_action = EMAIL in /etc/audit/auditd.conf",
}

