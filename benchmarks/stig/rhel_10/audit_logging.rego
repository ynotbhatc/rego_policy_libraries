	"status": status_rhel_10_500550,
	"detail": detail_rhel_10_500550,
	"fix_text": "Add an audit rule for /usr/bin/sudo to /etc/audit/rules.d/ and load it (augenrules --load)",
}

# RHEL-10-500780 | V-281163 | CAT II
# always,exit rules for the chmod family, both arches (auditctl -l)
missing_rhel_10_500780 := [concat(".", p) | some p in [["audit_rules"]]; not _collected(p)]

default audit_chmod := false

audit_chmod if {
	count(missing_rhel_10_500780) == 0
	is_array(input.audit_rules)
	_syscalls_audited("b32", {"chmod", "fchmod", "fchmodat", "fchmodat2"}, [{"auid>=1000"}, {"auid!=-1", "auid!=4294967295", "auid!=unset"}])
	_syscalls_audited("b64", {"chmod", "fchmod", "fchmodat", "fchmodat2"}, [{"auid>=1000"}, {"auid!=-1", "auid!=4294967295", "auid!=unset"}])
}

status_rhel_10_500780 := "Not_a_Finding" if audit_chmod

else := "Open"

detail_rhel_10_500780 := "RHEL-10-500780: Not_a_Finding" if audit_chmod

else := sprintf("%s: evidence missing — %s not collected", ["RHEL-10-500780", concat(", ", missing_rhel_10_500780)]) if count(missing_rhel_10_500780) > 0

else := "RHEL-10-500780: check failed — chmod, fchmod, fchmodat and fchmodat2 must be audited for both b32 and b64"

finding_rhel_10_500780 := {
	"vuln_id": "V-281163",
	"stig_id": "RHEL-10-500780",
	"severity": "CAT II",
	"rule_title": "RHEL 10 must generate audit records for all uses of the \"chmod\", \"fchmod\", \"fchmodat\", and \"fchmodat2\" syscalls.",
	"check_type": "machine",
	"status": status_rhel_10_500780,
	"detail": detail_rhel_10_500780,
	"fix_text": "Add the rules to /etc/audit/rules.d/audit.rules and load them (augenrules --load): -a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=-1 -F key=k",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

# No CAT I rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_i_findings := array.concat([], [])

cat_ii_findings := [
	finding_rhel_10_500205,
	finding_rhel_10_200661,
	finding_rhel_10_500300,
	finding_rhel_10_500790,
	finding_rhel_10_500310,
	finding_rhel_10_500390,
	finding_rhel_10_500410,
	finding_rhel_10_500680,
	finding_rhel_10_500730,
	finding_rhel_10_500550,
	finding_rhel_10_500780,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III), as in the RHEL 8/9 modules.
# `cat_i_compliant`: the CAT-I-only meaning, for gating on the critical subset.
open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

default cat_i_compliant := false

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "audit_logging",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
