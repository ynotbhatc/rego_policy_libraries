package stig.oracle_linux_8.services

# DISA STIG for Oracle Linux 8 - Services Module
# STIG Version: V2R10 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in ol8_rules.py (regenerate, don't hand-edit).
# Covers: Unnecessary/insecure services that must be disabled

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a number, or a string holding a decimal integer; undefined otherwise
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# OL08-00-040000 | V-248823 | CAT I
# the telnet-server package must not be installed (dnf list --installed telnet-server)
missing_ol08_00_040000 := [concat(".", p) | some p in [["packages", "telnet-server"]]; not _collected(p)]

default telnet_server_absent := false

telnet_server_absent if {
	count(missing_ol08_00_040000) == 0
	input.packages["telnet-server"] == false
}

status_ol08_00_040000 := "Not_a_Finding" if telnet_server_absent

else := "Open"

detail_ol08_00_040000 := "OL08-00-040000: Not_a_Finding" if telnet_server_absent

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-040000", concat(", ", missing_ol08_00_040000)]) if count(missing_ol08_00_040000) > 0

else := "OL08-00-040000: check failed — the telnet-server package must not be installed"

finding_ol08_00_040000 := {
	"vuln_id": "V-248823",
	"stig_id": "OL08-00-040000",
	"severity": "CAT I",
	"rule_title": "OL 8 must not have the telnet-server package installed.",
	"check_type": "machine",
	"status": status_ol08_00_040000,
	"detail": detail_ol08_00_040000,
	"fix_text": "Remove the package: dnf remove telnet-server",
}

# OL08-00-040190 | V-248873 | CAT I
# yum list installed tftp-server
missing_ol08_00_040190 := [concat(".", p) | some p in [["packages", "tftp-server"]]; not _collected(p)]

default tftp_server_absent := false

tftp_server_absent if {
	count(missing_ol08_00_040190) == 0
	input.packages["tftp-server"] == false
}

tftp_server_absent if {
	_attested("ol08_00_040190_tftp_documented")
}

status_ol08_00_040190 := "Not_a_Finding" if tftp_server_absent

else := "Open"

detail_ol08_00_040190 := "OL08-00-040190: Not_a_Finding" if tftp_server_absent

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-040190", concat(", ", missing_ol08_00_040190)]) if count(missing_ol08_00_040190) > 0

else := "OL08-00-040190: check failed — the tftp-server package must not be installed, or its requirement documented with the ISSO (input.attest.ol08_00_040190_tftp_documented)"

finding_ol08_00_040190 := {
	"vuln_id": "V-248873",
	"stig_id": "OL08-00-040190",
	"severity": "CAT I",
	"rule_title": "The Trivial File Transfer Protocol (TFTP) server package must not be installed if not required for OL 8 operational support.",
	"check_type": "machine+attestation",
	"status": status_ol08_00_040190,
	"detail": detail_ol08_00_040190,
	"fix_text": "Remove the TFTP server: yum remove tftp-server",
}

# OL08-00-040360 | V-248903 | CAT I
# input.ftpd_packages: installed package names matching ftpd
missing_ol08_00_040360 := [concat(".", p) | some p in [["ftpd_packages"]]; not _collected(p)]

default ftp_server_absent := false

ftp_server_absent if {
	count(missing_ol08_00_040360) == 0
	pk := input.ftpd_packages
	is_array(pk)
	count(pk) == 0
}

ftp_server_absent if {
	_attested("ol08_00_040360_ftp_documented")
}

status_ol08_00_040360 := "Not_a_Finding" if ftp_server_absent

else := "Open"

detail_ol08_00_040360 := "OL08-00-040360: Not_a_Finding" if ftp_server_absent

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-040360", concat(", ", missing_ol08_00_040360)]) if count(missing_ol08_00_040360) > 0

else := "OL08-00-040360: check failed — no FTP server package may be installed (yum list installed | grep ftpd), unless documented with the ISSO (input.attest.ol08_00_040360_ftp_documented)"

finding_ol08_00_040360 := {
	"vuln_id": "V-248903",
	"stig_id": "OL08-00-040360",
	"severity": "CAT I",
	"rule_title": "A File Transfer Protocol (FTP) server package must not be installed unless mission essential on OL 8.",
	"check_type": "machine+attestation",
	"status": status_ol08_00_040360,
	"detail": detail_ol08_00_040360,
	"fix_text": "Remove the FTP server: yum remove vsftpd",
}

# =============================================================================
# CAT II - MEDIUM SEVERITY
# =============================================================================

# OL08-00-040070 | V-248836 | CAT II
# systemctl is-enabled autofs (input.unit_enabled[<unit>] is that command's output)
missing_ol08_00_040070 := [concat(".", p) | some p in [["unit_enabled", "autofs"]]; not _collected(p)]

default autofs_disabled := false

autofs_disabled if {
	count(missing_ol08_00_040070) == 0
	_kw(["unit_enabled", "autofs"]) in {"masked", "disabled", "not-found"}
}

default na_ol08_00_040070 := false

na_ol08_00_040070 if {
	input.packages.autofs == false
}

status_ol08_00_040070 := "Not_a_Finding" if autofs_disabled

else := "Not_Applicable" if na_ol08_00_040070

else := "Open"

detail_ol08_00_040070 := "OL08-00-040070: Not_a_Finding" if autofs_disabled

else := "OL08-00-040070: Not_Applicable — the autofs service is not installed" if na_ol08_00_040070

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-040070", concat(", ", missing_ol08_00_040070)]) if count(missing_ol08_00_040070) > 0

else := "OL08-00-040070: check failed — systemctl is-enabled autofs must return masked, disabled or not-found"

finding_ol08_00_040070 := {
	"vuln_id": "V-248836",
	"stig_id": "OL08-00-040070",
	"severity": "CAT II",
	"rule_title": "The OL 8 file system automounter must be disabled.",
	"check_type": "machine",
	"status": status_ol08_00_040070,
	"detail": detail_ol08_00_040070,
	"fix_text": "Disable and mask the automounter: systemctl mask --now autofs.service",
}

# OL08-00-040350 | V-248902 | CAT II
# if tftp-server is installed, tftp.service ExecStart must carry -s; not installed is Not Applicable
missing_ol08_00_040350 := [concat(".", p) | some p in [["packages", "tftp-server"]]; not _collected(p)]

default tftp_secure_mode := false

tftp_secure_mode if {
	count(missing_ol08_00_040350) == 0
	input.packages["tftp-server"] == true
	s := _str(["tftp", "execstart"])
	regex.match(`(^|\s)-s(\s|$)`, s)
}

default na_ol08_00_040350 := false

na_ol08_00_040350 if {
	input.packages["tftp-server"] == false
}

status_ol08_00_040350 := "Not_a_Finding" if tftp_secure_mode

else := "Not_Applicable" if na_ol08_00_040350

else := "Open"

detail_ol08_00_040350 := "OL08-00-040350: Not_a_Finding" if tftp_secure_mode

else := "OL08-00-040350: Not_Applicable — tftp-server is not installed" if na_ol08_00_040350

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-040350", concat(", ", missing_ol08_00_040350)]) if count(missing_ol08_00_040350) > 0

else := "OL08-00-040350: check failed — tftp-server is installed: the ExecStart of tftp.service (input.tftp.execstart) must run in.tftpd with -s"

finding_ol08_00_040350 := {
	"vuln_id": "V-248902",
	"stig_id": "OL08-00-040350",
	"severity": "CAT II",
	"rule_title": "If the Trivial File Transfer Protocol (TFTP) server is required, the OL 8 TFTP daemon must be configured to operate in secure mode.",
	"check_type": "machine",
	"status": status_ol08_00_040350,
	"detail": detail_ol08_00_040350,
	"fix_text": "Remove tftp-server (dnf remove tftp-server) or set ExecStart=/usr/sbin/in.tftpd -s /var/lib/tftpboot",
}

# OL08-00-040002 | V-248825 | CAT II
# yum list installed sendmail
missing_ol08_00_040002 := [concat(".", p) | some p in [["packages", "sendmail"]]; not _collected(p)]

default sendmail_absent := false

sendmail_absent if {
	count(missing_ol08_00_040002) == 0
	input.packages.sendmail == false
}

status_ol08_00_040002 := "Not_a_Finding" if sendmail_absent

else := "Open"

detail_ol08_00_040002 := "OL08-00-040002: Not_a_Finding" if sendmail_absent

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-040002", concat(", ", missing_ol08_00_040002)]) if count(missing_ol08_00_040002) > 0

else := "OL08-00-040002: check failed — the sendmail package must not be installed"

finding_ol08_00_040002 := {
	"vuln_id": "V-248825",
	"stig_id": "OL08-00-040002",
	"severity": "CAT II",
	"rule_title": "OL 8 must not have the sendmail package installed.",
	"check_type": "machine",
	"status": status_ol08_00_040002,
	"detail": detail_ol08_00_040002,
	"fix_text": "Remove sendmail: yum remove sendmail",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

cat_i_findings := [
	finding_ol08_00_040000,
	finding_ol08_00_040190,
	finding_ol08_00_040360,
]

cat_ii_findings := [
	finding_ol08_00_040070,
	finding_ol08_00_040350,
	finding_ol08_00_040002,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III).
# `cat_i_compliant`: the former CAT-I-only meaning, for gating on the critical subset.
default cat_i_compliant := false

open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "services",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
