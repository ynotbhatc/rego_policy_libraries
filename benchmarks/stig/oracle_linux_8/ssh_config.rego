	every v in vals {
		v in fips_ssh_macs
	}
}

status_ol08_00_010290 := "Not_a_Finding" if ssh_fips_macs

else := "Open"

detail_ol08_00_010290 := "OL08-00-010290: Not_a_Finding" if ssh_fips_macs

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010290", concat(", ", missing_ol08_00_010290)]) if count(missing_ol08_00_010290) > 0

else := "OL08-00-010290: check failed — MACs in /etc/crypto-policies/back-ends/opensshserver.config must list only hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com,hmac-sha2-256,hmac-sha2-512"

finding_ol08_00_010290 := {
	"vuln_id": "V-283457",
	"stig_id": "OL08-00-010290",
	"severity": "CAT I",
	"rule_title": "The OL 8 SSH server must be configured to use only Message Authentication Codes (MACs) employing FIPS 140-3 validated cryptographic hash algorithms to protect the confidentiality of SSH server connections.",
	"check_type": "machine",
	"status": status_ol08_00_010290,
	"detail": detail_ol08_00_010290,
	"fix_text": "Apply the FIPS crypto policy (update-crypto-policies --set FIPS) so opensshserver.config carries the DISA list",
}

# OL08-00-020330 | V-248714 | CAT I
# OL 8's finding is only 'set to yes' or conflicting results: an unset keyword (sshd default no) passes
missing_ol08_00_020330 := [concat(".", p) | some p in [["sshd_config_lines", "PermitEmptyPasswords"]]; not _collected(p)]

default ssh_no_empty_passwords := false

ssh_no_empty_passwords if {
	count(missing_ol08_00_020330) == 0
	vals := _ssh_vals("PermitEmptyPasswords")
	count(vals) == count(input.sshd_config_lines.PermitEmptyPasswords)
	every v in vals {
		v == "no"
	}
	count({v | some v in vals}) <= 1
}

status_ol08_00_020330 := "Not_a_Finding" if ssh_no_empty_passwords

else := "Open"

detail_ol08_00_020330 := "OL08-00-020330: Not_a_Finding" if ssh_no_empty_passwords

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-020330", concat(", ", missing_ol08_00_020330)]) if count(missing_ol08_00_020330) > 0

else := "OL08-00-020330: check failed — PermitEmptyPasswords must not be yes (none conflicting)"

finding_ol08_00_020330 := {
	"vuln_id": "V-248714",
	"stig_id": "OL08-00-020330",
	"severity": "CAT I",
	"rule_title": "OL 8 must not allow accounts configured with blank or null passwords.",
	"check_type": "machine",
	"status": status_ol08_00_020330,
	"detail": detail_ol08_00_020330,
	"fix_text": "Set PermitEmptyPasswords no in /etc/ssh/sshd_config",
}

