# systemwide crypto policy FIPS; CURRENT.pol hash list and min_rsa_size
missing_ol08_00_010182 := [concat(".", p) | some p in [["crypto_policy"], ["crypto_policy_state", "hash"], ["crypto_policy_state", "min_rsa_size"]]; not _collected(p)]

invalid_ol08_00_010182 := [m | some p in [["crypto_policy_state", "min_rsa_size"]]; m := _not_a_number(concat(".", p), object.get(input, p, null))]

default crypto_policy_fips := false

crypto_policy_fips if {
	count(missing_ol08_00_010182) == 0
	_str(["crypto_policy"]) == "FIPS"
	hashes := input.crypto_policy_state.hash
	is_array(hashes)
	every h in ol8_fips_policy_hashes {
		h in hashes
	}
	count([h | some h in hashes; _weak_hash(h)]) == 0
	_num(["crypto_policy_state", "min_rsa_size"]) >= 2048
}

status_ol08_00_010182 := "Not_a_Finding" if crypto_policy_fips

else := "Open"

detail_ol08_00_010182 := "OL08-00-010182: Not_a_Finding" if crypto_policy_fips

