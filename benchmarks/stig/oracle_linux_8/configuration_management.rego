else := "OL08-00-010182: check failed — update-crypto-policies --show must be FIPS; CURRENT.pol hash must include SHA2-256 SHA2-384 SHA2-512 SHA2-224 SHA3-256 SHA3-384 SHA3-512, nothing with SHA1 or below 224 bits; min_rsa_size must be at least 2048"

finding_ol08_00_010182 := {
	"vuln_id": "V-283446",
	"stig_id": "OL08-00-010182",
	"severity": "CAT I",
	"rule_title": "OL 8 must implement NIST FIPS-validated cryptography for the following: To provision digital signatures, to generate cryptographic hashes, and to protect data requiring data-at-rest protections in accordance with applicable federal laws, Executive Orders, directives, policies, regulations, and standards.",
