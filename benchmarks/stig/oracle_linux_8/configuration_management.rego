# OL08-00-040170 | V-248869 | CAT I
# ctrl-alt-del.target load state (systemctl show -p LoadState) must be masked
missing_ol08_00_040170 := [concat(".", p) | some p in [["systemd_units", "ctrl-alt-del.target", "load_state"]]; not _collected(p)]

default ctrl_alt_del_disabled := false

ctrl_alt_del_disabled if {
	count(missing_ol08_00_040170) == 0
	_kw(["systemd_units", "ctrl-alt-del.target", "load_state"]) == "masked"
}

status_ol08_00_040170 := "Not_a_Finding" if ctrl_alt_del_disabled

else := "Open"

detail_ol08_00_040170 := "OL08-00-040170: Not_a_Finding" if ctrl_alt_del_disabled

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-040170", concat(", ", missing_ol08_00_040170)]) if count(missing_ol08_00_040170) > 0

else := "OL08-00-040170: check failed — ctrl-alt-del.target must be masked (systemctl status: Loaded: masked)"

finding_ol08_00_040170 := {
	"vuln_id": "V-248869",
	"stig_id": "OL08-00-040170",
	"severity": "CAT I",
	"rule_title": "The x86 Ctrl-Alt-Delete key sequence must be disabled on OL 8.",
	"check_type": "machine",
	"status": status_ol08_00_040170,
	"detail": detail_ol08_00_040170,
	"fix_text": "Mask the target: systemctl disable --now ctrl-alt-del.target && systemctl mask ctrl-alt-del.target",
}

