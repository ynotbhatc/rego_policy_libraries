package stig.oracle_linux_8.configuration_management

# DISA STIG for Oracle Linux 8 - Configuration Management Module
# STIG Version: V2R10 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in ol8_rules.py (regenerate, don't hand-edit).
# Covers: System settings, kernel params, banners, SELinux, GRUB, CTL-ALT-DEL

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a whole JSON number only; undefined otherwise. A number sent as text ("900") is
# not read: the collector converts the configured text, and the finding says "evidence invalid" with the type received
# (a fraction such as 3.5 is not a value these settings can hold)
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	_whole_number(v)
}

_whole_number(v) if {
	is_number(v)
	v == floor(v)
}

# what was received where a whole JSON number is required: the JSON type, or "a fraction"
_got(v) := "a fraction" if is_number(v)

_got(v) := type_name(v) if not is_number(v)

# the "evidence invalid" entry for a fact that is collected but is not a whole JSON number
_not_a_number(fact, v) := sprintf("%s is not a number (got %s)", [fact, _got(v)]) if {
	v != null
	not _whole_number(v)
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# a hash the crypto-policy check rejects: SHA1 (or MD5), or a digest size below 224
_weak_hash(h) if not is_string(h)

_weak_hash(h) if {
	is_string(h)
	u := upper(h)
	contains(u, "SHA1")
}

_weak_hash(h) if {
	is_string(h)
	u := upper(h)
	contains(u, "MD5")
}

_weak_hash(h) if {
	is_string(h)
	m := regex.find_all_string_submatch_n(`-([0-9]+)$`, h, 1)
	bits := to_number(m[0][1])
	bits < 224
}

# the Standard Mandatory DoW Notice and Consent Banner, from the OL08-00-010060 check text (whitespace-normalised)
dod_banner := "You are accessing a U.S. Government (USG) Information System (IS) that is provided for USG-authorized use only. By using this IS (which includes any device attached to this IS), you consent to the following conditions: -The USG routinely intercepts and monitors communications on this IS for purposes including, but not limited to, penetration testing, COMSEC monitoring, network operations and defense, personnel misconduct (PM), law enforcement (LE), and counterintelligence (CI) investigations. -At any time, the USG may inspect and seize data stored on this IS. -Communications using, or data stored on, this IS are not private, are subject to routine monitoring, interception, and search, and may be disclosed or used for any USG-authorized purpose. -This IS includes security measures (e.g., authentication and access controls) to protect USG interests--not for your personal benefit or privacy. -Notwithstanding the above, using this IS does not constitute consent to PM, LE or CI investigative searching or monitoring of the content of privileged communications, or work product, related to personal representation or services by attorneys, psychotherapists, or clergy, and their assistants. Such communications and work product are private and confidential. See User Agreement for details."

# text with every run of whitespace collapsed to one space and the ends trimmed
_squash(s) := regex.replace(trim_space(s), `\s+`, " ")

# a kernel module is disabled the way the check requires: an uncommented `install <mod> /bin/false` and
# `blacklist <mod>` in /etc/modprobe.conf or /etc/modprobe.d/* (input.modprobe[<mod>] = {install, blacklisted})
_module_disabled(mod) if {
	m := input.modprobe[mod]
	m.install == "/bin/false"
	m.blacklisted == true
}

# the AIDE job mails its result, or the SA attests to another notification path
_aide_notifies if {
	some l in input.aide.schedule
	_aide_check_line(l)
	regex.match(`\|\s*(\S*/)?(mail|mailx|sendmail)(\s|$)`, l)
}

# a cron line (as "<file>: <entry>") that runs the aide binary with --check, not commented out
_aide_check_line(l) if {
	is_string(l)
	not regex.match(`^[^:]*:\s*#`, l)
	regex.match(`(^|[\s:/])aide\s+(--check|-C)(\s|$)`, l)
}

_aide_notifies if _attested("ol08_00_010360_notification")

# the OL 8 crypto-policy hash set (OL 8 lists seven; SHAKE-256 is not required)
ol8_fips_policy_hashes := {"SHA2-256", "SHA2-384", "SHA2-512", "SHA2-224", "SHA3-256", "SHA3-384", "SHA3-512"}

_fstab_entry(mp) := e if {
	entries := input.fstab
	is_array(entries)
	some e in entries
	e.mount_point == mp
}

# the fstab entry's options as exact tokens
_fstab_opts(e) := {o | some x in parts; o := trim_space(x)} if {
	is_string(e.options)
	parts := split(e.options, ",")
}

