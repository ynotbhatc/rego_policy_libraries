else := "OL08-00-010150: check failed — GRUB2_PASSWORD in /boot/grub2/user.cfg must begin with grub.pbkdf2.sha512"

finding_ol08_00_010150 := {
	"vuln_id": "V-248540",
	"stig_id": "OL08-00-010150",
	"severity": "CAT I",
	"rule_title": "OL 8 operating systems booted with a BIOS must require authentication upon booting into single-user and maintenance modes.",
	"check_type": "machine",
