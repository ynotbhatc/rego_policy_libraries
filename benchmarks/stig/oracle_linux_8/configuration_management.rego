else := "OL08-00-040080: check failed — /etc/modprobe.conf or /etc/modprobe.d/* must carry uncommented 'install usb-storage /bin/false' and 'blacklist usb-storage', or its use must be documented with the ISSO (input.attest.ol08_00_040080_usb_storage_documented)"

