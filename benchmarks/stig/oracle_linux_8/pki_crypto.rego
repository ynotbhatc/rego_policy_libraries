package stig.oracle_linux_8.pki_crypto

# DISA STIG for Oracle Linux 8 - PKI and Cryptography Module
# STIG Version: V2R10 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in ol8_rules.py (regenerate, don't hand-edit).
# Covers: FIPS 140-3, PKI/CAC authentication, certificate management, crypto policies

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a number, or a string holding a decimal integer; undefined otherwise
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# the comma-separated option list at path, each entry trimmed; undefined unless a string
_csv(path) := [trim_space(x) | some x in parts] if {
	s := _str(path)
	parts := split(s, ",")
}

# a DoD root CA from /etc/sssd/pki/sssd_auth_ca_db.pem, as the OL08-00-010090 check shows it: self-signed
# (Subject == Issuer), Issuer C = US, O = U.S. Government, OU = DoD (the check text prints DoW), OU = PKI,
# CN = DoD Root CA <n>, compared component by component; inside its validity dates.
# input.sssd_ca_db.certificates: [{issuer_rdns, subject_rdns, not_before, not_after}], RDNs as [type, value]
# pairs in certificate order, dates RFC 3339.
_dod_root_valid(c) if {
	rdns := c.issuer_rdns
	is_array(rdns)
	count(rdns) == 5
	rdns[0] == ["C", "US"]
	rdns[1] == ["O", "U.S. Government"]
	rdns[2] in {["OU", "DoD"], ["OU", "DoW"]}
	rdns[3] == ["OU", "PKI"]
	rdns[4][0] == "CN"
	is_string(rdns[4][1])
	regex.match(`^DoD Root CA [0-9]+$`, rdns[4][1])
	c.subject_rdns == rdns
	nb := time.parse_rfc3339_ns(c.not_before)
	na := time.parse_rfc3339_ns(c.not_after)
	now := time.now_ns()
	nb <= now
	now < na
}

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# OL08-00-010293 | V-288821 | CAT I
# the lines of /etc/pki/tls/openssl.cnf must include the crypto-policy opensslcnf.config back-end
missing_ol08_00_010293 := [concat(".", p) | some p in [["openssl_cnf", "lines"]]; not _collected(p)]

default openssl_system_policy := false

openssl_system_policy if {
	count(missing_ol08_00_010293) == 0
	lines := input.openssl_cnf.lines
	is_array(lines)
	some l in lines
	regex.match(`^\s*\.include\s*=?\s*/etc/crypto-policies/back-ends/opensslcnf\.config\s*$`, l)
}

status_ol08_00_010293 := "Not_a_Finding" if openssl_system_policy

else := "Open"

detail_ol08_00_010293 := "OL08-00-010293: Not_a_Finding" if openssl_system_policy

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010293", concat(", ", missing_ol08_00_010293)]) if count(missing_ol08_00_010293) > 0

else := "OL08-00-010293: check failed — /etc/pki/tls/openssl.cnf must include /etc/crypto-policies/back-ends/opensslcnf.config (uncommented)"

finding_ol08_00_010293 := {
	"vuln_id": "V-288821",
	"stig_id": "OL08-00-010293",
	"severity": "CAT I",
	"rule_title": "OL 8 must implement DoW-approved encryption in the OpenSSL package.",
	"check_type": "machine",
	"status": status_ol08_00_010293,
	"detail": detail_ol08_00_010293,
	"fix_text": "Add .include = /etc/crypto-policies/back-ends/opensslcnf.config to /etc/pki/tls/openssl.cnf",
}

# OL08-00-010183 | V-283447 | CAT I
# output of update-crypto-policies --is-applied (OL 8; RHEL 9 runs --check and lists the back-ends)
missing_ol08_00_010183 := [concat(".", p) | some p in [["crypto_policy_check", "is_applied"]]; not _collected(p)]

default crypto_policy_not_overridden := false

crypto_policy_not_overridden if {
	count(missing_ol08_00_010183) == 0
	out := _str(["crypto_policy_check", "is_applied"])
	some l in split(out, "\n")
	trim_space(l) == "The configured policy is applied"
}

status_ol08_00_010183 := "Not_a_Finding" if crypto_policy_not_overridden

else := "Open"

detail_ol08_00_010183 := "OL08-00-010183: Not_a_Finding" if crypto_policy_not_overridden

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010183", concat(", ", missing_ol08_00_010183)]) if count(missing_ol08_00_010183) > 0

else := "OL08-00-010183: check failed — update-crypto-policies --is-applied must report: The configured policy is applied"

finding_ol08_00_010183 := {
	"vuln_id": "V-283447",
	"stig_id": "OL08-00-010183",
	"severity": "CAT I",
	"rule_title": "OL 8 cryptographic policy must not be overridden.",
	"check_type": "machine",
	"status": status_ol08_00_010183,
	"detail": detail_ol08_00_010183,
	"fix_text": "Remove the overrides and run update-crypto-policies --set FIPS, then reboot",
}

# =============================================================================
# CAT II - MEDIUM SEVERITY
# =============================================================================

# OL08-00-010090 | V-248531 | CAT II
# certificates in /etc/sssd/pki/sssd_auth_ca_db.pem: issuer / subject RDNs and validity dates
missing_ol08_00_010090 := [concat(".", p) | some p in [["sssd_ca_db", "certificates"]]; not _collected(p)]

default dod_ca_trusted := false

dod_ca_trusted if {
	count(missing_ol08_00_010090) == 0
	certs := input.sssd_ca_db.certificates
	is_array(certs)
	some c in certs
	_dod_root_valid(c)
}

default na_ol08_00_010090 := false

na_ol08_00_010090 if {
	_attested("ol08_00_010090_alternate_mfa")
}

status_ol08_00_010090 := "Not_a_Finding" if dod_ca_trusted

else := "Not_Applicable" if na_ol08_00_010090

else := "Open"

detail_ol08_00_010090 := "OL08-00-010090: Not_a_Finding" if dod_ca_trusted

else := "OL08-00-010090: Not_Applicable — the SA demonstrated an approved alternate multifactor authentication method" if na_ol08_00_010090

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010090", concat(", ", missing_ol08_00_010090)]) if count(missing_ol08_00_010090) > 0

else := "OL08-00-010090: check failed — /etc/sssd/pki/sssd_auth_ca_db.pem must hold a self-signed DoD root CA (Issuer = Subject = C=US, O=U.S. Government, OU=DoD, OU=PKI, CN=DoD Root CA <n>) within its validity dates"

finding_ol08_00_010090 := {
	"vuln_id": "V-248531",
	"stig_id": "OL08-00-010090",
	"severity": "CAT II",
	"rule_title": "OL 8, for PKI-based authentication, must validate certificates by constructing a certification path (which includes status information) to an accepted trust anchor.",
	"check_type": "machine",
	"status": status_ol08_00_010090,
	"detail": detail_ol08_00_010090,
	"fix_text": "Install the DoD root CA bundle as /etc/sssd/pki/sssd_auth_ca_db.pem",
}

# OL08-00-020050 | V-248679 | CAT II
# input.dconf_db.removal_action: the values of the uncommented removal-action= lines found by grep -R removal-action /etc/dconf/db/* (OL 9 reads the dconf files; RHEL 9 reads gsettings)
missing_ol08_00_020050 := [concat(".", p) | some p in [["dconf_db", "removal_action"]]; not _collected(p)]

default smartcard_lock_on_removal := false

smartcard_lock_on_removal if {
	count(missing_ol08_00_020050) == 0
	vals := input.dconf_db.removal_action
	is_array(vals)
	some v in vals
	is_string(v)
	trim_space(v) == "'lock-screen'"
}

default na_ol08_00_020050 := false

na_ol08_00_020050 if {
	input.gui_installed == false
}

status_ol08_00_020050 := "Not_a_Finding" if smartcard_lock_on_removal

else := "Not_Applicable" if na_ol08_00_020050

else := "Open"

detail_ol08_00_020050 := "OL08-00-020050: Not_a_Finding" if smartcard_lock_on_removal

else := "OL08-00-020050: Not_Applicable — no graphical user interface is installed" if na_ol08_00_020050

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-020050", concat(", ", missing_ol08_00_020050)]) if count(missing_ol08_00_020050) > 0

else := "OL08-00-020050: check failed — an uncommented removal-action='lock-screen' must be set in the dconf database files (/etc/dconf/db/*)"

finding_ol08_00_020050 := {
	"vuln_id": "V-248679",
	"stig_id": "OL08-00-020050",
	"severity": "CAT II",
	"rule_title": "OL 8 must be able to initiate directly a session lock for all connection types using smartcard when the smartcard is removed.",
	"check_type": "machine",
	"status": status_ol08_00_020050,
	"detail": detail_ol08_00_020050,
	"fix_text": "Set removal-action='lock-screen' under [org/gnome/settings-daemon/peripherals/smartcard] in /etc/dconf/db/local.d/ and run dconf update",
}

# OL08-00-020090 | V-248685 | CAT II
# input.sssd_conf_file.certmap_rules: [certmap/...] sections of /etc/sssd/sssd.conf (OL 9 reads that file only)
missing_ol08_00_020090 := [concat(".", p) | some p in [["sssd_conf_file", "certmap_rules"]]; not _collected(p)]

default cert_user_mapping := false

cert_user_mapping if {
	count(missing_ol08_00_020090) == 0
	rules := input.sssd_conf_file.certmap_rules
	is_array(rules)
	some r in rules
	is_string(r.maprule)
	trim_space(r.maprule) != ""
}

default na_ol08_00_020090 := false

na_ol08_00_020090 if {
	_attested("ol08_00_020090_alternate_mfa")
}

status_ol08_00_020090 := "Not_a_Finding" if cert_user_mapping

else := "Not_Applicable" if na_ol08_00_020090

else := "Open"

detail_ol08_00_020090 := "OL08-00-020090: Not_a_Finding" if cert_user_mapping

else := "OL08-00-020090: Not_Applicable — the SA demonstrated an approved alternate multifactor authentication method" if na_ol08_00_020090

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-020090", concat(", ", missing_ol08_00_020090)]) if count(missing_ol08_00_020090) > 0

else := "OL08-00-020090: check failed — /etc/sssd/sssd.conf must have a [certmap/...] section with a maprule"

finding_ol08_00_020090 := {
	"vuln_id": "V-248685",
	"stig_id": "OL08-00-020090",
	"severity": "CAT II",
	"rule_title": "OL 8 must map the authenticated identity to the user or group account for PKI-based authentication.",
	"check_type": "machine",
	"status": status_ol08_00_020090,
	"detail": detail_ol08_00_020090,
	"fix_text": "Add a [certmap/<domain>/<rule>] section with matchrule and maprule to /etc/sssd/sssd.conf",
}

# OL08-00-010400 | V-248587 | CAT II
# certificate_verification from the [sssd] section of sssd.conf / conf.d (uncommented)
missing_ol08_00_010400 := [concat(".", p) | some p in [["sssd", "certificate_verification"]]; not _collected(p)]

default cert_revocation_check := false

cert_revocation_check if {
	count(missing_ol08_00_010400) == 0
	opts := {o | some o in _csv(["sssd", "certificate_verification"])}
	"ocsp_dgst=sha1" in opts
	not "no_ocsp" in opts
	not "no_verification" in opts
}

cert_revocation_check if {
	_attested("ol08_00_010400_status_checking")
}

status_ol08_00_010400 := "Not_a_Finding" if cert_revocation_check

else := "Open"

detail_ol08_00_010400 := "OL08-00-010400: Not_a_Finding" if cert_revocation_check

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010400", concat(", ", missing_ol08_00_010400)]) if count(missing_ol08_00_010400) > 0

else := "OL08-00-010400: check failed — certificate_verification in the [sssd] section must carry ocsp_dgst=sha1 (as the OL 8 check prints it) and neither no_ocsp nor no_verification, or the SA must show how certificate status checking is implemented (input.attest.ol08_00_010400_status_checking)"

finding_ol08_00_010400 := {
	"vuln_id": "V-248587",
	"stig_id": "OL08-00-010400",
	"severity": "CAT II",
	"rule_title": "OL 8 must implement certificate status checking for multifactor authentication.",
	"check_type": "machine+attestation",
	"status": status_ol08_00_010400,
	"detail": detail_ol08_00_010400,
	"fix_text": "Set certificate_verification = ocsp_dgst=sha512 in the [sssd] section of /etc/sssd/sssd.conf",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

cat_i_findings := [
	finding_ol08_00_010293,
	finding_ol08_00_010183,
]

cat_ii_findings := [
	finding_ol08_00_010090,
	finding_ol08_00_020050,
	finding_ol08_00_020090,
	finding_ol08_00_010400,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III).
# `cat_i_compliant`: the former CAT-I-only meaning, for gating on the critical subset.
default cat_i_compliant := false

open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "pki_crypto",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
