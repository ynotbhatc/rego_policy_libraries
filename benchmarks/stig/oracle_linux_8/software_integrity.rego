package stig.oracle_linux_8.software_integrity

# DISA STIG for Oracle Linux 8 - Software Integrity Module
# STIG Version: V2R10 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in ol8_rules.py (regenerate, don't hand-edit).
# Covers: GPG signing, package verification, AIDE, kernel module restrictions

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a whole number, or a string holding a decimal integer; undefined otherwise
# (a fraction such as 3.5 is not a value these settings can hold)
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

_ol8_str_val(v) := trim_space(v) if is_string(v)

_ol8_str_val(v) := format_int(v, 10) if {
	is_number(v)
	v == floor(v)
}

_ol8_fpr(s) := upper(replace(s, " ", "")) if is_string(s)

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# OL08-00-010371 | V-248575 | CAT I
# localpkg_gpgcheck as written in /etc/dnf/dnf.conf
missing_ol08_00_010371 := [concat(".", p) | some p in [["dnf_config", "localpkg_gpgcheck"]]; not _collected(p)]

default localpkg_gpgcheck := false

localpkg_gpgcheck if {
	count(missing_ol08_00_010371) == 0
	_truthy(input.dnf_config.localpkg_gpgcheck)
}

status_ol08_00_010371 := "Not_a_Finding" if localpkg_gpgcheck

else := "Open"

detail_ol08_00_010371 := "OL08-00-010371: Not_a_Finding" if localpkg_gpgcheck

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010371", concat(", ", missing_ol08_00_010371)]) if count(missing_ol08_00_010371) > 0

else := "OL08-00-010371: check failed — localpkg_gpgcheck in /etc/dnf/dnf.conf must be 1, True or yes"

finding_ol08_00_010371 := {
	"vuln_id": "V-248575",
	"stig_id": "OL08-00-010371",
	"severity": "CAT I",
	"rule_title": "OL 8 must prevent the installation of software, patches, service packs, device drivers, or operating system components of local packages without verification they have been digitally signed using a certificate that is issued by a Certificate Authority (CA) that is recognized and approved by the organization.",
	"check_type": "machine",
	"status": status_ol08_00_010371,
	"detail": detail_ol08_00_010371,
	"fix_text": "Set localpkg_gpgcheck=1 in /etc/dnf/dnf.conf",
}

# OL08-00-010370 | V-248574 | CAT I
# input.yum_repos[{name, gpgcheck}]; OL 8 accepts only "1"; the ask-the-SA clause is an attestation
missing_ol08_00_010370 := [concat(".", p) | some p in [["yum_repos"]]; not _collected(p)]

default all_repos_gpgcheck := false

all_repos_gpgcheck if {
	count(missing_ol08_00_010370) == 0
	repos := input.yum_repos
	is_array(repos)
	count(repos) > 0
	every r in repos {
		_ol8_str_val(object.get(r, "gpgcheck", null)) == "1"
	}
}

all_repos_gpgcheck if {
	_attested("ol08_00_010370_gpg_process")
}

status_ol08_00_010370 := "Not_a_Finding" if all_repos_gpgcheck

else := "Open"

detail_ol08_00_010370 := "OL08-00-010370: Not_a_Finding" if all_repos_gpgcheck

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010370", concat(", ", missing_ol08_00_010370)]) if count(missing_ol08_00_010370) > 0

else := "OL08-00-010370: check failed — every repository in /etc/yum.repos.d/*.repo must set gpgcheck=1, or the SA must show an approved certificate validation process (input.attest.ol08_00_010370_gpg_process)"

finding_ol08_00_010370 := {
	"vuln_id": "V-248574",
	"stig_id": "OL08-00-010370",
	"severity": "CAT I",
	"rule_title": "YUM must be configured to prevent the installation of patches, service packs, device drivers, or OL 8 system components that have not been digitally signed using a certificate that is recognized and approved by the organization.",
	"check_type": "machine+attestation",
	"status": status_ol08_00_010370,
	"detail": detail_ol08_00_010370,
	"fix_text": "Set gpgcheck=1 in every repository definition under /etc/yum.repos.d/",
}

# =============================================================================
# CAT II - MEDIUM SEVERITY
# =============================================================================

# OL08-00-030670 | V-248812 | CAT II
# rsyslog package installed
missing_ol08_00_030670 := [concat(".", p) | some p in [["packages", "rsyslog"]]; not _collected(p)]

default rsyslog_installed := false

rsyslog_installed if {
	count(missing_ol08_00_030670) == 0
	input.packages.rsyslog == true
}

rsyslog_installed if {
	_attested("ol08_00_030670_offload")
}

status_ol08_00_030670 := "Not_a_Finding" if rsyslog_installed

else := "Open"

detail_ol08_00_030670 := "OL08-00-030670: Not_a_Finding" if rsyslog_installed

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-030670", concat(", ", missing_ol08_00_030670)]) if count(missing_ol08_00_030670) > 0

else := "OL08-00-030670: check failed — the rsyslog package must be installed, or the SA must show how audit logs are offloaded (input.attest.ol08_00_030670_offload)"

finding_ol08_00_030670 := {
	"vuln_id": "V-248812",
	"stig_id": "OL08-00-030670",
	"severity": "CAT II",
	"rule_title": "OL 8 must have the packages required for offloading audit logs installed.",
	"check_type": "machine+attestation",
	"status": status_ol08_00_030670,
	"detail": detail_ol08_00_030670,
	"fix_text": "Install rsyslog: dnf install rsyslog",
}

# OL08-00-010372 | V-248576 | CAT II
# kernel.kexec_load_disabled must be 1; UEK R6+ with Secure Boot is Not Applicable (input.kernel_info.uek_release, input.secureboot_enabled)
missing_ol08_00_010372 := [concat(".", p) | some p in [["kernel_params", "kernel.kexec_load_disabled"]]; not _collected(p)]

default kexec_disabled := false

kexec_disabled if {
	count(missing_ol08_00_010372) == 0
	_str(["kernel_params", "kernel.kexec_load_disabled"]) == "1"
}

default na_ol08_00_010372 := false

na_ol08_00_010372 if {
	_num(["kernel_info", "uek_release"]) >= 6
	input.secureboot_enabled == true
}

status_ol08_00_010372 := "Not_a_Finding" if kexec_disabled

else := "Not_Applicable" if na_ol08_00_010372

else := "Open"

detail_ol08_00_010372 := "OL08-00-010372: Not_a_Finding" if kexec_disabled

else := "OL08-00-010372: Not_Applicable — the Unbreakable Enterprise Kernel release 6 or above runs with Secure Boot enabled" if na_ol08_00_010372

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010372", concat(", ", missing_ol08_00_010372)]) if count(missing_ol08_00_010372) > 0

else := "OL08-00-010372: check failed — kernel.kexec_load_disabled must be 1"

finding_ol08_00_010372 := {
	"vuln_id": "V-248576",
	"stig_id": "OL08-00-010372",
	"severity": "CAT II",
	"rule_title": "OL 8 must prevent the loading of a new kernel for later execution.",
	"check_type": "machine",
	"status": status_ol08_00_010372,
	"detail": detail_ol08_00_010372,
	"fix_text": "Set kernel.kexec_load_disabled = 1 in /etc/sysctl.d/ and run sysctl --system",
}

# OL08-00-010019 | V-256978 | CAT II
# rpm -q --queryformat "%{SUMMARY}" gpg-pubkey and gpg --with-fingerprint /etc/pki/rpm-gpg/RPM-GPG-KEY-oracle
missing_ol08_00_010019 := [concat(".", p) | some p in [["rpm_gpg_pubkeys"], ["oracle_release_key_file", "fingerprints"]]; not _collected(p)]

default oracle_gpg_key := false

oracle_gpg_key if {
	count(missing_ol08_00_010019) == 0
	"gpg(Oracle OSS group (Open Source Software group) <build@oss.oracle.com>)" in {trim_space(s) | some s in input.rpm_gpg_pubkeys; is_string(s)}
	fps := input.oracle_release_key_file.fingerprints
	is_array(fps)
	"76FD3DB13AB67410B89DB10E82562EA9AD986DA3" in {f | some x in fps; f := _ol8_fpr(x)}
}

status_ol08_00_010019 := "Not_a_Finding" if oracle_gpg_key

else := "Open"

detail_ol08_00_010019 := "OL08-00-010019: Not_a_Finding" if oracle_gpg_key

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010019", concat(", ", missing_ol08_00_010019)]) if count(missing_ol08_00_010019) > 0

else := "OL08-00-010019: check failed — the Oracle OSS group GPG key must be installed and /etc/pki/rpm-gpg/RPM-GPG-KEY-oracle must carry fingerprint 76FD3DB13AB67410B89DB10E82562EA9AD986DA3"

finding_ol08_00_010019 := {
	"vuln_id": "V-256978",
	"stig_id": "OL08-00-010019",
	"severity": "CAT II",
	"rule_title": "OL 8 must ensure cryptographic verification of vendor software packages.",
	"check_type": "machine",
	"status": status_ol08_00_010019,
	"detail": detail_ol08_00_010019,
	"fix_text": "Install the Oracle signing key: rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-oracle (verify the fingerprint first)",
}

# OL08-00-010561 | V-248615 | CAT II
# systemctl is-enabled rsyslog and systemctl is-active rsyslog
missing_ol08_00_010561 := [concat(".", p) | some p in [["services", "rsyslog"], ["unit_enabled", "rsyslog"]]; not _collected(p)]

default rsyslog_active := false

rsyslog_active if {
	count(missing_ol08_00_010561) == 0
	_kw(["services", "rsyslog"]) == "active"
	_kw(["unit_enabled", "rsyslog"]) == "enabled"
}

status_ol08_00_010561 := "Not_a_Finding" if rsyslog_active

else := "Open"

detail_ol08_00_010561 := "OL08-00-010561: Not_a_Finding" if rsyslog_active

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010561", concat(", ", missing_ol08_00_010561)]) if count(missing_ol08_00_010561) > 0

else := "OL08-00-010561: check failed — rsyslog must be enabled and active (systemctl is-enabled / is-active rsyslog)"

finding_ol08_00_010561 := {
	"vuln_id": "V-248615",
	"stig_id": "OL08-00-010561",
	"severity": "CAT II",
	"rule_title": "OL 8 must have the rsyslog service enabled and active.",
	"check_type": "machine",
	"status": status_ol08_00_010561,
	"detail": detail_ol08_00_010561,
	"fix_text": "systemctl enable --now rsyslog",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

cat_i_findings := [
	finding_ol08_00_010371,
	finding_ol08_00_010370,
]

cat_ii_findings := [
	finding_ol08_00_030670,
	finding_ol08_00_010372,
	finding_ol08_00_010019,
	finding_ol08_00_010561,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# Evidence gate: a module with none of its facts collected is unevaluated, not compliant.
evidence_present if {
	some key in {"services", "kernel_params"}
	object.get(input, key, null) != null
}

# `compliant`: no open finding at ANY category (CAT I, II or III) and evidence present.
# `cat_i_compliant`: the former CAT-I-only meaning, for gating on the critical subset.
default cat_i_compliant := false

open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	evidence_present
	count(open_all_findings) == 0
}

cat_i_compliant if {
	evidence_present
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "software_integrity",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
