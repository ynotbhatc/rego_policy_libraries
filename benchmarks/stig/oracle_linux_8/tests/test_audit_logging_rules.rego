test_every_finding_open_on_empty_input if {
	fs := data.stig.oracle_linux_8.audit_logging.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.oracle_linux_8.audit_logging.compliant with input as green_fixture
}

test_ol08_00_030181_pass if {
	data.stig.oracle_linux_8.audit_logging.status_ol08_00_030181 == "Not_a_Finding" with input as green_fixture
}

test_ol08_00_030181_fail_1 if {
	f := data.stig.oracle_linux_8.audit_logging.finding_ol08_00_030181 with input as object.union(green_fixture, {"services": {"auditd": "inactive"}})
	f.status == "Open"
	contains(f.detail, "OL08-00-030181: check failed")
}

