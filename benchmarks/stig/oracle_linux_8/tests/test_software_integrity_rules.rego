package stig.oracle_linux_8.software_integrity_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"dnf_config": {"localpkg_gpgcheck": "1"},
	"kernel_params": {"kernel.kexec_load_disabled": "1"},
	"oracle_release_key_file": {"fingerprints": ["76FD 3DB1 3AB6 7410 B89D  B10E 8256 2EA9 AD98 6DA3"]},
	"packages": {"rsyslog": true},
	"rpm_gpg_pubkeys": ["gpg(Oracle OSS group (Open Source Software group) <build@oss.oracle.com>)"],
	"services": {"rsyslog": "active"},
	"unit_enabled": {"rsyslog": "enabled"},
	"yum_repos": [
		{
			"gpgcheck": "1",
			"name": "ol8_baseos_latest",
		},
		{
			"gpgcheck": 1,
			"name": "ol8_appstream",
		},
	],
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.oracle_linux_8.software_integrity.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.oracle_linux_8.software_integrity.compliant with input as green_fixture
}

test_ol08_00_010371_pass if {
	data.stig.oracle_linux_8.software_integrity.status_ol08_00_010371 == "Not_a_Finding" with input as green_fixture
}

test_ol08_00_010371_fail_1 if {
	f := data.stig.oracle_linux_8.software_integrity.finding_ol08_00_010371 with input as object.union(green_fixture, {"dnf_config": {"localpkg_gpgcheck": "0"}})
	f.status == "Open"
	contains(f.detail, "OL08-00-010371: check failed")
}

test_ol08_00_010371_fail_2 if {
	f := data.stig.oracle_linux_8.software_integrity.finding_ol08_00_010371 with input as object.union(green_fixture, {"dnf_config": {"localpkg_gpgcheck": "False"}})
	f.status == "Open"
	contains(f.detail, "OL08-00-010371: check failed")
}

test_ol08_00_010371_evidence_missing_1 if {
	f := data.stig.oracle_linux_8.software_integrity.finding_ol08_00_010371 with input as json.remove(green_fixture, [["dnf_config", "localpkg_gpgcheck"]])
	f.status == "Open"
	contains(f.detail, "OL08-00-010371: evidence missing — dnf_config.localpkg_gpgcheck")
}

