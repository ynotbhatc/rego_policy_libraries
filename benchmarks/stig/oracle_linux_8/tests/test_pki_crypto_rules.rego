package stig.oracle_linux_8.pki_crypto_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"crypto_policy_check": {"is_applied": "The configured policy is applied"},
	"dconf_db": {"removal_action": ["'lock-screen'"]},
	"openssl_cnf": {"lines": [
		"[ crypto_policy ]",
		".include = /etc/crypto-policies/back-ends/opensslcnf.config",
	]},
	"sssd": {"certificate_verification": "ocsp_dgst=sha1"},
	"sssd_ca_db": {"certificates": [{
		"issuer_rdns": [
			[
				"C",
				"US",
			],
			[
				"O",
				"U.S. Government",
			],
			[
				"OU",
				"DoD",
			],
			[
				"OU",
				"PKI",
			],
			[
				"CN",
				"DoD Root CA 3",
			],
		],
		"not_after": "2099-12-30T18:46:41Z",
		"not_before": "2012-03-20T18:46:41Z",
		"subject_rdns": [
			[
				"C",
				"US",
			],
			[
				"O",
				"U.S. Government",
			],
			[
				"OU",
				"DoD",
			],
			[
				"OU",
				"PKI",
			],
			[
				"CN",
				"DoD Root CA 3",
			],
		],
	}]},
	"sssd_conf_file": {"certmap_rules": [{
		"domains": "testing.test",
		"maprule": "(userCertificate;binary={cert!bin})",
		"matchrule": "<SAN>.*EDIPI@mil",
		"section": "certmap/testing.test/rule_name",
	}]},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.oracle_linux_8.pki_crypto.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.oracle_linux_8.pki_crypto.compliant with input as green_fixture
}

test_ol08_00_010293_pass if {
	data.stig.oracle_linux_8.pki_crypto.status_ol08_00_010293 == "Not_a_Finding" with input as green_fixture
}

test_ol08_00_010293_fail_1 if {
	f := data.stig.oracle_linux_8.pki_crypto.finding_ol08_00_010293 with input as object.union(green_fixture, {"openssl_cnf": {"lines": ["# .include = /etc/crypto-policies/back-ends/opensslcnf.config"]}})
	f.status == "Open"
	contains(f.detail, "OL08-00-010293: check failed")
}

test_ol08_00_010293_fail_2 if {
	f := data.stig.oracle_linux_8.pki_crypto.finding_ol08_00_010293 with input as object.union(green_fixture, {"openssl_cnf": {"lines": [".include = /etc/pki/tls/other.cnf"]}})
	f.status == "Open"
	contains(f.detail, "OL08-00-010293: check failed")
}

test_ol08_00_010293_evidence_missing_1 if {
	f := data.stig.oracle_linux_8.pki_crypto.finding_ol08_00_010293 with input as json.remove(green_fixture, [["openssl_cnf", "lines"]])
	f.status == "Open"
	contains(f.detail, "OL08-00-010293: evidence missing — openssl_cnf.lines")
}

