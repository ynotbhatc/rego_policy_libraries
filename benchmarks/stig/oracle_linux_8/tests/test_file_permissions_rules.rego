}

test_every_finding_open_on_empty_input if {
	fs := data.stig.oracle_linux_8.file_permissions.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.oracle_linux_8.file_permissions.compliant with input as green_fixture
}

test_ol08_00_010780_pass if {
	data.stig.oracle_linux_8.file_permissions.status_ol08_00_010780 == "Not_a_Finding" with input as green_fixture
}

test_ol08_00_010780_fail_1 if {
	f := data.stig.oracle_linux_8.file_permissions.finding_ol08_00_010780 with input as object.union(green_fixture, {"file_permissions": {"unowned_files": ["/srv/x"]}})
	f.status == "Open"
	contains(f.detail, "OL08-00-010780: check failed")
}

test_ol08_00_010780_evidence_missing_1 if {
	f := data.stig.oracle_linux_8.file_permissions.finding_ol08_00_010780 with input as json.remove(green_fixture, [["file_permissions", "unowned_files"]])
	f.status == "Open"
	contains(f.detail, "OL08-00-010780: evidence missing — file_permissions.unowned_files")
}

