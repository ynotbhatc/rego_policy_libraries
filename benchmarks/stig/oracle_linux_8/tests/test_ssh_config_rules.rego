	f := data.stig.oracle_linux_8.ssh_config.finding_ol08_00_010291 with input as object.union(green_fixture, {"opensshserver_config": {"Ciphers": ""}})
	f.status == "Open"
	contains(f.detail, "OL08-00-010291: check failed")
}

test_ol08_00_010291_evidence_missing_1 if {
	f := data.stig.oracle_linux_8.ssh_config.finding_ol08_00_010291 with input as json.remove(green_fixture, [["opensshserver_config", "Ciphers"]])
