package stig.oracle_linux_8.ssh_config_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"opensshserver_config": {
		"Ciphers": "aes256-gcm@openssh.com,aes256-ctr,aes128-gcm@openssh.com,aes128-ctr",
		"MACs": "hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com,hmac-sha2-256,hmac-sha2-512",
	},
	"services": {
		"sshd": "active",
	},
	"sshd_config_lines": {
		"ClientAliveCountMax": [
			"1",
		],
		"ClientAliveInterval": [
			"600",
		],
		"IgnoreUserKnownHosts": [
			"yes",
		],
		"PermitEmptyPasswords": [
			"no",
		],
		"PermitRootLogin": [
			"no",
		],
		"PrintLastLog": [
			"yes",
		],
		"StrictModes": [
			"yes",
		],
		"X11Forwarding": [
			"no",
		],
	},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.oracle_linux_8.ssh_config.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.oracle_linux_8.ssh_config.compliant with input as green_fixture
}

test_ol08_00_010291_pass if {
	data.stig.oracle_linux_8.ssh_config.status_ol08_00_010291 == "Not_a_Finding" with input as green_fixture
}

test_ol08_00_010291_fail_1 if {
	f := data.stig.oracle_linux_8.ssh_config.finding_ol08_00_010291 with input as object.union(green_fixture, {"opensshserver_config": {"Ciphers": "aes256-gcm@openssh.com,aes256-ctr,aes128-gcm@openssh.com,aes128-ctr,aes192-ctr"}})
	f.status == "Open"
	contains(f.detail, "OL08-00-010291: check failed")
}

