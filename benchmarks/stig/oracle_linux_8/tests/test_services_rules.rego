	f.status == "Open"
	contains(f.detail, "OL08-00-040070: check failed")
}

test_ol08_00_040070_fail_2 if {
	f := data.stig.oracle_linux_8.services.finding_ol08_00_040070 with input as object.union(green_fixture, {"unit_enabled": {"autofs": "static"}})
	f.status == "Open"
	contains(f.detail, "OL08-00-040070: check failed")
}

test_ol08_00_040070_evidence_missing_1 if {
	f := data.stig.oracle_linux_8.services.finding_ol08_00_040070 with input as json.remove(green_fixture, [["unit_enabled", "autofs"]])
	f.status == "Open"
	contains(f.detail, "OL08-00-040070: evidence missing — unit_enabled.autofs")
}

test_ol08_00_040070_not_applicable_1 if {
	f := data.stig.oracle_linux_8.services.finding_ol08_00_040070 with input as object.union(green_fixture, {"unit_enabled": {"autofs": null}, "packages": {"autofs": false}})
	f.status == "Not_Applicable"
}

test_ol08_00_040070_pass_2 if {
	data.stig.oracle_linux_8.services.status_ol08_00_040070 == "Not_a_Finding" with input as object.union(green_fixture, {"unit_enabled": {"autofs": "disabled"}})
}

test_ol08_00_040070_pass_3 if {
	data.stig.oracle_linux_8.services.status_ol08_00_040070 == "Not_a_Finding" with input as object.union(green_fixture, {"unit_enabled": {"autofs": "not-found"}})
}

test_ol08_00_040350_pass if {
	data.stig.oracle_linux_8.services.status_ol08_00_040350 == "Not_a_Finding" with input as object.union(green_fixture, {"packages": {"tftp-server": true}, "tftp": {"execstart": "/usr/sbin/in.tftpd -s /var/lib/tftpboot"}})
}

test_ol08_00_040350_fail_1 if {
	f := data.stig.oracle_linux_8.services.finding_ol08_00_040350 with input as object.union(object.union(green_fixture, {"packages": {"tftp-server": true}, "tftp": {"execstart": "/usr/sbin/in.tftpd -s /var/lib/tftpboot"}}), {"tftp": {"execstart": "/usr/sbin/in.tftpd /var/lib/tftpboot"}})
	f.status == "Open"
	contains(f.detail, "OL08-00-040350: check failed")
}

