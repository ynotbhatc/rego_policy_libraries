package stig.oracle_linux_8.services_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"ftpd_packages": [],
	"packages": {
		"sendmail": false,
		"telnet-server": false,
		"tftp-server": false,
	},
	"unit_enabled": {"autofs": "masked"},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.oracle_linux_8.services.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.oracle_linux_8.services.compliant with input as green_fixture
}

test_ol08_00_040000_pass if {
	data.stig.oracle_linux_8.services.status_ol08_00_040000 == "Not_a_Finding" with input as green_fixture
}

test_ol08_00_040000_fail_1 if {
	f := data.stig.oracle_linux_8.services.finding_ol08_00_040000 with input as object.union(green_fixture, {"packages": {"telnet-server": true}})
	f.status == "Open"
	contains(f.detail, "OL08-00-040000: check failed")
}

test_ol08_00_040000_evidence_missing_1 if {
	f := data.stig.oracle_linux_8.services.finding_ol08_00_040000 with input as json.remove(green_fixture, [["packages", "telnet-server"]])
	f.status == "Open"
	contains(f.detail, "OL08-00-040000: evidence missing — packages.telnet-server")
}

test_ol08_00_040070_pass if {
	data.stig.oracle_linux_8.services.status_ol08_00_040070 == "Not_a_Finding" with input as green_fixture
}

test_ol08_00_040070_fail_1 if {
