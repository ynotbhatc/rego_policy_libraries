	f := data.stig.oracle_linux_8.services.finding_ol08_00_040350 with input as object.union(object.union(green_fixture, {"packages": {"tftp-server": true}, "tftp": {"execstart": "/usr/sbin/in.tftpd -s /var/lib/tftpboot"}}), {"tftp": {"execstart": null}})
	f.status == "Open"
	contains(f.detail, "OL08-00-040350: check failed")
}

test_ol08_00_040350_evidence_missing_1 if {
	f := data.stig.oracle_linux_8.services.finding_ol08_00_040350 with input as json.remove(object.union(green_fixture, {"packages": {"tftp-server": true}, "tftp": {"execstart": "/usr/sbin/in.tftpd -s /var/lib/tftpboot"}}), [["packages", "tftp-server"]])
