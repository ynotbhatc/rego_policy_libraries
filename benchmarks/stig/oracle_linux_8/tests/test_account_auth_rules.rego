package stig.oracle_linux_8.account_auth_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"duplicate_uid_accounts": [],
	"faillock_conf": {
		"deny": 3,
		"fail_interval": 900,
	},
	"local_accounts_with_empty_passwords": [],
	"login_defs": {"ENCRYPT_METHOD": "SHA512"},
	"password_policy": {
		"maxdays": 180,
		"mindays": 1,
	},
	"pwquality_values": {
		"dcredit": ["-1"],
		"lcredit": ["-1"],
		"minlen": ["15"],
		"ocredit": ["-1"],
		"ucredit": ["-1"],
	},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.oracle_linux_8.account_auth.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.oracle_linux_8.account_auth.compliant with input as green_fixture
}

test_ol08_00_010110_pass if {
	data.stig.oracle_linux_8.account_auth.status_ol08_00_010110 == "Not_a_Finding" with input as green_fixture
}

test_ol08_00_010110_fail_1 if {
	f := data.stig.oracle_linux_8.account_auth.finding_ol08_00_010110 with input as object.union(green_fixture, {"login_defs": {"ENCRYPT_METHOD": "MD5"}})
	f.status == "Open"
	contains(f.detail, "OL08-00-010110: check failed")
}

