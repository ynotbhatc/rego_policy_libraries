# OL08-00-010330 | V-248570 | CAT II
# output of find /lib /lib64 /usr/lib /usr/lib64 -type f -name '*.so*' -perm /022
missing_ol08_00_010330 := [concat(".", p) | some p in [["file_permissions", "library_files_group_or_world_writable"]]; not _collected(p)]

default lib_permissions_ok := false

lib_permissions_ok if {
	count(missing_ol08_00_010330) == 0
	xs := object.get(input, ["file_permissions", "library_files_group_or_world_writable"], null)
	is_array(xs)
	count(xs) == 0
}

status_ol08_00_010330 := "Not_a_Finding" if lib_permissions_ok

else := "Open"

detail_ol08_00_010330 := "OL08-00-010330: Not_a_Finding" if lib_permissions_ok

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010330", concat(", ", missing_ol08_00_010330)]) if count(missing_ol08_00_010330) > 0

else := "OL08-00-010330: check failed — no shared library file (*.so*) in /lib, /lib64, /usr/lib, /usr/lib64 may be group- or world-writable"

finding_ol08_00_010330 := {
	"vuln_id": "V-248570",
	"stig_id": "OL08-00-010330",
	"severity": "CAT II",
	"rule_title": "OL 8 library files must have mode 755 or less permissive.",
	"check_type": "machine",
	"status": status_ol08_00_010330,
	"detail": detail_ol08_00_010330,
	"fix_text": "chmod 755 each listed library file",
}

# OL08-00-010340 | V-248571 | CAT II
# output of find /lib /lib64 /usr/lib /usr/lib64 -type f -name '*.so*' ! -user root
missing_ol08_00_010340 := [concat(".", p) | some p in [["file_permissions", "library_files_not_owned_by_root"]]; not _collected(p)]

default lib_dirs_owned_root := false

lib_dirs_owned_root if {
	count(missing_ol08_00_010340) == 0
	xs := object.get(input, ["file_permissions", "library_files_not_owned_by_root"], null)
	is_array(xs)
	count(xs) == 0
}

status_ol08_00_010340 := "Not_a_Finding" if lib_dirs_owned_root

else := "Open"

detail_ol08_00_010340 := "OL08-00-010340: Not_a_Finding" if lib_dirs_owned_root

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010340", concat(", ", missing_ol08_00_010340)]) if count(missing_ol08_00_010340) > 0

else := "OL08-00-010340: check failed — every shared library file (*.so*) in /lib, /lib64, /usr/lib, /usr/lib64 must be owned by root"

finding_ol08_00_010340 := {
	"vuln_id": "V-248571",
	"stig_id": "OL08-00-010340",
	"severity": "CAT II",
	"rule_title": "OL 8 library files must be owned by root.",
	"check_type": "machine",
	"status": status_ol08_00_010340,
	"detail": detail_ol08_00_010340,
	"fix_text": "chown root each listed library file",
}

# OL08-00-010300 | V-248567 | CAT II
# the RHEL 9 offender list (find -perm /022 incl. /usr/libexec); OL 8 does not search /usr/libexec, so those entries are ignored
missing_ol08_00_010300 := [concat(".", p) | some p in [["file_permissions", "system_commands_group_or_world_writable"]]; not _collected(p)]

default sys_commands_permissions_ok := false

sys_commands_permissions_ok if {
	count(missing_ol08_00_010300) == 0
	xs := object.get(input, ["file_permissions", "system_commands_group_or_world_writable"], null)
	is_array(xs)
	count([x | some x in xs; not _in_libexec(x)]) == 0
}

status_ol08_00_010300 := "Not_a_Finding" if sys_commands_permissions_ok

else := "Open"

detail_ol08_00_010300 := "OL08-00-010300: Not_a_Finding" if sys_commands_permissions_ok

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010300", concat(", ", missing_ol08_00_010300)]) if count(missing_ol08_00_010300) > 0

else := "OL08-00-010300: check failed — no system command in /bin, /sbin, /usr/bin, /usr/sbin, /usr/local/bin, /usr/local/sbin may be group- or world-writable"

finding_ol08_00_010300 := {
	"vuln_id": "V-248567",
	"stig_id": "OL08-00-010300",
	"severity": "CAT II",
	"rule_title": "OL 8 system commands must have mode 755 or less permissive.",
	"check_type": "machine",
	"status": status_ol08_00_010300,
	"detail": detail_ol08_00_010300,
	"fix_text": "chmod go-w on each file the find command lists",
}

# OL08-00-010730 | V-248639 | CAT II
# input.file_permissions.home_dirs_uid_1000 [{path, mode}]: users with UID >= 1000 other than nobody (OL 8's awk; RHEL 9 excludes nologin shells instead)
missing_ol08_00_010730 := [concat(".", p) | some p in [["file_permissions", "home_dirs_uid_1000"]]; not _collected(p)]

default home_dir_permissions_ok := false

home_dir_permissions_ok if {
	count(missing_ol08_00_010730) == 0
	dirs := input.file_permissions.home_dirs_uid_1000
	is_array(dirs)
	every d in dirs {
		mode_within(d.mode, "0750")
	}
}

status_ol08_00_010730 := "Not_a_Finding" if home_dir_permissions_ok

else := "Open"

detail_ol08_00_010730 := "OL08-00-010730: Not_a_Finding" if home_dir_permissions_ok

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010730", concat(", ", missing_ol08_00_010730)]) if count(missing_ol08_00_010730) > 0

else := "OL08-00-010730: check failed — the home directory of every UID >= 1000 user except nobody must have mode 0750 or less permissive"

finding_ol08_00_010730 := {
	"vuln_id": "V-248639",
	"stig_id": "OL08-00-010730",
	"severity": "CAT II",
	"rule_title": "All OL 8 local interactive user home directories must have mode \"0750\" or less permissive.",
	"check_type": "machine",
	"status": status_ol08_00_010730,
	"detail": detail_ol08_00_010730,
	"fix_text": "chmod 0750 each listed home directory",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

# No CAT I rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_i_findings := array.concat([], [])

cat_ii_findings := [
	finding_ol08_00_010780,
	finding_ol08_00_010790,
	finding_ol08_00_010330,
	finding_ol08_00_010340,
	finding_ol08_00_010300,
	finding_ol08_00_010730,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# Evidence gate: a module with none of its facts collected is unevaluated, not compliant.
evidence_present if {
	object.get(input, "file_permissions", null) != null
}

# `compliant`: no open finding at ANY category (CAT I, II or III) and evidence present.
# `cat_i_compliant`: the former CAT-I-only meaning, for gating on the critical subset.
default cat_i_compliant := false

open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	evidence_present
	count(open_all_findings) == 0
}

cat_i_compliant if {
	evidence_present
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "file_permissions",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
