package stig.oracle_linux_8.file_permissions

# DISA STIG for Oracle Linux 8 - File Permissions Module
# STIG Version: V2R10 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in ol8_rules.py (regenerate, don't hand-edit).
# Covers: World-writable files, SUID/SGID, system file ownership, /etc permissions

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a whole number, or a string holding a decimal integer; undefined otherwise
# (a fraction such as 3.5 is not a value these settings can hold)
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# Parse an octal permission string ("644", "0644", "0o644") to an integer; undefined if not octal.
octal(s) := n if {
	t := trim_prefix(lower(trim_space(sprintf("%v", [s]))), "0o")
	regex.match(`^[0-7]{1,4}$`, t)
	p := concat("", [substring("0000", 0, 4 - count(t)), t])
	ds := [to_number(substring(p, i, 1)) | some i in numbers.range(0, 3)]
	n := ((ds[0] * 512) + (ds[1] * 64)) + ((ds[2] * 8) + ds[3])
}

# true when mode grants nothing beyond max (both octal strings)
mode_within(mode, max) if bits.and(octal(mode), bits.and(bits.negate(octal(max)), 4095)) == 0

# an offender under /usr/libexec (a path, or an ls -l line ending in one)
_in_libexec(x) if {
	is_string(x)
	regex.match(`(^|\s)/usr/libexec/`, x)
}

# =============================================================================
# CAT II - MEDIUM SEVERITY
# =============================================================================

# OL08-00-010780 | V-248646 | CAT II
# files found by find <local mounts> -xdev -nouser
missing_ol08_00_010780 := [concat(".", p) | some p in [["file_permissions", "unowned_files"]]; not _collected(p)]

default no_unowned_files := false

no_unowned_files if {
	count(missing_ol08_00_010780) == 0
	xs := object.get(input, ["file_permissions", "unowned_files"], null)
	is_array(xs)
	count(xs) == 0
}

status_ol08_00_010780 := "Not_a_Finding" if no_unowned_files

else := "Open"

detail_ol08_00_010780 := "OL08-00-010780: Not_a_Finding" if no_unowned_files

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010780", concat(", ", missing_ol08_00_010780)]) if count(missing_ol08_00_010780) > 0

else := "OL08-00-010780: check failed — no local file or directory may lack a valid owner"

finding_ol08_00_010780 := {
	"vuln_id": "V-248646",
	"stig_id": "OL08-00-010780",
	"severity": "CAT II",
	"rule_title": "All OL 8 files and directories must have a valid owner.",
	"check_type": "machine",
	"status": status_ol08_00_010780,
	"detail": detail_ol08_00_010780,
	"fix_text": "Assign an owner to each listed file: chown <user> <file>",
}

