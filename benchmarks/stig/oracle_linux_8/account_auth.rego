package stig.oracle_linux_8.account_auth

# DISA STIG for Oracle Linux 8 - Account and Authentication Module
# STIG Version: V2R10 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in ol8_rules.py (regenerate, don't hand-edit).
# Covers: Password policy, PAM, account lockout, MFA, inactivity

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a whole number, or a string holding a decimal integer; undefined otherwise
# (a fraction such as 3.5 is not a value these settings can hold)
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# OL 8.0 or 8.1 (input.os_release.version_id, e.g. "8.1"): the faillock.conf checks do not apply
_ol8_before_8_2 if {
	v := _str(["os_release", "version_id"])
	m := regex.find_all_string_submatch_n(`^8\.([0-9]+)$`, v, 1)
	minor := to_number(m[0][1])
	minor < 2
}

# every value of an option in /etc/security/pwquality.conf and pwquality.conf.d/*.conf (input.pwquality_values[<opt>],
# one entry per uncommented line), as numbers; undefined unless every entry is a decimal integer
_pwq(opt) := ns if {
	vs := input.pwquality_values[opt]
	is_array(vs)
	ns := [n | some v in vs; n := _num_val(v)]
	count(ns) == count(vs)
}

_num_val(v) := v if {
	is_number(v)
	v == floor(v)
}

_num_val(v) := to_number(trim_space(v)) if {
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
}

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# OL08-00-010121 | V-252650 | CAT I
# accounts whose /etc/shadow password field is empty (awk -F: '!$2 {print $1}' /etc/shadow)
missing_ol08_00_010121 := [concat(".", p) | some p in [["local_accounts_with_empty_passwords"]]; not _collected(p)]

default no_empty_password_hashes := false

no_empty_password_hashes if {
	count(missing_ol08_00_010121) == 0
	accts := input.local_accounts_with_empty_passwords
	is_array(accts)
	count(accts) == 0
}

status_ol08_00_010121 := "Not_a_Finding" if no_empty_password_hashes

else := "Open"

detail_ol08_00_010121 := "OL08-00-010121: Not_a_Finding" if no_empty_password_hashes

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-010121", concat(", ", missing_ol08_00_010121)]) if count(missing_ol08_00_010121) > 0

else := "OL08-00-010121: check failed — no /etc/shadow entry may have an empty password field"

finding_ol08_00_010121 := {
	"vuln_id": "V-252650",
	"stig_id": "OL08-00-010121",
	"severity": "CAT I",
	"rule_title": "The OL 8 operating system must not have accounts configured with blank or null passwords.",
	"check_type": "machine",
	"status": status_ol08_00_010121,
	"detail": detail_ol08_00_010121,
	"fix_text": "Lock or set a password for each listed account: passwd -l <username>",
}

