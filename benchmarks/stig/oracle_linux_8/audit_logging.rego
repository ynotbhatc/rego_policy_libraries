else := "OL08-00-030171: check failed — a rule in /etc/audit/audit.rules must watch /etc/sudoers itself (not only /etc/sudoers.d/) for write and attribute change (perm wa)"

finding_ol08_00_030171 := {
	"vuln_id": "V-248745",
	"stig_id": "OL08-00-030171",
	"severity": "CAT II",
	"rule_title": "OL 8 must generate audit records for all account creations, modifications, disabling, and termination events that affect \"/etc/sudoers\".",
	"check_type": "machine",
	"status": status_ol08_00_030171,
	"detail": detail_ol08_00_030171,
	"fix_text": "Add an audit rule for /etc/sudoers to /etc/audit/rules.d/ and load it (augenrules --load)",
}

# OL08-00-030150 | V-248742 | CAT II
