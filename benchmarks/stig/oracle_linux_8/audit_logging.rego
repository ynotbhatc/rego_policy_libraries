disk_error_action_ok if {
	count(missing_ol08_00_030040) == 0
	_kw(["auditd_config", "disk_error_action"]) in {"syslog", "single", "halt"}
}

status_ol08_00_030040 := "Not_a_Finding" if disk_error_action_ok

