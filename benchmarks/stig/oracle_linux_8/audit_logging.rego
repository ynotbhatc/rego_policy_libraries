# CAT II - MEDIUM SEVERITY
# =============================================================================

# OL08-00-030181 | V-248520 | CAT II
# systemctl is-active auditd
missing_ol08_00_030181 := [concat(".", p) | some p in [["services", "auditd"]]; not _collected(p)]

default auditd_active := false

auditd_active if {
	count(missing_ol08_00_030181) == 0
	_kw(["services", "auditd"]) == "active"
}

status_ol08_00_030181 := "Not_a_Finding" if auditd_active

else := "Open"

detail_ol08_00_030181 := "OL08-00-030181: Not_a_Finding" if auditd_active

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-030181", concat(", ", missing_ol08_00_030181)]) if count(missing_ol08_00_030181) > 0

else := "OL08-00-030181: check failed — auditd.service must be active (running)"

finding_ol08_00_030181 := {
	"vuln_id": "V-248520",
	"stig_id": "OL08-00-030181",
	"severity": "CAT II",
	"rule_title": "OL 8 audit records must contain information to establish what type of events occurred, the source of events, where events occurred, and the outcome of events.",
	"check_type": "machine",
	"status": status_ol08_00_030181,
	"detail": detail_ol08_00_030181,
	"fix_text": "Enable and start auditd: systemctl enable --now auditd",
}

