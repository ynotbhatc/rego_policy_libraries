# OL08-00-040285 | V-248893 | CAT II
# runtime net.ipv4.conf.all.rp_filter (sysctl)
missing_ol08_00_040285 := [concat(".", p) | some p in [["kernel_params", "net.ipv4.conf.all.rp_filter"]]; not _collected(p)]

default rp_filter_enabled := false

rp_filter_enabled if {
	count(missing_ol08_00_040285) == 0
	_str(["kernel_params", "net.ipv4.conf.all.rp_filter"]) == "1"
}

status_ol08_00_040285 := "Not_a_Finding" if rp_filter_enabled

else := "Open"

detail_ol08_00_040285 := "OL08-00-040285: Not_a_Finding" if rp_filter_enabled

else := sprintf("%s: evidence missing — %s not collected", ["OL08-00-040285", concat(", ", missing_ol08_00_040285)]) if count(missing_ol08_00_040285) > 0

else := "OL08-00-040285: check failed — net.ipv4.conf.all.rp_filter must be 1"

finding_ol08_00_040285 := {
	"vuln_id": "V-248893",
	"stig_id": "OL08-00-040285",
	"severity": "CAT II",
	"rule_title": "OL 8 must use reverse path filtering on all IPv4 interfaces.",
	"check_type": "machine",
	"status": status_ol08_00_040285,
	"detail": detail_ol08_00_040285,
	"fix_text": "Set net.ipv4.conf.all.rp_filter = 1 in /etc/sysctl.d/ and run sysctl --system",
}

