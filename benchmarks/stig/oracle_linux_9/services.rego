# OL09-00-002426 | V-271764 | CAT II
# the tftp unit as systemd loads it (systemctl cat tftp | grep ExecStart); tftp-server not installed is Not Applicable
missing_ol09_00_002426 := [concat(".", p) | some p in [["packages", "tftp-server"]]; not _collected(p)]

default tftp_secure_mode := false

tftp_secure_mode if {
	count(missing_ol09_00_002426) == 0
	input.packages["tftp-server"] == true
	s := _str(["tftp", "unit_execstart"])
	regex.match(`(^|\s)-s(\s|$)`, s)
}

default na_ol09_00_002426 := false

na_ol09_00_002426 if {
	input.packages["tftp-server"] == false
}

status_ol09_00_002426 := "Not_a_Finding" if tftp_secure_mode

else := "Not_Applicable" if na_ol09_00_002426

else := "Open"

detail_ol09_00_002426 := "OL09-00-002426: Not_a_Finding" if tftp_secure_mode

else := "OL09-00-002426: Not_Applicable — tftp-server is not installed" if na_ol09_00_002426

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-002426", concat(", ", missing_ol09_00_002426)]) if count(missing_ol09_00_002426) > 0

else := "OL09-00-002426: check failed — tftp-server is installed: the ExecStart line of `systemctl cat tftp` (input.tftp.unit_execstart) must carry the -s option"

finding_ol09_00_002426 := {
	"vuln_id": "V-271764",
	"stig_id": "OL09-00-002426",
	"severity": "CAT II",
	"rule_title": "OL 9 Trivial File Transfer Protocol (TFTP) daemon must be configured to operate in secure mode if the TFTP server is required.",
	"check_type": "machine",
	"status": status_ol09_00_002426,
	"detail": detail_ol09_00_002426,
	"fix_text": "Add -s <directory> to the in.tftpd ExecStart line (systemctl edit tftp)",
}

