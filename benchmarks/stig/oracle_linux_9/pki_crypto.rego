package stig.oracle_linux_9.pki_crypto

# DISA STIG for Oracle Linux 9 - PKI and Cryptography Module
# STIG Version: V1R7 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in ol9_rules.py (regenerate, don't hand-edit).
# Covers: FIPS 140-3, PKI/CAC authentication, certificate management, crypto policies

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a number, or a string holding a decimal integer; undefined otherwise
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# a crypto back-end in /etc/crypto-policies/back-ends/: nss.config is a regular file; every other one is a
# symlink to its own file under /usr/share/crypto-policies/FIPS/ (bind.config -> FIPS/bind.txt)
_backend_ok(b) if {
	b.name == "nss.config"
	b.is_symlink == false
}

_backend_ok(b) if {
	is_string(b.name)
	b.name != "nss.config"
	b.is_symlink == true
	base := trim_suffix(b.name, ".config")
	b.target == concat("", ["/usr/share/crypto-policies/FIPS/", base, ".txt"])
}

# the comma-separated option list at path, each entry trimmed; undefined unless a string
_csv(path) := [trim_space(x) | some x in parts] if {
	s := _str(path)
	parts := split(s, ",")
}

# a DoD root CA from /etc/sssd/pki/sssd_auth_ca_db.pem, as the OL09-00-000900 check shows it: self-signed
# (Subject == Issuer), Issuer C = US, O = U.S. Government, OU = DoD (the check text prints DoW), OU = PKI,
# CN = DoD Root CA <n>, compared component by component; inside its validity dates.
# input.sssd_ca_db.certificates: [{issuer_rdns, subject_rdns, not_before, not_after}], RDNs as [type, value]
# pairs in certificate order, dates RFC 3339.
_dod_root_valid(c) if {
	rdns := c.issuer_rdns
	is_array(rdns)
	count(rdns) == 5
	rdns[0] == ["C", "US"]
	rdns[1] == ["O", "U.S. Government"]
	rdns[2] in {["OU", "DoD"], ["OU", "DoW"]}
	rdns[3] == ["OU", "PKI"]
	rdns[4][0] == "CN"
	is_string(rdns[4][1])
	regex.match(`^DoD Root CA [0-9]+$`, rdns[4][1])
	c.subject_rdns == rdns
	nb := time.parse_rfc3339_ns(c.not_before)
	na := time.parse_rfc3339_ns(c.not_after)
	now := time.now_ns()
	nb <= now
	now < na
}

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# OL09-00-002424 | V-288825 | CAT I
# the lines of /etc/pki/tls/openssl.cnf must include the crypto-policy opensslcnf.config back-end
missing_ol09_00_002424 := [concat(".", p) | some p in [["openssl_cnf", "lines"]]; not _collected(p)]

default openssl_system_policy := false

openssl_system_policy if {
	count(missing_ol09_00_002424) == 0
	lines := input.openssl_cnf.lines
	is_array(lines)
	some l in lines
	regex.match(`^\s*\.include\s*=?\s*/etc/crypto-policies/back-ends/opensslcnf\.config\s*$`, l)
}

status_ol09_00_002424 := "Not_a_Finding" if openssl_system_policy

else := "Open"

detail_ol09_00_002424 := "OL09-00-002424: Not_a_Finding" if openssl_system_policy

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-002424", concat(", ", missing_ol09_00_002424)]) if count(missing_ol09_00_002424) > 0

else := "OL09-00-002424: check failed — /etc/pki/tls/openssl.cnf must include /etc/crypto-policies/back-ends/opensslcnf.config (uncommented)"

finding_ol09_00_002424 := {
	"vuln_id": "V-288825",
	"stig_id": "OL09-00-002424",
	"severity": "CAT I",
	"rule_title": "OL9 must implement DoW-approved encryption in the OpenSSL package.",
	"check_type": "machine",
	"status": status_ol09_00_002424,
	"detail": detail_ol09_00_002424,
	"fix_text": "Add .include = /etc/crypto-policies/back-ends/opensslcnf.config to /etc/pki/tls/openssl.cnf",
}

# OL09-00-000242 | V-271479 | CAT I
# input.crypto_policy_check.pass_output: output of `update-crypto-policies --check && echo PASS`; input.crypto_backends[{name, is_symlink, target}] from ls -l /etc/crypto-policies/back-ends/
missing_ol09_00_000242 := [concat(".", p) | some p in [["crypto_policy_check", "pass_output"], ["crypto_backends"]]; not _collected(p)]

default crypto_policy_not_overridden := false

crypto_policy_not_overridden if {
	count(missing_ol09_00_000242) == 0
	out := _str(["crypto_policy_check", "pass_output"])
	raw := split(out, "\n")
	lines := [l | some x in raw; l := trim_space(x); l != ""]
	count(lines) > 0
	lines[count(lines) - 1] == "PASS"
	backends := input.crypto_backends
	is_array(backends)
	count(backends) > 0
	count([b | some b in backends; not _backend_ok(b)]) == 0
}

status_ol09_00_000242 := "Not_a_Finding" if crypto_policy_not_overridden

else := "Open"

detail_ol09_00_000242 := "OL09-00-000242: Not_a_Finding" if crypto_policy_not_overridden

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000242", concat(", ", missing_ol09_00_000242)]) if count(missing_ol09_00_000242) > 0

else := "OL09-00-000242: check failed — the last line of 'update-crypto-policies --check && echo PASS' must be PASS, and every back-end in /etc/crypto-policies/back-ends/ except nss.config (not a link) must link to its file under /usr/share/crypto-policies/FIPS/"

finding_ol09_00_000242 := {
	"vuln_id": "V-271479",
	"stig_id": "OL09-00-000242",
	"severity": "CAT I",
	"rule_title": "OL 9 must not allow the cryptographic policy to be overridden.",
	"check_type": "machine",
	"status": status_ol09_00_000242,
	"detail": detail_ol09_00_000242,
	"fix_text": "Remove the overrides and run update-crypto-policies --set FIPS, then reboot",
}

# =============================================================================
# CAT II - MEDIUM SEVERITY
# =============================================================================

# OL09-00-000930 | V-271608 | CAT II
# certificate_verification from the [sssd] section of sssd.conf / conf.d (uncommented)
missing_ol09_00_000930 := [concat(".", p) | some p in [["sssd", "certificate_verification"]]; not _collected(p)]

default cert_revocation_check := false

cert_revocation_check if {
	count(missing_ol09_00_000930) == 0
	opts := {o | some o in _csv(["sssd", "certificate_verification"])}
	"ocsp_dgst=sha512" in opts
	not "no_ocsp" in opts
	not "no_verification" in opts
}

cert_revocation_check if {
	_attested("ol09_00_000930_status_checking")
}

status_ol09_00_000930 := "Not_a_Finding" if cert_revocation_check

else := "Open"

detail_ol09_00_000930 := "OL09-00-000930: Not_a_Finding" if cert_revocation_check

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000930", concat(", ", missing_ol09_00_000930)]) if count(missing_ol09_00_000930) > 0

else := "OL09-00-000930: check failed — certificate_verification in the [sssd] section must carry the option ocsp_dgst=sha512 and neither no_ocsp nor no_verification, or the SA must show how certificate status checking is implemented (input.attest.ol09_00_000930_status_checking)"

finding_ol09_00_000930 := {
	"vuln_id": "V-271608",
	"stig_id": "OL09-00-000930",
	"severity": "CAT II",
	"rule_title": "OL 9 must implement certificate status checking for multifactor authentication (MFA).",
	"check_type": "machine+attestation",
	"status": status_ol09_00_000930,
	"detail": detail_ol09_00_000930,
	"fix_text": "Set certificate_verification = ocsp_dgst=sha512 in the [sssd] section of /etc/sssd/sssd.conf",
}

# OL09-00-000900 | V-271604 | CAT II
# certificates in /etc/sssd/pki/sssd_auth_ca_db.pem: issuer / subject RDNs and validity dates
missing_ol09_00_000900 := [concat(".", p) | some p in [["sssd_ca_db", "certificates"]]; not _collected(p)]

default dod_ca_trusted := false

dod_ca_trusted if {
	count(missing_ol09_00_000900) == 0
	certs := input.sssd_ca_db.certificates
	is_array(certs)
	some c in certs
	_dod_root_valid(c)
}

status_ol09_00_000900 := "Not_a_Finding" if dod_ca_trusted

else := "Open"

detail_ol09_00_000900 := "OL09-00-000900: Not_a_Finding" if dod_ca_trusted

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000900", concat(", ", missing_ol09_00_000900)]) if count(missing_ol09_00_000900) > 0

else := "OL09-00-000900: check failed — /etc/sssd/pki/sssd_auth_ca_db.pem must hold a self-signed DoD root CA (Issuer = Subject = C=US, O=U.S. Government, OU=DoD, OU=PKI, CN=DoD Root CA <n>) within its validity dates"

finding_ol09_00_000900 := {
	"vuln_id": "V-271604",
	"stig_id": "OL09-00-000900",
	"severity": "CAT II",
	"rule_title": "OL 9, for PKI-based authentication, must validate certificates by constructing a certification path (which includes status information) to an accepted trust anchor.",
	"check_type": "machine",
	"status": status_ol09_00_000900,
	"detail": detail_ol09_00_000900,
	"fix_text": "Install the DoD root CA bundle as /etc/sssd/pki/sssd_auth_ca_db.pem",
}

# OL09-00-000910 | V-271606 | CAT II
# input.sssd_conf_file.certmap_rules: [certmap/...] sections of /etc/sssd/sssd.conf (OL 9 reads that file only)
missing_ol09_00_000910 := [concat(".", p) | some p in [["sssd_conf_file", "certmap_rules"]]; not _collected(p)]

default cert_user_mapping := false

cert_user_mapping if {
	count(missing_ol09_00_000910) == 0
	rules := input.sssd_conf_file.certmap_rules
	is_array(rules)
	some r in rules
	is_string(r.maprule)
	trim_space(r.maprule) != ""
}

cert_user_mapping if {
	_attested("ol09_00_000910_certificate_mapping")
}

status_ol09_00_000910 := "Not_a_Finding" if cert_user_mapping

else := "Open"

detail_ol09_00_000910 := "OL09-00-000910: Not_a_Finding" if cert_user_mapping

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000910", concat(", ", missing_ol09_00_000910)]) if count(missing_ol09_00_000910) > 0

else := "OL09-00-000910: check failed — /etc/sssd/sssd.conf must have a [certmap/...] section with a maprule, or the SA must show how certificates are mapped to accounts (input.attest.ol09_00_000910_certificate_mapping)"

finding_ol09_00_000910 := {
	"vuln_id": "V-271606",
	"stig_id": "OL09-00-000910",
	"severity": "CAT II",
	"rule_title": "OL 9 must map the authenticated identity to the user or group account for PKI-based authentication.",
	"check_type": "machine+attestation",
	"status": status_ol09_00_000910,
	"detail": detail_ol09_00_000910,
	"fix_text": "Add a [certmap/<domain>/<rule>] section with matchrule and maprule to /etc/sssd/sssd.conf",
}

# OL09-00-002160 | V-271690 | CAT II
# input.dconf_db.removal_action: the values of the uncommented removal-action= lines found by grep -R removal-action /etc/dconf/db/* (OL 9 reads the dconf files; RHEL 9 reads gsettings)
missing_ol09_00_002160 := [concat(".", p) | some p in [["dconf_db", "removal_action"]]; not _collected(p)]

default smartcard_lock_on_removal := false

smartcard_lock_on_removal if {
	count(missing_ol09_00_002160) == 0
	vals := input.dconf_db.removal_action
	is_array(vals)
	some v in vals
	is_string(v)
	trim_space(v) == "'lock-screen'"
}

default na_ol09_00_002160 := false

na_ol09_00_002160 if {
	input.gui_installed == false
}

status_ol09_00_002160 := "Not_a_Finding" if smartcard_lock_on_removal

else := "Not_Applicable" if na_ol09_00_002160

else := "Open"

detail_ol09_00_002160 := "OL09-00-002160: Not_a_Finding" if smartcard_lock_on_removal

else := "OL09-00-002160: Not_Applicable — no graphical user interface is installed" if na_ol09_00_002160

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-002160", concat(", ", missing_ol09_00_002160)]) if count(missing_ol09_00_002160) > 0

else := "OL09-00-002160: check failed — an uncommented removal-action='lock-screen' must be set in the dconf database files (/etc/dconf/db/*)"

finding_ol09_00_002160 := {
	"vuln_id": "V-271690",
	"stig_id": "OL09-00-002160",
	"severity": "CAT II",
	"rule_title": "OL 9 must be able to directly initiate a session lock for all connection types using smart card when the smart card is removed.",
	"check_type": "machine",
	"status": status_ol09_00_002160,
	"detail": detail_ol09_00_002160,
	"fix_text": "Set removal-action='lock-screen' under [org/gnome/settings-daemon/peripherals/smartcard] in /etc/dconf/db/local.d/ and run dconf update",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

cat_i_findings := [
	finding_ol09_00_002424,
	finding_ol09_00_000242,
]

cat_ii_findings := [
	finding_ol09_00_000930,
	finding_ol09_00_000900,
	finding_ol09_00_000910,
	finding_ol09_00_002160,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III).
# `cat_i_compliant`: the former CAT-I-only meaning, for gating on the critical subset.
default cat_i_compliant := false

open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "pki_crypto",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
