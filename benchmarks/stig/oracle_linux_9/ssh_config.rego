package stig.oracle_linux_9.ssh_config

# DISA STIG for Oracle Linux 9 - SSH Configuration Module
# STIG Version: V1R7 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in ol9_rules.py (regenerate, don't hand-edit).
# Covers: SSH daemon hardening, key exchange, MACs, ciphers

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a number, or a string holding a decimal integer; undefined otherwise
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# DISA's lists for the opensshserver crypto-policy back-end (OL09-00-000254 / OL09-00-000255)
fips_ssh_ciphers := {"aes256-gcm@openssh.com", "aes256-ctr", "aes128-gcm@openssh.com", "aes128-ctr"}

fips_ssh_macs := {"hmac-sha2-256-etm@openssh.com", "hmac-sha2-512-etm@openssh.com", "hmac-sha2-256", "hmac-sha2-512"}

# the comma-separated list at path, each entry trimmed; undefined unless a string
_csv(path) := [trim_space(x) | some x in parts] if {
	s := _str(path)
	parts := split(s, ",")
}

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# OL09-00-000254 | V-271485 | CAT I
# Ciphers line of /etc/crypto-policies/back-ends/opensshserver.config (not sshd_config)
missing_ol09_00_000254 := [concat(".", p) | some p in [["opensshserver_config", "Ciphers"]]; not _collected(p)]

default ssh_fips_ciphers := false

ssh_fips_ciphers if {
	count(missing_ol09_00_000254) == 0
	vals := _csv(["opensshserver_config", "Ciphers"])
	count(vals) > 0
	every v in vals {
		v in fips_ssh_ciphers
	}
}

status_ol09_00_000254 := "Not_a_Finding" if ssh_fips_ciphers

else := "Open"

detail_ol09_00_000254 := "OL09-00-000254: Not_a_Finding" if ssh_fips_ciphers

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000254", concat(", ", missing_ol09_00_000254)]) if count(missing_ol09_00_000254) > 0

else := "OL09-00-000254: check failed — Ciphers in /etc/crypto-policies/back-ends/opensshserver.config must list only aes256-gcm@openssh.com,aes256-ctr,aes128-gcm@openssh.com,aes128-ctr"

finding_ol09_00_000254 := {
	"vuln_id": "V-271485",
	"stig_id": "OL09-00-000254",
	"severity": "CAT I",
	"rule_title": "OL 9 SSH server must be configured to use only ciphers employing FIPS 140-3 validated cryptographic hash algorithms to protect the confidentiality of SSH server connections.",
	"check_type": "machine",
	"status": status_ol09_00_000254,
	"detail": detail_ol09_00_000254,
	"fix_text": "Apply the FIPS crypto policy (update-crypto-policies --set FIPS) so opensshserver.config carries the DISA list",
}

