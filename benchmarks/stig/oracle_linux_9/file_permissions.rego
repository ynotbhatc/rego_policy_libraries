# OL09-00-002512 | V-271781 | CAT II
# files found by find <local mounts> -xdev -nouser
missing_ol09_00_002512 := [concat(".", p) | some p in [["file_permissions", "unowned_files"]]; not _collected(p)]

default no_unowned_files := false

no_unowned_files if {
	count(missing_ol09_00_002512) == 0
	xs := object.get(input, ["file_permissions", "unowned_files"], null)
	is_array(xs)
	count(xs) == 0
}

status_ol09_00_002512 := "Not_a_Finding" if no_unowned_files

else := "Open"

detail_ol09_00_002512 := "OL09-00-002512: Not_a_Finding" if no_unowned_files

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-002512", concat(", ", missing_ol09_00_002512)]) if count(missing_ol09_00_002512) > 0

else := "OL09-00-002512: check failed — no local file or directory may lack a valid owner"

finding_ol09_00_002512 := {
	"vuln_id": "V-271781",
	"stig_id": "OL09-00-002512",
	"severity": "CAT II",
	"rule_title": "OL 9 local files and directories must have a valid owner.",
	"check_type": "machine",
	"status": status_ol09_00_002512,
	"detail": detail_ol09_00_002512,
	"fix_text": "Assign an owner to each listed file: chown <user> <file>",
}

