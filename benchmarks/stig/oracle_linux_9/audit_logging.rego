	"fix_text": "Add the rules to /etc/audit/rules.d/audit.rules and load them (augenrules --load): -a always,exit -F arch=b64 -S setxattr,fsetxattr,lsetxattr,removexattr,fremovexattr,lremovexattr -F auid>=1000 -F auid!=-1 -F key=k",
}

# OL09-00-000525 | V-271532 | CAT II
# a loaded rule (auditctl -l) on exactly /etc/passwd: -w /etc/passwd or -F path=/etc/passwd
missing_ol09_00_000525 := [concat(".", p) | some p in [["audit_rules"]]; not _collected(p)]

default audit_passwd_file := false

audit_passwd_file if {
	count(missing_ol09_00_000525) == 0
	is_array(input.audit_rules)
	_path_audited("/etc/passwd", ["w", "a"])
}

status_ol09_00_000525 := "Not_a_Finding" if audit_passwd_file

else := "Open"

detail_ol09_00_000525 := "OL09-00-000525: Not_a_Finding" if audit_passwd_file

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000525", concat(", ", missing_ol09_00_000525)]) if count(missing_ol09_00_000525) > 0

else := "OL09-00-000525: check failed — a loaded audit rule must watch /etc/passwd for write and attribute change (perm wa)"

finding_ol09_00_000525 := {
	"vuln_id": "V-271532",
	"stig_id": "OL09-00-000525",
	"severity": "CAT II",
	"rule_title": "OL 9 must generate audit records for all account creations, modifications, disabling, and termination events that affect /etc/passwd.",
	"check_type": "machine",
	"status": status_ol09_00_000525,
	"detail": detail_ol09_00_000525,
	"fix_text": "Add an audit rule for /etc/passwd to /etc/audit/rules.d/ and load it (augenrules --load)",
}

