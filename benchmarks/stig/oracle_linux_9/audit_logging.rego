default auditd_active := false

auditd_active if {
	count(missing_ol09_00_000441) == 0
	_kw(["services", "auditd"]) == "active"
}

status_ol09_00_000441 := "Not_a_Finding" if auditd_active

else := "Open"

detail_ol09_00_000441 := "OL09-00-000441: Not_a_Finding" if auditd_active

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000441", concat(", ", missing_ol09_00_000441)]) if count(missing_ol09_00_000441) > 0

else := "OL09-00-000441: check failed — auditd.service must be active (running)"

finding_ol09_00_000441 := {
	"vuln_id": "V-271520",
	"stig_id": "OL09-00-000441",
	"severity": "CAT II",
	"rule_title": "OL 9 audit service must be enabled.",
	"check_type": "machine",
	"status": status_ol09_00_000441,
	"detail": detail_ol09_00_000441,
	"fix_text": "Enable and start auditd: systemctl enable --now auditd",
}

