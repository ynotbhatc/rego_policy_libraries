# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

cat_i_findings := [
	finding_ol09_00_002413,
	finding_ol09_00_000060,
	finding_ol09_00_000241,
	finding_ol09_00_000070,
]

cat_ii_findings := [
	finding_ol09_00_000090,
	finding_ol09_00_000047,
	finding_ol09_00_000301,
	finding_ol09_00_002407,
	finding_ol09_00_002070,
	finding_ol09_00_002071,
	finding_ol09_00_002072,
	finding_ol09_00_000065,
	finding_ol09_00_002423,
	finding_ol09_00_002406,
	finding_ol09_00_000004,
	finding_ol09_00_002107,
	finding_ol09_00_002409,
	finding_ol09_00_002430,
	finding_ol09_00_001115,
	finding_ol09_00_000256,
	finding_ol09_00_000042,
	finding_ol09_00_000300,
	finding_ol09_00_002410,
]

cat_iii_findings := [
	finding_ol09_00_000002,
	finding_ol09_00_000006,
]

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III).
# `cat_i_compliant`: the former CAT-I-only meaning, for gating on the critical subset.
default cat_i_compliant := false

open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "configuration_management",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
