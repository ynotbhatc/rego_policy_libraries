# OL09-00-000002 | V-271432 | CAT III
# the audit data path is the directory of auditd.conf log_file; it must be its own mount
missing_ol09_00_000002 := [concat(".", p) | some p in [["filesystem_mounts"], ["auditd_config", "log_file"]]; not _collected(p)]

default var_log_audit_separate := false

var_log_audit_separate if {
	count(missing_ol09_00_000002) == 0
	f := _str(["auditd_config", "log_file"])
	dir := regex.replace(f, `/[^/]*$`, "")
	_mount(dir)
}

status_ol09_00_000002 := "Not_a_Finding" if var_log_audit_separate

else := "Open"

detail_ol09_00_000002 := "OL09-00-000002: Not_a_Finding" if var_log_audit_separate

