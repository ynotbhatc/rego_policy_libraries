detail_ol09_00_002413 := "OL09-00-002413: Not_a_Finding" if ctrl_alt_del_disabled

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-002413", concat(", ", missing_ol09_00_002413)]) if count(missing_ol09_00_002413) > 0

else := "OL09-00-002413: check failed — ctrl-alt-del.target must be masked (systemctl status: Loaded: masked)"

finding_ol09_00_002413 := {
	"vuln_id": "V-271752",
	"stig_id": "OL09-00-002413",
	"severity": "CAT I",
	"rule_title": "OL 9 must be configured so that the x86 Ctrl-Alt-Delete key sequence is disabled.",
	"check_type": "machine",
	"status": status_ol09_00_002413,
	"detail": detail_ol09_00_002413,
	"fix_text": "Mask the target: systemctl disable --now ctrl-alt-del.target && systemctl mask ctrl-alt-del.target",
}

