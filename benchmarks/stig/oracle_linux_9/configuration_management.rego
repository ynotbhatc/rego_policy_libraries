# OL09-00-002423 | V-271761 | CAT II
# runtime value (sysctl) and every value configured in the sysctl.d / sysctl.conf files the check greps
missing_ol09_00_002423 := [concat(".", p) | some p in [["kernel_params", "kernel.randomize_va_space"], ["sysctl_config", "kernel.randomize_va_space"]]; not _collected(p)]

default aslr_enabled := false

aslr_enabled if {
	count(missing_ol09_00_002423) == 0
	_str(["kernel_params", "kernel.randomize_va_space"]) == "2"
	vals := input.sysctl_config["kernel.randomize_va_space"]
	is_array(vals)
	count(vals) > 0
	every v in vals {
		sprintf("%v", [v]) == "2"
	}
}

status_ol09_00_002423 := "Not_a_Finding" if aslr_enabled

else := "Open"

detail_ol09_00_002423 := "OL09-00-002423: Not_a_Finding" if aslr_enabled

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-002423", concat(", ", missing_ol09_00_002423)]) if count(missing_ol09_00_002423) > 0

else := "OL09-00-002423: check failed — kernel.randomize_va_space must be 2 at runtime and in every sysctl configuration file that sets it (none conflicting)"

finding_ol09_00_002423 := {
	"vuln_id": "V-271761",
	"stig_id": "OL09-00-002423",
	"severity": "CAT II",
	"rule_title": "OL 9 must implement address space layout randomization (ASLR) to protect its memory from unauthorized code execution.",
	"check_type": "machine",
	"status": status_ol09_00_002423,
	"detail": detail_ol09_00_002423,
	"fix_text": "Set kernel.randomize_va_space = 2 in /etc/sysctl.d/99-kernel_randomize_va_space.conf and run sysctl --system",
}

