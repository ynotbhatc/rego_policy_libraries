# OL09-00-000241 | V-271478 | CAT I
# systemwide crypto policy FIPS (subpolicies allowed, as OL 9's note says); CURRENT.pol hash list and min_rsa_size
missing_ol09_00_000241 := [concat(".", p) | some p in [["crypto_policy"], ["crypto_policy_state", "hash"], ["crypto_policy_state", "min_rsa_size"]]; not _collected(p)]

default crypto_policy_fips := false

crypto_policy_fips if {
	count(missing_ol09_00_000241) == 0
	_ol_fips_policy(_str(["crypto_policy"]))
	hashes := input.crypto_policy_state.hash
	is_array(hashes)
	every h in ol_fips_policy_hashes {
		h in hashes
	}
	count([h | some h in hashes; _ol_weak_hash(h)]) == 0
	_num(["crypto_policy_state", "min_rsa_size"]) >= 2048
}

status_ol09_00_000241 := "Not_a_Finding" if crypto_policy_fips

else := "Open"

