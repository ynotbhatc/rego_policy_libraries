else := "OL09-00-000002: check failed — the directory of auditd log_file (the audit data path) must be a separate mounted file system"

finding_ol09_00_000002 := {
	"vuln_id": "V-271432",
	"stig_id": "OL09-00-000002",
	"severity": "CAT III",
	"rule_title": "OL 9 must use a separate file system for the system audit data path.",
