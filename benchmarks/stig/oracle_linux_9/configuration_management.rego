finding_ol09_00_000241 := {
	"vuln_id": "V-271478",
	"stig_id": "OL09-00-000241",
	"severity": "CAT I",
	"rule_title": "OL 9 must implement a FIPS 140-3 compliant systemwide cryptographic policy.",
