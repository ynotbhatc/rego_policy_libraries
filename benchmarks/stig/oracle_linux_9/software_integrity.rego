#     as_of: v2.5.0
package stig.oracle_linux_9.software_integrity

# DISA STIG for Oracle Linux 9 - Software Integrity Module
# STIG Version: V1R7 | Released: 30 Sep 2026
# Generated by tools/stig_generators/gen_rhel9.py from the October 2026 SRG-STIG library XCCDF (2026-11-18): ids, severities
# and titles from the catalog, logic from the reviewed table in ol9_rules.py (regenerate, don't hand-edit).
# Covers: GPG signing, package verification, AIDE, kernel module restrictions

import rego.v1

default compliant := false

# =============================================================================
# SHARED HELPERS (tools/stig_generators/gen_rhel9.py)
# =============================================================================

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a whole number, or a string holding a decimal integer; undefined otherwise
# (a fraction such as 3.5 is not a value these settings can hold)
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# an AIDE rule line (uncommented selection / group definition) that uses sha512
_aide_sha512(l) if {
	is_string(l)
	parts := regex.split(`[=+ ]+`, trim_space(l))
	"sha512" in parts
}

# a setting value as a trimmed string (string as given, integer in decimal)
_str_val(v) := trim_space(v) if is_string(v)

_str_val(v) := format_int(v, 10) if {
	is_number(v)
	v == floor(v)
}

_ol_fpr(s) := upper(replace(s, " ", "")) if is_string(s)

# Oracle's OL 9 signing keys as the check's rpm -q and gpg output print them
oracle_key_fingerprints := {"3E6D826D3FBAB389C2F38E34BC4D06A08D8B756F", "982231759C7467065D0CE9B2A7DD07088B4EFBE6"}

_oracle_key_installed(label) if {
	some s in input.rpm_gpg_pubkeys
	is_string(s)
	trim_space(s) == concat("", ["Oracle Linux ", label, " <secalert_us@oracle.com> public key"])
}

# =============================================================================
# CAT I - HIGH SEVERITY
# =============================================================================

# OL09-00-000496 | V-271523 | CAT I
# OL 9 accepts only "1" (RHEL 9 also accepts true/yes); the ask-the-SA clause is an attestation
missing_ol09_00_000496 := [concat(".", p) | some p in [["dnf_config", "localpkg_gpgcheck"]]; not _collected(p)]

default localpkg_gpgcheck := false

localpkg_gpgcheck if {
	count(missing_ol09_00_000496) == 0
	_str(["dnf_config", "localpkg_gpgcheck"]) == "1"
}

localpkg_gpgcheck if {
	_attested("ol09_00_000496_gpg_process")
}

status_ol09_00_000496 := "Not_a_Finding" if localpkg_gpgcheck

else := "Open"

detail_ol09_00_000496 := "OL09-00-000496: Not_a_Finding" if localpkg_gpgcheck

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000496", concat(", ", missing_ol09_00_000496)]) if count(missing_ol09_00_000496) > 0

else := "OL09-00-000496: check failed — localpkg_gpgcheck in /etc/dnf/dnf.conf must be 1, or an approved GPG verification process must be attested (input.attest.ol09_00_000496_gpg_process)"

finding_ol09_00_000496 := {
	"vuln_id": "V-271523",
	"stig_id": "OL09-00-000496",
	"severity": "CAT I",
	"rule_title": "OL 9 must check the GPG signature of locally installed software packages before installation.",
	"check_type": "machine+attestation",
	"status": status_ol09_00_000496,
	"detail": detail_ol09_00_000496,
	"fix_text": "Set localpkg_gpgcheck=1 in /etc/dnf/dnf.conf",
}

# OL09-00-000497 | V-271524 | CAT I
# gpgcheck in /etc/dnf/dnf.conf (grep gpgcheck /etc/dnf/dnf.conf); only "1" passes; the SA clause is an attestation
missing_ol09_00_000497 := [concat(".", p) | some p in [["dnf_config", "gpgcheck"]]; not _collected(p)]

default dnf_gpgcheck := false

dnf_gpgcheck if {
	count(missing_ol09_00_000497) == 0
	_str(["dnf_config", "gpgcheck"]) == "1"
}

dnf_gpgcheck if {
	_attested("ol09_00_000497_gpg_process")
}

status_ol09_00_000497 := "Not_a_Finding" if dnf_gpgcheck

else := "Open"

detail_ol09_00_000497 := "OL09-00-000497: Not_a_Finding" if dnf_gpgcheck

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000497", concat(", ", missing_ol09_00_000497)]) if count(missing_ol09_00_000497) > 0

else := "OL09-00-000497: check failed — gpgcheck in /etc/dnf/dnf.conf must be 1, or an approved GPG verification process must be attested (input.attest.ol09_00_000497_gpg_process)"

finding_ol09_00_000497 := {
	"vuln_id": "V-271524",
	"stig_id": "OL09-00-000497",
	"severity": "CAT I",
	"rule_title": "OL 9 must check the GPG signature of software packages originating from external software repositories before installation.",
	"check_type": "machine+attestation",
	"status": status_ol09_00_000497,
	"detail": detail_ol09_00_000497,
	"fix_text": "Set gpgcheck=1 in /etc/dnf/dnf.conf",
}

# OL09-00-000498 | V-271525 | CAT I
# input.yum_repos[{name, gpgcheck}] from /etc/yum.repos.d/*.repo; OL 9: only "1", no SA clause
missing_ol09_00_000498 := [concat(".", p) | some p in [["yum_repos"]]; not _collected(p)]

default all_repos_gpgcheck := false

all_repos_gpgcheck if {
	count(missing_ol09_00_000498) == 0
	repos := input.yum_repos
	is_array(repos)
	count(repos) > 0
	every r in repos {
		_str_val(object.get(r, "gpgcheck", null)) == "1"
	}
}

status_ol09_00_000498 := "Not_a_Finding" if all_repos_gpgcheck

else := "Open"

detail_ol09_00_000498 := "OL09-00-000498: Not_a_Finding" if all_repos_gpgcheck

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000498", concat(", ", missing_ol09_00_000498)]) if count(missing_ol09_00_000498) > 0

else := "OL09-00-000498: check failed — every repository in /etc/yum.repos.d/*.repo must set gpgcheck = 1"

finding_ol09_00_000498 := {
	"vuln_id": "V-271525",
	"stig_id": "OL09-00-000498",
	"severity": "CAT I",
	"rule_title": "OL 9 must have GPG signature verification enabled for all software repositories.",
	"check_type": "machine",
	"status": status_ol09_00_000498,
	"detail": detail_ol09_00_000498,
	"fix_text": "Set gpgcheck=1 in every repository definition under /etc/yum.repos.d/",
}

# =============================================================================
# CAT II - MEDIUM SEVERITY
# =============================================================================

# OL09-00-002428 | V-271766 | CAT II
# runtime kernel.kexec_load_disabled (sysctl)
missing_ol09_00_002428 := [concat(".", p) | some p in [["kernel_params", "kernel.kexec_load_disabled"]]; not _collected(p)]

default kexec_disabled := false

kexec_disabled if {
	count(missing_ol09_00_002428) == 0
	_str(["kernel_params", "kernel.kexec_load_disabled"]) == "1"
}

status_ol09_00_002428 := "Not_a_Finding" if kexec_disabled

else := "Open"

detail_ol09_00_002428 := "OL09-00-002428: Not_a_Finding" if kexec_disabled

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-002428", concat(", ", missing_ol09_00_002428)]) if count(missing_ol09_00_002428) > 0

else := "OL09-00-002428: check failed — kernel.kexec_load_disabled must be 1"

finding_ol09_00_002428 := {
	"vuln_id": "V-271766",
	"stig_id": "OL09-00-002428",
	"severity": "CAT II",
	"rule_title": "OL 9 must prevent the loading of a new kernel for later execution.",
	"check_type": "machine",
	"status": status_ol09_00_002428,
	"detail": detail_ol09_00_002428,
	"fix_text": "Set kernel.kexec_load_disabled = 1 in /etc/sysctl.d/ and run sysctl --system",
}

# OL09-00-000351 | V-271509 | CAT II
# systemctl is-active rsyslog
missing_ol09_00_000351 := [concat(".", p) | some p in [["services", "rsyslog"]]; not _collected(p)]

default rsyslog_active := false

rsyslog_active if {
	count(missing_ol09_00_000351) == 0
	_kw(["services", "rsyslog"]) == "active"
}

status_ol09_00_000351 := "Not_a_Finding" if rsyslog_active

else := "Open"

detail_ol09_00_000351 := "OL09-00-000351: Not_a_Finding" if rsyslog_active

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000351", concat(", ", missing_ol09_00_000351)]) if count(missing_ol09_00_000351) > 0

else := "OL09-00-000351: check failed — rsyslog must be active (systemctl is-active rsyslog)"

finding_ol09_00_000351 := {
	"vuln_id": "V-271509",
	"stig_id": "OL09-00-000351",
	"severity": "CAT II",
	"rule_title": "OL 9 must be configured so that the rsyslog service is active.",
	"check_type": "machine",
	"status": status_ol09_00_000351,
	"detail": detail_ol09_00_000351,
	"fix_text": "Enable rsyslog: systemctl enable --now rsyslog",
}

# OL09-00-000302 | V-271498 | CAT II
# the uncommented rule / selection lines of /etc/aide.conf
missing_ol09_00_000302 := [concat(".", p) | some p in [["aide", "rule_lines"]]; not _collected(p)]

default aide_fips_hashes := false

aide_fips_hashes if {
	count(missing_ol09_00_000302) == 0
	lines := input.aide.rule_lines
	is_array(lines)
	count(lines) > 0
	every l in lines {
		_aide_sha512(l)
	}
}

aide_fips_hashes if {
	_attested("ol09_00_000302_other_tool")
}

status_ol09_00_000302 := "Not_a_Finding" if aide_fips_hashes

else := "Open"

detail_ol09_00_000302 := "OL09-00-000302: Not_a_Finding" if aide_fips_hashes

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000302", concat(", ", missing_ol09_00_000302)]) if count(missing_ol09_00_000302) > 0

else := "OL09-00-000302: check failed — every uncommented selection line in /etc/aide.conf must use sha512, or another tool using FIPS 140-3 hashes must be attested (input.attest.ol09_00_000302_other_tool)"

finding_ol09_00_000302 := {
	"vuln_id": "V-271498",
	"stig_id": "OL09-00-000302",
	"severity": "CAT II",
	"rule_title": "OL 9 must use a file integrity tool that is configured to use FIPS 140-3-approved cryptographic hashes for validating file contents and directories.",
	"check_type": "machine+attestation",
	"status": status_ol09_00_000302,
	"detail": detail_ol09_00_000302,
	"fix_text": "Add sha512 to every uncommented selection line in /etc/aide.conf",
}

# OL09-00-000350 | V-271508 | CAT II
# rsyslog package installed
missing_ol09_00_000350 := [concat(".", p) | some p in [["packages", "rsyslog"]]; not _collected(p)]

default rsyslog_installed := false

rsyslog_installed if {
	count(missing_ol09_00_000350) == 0
	input.packages.rsyslog == true
}

status_ol09_00_000350 := "Not_a_Finding" if rsyslog_installed

else := "Open"

detail_ol09_00_000350 := "OL09-00-000350: Not_a_Finding" if rsyslog_installed

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000350", concat(", ", missing_ol09_00_000350)]) if count(missing_ol09_00_000350) > 0

else := "OL09-00-000350: check failed — the rsyslog package must be installed"

finding_ol09_00_000350 := {
	"vuln_id": "V-271508",
	"stig_id": "OL09-00-000350",
	"severity": "CAT II",
	"rule_title": "OL 9 must have the rsyslog package installed.",
	"check_type": "machine",
	"status": status_ol09_00_000350,
	"detail": detail_ol09_00_000350,
	"fix_text": "Install rsyslog: dnf install rsyslog",
}

# OL09-00-000499 | V-271526 | CAT II
# input.rpm_gpg_pubkeys: rpm -q --queryformat "%{SUMMARY}" gpg-pubkey; input.oracle_release_key_file.fingerprints: gpg --with-fingerprint /etc/pki/rpm-gpg/RPM-GPG-KEY-oracle (absent file: not collected)
missing_ol09_00_000499 := [concat(".", p) | some p in [["rpm_gpg_pubkeys"], ["oracle_release_key_file", "fingerprints"]]; not _collected(p)]

default oracle_gpg_keys := false

oracle_gpg_keys if {
	count(missing_ol09_00_000499) == 0
	_oracle_key_installed("(release key 1)")
	_oracle_key_installed("(backup key 1)")
	fps := input.oracle_release_key_file.fingerprints
	is_array(fps)
	installed := {f | some x in fps; f := _ol_fpr(x)}
	every k in oracle_key_fingerprints {
		k in installed
	}
}

status_ol09_00_000499 := "Not_a_Finding" if oracle_gpg_keys

else := "Open"

detail_ol09_00_000499 := "OL09-00-000499: Not_a_Finding" if oracle_gpg_keys

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000499", concat(", ", missing_ol09_00_000499)]) if count(missing_ol09_00_000499) > 0

else := "OL09-00-000499: check failed — Oracle GPG keys 'release key 1' and 'backup key 1' must be installed and /etc/pki/rpm-gpg/RPM-GPG-KEY-oracle must carry fingerprints 3E6D826D3FBAB389C2F38E34BC4D06A08D8B756F and 982231759C7467065D0CE9B2A7DD07088B4EFBE6"

finding_ol09_00_000499 := {
	"vuln_id": "V-271526",
	"stig_id": "OL09-00-000499",
	"severity": "CAT II",
	"rule_title": "OL 9 must ensure cryptographic verification of vendor software packages.",
	"check_type": "machine",
	"status": status_ol09_00_000499,
	"detail": detail_ol09_00_000499,
	"fix_text": "Install the Oracle signing keys: rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-oracle (verify the fingerprints first)",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

cat_i_findings := [
	finding_ol09_00_000496,
	finding_ol09_00_000497,
	finding_ol09_00_000498,
]

cat_ii_findings := [
	finding_ol09_00_002428,
	finding_ol09_00_000351,
	finding_ol09_00_000302,
	finding_ol09_00_000350,
	finding_ol09_00_000499,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III).
# `cat_i_compliant`: the former CAT-I-only meaning, for gating on the critical subset.
default cat_i_compliant := false

open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "software_integrity",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
