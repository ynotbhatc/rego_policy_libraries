	"check_type": "machine",
	"status": status_ol09_00_001130,
	"detail": detail_ol09_00_001130,
	"fix_text": "Lock or set a password for each listed account: passwd -l <username>",
}

# OL09-00-002416 | V-271754 | CAT II
# fail_interval as configured in /etc/security/faillock.conf
missing_ol09_00_002416 := [concat(".", p) | some p in [["faillock_conf", "fail_interval"]]; not _collected(p)]

invalid_ol09_00_002416 := [m | some p in [["faillock_conf", "fail_interval"]]; m := _not_a_number(concat(".", p), object.get(input, p, null))]

default lockout_duration_ok := false

lockout_duration_ok if {
	count(missing_ol09_00_002416) == 0
	n := _num(["faillock_conf", "fail_interval"])
	is_number(n)
	n >= 1
	is_number(n)
	n <= 900
}

status_ol09_00_002416 := "Not_a_Finding" if lockout_duration_ok

else := "Open"

detail_ol09_00_002416 := "OL09-00-002416: Not_a_Finding" if lockout_duration_ok

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-002416", concat(", ", missing_ol09_00_002416)]) if count(missing_ol09_00_002416) > 0

else := sprintf("%s: evidence invalid — %s", ["OL09-00-002416", concat(", ", invalid_ol09_00_002416)]) if count(invalid_ol09_00_002416) > 0

else := "OL09-00-002416: check failed — fail_interval in /etc/security/faillock.conf must be 900 or less (not 0)"

finding_ol09_00_002416 := {
	"vuln_id": "V-271754",
	"stig_id": "OL09-00-002416",
	"severity": "CAT II",
	"rule_title": "OL 9 must automatically lock an account when three unsuccessful logon attempts occur during a 15-minute time period.",
	"check_type": "machine",
	"status": status_ol09_00_002416,
	"detail": detail_ol09_00_002416,
	"fix_text": "Set fail_interval = 900 in /etc/security/faillock.conf",
}

# OL09-00-000925 | V-271607 | CAT II
# pam_cert_auth as written in /etc/sssd/sssd.conf itself (OL 9 greps that file only; RHEL 9 also reads conf.d)
missing_ol09_00_000925 := [concat(".", p) | some p in [["sssd_conf_file", "pam_cert_auth"]]; not _collected(p)]

default mfa_enabled := false

mfa_enabled if {
	count(missing_ol09_00_000925) == 0
	_kw(["sssd_conf_file", "pam_cert_auth"]) == "true"
}

status_ol09_00_000925 := "Not_a_Finding" if mfa_enabled

else := "Open"

detail_ol09_00_000925 := "OL09-00-000925: Not_a_Finding" if mfa_enabled

else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-000925", concat(", ", missing_ol09_00_000925)]) if count(missing_ol09_00_000925) > 0

else := "OL09-00-000925: check failed — pam_cert_auth = True must be set (uncommented) in /etc/sssd/sssd.conf"

finding_ol09_00_000925 := {
	"vuln_id": "V-271607",
	"stig_id": "OL09-00-000925",
	"severity": "CAT II",
	"rule_title": "OL 9 must enable certificate-based smart card authentication.",
	"check_type": "machine",
	"status": status_ol09_00_000925,
	"detail": detail_ol09_00_000925,
	"fix_text": "Set pam_cert_auth = True in the [pam] section of /etc/sssd/sssd.conf and restart sssd",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

# No CAT I rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_i_findings := array.concat([], [])

cat_ii_findings := [
	finding_ol09_00_003020,
	finding_ol09_00_001105,
	finding_ol09_00_001015,
	finding_ol09_00_001020,
	finding_ol09_00_001120,
	finding_ol09_00_001095,
	finding_ol09_00_003065,
	finding_ol09_00_003001,
	finding_ol09_00_003006,
	finding_ol09_00_001055,
	finding_ol09_00_001005,
	finding_ol09_00_001085,
	finding_ol09_00_001130,
	finding_ol09_00_002416,
	finding_ol09_00_000925,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III).
# `cat_i_compliant`: the former CAT-I-only meaning, for gating on the critical subset.
default cat_i_compliant := false

open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "account_auth",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
