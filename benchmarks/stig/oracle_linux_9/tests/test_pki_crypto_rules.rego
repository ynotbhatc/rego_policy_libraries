test_every_finding_open_on_empty_input if {
	fs := data.stig.oracle_linux_9.pki_crypto.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.oracle_linux_9.pki_crypto.compliant with input as green_fixture
}

