package stig.oracle_linux_9.software_integrity_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"aide": {"rule_lines": ["All=p+i+n+u+g+s+m+S+sha512+acl+xattrs+selinux"]},
	"dnf_config": {
		"gpgcheck": "1",
		"localpkg_gpgcheck": "1",
	},
	"kernel_params": {"kernel.kexec_load_disabled": "1"},
	"oracle_release_key_file": {"fingerprints": [
		"3E6D 826D 3FBA B389 C2F3  8E34 BC4D 06A0 8D8B 756F",
		"9822 3175 9C74 6706 5D0C  E9B2 A7DD 0708 8B4E FBE6",
	]},
	"packages": {"rsyslog": true},
	"rpm_gpg_pubkeys": [
		"Oracle Linux (release key 1) <secalert_us@oracle.com> public key",
		"Oracle Linux (backup key 1) <secalert_us@oracle.com> public key",
	],
	"services": {"rsyslog": "active"},
	"yum_repos": [
		{
			"gpgcheck": "1",
			"name": "ol9_baseos_latest",
		},
		{
			"gpgcheck": 1,
			"name": "ol9_appstream",
		},
	],
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.oracle_linux_9.software_integrity.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.oracle_linux_9.software_integrity.compliant with input as green_fixture
}

test_ol09_00_002428_pass if {
	data.stig.oracle_linux_9.software_integrity.status_ol09_00_002428 == "Not_a_Finding" with input as green_fixture
}

test_ol09_00_002428_fail_1 if {
	f := data.stig.oracle_linux_9.software_integrity.finding_ol09_00_002428 with input as object.union(green_fixture, {"kernel_params": {"kernel.kexec_load_disabled": "0"}})
	f.status == "Open"
	contains(f.detail, "OL09-00-002428: check failed")
}

test_ol09_00_002428_evidence_missing_1 if {
	f := data.stig.oracle_linux_9.software_integrity.finding_ol09_00_002428 with input as json.remove(green_fixture, [["kernel_params", "kernel.kexec_load_disabled"]])
	f.status == "Open"
	contains(f.detail, "OL09-00-002428: evidence missing — kernel_params.kernel.kexec_load_disabled")
}

test_ol09_00_002428_pass_2 if {
	data.stig.oracle_linux_9.software_integrity.status_ol09_00_002428 == "Not_a_Finding" with input as object.union(green_fixture, {"kernel_params": {"kernel.kexec_load_disabled": 1}})
}

