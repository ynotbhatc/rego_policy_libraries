package stig.oracle_linux_9.account_auth_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"duplicate_gids": [],
	"duplicate_uid_accounts": [],
	"faillock_conf": {
		"deny": 3,
		"fail_interval": 900,
	},
	"local_accounts_with_empty_passwords": [],
	"login_defs": {
		"ENCRYPT_METHOD": "SHA512",
	},
	"password_policy": {
		"dcredit": -1,
		"inactive_days": 35,
		"lcredit": -1,
		"maxdays": 180,
		"mindays": 1,
		"minlen": 15,
		"ocredit": -1,
		"ucredit": -1,
	},
	"sssd_conf_file": {
		"pam_cert_auth": "True",
	},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.oracle_linux_9.account_auth.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.oracle_linux_9.account_auth.compliant with input as green_fixture
}

