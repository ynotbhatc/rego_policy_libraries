	f := data.stig.oracle_linux_9.audit_logging.finding_ol09_00_000441 with input as object.union(green_fixture, {"services": {"auditd": "failed"}})
	f.status == "Open"
	contains(f.detail, "OL09-00-000441: check failed")
}

