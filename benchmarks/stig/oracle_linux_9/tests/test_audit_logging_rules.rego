package stig.oracle_linux_9.audit_logging_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"audit_rules": [
		"-a always,exit -F arch=b32 -S execve -C uid!=euid -F euid=0 -k k",
		"-a always,exit -F arch=b32 -S execve -C gid!=egid -F egid=0 -k k",
		"-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -k k",
		"-a always,exit -F arch=b64 -S execve -C gid!=egid -F egid=0 -k k",
		"-a always,exit -F arch=b32 -S chown,fchown,fchownat,lchown -F auid>=1000 -F auid!=unset -k k",
		"-a always,exit -F arch=b64 -S chown,fchown,fchownat,lchown -F auid>=1000 -F auid!=unset -k k",
		"-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k k",
		"-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k k",
		"-a always,exit -F arch=b32 -S setxattr,fsetxattr,lsetxattr,removexattr,fremovexattr,lremovexattr -F auid>=1000 -F auid!=unset -k k",
		"-a always,exit -F arch=b64 -S setxattr,fsetxattr,lsetxattr,removexattr,fremovexattr,lremovexattr -F auid>=1000 -F auid!=unset -k k",
		"-a always,exit -F arch=b32 -S truncate,ftruncate,creat,open,openat,open_by_handle_at -F exit=-EPERM -F auid>=1000 -F auid!=unset -k k",
		"-a always,exit -F arch=b32 -S truncate,ftruncate,creat,open,openat,open_by_handle_at -F exit=-EACCES -F auid>=1000 -F auid!=unset -k k",
		"-a always,exit -F arch=b64 -S truncate,ftruncate,creat,open,openat,open_by_handle_at -F exit=-EPERM -F auid>=1000 -F auid!=unset -k k",
		"-a always,exit -F arch=b64 -S truncate,ftruncate,creat,open,openat,open_by_handle_at -F exit=-EACCES -F auid>=1000 -F auid!=unset -k k",
		"-a always,exit -F arch=b32 -S init_module,finit_module -F auid>=1000 -F auid!=unset -k k",
		"-a always,exit -F arch=b64 -S init_module,finit_module -F auid>=1000 -F auid!=unset -k k",
		"-a always,exit -F arch=b32 -F path=/etc/sudoers -F perm=wa -k identity",
		"-a always,exit -F arch=b64 -F path=/etc/sudoers -F perm=wa -k identity",
		"-w /etc/passwd -p wa -k identity",
		"-a always,exit -S all -F path=/usr/bin/sudo -F perm=x -F auid>=1000 -F auid!=unset -k priv_cmd",
	],
	"auditd_config": {
		"disk_full_action": "SYSLOG",
		"max_log_file_action": "ROTATE",
		"space_left_action": "EMAIL",
	},
	"services": {"auditd": "active"},
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.oracle_linux_9.audit_logging.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.oracle_linux_9.audit_logging.compliant with input as green_fixture
}

test_ol09_00_000441_pass if {
	data.stig.oracle_linux_9.audit_logging.status_ol09_00_000441 == "Not_a_Finding" with input as green_fixture
}

test_ol09_00_000441_fail_1 if {
	f := data.stig.oracle_linux_9.audit_logging.finding_ol09_00_000441 with input as object.union(green_fixture, {"services": {"auditd": "inactive"}})
	f.status == "Open"
	contains(f.detail, "OL09-00-000441: check failed")
}

