package stig.oracle_linux_9.network_rules_test

import rego.v1

# Generated by tools/stig_generators/gen_rhel9.py: for every reviewed rule a pass, a fail per mutation, an
# evidence-missing test per evidence path and, where the check text has one, the Not Applicable case.

green_fixture := {
	"ipv6_disabled": false,
	"kernel_params": {
		"net.ipv4.conf.all.accept_redirects": "0",
		"net.ipv4.conf.all.accept_source_route": "0",
		"net.ipv4.conf.all.forwarding": "0",
		"net.ipv4.conf.all.rp_filter": "1",
		"net.ipv4.conf.all.send_redirects": "0",
		"net.ipv4.icmp_ignore_bogus_error_responses": "1",
		"net.ipv4.tcp_syncookies": "1",
		"net.ipv6.conf.all.accept_redirects": "0",
		"net.ipv6.conf.all.accept_source_route": "0",
	},
	"modprobe": {
		"bluetooth": {
			"blacklisted": true,
			"install": "/bin/false",
		},
	},
	"packages": {
		"firewalld": true,
	},
	"promiscuous_interfaces": [],
	"services": {
		"firewalld": "active",
	},
	"wireless_interfaces": [],
}

test_every_finding_open_on_empty_input if {
	fs := data.stig.oracle_linux_9.network.findings with input as {}
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_section_compliant_on_green_fixture if {
	data.stig.oracle_linux_9.network.compliant with input as green_fixture
}

test_ol09_00_006032_pass if {
	data.stig.oracle_linux_9.network.status_ol09_00_006032 == "Not_a_Finding" with input as green_fixture
}

test_ol09_00_006032_fail_1 if {
	f := data.stig.oracle_linux_9.network.finding_ol09_00_006032 with input as object.union(green_fixture, {"kernel_params": {"net.ipv4.conf.all.send_redirects": "1"}})
	f.status == "Open"
	contains(f.detail, "OL09-00-006032: check failed")
}

test_ol09_00_006032_evidence_missing_1 if {
	f := data.stig.oracle_linux_9.network.finding_ol09_00_006032 with input as json.remove(green_fixture, [["kernel_params", "net.ipv4.conf.all.send_redirects"]])
	f.status == "Open"
	contains(f.detail, "OL09-00-006032: evidence missing — kernel_params.net.ipv4.conf.all.send_redirects")
}

test_ol09_00_006032_pass_2 if {
	data.stig.oracle_linux_9.network.status_ol09_00_006032 == "Not_a_Finding" with input as object.union(green_fixture, {"kernel_params": {"net.ipv4.conf.all.send_redirects": 0}})
}

