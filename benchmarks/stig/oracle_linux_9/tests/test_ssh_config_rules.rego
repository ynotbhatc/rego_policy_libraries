	f := data.stig.oracle_linux_9.ssh_config.finding_ol09_00_000254 with input as object.union(green_fixture, {"opensshserver_config": {"Ciphers": ""}})
	f.status == "Open"
	contains(f.detail, "OL09-00-000254: check failed")
}

test_ol09_00_000254_evidence_missing_1 if {
	f := data.stig.oracle_linux_9.ssh_config.finding_ol09_00_000254 with input as json.remove(green_fixture, [["opensshserver_config", "Ciphers"]])
