else := sprintf("%s: evidence missing — %s not collected", ["OL09-00-006042", concat(", ", missing_ol09_00_006042)]) if count(missing_ol09_00_006042) > 0

else := "OL09-00-006042: check failed — net.ipv6.conf.all.accept_source_route must be 0"

finding_ol09_00_006042 := {
	"vuln_id": "V-271879",
	"stig_id": "OL09-00-006042",
	"severity": "CAT II",
	"rule_title": "OL 9 must not forward IPv6 source-routed packets.",
	"check_type": "machine",
	"status": status_ol09_00_006042,
	"detail": detail_ol09_00_006042,
	"fix_text": "Set net.ipv6.conf.all.accept_source_route = 0 in /etc/sysctl.d/ and run sysctl --system",
}

# =============================================================================
# COMPLIANCE AGGREGATION
# =============================================================================

# No CAT I rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_i_findings := array.concat([], [])

cat_ii_findings := [
	finding_ol09_00_006032,
	finding_ol09_00_000221,
	finding_ol09_00_000046,
	finding_ol09_00_006004,
	finding_ol09_00_006028,
	finding_ol09_00_006050,
	finding_ol09_00_006020,
	finding_ol09_00_006021,
	finding_ol09_00_006031,
	finding_ol09_00_006001,
	finding_ol09_00_006024,
	finding_ol09_00_000220,
	finding_ol09_00_006041,
	finding_ol09_00_006042,
]

# No CAT III rule in this module. array.concat rather than the literal `[]`: OPA >= 1.22 types a literal
# empty array as having no members and rejects iterating it (scripts/check_per_file_load.py).
cat_iii_findings := array.concat([], [])

findings := array.concat(cat_i_findings, array.concat(cat_ii_findings, cat_iii_findings))

violations contains finding.stig_id if {
	some finding in findings
	finding.status == "Open"
}

open_cat_i contains f if {
	some f in cat_i_findings
	f.status == "Open"
}

# `compliant`: no open finding at ANY category (CAT I, II or III).
# `cat_i_compliant`: the former CAT-I-only meaning, for gating on the critical subset.
default cat_i_compliant := false

open_all_findings := [f | some f in findings; f.status == "Open"]

compliant if {
	count(open_all_findings) == 0
}

cat_i_compliant if {
	count(open_cat_i) == 0
}

compliance_report := {
	"module": "network",
	"total_findings": count(findings),
	"open_findings": count(violations),
	"cat_i_open": count(open_cat_i),
	"findings": findings,
	"compliant": compliant,
	"cat_i_compliant": cat_i_compliant,
}
