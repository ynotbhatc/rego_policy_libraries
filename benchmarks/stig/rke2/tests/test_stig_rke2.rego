test_report_wellformed_on_empty_input if {
	report := rke2.stig_assessment with input as {}
	is_object(report)
	report.summary.total_findings == 21
}

test_every_finding_open_on_empty_input if {
	fs := rke2.core.findings with input as {}
	count(fs) == 21
	count([f | some f in fs; f.status != "Open"]) == 0
}

test_fully_compliant_on_green_fixture if {
	report := rke2.stig_assessment with input as green_fixture
	report.summary.total_findings == 21
	report.summary.fully_compliant == true
}

test_main_fail_closed_on_empty_input if {
	rep := data.stig.rke2.main.compliance_report with input as {}
	rep.compliant == false
	rep.facts_supplied == false
	rep.failed_controls == 21
}

test_main_compliant_on_green_fixture if {
	rep := data.stig.rke2.main.compliance_report with input as green_fixture
	rep.compliant == true
	rep.violation_count == 0
}

test_main_partial_input_is_not_compliant if {
	rep := data.stig.rke2.main.compliance_report with input as {"cluster": {"version": "v1.30.2"}}
	rep.compliant == false
	rep.facts_supplied == true
}

