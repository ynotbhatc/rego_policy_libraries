package stig.windows_11_check_text_test

# Generated by tools/stig_generators/gen_windows.py — regenerate, don't hand-edit.
# Each rule below is written from more of DISA's check text than its registry block; these tests hold the
# values the check text accepts and values it does not.

import rego.v1

import data.stig.windows_11
import data.stig.windows_11_test.green_fixture

open_rules(facts) := {f.stig_id |
	some f in windows_11.stig_assessment.findings with input as facts
	f.status == "Open"
}

_other_facts := object.remove(green_fixture, {"registry"})

# the green fixture with one registry key replaced
_with_key(key, value) := object.union(_other_facts, {"registry": object.union(object.remove(green_fixture.registry, {key}), {key: value})})

# the green fixture with one registry value replaced
_with_value(key, name, value) := _with_key(key, object.union(object.remove(green_fixture.registry[key], {name}), {name: value}))

# the green fixture without one registry value (the key stays, as an object)
_without_value(key, name) := _with_key(key, object.remove(green_fixture.registry[key], {name}))

test_the_green_fixture_opens_nothing if {
	count(open_rules(green_fixture)) == 0
}

# WN11-SO-000075: the Standard Mandatory DoD Notice and Consent Banner, white space normalised, nothing else
_banner := green_fixture.registry["HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System"].LegalNoticeText

_banner_one_line := replace(_banner, "\r\n\r\n", " ")

test_banner_passes_however_its_lines_are_broken if {
	every text in [
		_banner,
		_banner_one_line,
		replace(_banner, "\r\n\r\n", "\n"),
		replace(_banner, "\r\n\r\n", "\n\n"),
		replace(_banner, "\r\n\r\n", " \t\r\n"),
		concat("", ["\r\n  ", replace(_banner_one_line, " ", "  "), " \n"]),
	] {
		not "WN11-SO-000075" in open_rules(_with_value("HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "LegalNoticeText", text))
	}
}

test_text_that_is_not_the_banner_is_a_finding if {
	every text in [
		"",
		"   ",
		"true",
		"false",
		"no",
		"<banner text as configured>",
		"Authorized use only.",
		# part of the banner, and the banner with text added
		substring(_banner_one_line, 0, 111),
		split(_banner, "\r\n\r\n")[0],
		concat(" ", [_banner_one_line, "Have a nice day."]),
		concat(" ", ["WARNING:", _banner_one_line]),
		# wording, case, punctuation and paragraphs run together
		replace(_banner_one_line, "USG-authorized use only", "authorized use only"),
		replace(_banner_one_line, "may inspect and seize", "may not inspect or seize"),
		lower(_banner_one_line),
		upper(_banner_one_line),
		replace(_banner_one_line, "-The USG", "- The USG"),
		replace(_banner_one_line, "--", "-"),
		replace(_banner, "\r\n\r\n", ""),
		# a non-breaking space is not ASCII white space
		replace(_banner_one_line, "You are", "You\u00a0are"),
	] {
		"WN11-SO-000075" in open_rules(_with_value("HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "LegalNoticeText", text))
	}
}

test_a_banner_that_is_not_a_string_is_a_finding if {
	every bad in [null, true, 1, split(_banner, "\r\n\r\n"), {"text": _banner}] {
		"WN11-SO-000075" in open_rules(_with_value("HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "LegalNoticeText", bad))
	}
	"WN11-SO-000075" in open_rules(_without_value("HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "LegalNoticeText"))
}

# Win32_DeviceGuard rules: [rule, property, how the check reads it, value]
device_guard_conditions := [
	["WN11-CC-000070", "RequiredSecurityProperties", "includes", 2],
	["WN11-CC-000070", "VirtualizationBasedSecurityStatus", "equals", 2],
	["WN11-CC-000075", "SecurityServicesRunning", "includes", 1],
	["WN11-CC-000080", "SecurityServicesRunning", "includes", 2],
]

_with_device_guard(value) := object.union(object.remove(green_fixture, {"device_guard"}), {"device_guard": value})

test_device_guard_rules_need_the_wmi_properties if {
	every c in device_guard_conditions {
		c[0] in open_rules(object.remove(green_fixture, {"device_guard"}))
		every bad in [null, {}, "Running", [1, 2], true] {
			c[0] in open_rules(_with_device_guard(bad))
		}
		c[0] in open_rules(_with_device_guard(object.remove(green_fixture.device_guard, {c[1]})))
	}
}

test_a_device_guard_property_of_the_wrong_value_or_type_is_a_finding if {
	every c in device_guard_conditions {
		bad_values := _bad_device_guard_values(c[2], c[3])
		count(bad_values) > 5
		every bad in bad_values {
			c[0] in open_rules(_with_device_guard(object.union(green_fixture.device_guard, {c[1]: bad})))
		}
	}
}

# a list that must include n: the list without n, n outside a list, n as text, and an object holding n
_bad_device_guard_values("includes", n) := [[], [n + 1], [sprintf("%d", [n])], n, sprintf("{%d}", [n]), {"value": n}, null, true]

# a number that must be n
_bad_device_guard_values("equals", n) := [n - 1, n + 1, sprintf("%d", [n]), [n], {"value": n}, null, true]

test_the_registry_alone_does_not_close_a_device_guard_rule if {
	facts := object.union(object.remove(green_fixture, {"device_guard"}), {"registry": object.union(green_fixture.registry, {"HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeviceGuard": {
		"EnableVirtualizationBasedSecurity": 1,
		"RequirePlatformSecurityFeatures": 1,
		"LsaCfgFlags": 1,
		"HypervisorEnforcedCodeIntegrity": 1,
	}})})
	every c in device_guard_conditions {
		c[0] in open_rules(facts)
	}
}

# WN11-CC-000327: the registry value and the attested review of the transcript directory permissions
test_transcription_is_open_until_the_directory_review_is_attested if {
	"WN11-CC-000327" in open_rules(object.remove(green_fixture, {"attest"}))
	every word in ["true", "yes", 1, null, false] {
		"WN11-CC-000327" in open_rules(object.union(green_fixture, {"attest": object.union(green_fixture.attest, {"wn11_cc_000327_transcript_directory_acl": word})}))
	}
}

# Rules whose check text says an absent value is not a finding: [rule, key, value name]
absent_allowed := [
	["WN11-CC-000055", "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WcmSvc\\GroupPolicy", "fMinimizeConnections"],
	["WN11-CC-000115", "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\Kerberos\\Parameters", "DevicePKInitEnabled"],
	["WN11-CC-000215", "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer", "NoDataExecutionPrevention"],
	["WN11-CC-000220", "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer", "NoHeapTerminationOnCorruption"],
	["WN11-CC-000225", "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer", "PreXPSP2ShellProtocolBehavior"],
	["WN11-CC-000300", "HKLM\\SOFTWARE\\Policies\\Microsoft\\Internet Explorer\\Feeds", "AllowBasicAuthInClear"],
	["WN11-CC-000320", "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Installer", "SafeForScripting"],
	["WN11-UC-000020", "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Attachments", "SaveZoneInformation"],
]

test_an_absent_value_is_not_a_finding if {
	every a in absent_allowed {
		# the key is there without the value, or the key itself does not exist
		not a[0] in open_rules(_without_value(a[1], a[2]))
		facts := object.union(_other_facts, {"registry": object.remove(green_fixture.registry, {a[1]})})
		not a[0] in open_rules(facts)
	}
}

test_a_key_that_was_not_read_is_a_finding if {
	every a in absent_allowed {
		every bad in [null, "", "not found", [], true, 0] {
			a[0] in open_rules(_with_key(a[1], bad))
		}
	}
}

test_a_value_that_is_there_but_wrong_is_a_finding if {
	every a in absent_allowed {
		good := green_fixture.registry[a[1]][a[2]]
		every bad in [null, "", sprintf("%d", [good]), true, false, [good], 9999] {
			a[0] in open_rules(_with_value(a[1], a[2], bad))
		}
	}
}

test_absence_counts_only_when_registry_facts_were_collected if {
	every a in absent_allowed {
		a[0] in open_rules(_other_facts)
		every bad in [{}, null, "collected", []] {
			a[0] in open_rules(object.union(_other_facts, {"registry": bad}))
		}
	}
}
