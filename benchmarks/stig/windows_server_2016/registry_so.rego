r_wn16_so_000430 if {
	input.registry["HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\FIPSAlgorithmPolicy"].Enabled == 1
}

finding_r_wn16_so_000430 := {
	"vuln_id": "V-225059",
	"stig_id": "WN16-SO-000430",
	"severity": "CAT II",
	"rule_title": "Windows Server 2016 must be configured to use FIPS-compliant algorithms for encryption, hashing, and signing.",
	"status": status_r_wn16_so_000430,
}

status_r_wn16_so_000430 := "Not_a_Finding" if r_wn16_so_000430
status_r_wn16_so_000430 := "Open" if not r_wn16_so_000430

