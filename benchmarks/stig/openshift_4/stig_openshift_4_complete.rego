# METADATA
# title: "DISA STIG — Red Hat OpenShift Container Platform 4.x Security Technical Implementation Guide — Master Aggregator"
# custom:
#   class: security
#   framework: stig_openshift_4
#   source: disa
#   domains: [kubernetes, openshift, container]
#   coverage:
#     checks: 2
#     cited: 2
#     density: orchestrator
#     basis: role
#     tested: true
#     entrypoint: compliance_report
#     guard: self
#     as_of: v2.4.2
package stig.openshift_4

# DISA STIG — Red Hat OpenShift Container Platform 4.x Security Technical Implementation Guide — Master Aggregator
# V2R7 | Released: 30 Sep 2026
# Coverage: 14 of 83 rules (7 of 7 CAT I), generated by tools/stig_generators/gen_openshift_stig.py (2026-11-18).
# Not_Reviewed (an organizational review not yet attested) is unresolved: it counts as failed, never as passed.

import rego.v1

import data.stig.openshift_4.core

all_findings := core.findings

open_findings := [f | some f in all_findings; f.status == "Open"]

not_reviewed_findings := [f | some f in all_findings; f.status == "Not_Reviewed"]

unresolved_findings := array.concat(open_findings, not_reviewed_findings)
cat_i_open := [f | some f in open_findings; f.severity == "CAT I"]

default overall_compliant := false

overall_compliant if count(cat_i_open) == 0

default fully_compliant := false

fully_compliant if count(unresolved_findings) == 0

stig_assessment := {
	"metadata": {
		"stig_title": "Red Hat OpenShift Container Platform 4.x Security Technical Implementation Guide",
		"version": "V2R7",
		"release": "Release: 7 Benchmark Date: 30 Sep 2026",
		"platform": "Red Hat OpenShift Container Platform 4.x",
		"assessed_host": object.get(input, ["system_info", "hostname"], "unknown"),
	},
	"summary": {
		"total_findings": count(all_findings),
		"open": count(open_findings),
		"not_a_finding": count([f | some f in all_findings; f.status == "Not_a_Finding"]),
		"not_applicable": count([f | some f in all_findings; f.status == "Not_Applicable"]),
		"not_reviewed": count(not_reviewed_findings),
		"cat_i_open": count(cat_i_open),
		"overall_compliant": overall_compliant,
		"fully_compliant": fully_compliant,
	},
	"findings": all_findings,
}

# Uniform library entrypoint contract (consumed by the .main alias's
# fail-closed gate): total_controls + open_findings are required.
compliance_report := {
	# every rule's DISA status (Not_a_Finding, Open, Not_Applicable, Not_Reviewed), for rollups such as
	# crosswalk.correlation; violations stay the open findings
	"rule_results": [{"rule": f.stig_id, "status": f.status} | some f in all_findings],
	"total_controls": count(all_findings),
	"open_findings": unresolved_findings,
	"passed_controls": count(all_findings) - count(unresolved_findings),
	"failed_controls": count(unresolved_findings),
	"compliant": fully_compliant,
}
