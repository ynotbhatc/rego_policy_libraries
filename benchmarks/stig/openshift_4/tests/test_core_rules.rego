test_every_finding_unresolved_on_empty_input if {
	fs := data.stig.openshift_4.core.findings with input as {}
	count([f | some f in fs; not f.status in {"Open", "Not_Reviewed"}]) == 0
}

test_compliant_on_green_fixture if {
	data.stig.openshift_4.core.compliant with input as green_fixture
