# SCC subjects the CNTR-OS-000660 check permits on a host-access / privileged / non-MustRunAsRange SCC
scc_permitted_subjects := {"system:cluster-admins", "system:nodes", "system:masters", "system:admin", "system:serviceaccount:openshift-infra:build-controller", "system:serviceaccount:openshift-infra:pv-recycler-controller", "system:serviceaccount:openshift-machine-api:machine-api-termination-handler"}

_scc_privileged(s) if s.allowHostIPC == true

_scc_privileged(s) if s.allowHostPID == true

_scc_privileged(s) if s.allowHostPorts == true

_scc_privileged(s) if s.allowHostNetwork == true

_scc_privileged(s) if s.allowHostDirVolumePlugin == true

_scc_privileged(s) if s.allowPrivilegedContainer == true

_scc_privileged(s) if object.get(s, ["runAsUser", "type"], "") != "MustRunAsRange"

# The allow* fields are booleans in the API object. A string or a number in their place can be read neither as
# a refusal nor as a grant, so the SCC counts as an offender until the fact is collected with its real type.
_scc_offender(s) if {
	some field in ["allowHostIPC", "allowHostPID", "allowHostPorts", "allowHostNetwork", "allowHostDirVolumePlugin", "allowPrivilegedContainer"]
	value := s[field]
	not is_null(value)
	not is_boolean(value)
}

_scc_subjects(s) := {x | some k in ["users", "groups"]; xs := object.get(s, k, []); some x in xs}

_scc_offender(s) if {
	_scc_privileged(s)
	some x in _scc_subjects(s)
	not x in scc_permitted_subjects
}

# system:authenticated belongs only on the restricted profile
_scc_offender(s) if {
	not s.metadata.name in {"restricted", "restricted-v2"}
	groups := object.get(s, "groups", [])
	"system:authenticated" in groups
}

# OpenShift Virtualization on a cluster older than 4.18 (input.openshift.cluster_version "4.17.3")
_pre_418 if {
	v := _str(["openshift", "cluster_version"])
	m := regex.find_all_string_submatch_n(`^4\.([0-9]+)(\.|$)`, v, 1)
	minor := to_number(m[0][1])
	minor < 18
}

_s(v) := lower(trim_space(v)) if is_string(v)

_lower_eq(v, want) if _s(v) == want

_nx(n) if contains(n.dmesg_nx, "NX (Execute Disable) protection: active")

_nx(n) if "nx" in n.cpu_flags

default _virt_nonroot_ok := false

_virt_nonroot_ok if input.openshift.virtualization_enabled == false

_virt_nonroot_ok if {
	input.openshift.virtualization_enabled == true
	not _pre_418
	_collected(["openshift", "cluster_version"])
}

_virt_nonroot_ok if {
	input.openshift.virtualization_enabled == true
	_pre_418
	input.openshift.hyperconverged.spec.featureGates.nonRoot == true
}

default _virt_sharing_ok := false

_virt_sharing_ok if input.openshift.virtualization_enabled == false

_virt_sharing_ok if {
	input.openshift.virtualization_enabled == true
	hc := input.openshift.hyperconverged
	object.get(hc, ["spec", "ksmConfiguration"], false) == false
	vms := input.openshift.cnv_shareable_disk_vms
	is_array(vms)
	count(vms) == 0
	_persistent_reservation_ok(hc)
}

_persistent_reservation_ok(hc) if object.get(hc, ["spec", "featureGates", "persistentReservation"], false) == false

_persistent_reservation_ok(_) if _attested("cntr_os_000560_windows_scf")

# CNTR-OS-000010 | V-257505 | CAT II
# input.openshift.image_config: image.config.openshift.io/cluster (the CIS OpenShift fact)
missing_cntr_os_000010 := [concat(".", p) | some p in [["openshift", "image_config"]]; not _collected(p)]

default registries_secure := false

registries_secure if {
	count(missing_cntr_os_000010) == 0
	ic := input.openshift.image_config
	allowed := object.get(ic, ["spec", "allowedRegistriesForImport"], [])
	is_array(allowed)
	count([r | some r in allowed; object.get(r, "insecure", false) != false]) == 0
	insecure := object.get(ic, ["spec", "registrySources", "insecureRegistries"], [])
	is_array(insecure)
	count(insecure) == 0
}

status_cntr_os_000010 := "Not_a_Finding" if registries_secure

else := "Open"

detail_cntr_os_000010 := "CNTR-OS-000010: Not_a_Finding" if registries_secure

else := sprintf("%s: evidence missing — %s not collected", ["CNTR-OS-000010", concat(", ", missing_cntr_os_000010)]) if count(missing_cntr_os_000010) > 0

else := "CNTR-OS-000010: check failed — image.config.openshift.io/cluster must list no allowedRegistriesForImport entry with insecure: true and no registrySources.insecureRegistries"

finding_cntr_os_000010 := {
	"vuln_id": "V-257505",
	"stig_id": "CNTR-OS-000010",
	"severity": "CAT II",
	"rule_title": "OpenShift must use TLS 1.2 or greater for secure container image transport from trusted sources.",
	"check_type": "machine",
	"status": status_cntr_os_000010,
	"detail": detail_cntr_os_000010,
	"fix_text": "Remove insecure registries from image.config.openshift.io/cluster",
}

