import rego.v1

# evidence present: the value exists at the path (an explicit null counts as not collected)
_collected(path) if object.get(input, path, null) != null

# the value at path as a trimmed string: a string as given, an integer number in decimal
_str(path) := trim_space(v) if {
	v := object.get(input, path, null)
	is_string(v)
}

_str(path) := format_int(v, 10) if {
	v := object.get(input, path, null)
	is_number(v)
	v == floor(v)
}

# a keyword value (sshd, auditd, faillock ...), compared case-insensitively
_kw(path) := lower(s) if s := _str(path)

# the value at path as a number: a number, or a string holding a decimal integer; undefined otherwise
# (in OPA a string compares greater than any number and null <= 60 is true, so never compare raw input)
_num(path) := v if {
	v := object.get(input, path, null)
	is_number(v)
}

_num(path) := n if {
	v := object.get(input, path, null)
	is_string(v)
	regex.match(`^\s*-?[0-9]+\s*$`, v)
	n := to_number(trim_space(v))
}

# a dnf/yum boolean option as written in the file: "1", "true" or "yes" (letters case-insensitive)
_truthy(v) if v == true

_truthy(v) if v == 1

_truthy(v) if {
	is_string(v)
	lower(trim_space(v)) in {"1", "true", "yes"}
}

# an organizational attestation (SA / ISSO documentation the check text asks for)
_attested(key) if input.attest[key] == true

# rhcos.nodes[]: per-node facts; every node must pass, an empty list is not collected
_nodes := ns if {
	ns := input.rhcos.nodes
	is_array(ns)
	count(ns) > 0
}

# kernel arguments of a node: the tokens of its /boot/loader/entries/*.conf options lines
_kargs(n) := {t | some l in n.boot_entries_options; is_string(l); s := trim_space(l); parts := split(s, " "); some t in parts; t != ""}

# an audit rule line compared token for token (`-F key=x` is `-k x`; auid!=-1 / 4294967295 are auid!=unset)
_rule_norm(l) := concat(" ", [t | some t in parts; t != ""]) if {
	is_string(l)
	a := replace(trim_space(l), " -F key=", " -k ")
	b := replace(a, "auid!=-1", "auid!=unset")
	x := replace(b, "auid!=4294967295", "auid!=unset")
	parts := split(x, " ")
}

_node_rules(n) := {r | some l in n.audit_rules; r := _rule_norm(l)}

# the expected audit rules of CNTR-OS-000720 / CNTR-OS-000930, normalised as above (from the check text)
execpriv_rules := {
