# CNTR-OS-000400 | V-257540 | CAT I
# per-node sshd_config values; input.openshift.virtualization_enabled, cluster_version, hyperconverged
missing_cntr_os_000400 := [concat(".", p) | some p in [["rhcos", "nodes"], ["openshift", "virtualization_enabled"]]; not _collected(p)]

default root_ssh_disabled_and_timeouts := false

root_ssh_disabled_and_timeouts if {
	count(missing_cntr_os_000400) == 0
	ns := _nodes
	every n in ns {
		_lower_eq(n.sshd_config.PermitRootLogin, "no")
		_lower_eq(n.sshd_config.ClientAliveCountMax, "0")
		is_string(n.sshd_config.ClientAliveInterval)
		regex.match(`^[0-9]+$`, trim_space(n.sshd_config.ClientAliveInterval))
		to_number(trim_space(n.sshd_config.ClientAliveInterval)) <= 600
	}
	_virt_nonroot_ok
}

status_cntr_os_000400 := "Not_a_Finding" if root_ssh_disabled_and_timeouts

else := "Open"

detail_cntr_os_000400 := "CNTR-OS-000400: Not_a_Finding" if root_ssh_disabled_and_timeouts

else := sprintf("%s: evidence missing — %s not collected", ["CNTR-OS-000400", concat(", ", missing_cntr_os_000400)]) if count(missing_cntr_os_000400) > 0

else := "CNTR-OS-000400: check failed — on every node /etc/ssh/sshd_config must set PermitRootLogin no, ClientAliveCountMax 0 and ClientAliveInterval 600 or less; with OpenShift Virtualization before 4.18 the hyperconverged featureGates.nonRoot must be true"

finding_cntr_os_000400 := {
	"vuln_id": "V-257540",
	"stig_id": "CNTR-OS-000400",
	"severity": "CAT I",
	"rule_title": "OpenShift must disable root and terminate network connections.",
	"check_type": "machine",
	"status": status_cntr_os_000400,
	"detail": detail_cntr_os_000400,
	"fix_text": "Set the sshd options with a MachineConfig; enable the nonRoot feature gate",
}

