BENCHMARK_TOTAL_CONTROLS := 408

section_reports := [
	account_policies.compliance_report,
	local_policies.compliance_report,
	system_services.compliance_report,
	firewall.compliance_report,
	advanced_audit.compliance_report,
	admin_templates_computer.compliance_report,
	admin_templates_user.compliance_report,
]

_tables := [
	account_policies.controls,
	local_policies.controls,
	system_services.controls,
	firewall.controls,
	advanced_audit.controls,
	admin_templates_computer.controls,
	admin_templates_user.controls,
]

# Static: every recommendation with a check row, whatever the facts or profile. check_cis_coverage.py reads
# this (with empty input) to prove the rows and the attestation ledger partition the benchmark.
evaluated_control_ids := sort([cid | some t in _tables; some cid; _ = t[cid]])

results := object.union_n([r.results | some r in section_reports])

applicable_ids := {cid | some cid; s := results[cid]; s != "not_applicable"} | attestation.in_scope_ids

passed_ids := {cid | some cid; s := results[cid]; s == "pass"} | attestation.passed_ids

failed_ids := {cid | some cid; s := results[cid]; s == "fail"}

not_assessed_ids := {cid | some cid; s := results[cid]; s == "not_assessed"}

# Unattested Manual recommendations count against the host: unverified is not passed.
unattested_ids := attestation.in_scope_ids - attestation.passed_ids

all_violations := array.concat(
	[v | some r in section_reports; some v in r.violations],
	[v | some v in attestation.violation],
)

# Sections that could assess nothing in scope, and the inputs each one lacked.
not_assessed_sections := [r.name |
	some r in section_reports
	count(r.in_scope) > 0
	count(r.assessed) == 0
]

missing_inputs := {r.name: r.missing_inputs |
	some r in section_reports
	count(r.missing_inputs) > 0
}

section_compliance := {r.name: {
	"in_scope": count(r.in_scope),
	"passed": count(r.passed),
	"failed": count(r.failed),
	"not_assessed": count(r.not_assessed),
} |
	some r in section_reports
}

# ---------------------------------------------------------------------------------------------------------------
# control_results: one object per recommendation of the benchmark (section rows and the Manual ledger) in natural
# id order, with its status, basis, scope, profile tags and the input paths its decision reads. CONTROL_INDEX (the
# static part: id, basis, profile, evidence) is written by the generator below this body; only the status is
# computed here, from the per-row statuses above (no row is evaluated twice) and the attestation ledger, so it
# cannot disagree with total_controls, failed_controls or the violations. Status mapping: pass -> pass,
# fail -> fail, not_assessed (its facts were not collected, or the profile cannot place a role-specific row)
# -> evidence_missing, not_applicable -> not_applicable. A Manual recommendation is pass when attested,
# not_attested when in scope and unattested (or its attestation is incomplete), not_applicable outside the
# profile. No benchmark text is carried.
# ---------------------------------------------------------------------------------------------------------------

CONTROL_STATUSES := ["pass", "fail", "evidence_missing", "not_attested", "not_applicable"]

_row_status := {"pass": "pass", "fail": "fail", "not_assessed": "evidence_missing", "not_applicable": "not_applicable"}

_attested_status(cid) := "pass" if cid in attestation.passed_ids

_attested_status(cid) := "not_attested" if {
	cid in attestation.in_scope_ids
	not cid in attestation.passed_ids
}

_attested_status(cid) := "not_applicable" if not cid in attestation.in_scope_ids

_status(e) := s if {
	e.basis == "evidence"
	row := results[e.id]
	s := _row_status[row]
}

_status(e) := s if {
	e.basis == "attestation"
	s := _attested_status(e.id)
}

control_results := [r |
	some e in CONTROL_INDEX
	s := _status(e)
	r := object.union(e, {"status": s, "in_scope": s != "not_applicable"})
]

_statuses := [r.status | some r in control_results]

control_result_counts := {s: n |
	some s in CONTROL_STATUSES
	n := count([x | some x in _statuses; x == s])
}

