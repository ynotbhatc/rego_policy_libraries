	"2.3.7.7": {"msg": "CIS 2.3.7.7: Ensure 'Interactive logon: Prompt user to change password before expiration' is set to 'between 5 and 14 days'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon", "name": "PasswordExpiryWarning", "op": "range", "value": [5, 14]},
	"2.3.7.8": {"msg": "CIS 2.3.7.8: Ensure 'Interactive logon: Require Domain Controller Authentication to unlock workstation' is set to 'Enabled' (MS only)", "profiles": ["L1_MS"], "kind": "reg", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon", "name": "ForceUnlockLogon", "op": "eq", "value": 1},
	"2.3.7.9": {"msg": "CIS 2.3.7.9: Ensure 'Interactive logon: Smart card removal behavior' is set to 'Lock Workstation' or higher", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon", "name": "ScRemoveOption", "op": "in", "value": [1, 2, 3]},
	"2.3.8.1": {"msg": "CIS 2.3.8.1: Ensure 'Microsoft network client: Digitally sign communications (always)' is set to 'Enabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters", "name": "RequireSecuritySignature", "op": "eq", "value": 1},
	"2.3.8.2": {"msg": "CIS 2.3.8.2: Ensure 'Microsoft network client: Send unencrypted password to third-party SMB servers' is set to 'Disabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters", "name": "EnablePlainTextPassword", "op": "eq", "value": 0},
	"2.3.9.1": {"msg": "CIS 2.3.9.1: Ensure 'Microsoft network server: Amount of idle time required before suspending session' is set to '15 or fewer minute(s)'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanManServer\\Parameters", "name": "AutoDisconnect", "op": "le", "value": 15},
	"2.3.9.2": {"msg": "CIS 2.3.9.2: Ensure 'Microsoft network server: Digitally sign communications (always)' is set to 'Enabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanManServer\\Parameters", "name": "RequireSecuritySignature", "op": "eq", "value": 1},
	"2.3.9.3": {"msg": "CIS 2.3.9.3: Ensure 'Microsoft network server: Disconnect clients when logon hours expire' is set to 'Enabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanManServer\\Parameters", "name": "enableforcedlogoff", "op": "eq", "value": 1},
	"2.3.9.4": {"msg": "CIS 2.3.9.4: Ensure 'Microsoft network server: Server SPN target name validation level' is set to 'Accept if provided by client' or higher (MS only)", "profiles": ["L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanManServer\\Parameters", "name": "SMBServerNameHardeningLevel", "op": "in", "value": [1, 2]},
	"2.3.10.1": {"msg": "CIS 2.3.10.1: Ensure 'Network access: Allow anonymous SID/Name translation' is set to 'Disabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "secedit", "key": "LSAAnonymousNameLookup", "op": "eq", "value": 0},
	"2.3.10.2": {"msg": "CIS 2.3.10.2: Ensure 'Network access: Do not allow anonymous enumeration of SAM accounts' is set to 'Enabled' (MS only)", "profiles": ["L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "RestrictAnonymousSAM", "op": "eq", "value": 1},
	"2.3.10.3": {"msg": "CIS 2.3.10.3: Ensure 'Network access: Do not allow anonymous enumeration of SAM accounts and shares' is set to 'Enabled' (MS only)", "profiles": ["L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "RestrictAnonymous", "op": "eq", "value": 1},
	"2.3.10.4": {"msg": "CIS 2.3.10.4: Ensure 'Network access: Do not allow storage of passwords and credentials for network authentication' is set to 'Enabled'", "profiles": ["L2_DC", "L2_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "DisableDomainCreds", "op": "eq", "value": 1},
	"2.3.10.5": {"msg": "CIS 2.3.10.5: Ensure 'Network access: Let Everyone permissions apply to anonymous users' is set to 'Disabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "EveryoneIncludesAnonymous", "op": "eq", "value": 0},
	"2.3.10.6": {"msg": "CIS 2.3.10.6: Ensure 'Network access: Named Pipes that can be accessed anonymously' is configured (DC only)", "profiles": ["L1_DC"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanManServer\\Parameters", "name": "NullSessionPipes", "op": "set", "value": ["LSARPC", "NETLOGON", "SAMR"]},
	"2.3.10.7": {"msg": "CIS 2.3.10.7: Ensure 'Network access: Named Pipes that can be accessed anonymously' is configured (MS only)", "profiles": ["L1_MS"], "kind": "reg_absent", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanManServer\\Parameters", "name": "NullSessionPipes"},
	"2.3.10.8": {"msg": "CIS 2.3.10.8: Ensure 'Network access: Remotely accessible registry paths' is configured", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecurePipeServers\\Winreg\\AllowedExactPaths", "name": "Machine", "op": "set", "value": ["System\\CurrentControlSet\\Control\\ProductOptions", "System\\CurrentControlSet\\Control\\Server Applications", "Software\\Microsoft\\Windows NT\\CurrentVersion"]},
	"2.3.10.9": {"msg": "CIS 2.3.10.9: Ensure 'Network access: Remotely accessible registry paths and sub-paths' is configured", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\SecurePipeServers\\Winreg\\AllowedPaths", "name": "Machine", "op": "set", "value": ["System\\CurrentControlSet\\Control\\Print\\Printers", "System\\CurrentControlSet\\Services\\Eventlog", "Software\\Microsoft\\OLAP Server", "Software\\Microsoft\\Windows NT\\CurrentVersion\\Print", "Software\\Microsoft\\Windows NT\\CurrentVersion\\Windows", "System\\CurrentControlSet\\Control\\ContentIndex", "System\\CurrentControlSet\\Control\\Terminal Server", "System\\CurrentControlSet\\Control\\Terminal Server\\UserConfig", "System\\CurrentControlSet\\Control\\Terminal Server\\DefaultUserConfiguration", "Software\\Microsoft\\Windows NT\\CurrentVersion\\Perflib", "System\\CurrentControlSet\\Services\\SysmonLog", "System\\CurrentControlSet\\Services\\CertSvc", "System\\CurrentControlSet\\Services\\WINS"]},
	"2.3.10.10": {"msg": "CIS 2.3.10.10: Ensure 'Network access: Restrict anonymous access to Named Pipes and Shares' is set to 'Enabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanManServer\\Parameters", "name": "RestrictNullSessAccess", "op": "eq", "value": 1},
	"2.3.10.11": {"msg": "CIS 2.3.10.11: Ensure 'Network access: Restrict clients allowed to make remote calls to SAM' is set to 'Administrators: Remote Access: Allow' (MS only)", "profiles": ["L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "restrictremotesam", "op": "eq", "value": "O:BAG:BAD:(A;;RC;;;BA)"},
	"2.3.10.12": {"msg": "CIS 2.3.10.12: Ensure 'Network access: Shares that can be accessed anonymously' is set to 'None'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg_absent", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanManServer\\Parameters", "name": "NullSessionShares"},
	"2.3.10.13": {"msg": "CIS 2.3.10.13: Ensure 'Network access: Sharing and security model for local accounts' is set to 'Classic - local users authenticate as themselves'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "ForceGuest", "op": "eq", "value": 0},
	"2.3.11.1": {"msg": "CIS 2.3.11.1: Ensure 'Network security: Allow Local System to use computer identity for NTLM' is set to 'Enabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "UseMachineId", "op": "eq", "value": 1},
	"2.3.11.2": {"msg": "CIS 2.3.11.2: Ensure 'Network security: Allow LocalSystem NULL session fallback' is set to 'Disabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\MSV1_0", "name": "AllowNullSessionFallback", "op": "eq", "value": 0},
	"2.3.11.3": {"msg": "CIS 2.3.11.3: Ensure 'Network Security: Allow PKU2U authentication requests to this computer to use online identities' is set to 'Disabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\pku2u", "name": "AllowOnlineID", "op": "eq", "value": 0},
	"2.3.11.4": {"msg": "CIS 2.3.11.4: Ensure 'Network security: Configure encryption types allowed for Kerberos' is set to 'AES128_HMAC_SHA1, AES256_HMAC_SHA1, Future encryption types'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\Kerberos\\Parameters", "name": "SupportedEncryptionTypes", "op": "eq", "value": 2147483640},
	"2.3.11.5": {"msg": "CIS 2.3.11.5: Ensure 'Network security: Do not store LAN Manager hash value on next password change' is set to 'Enabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "NoLMHash", "op": "eq", "value": 1},
	"2.3.11.7": {"msg": "CIS 2.3.11.7: Ensure 'Network security: LAN Manager authentication level' is set to 'Send NTLMv2 response only. Refuse LM & NTLM'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "LmCompatibilityLevel", "op": "eq", "value": 5},
	"2.3.11.8": {"msg": "CIS 2.3.11.8: Ensure 'Network security: LDAP client signing requirements' is set to 'Negotiate signing' or higher", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LDAP", "name": "LDAPClientIntegrity", "op": "in", "value": [1, 2]},
	"2.3.11.9": {"msg": "CIS 2.3.11.9: Ensure 'Network security: Minimum session security for NTLM SSP based (including secure RPC) clients' is set to 'Require NTLMv2 session security, Require 128-bit encryption'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\MSV1_0", "name": "NTLMMinClientSec", "op": "eq", "value": 537395200},
	"2.3.11.10": {"msg": "CIS 2.3.11.10: Ensure 'Network security: Minimum session security for NTLM SSP based (including secure RPC) servers' is set to 'Require NTLMv2 session security, Require 128-bit encryption'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\MSV1_0", "name": "NTLMMinServerSec", "op": "eq", "value": 537395200},
	"2.3.11.11": {"msg": "CIS 2.3.11.11: Ensure 'Network security: Restrict NTLM: Audit Incoming NTLM Traffic' is set to 'Enable auditing for all accounts'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\MSV1_0", "name": "AuditReceivingNTLMTraffic", "op": "eq", "value": 2},
	"2.3.11.12": {"msg": "CIS 2.3.11.12: Ensure 'Network security: Restrict NTLM: Audit NTLM authentication in this domain' is set to 'Enable all' (DC only)", "profiles": ["L1_DC"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Netlogon\\Parameters", "name": "AuditNTLMInDomain", "op": "eq", "value": 7},
	"2.3.11.13": {"msg": "CIS 2.3.11.13: Ensure 'Network security: Restrict NTLM: Outgoing NTLM traffic to remote servers' is set to 'Audit all' or higher", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\MSV1_0", "name": "RestrictSendingNTLMTraffic", "op": "in", "value": [1, 2]},
	"2.3.13.1": {"msg": "CIS 2.3.13.1: Ensure 'Shutdown: Allow system to be shut down without having to log on' is set to 'Disabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "ShutdownWithoutLogon", "op": "eq", "value": 0},
	"2.3.15.1": {"msg": "CIS 2.3.15.1: Ensure 'System objects: Require case insensitivity for non-Windows subsystems' is set to 'Enabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Kernel", "name": "ObCaseInsensitive", "op": "eq", "value": 1},
	"2.3.15.2": {"msg": "CIS 2.3.15.2: Ensure 'System objects: Strengthen default permissions of internal system objects (e.g. Symbolic Links)' is set to 'Enabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager", "name": "ProtectionMode", "op": "eq", "value": 1},
	"2.3.17.1": {"msg": "CIS 2.3.17.1: Ensure 'User Account Control: Admin Approval Mode for the Built-in Administrator account' is set to 'Enabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "FilterAdministratorToken", "op": "eq", "value": 1},
	"2.3.17.2": {"msg": "CIS 2.3.17.2: Ensure 'User Account Control: Behavior of the elevation prompt for administrators in Admin Approval Mode' is set to 'Prompt for consent on the secure desktop' or higher", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "ConsentPromptBehaviorAdmin", "op": "in", "value": [1, 2]},
	"2.3.17.3": {"msg": "CIS 2.3.17.3: Ensure 'User Account Control: Behavior of the elevation prompt for standard users' is set to 'Automatically deny elevation requests'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "ConsentPromptBehaviorUser", "op": "eq", "value": 0},
	"2.3.17.4": {"msg": "CIS 2.3.17.4: Ensure 'User Account Control: Detect application installations and prompt for elevation' is set to 'Enabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "EnableInstallerDetection", "op": "eq", "value": 1},
	"2.3.17.5": {"msg": "CIS 2.3.17.5: Ensure 'User Account Control: Only elevate UIAccess applications that are installed in secure locations' is set to 'Enabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "EnableSecureUIAPaths", "op": "eq", "value": 1},
	"2.3.17.6": {"msg": "CIS 2.3.17.6: Ensure 'User Account Control: Run all administrators in Admin Approval Mode' is set to 'Enabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "EnableLUA", "op": "eq", "value": 1},
	"2.3.17.7": {"msg": "CIS 2.3.17.7: Ensure 'User Account Control: Switch to the secure desktop when prompting for elevation' is set to 'Enabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "PromptOnSecureDesktop", "op": "eq", "value": 1},
	"2.3.17.8": {"msg": "CIS 2.3.17.8: Ensure 'User Account Control: Virtualize file and registry write failures to per-user locations' is set to 'Enabled'", "profiles": ["L1_DC", "L1_MS"], "kind": "reg", "path": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "EnableVirtualization", "op": "eq", "value": 1},
}

compliance_report := lib.section_reports.local_policies
