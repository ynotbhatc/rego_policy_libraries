}

default e_3_13 := false
e_3_13 if {
	is_array(input.sql.msdb_admin_role_members)
}

violations contains "3.13: evidence missing — sql.msdb_admin_role_members not collected" if {
	"3.13" in in_scope
	not e_3_13
}

violations contains "3.13: Ensure no admin role membership in MSDB database" if {
	"3.13" in in_scope
	e_3_13
	not r_3_13
}

# 3.14 (Manual, Level 1 - Database Engine)
default r_3_14 := false
r_3_14 if {
	input.sql.attest.control_server_grants_reviewed == true
}

violations contains "3.14: Ensure 'Control Server' permission is not granted (manual review not attested)" if {
	"3.14" in in_scope
	not r_3_14
}

# 3.15 (Manual, Level 1 - Database Engine)
default r_3_15 := false
r_3_15 if {
	input.sql.attest.external_rest_endpoint_access_reviewed == true
}

violations contains "3.15: Ensure access to 'sp_invoke_external_rest_endpoint' is limited to trusted accounts only (manual review not attested)" if {
	"3.15" in in_scope
	not r_3_15
}

# 4.1 (Manual, Level 1 - Database Engine)
default r_4_1 := false
r_4_1 if {
	input.sql.attest.must_change_reviewed == true
}

violations contains "4.1: Ensure 'MUST_CHANGE' Option is set to 'ON' for All SQL Authenticated Logins (manual review not attested)" if {
	"4.1" in in_scope
	not r_4_1
}

# 4.2 (Automated, Level 1 - Database Engine; Level 1 - AWS RDS)
default r_4_2 := false
r_4_2 if {
	count([r | some r in input.sql.sysadmin_logins_without_expiration_check; not _rds_master_rdsa(r)]) == 0
}

default e_4_2 := false
e_4_2 if {
	is_array(input.sql.sysadmin_logins_without_expiration_check)
}

violations contains "4.2: evidence missing — sql.sysadmin_logins_without_expiration_check not collected" if {
	"4.2" in in_scope
	not e_4_2
}

violations contains "4.2: Ensure 'CHECK_EXPIRATION' Option is set to 'ON' for All SQL Authenticated Logins Within the Sysadmin Role" if {
	"4.2" in in_scope
	e_4_2
	not r_4_2
}

# 4.3 (Automated, Level 1 - Database Engine; Level 1 - AWS RDS)
default r_4_3 := false
r_4_3 if {
	count(input.sql.sql_logins_without_check_policy) == 0
}

default e_4_3 := false
e_4_3 if {
	is_array(input.sql.sql_logins_without_check_policy)
}

violations contains "4.3: evidence missing — sql.sql_logins_without_check_policy not collected" if {
	"4.3" in in_scope
	not e_4_3
}

violations contains "4.3: Ensure 'CHECK_POLICY' Option is set to 'ON' for All SQL Authenticated Logins" if {
	"4.3" in in_scope
	e_4_3
	not r_4_3
}

# 5.1 (Automated, Level 1 - Database Engine; Level 1 - AWS RDS)
default r_5_1 := false
r_5_1 if {
	input.sql.num_error_logs == -1
}

r_5_1 if {
	input.sql.num_error_logs >= 12
}

default e_5_1 := false
e_5_1 if {
	is_number(input.sql.num_error_logs)
}

violations contains "5.1: evidence missing — sql.num_error_logs not collected" if {
	"5.1" in in_scope
	not e_5_1
}

violations contains "5.1: Ensure 'Maximum number of error log files' is set to greater than or equal to '12'" if {
	"5.1" in in_scope
	e_5_1
	not r_5_1
}

# 5.2 (Automated, Level 1 - Database Engine; Level 1 - AWS RDS)
default r_5_2 := false
r_5_2 if {
	_cfg_is("default trace enabled", 1)
}

default e_5_2 := false
e_5_2 if {
	count(_cfg_rows("default trace enabled")) > 0
}

violations contains "5.2: evidence missing — sql.configurations['default trace enabled'] not collected" if {
	"5.2" in in_scope
	not e_5_2
}

violations contains "5.2: Ensure 'Default Trace Enabled' Server Configuration Option is set to '1'" if {
	"5.2" in in_scope
	e_5_2
	not r_5_2
}

# 5.3 (Automated, Level 1 - Database Engine; Level 1 - AWS RDS)
default r_5_3 := false
r_5_3 if {
	lower(input.sql.login_audit_level) in {"failure", "all"}
}

default e_5_3 := false
e_5_3 if {
	is_string(input.sql.login_audit_level)
}

violations contains "5.3: evidence missing — sql.login_audit_level not collected" if {
	"5.3" in in_scope
	not e_5_3
}

violations contains "5.3: Ensure 'Login Auditing' is set to 'failed logins'" if {
	"5.3" in in_scope
	e_5_3
	not r_5_3
}

# 5.4 (Automated, Level 1 - Database Engine; Level 1 - AWS RDS)
default r_5_4 := false
r_5_4 if {
	every g in _audit_groups_required { _audit_group_ok(g) }
}

default e_5_4 := false
e_5_4 if {
	is_array(input.sql.server_audit_actions)
	is_boolean(input.sql.has_contained_databases)
}

violations contains "5.4: evidence missing — sql.server_audit_actions / sql.has_contained_databases not collected" if {
	"5.4" in in_scope
	not e_5_4
}

violations contains "5.4: Ensure 'SQL Server Audit' is set to capture both 'failed' and 'successful logins'" if {
	"5.4" in in_scope
	e_5_4
	not r_5_4
}

# 6.1 (Manual, Level 1 - Database Engine)
default r_6_1 := false
r_6_1 if {
	input.sql.attest.input_sanitization_reviewed == true
}

violations contains "6.1: Ensure Database and Application User Input is Sanitized (manual review not attested)" if {
	"6.1" in in_scope
	not r_6_1
}

# 6.2 (Automated, Level 1 - Database Engine; Level 1 - AWS RDS)
default r_6_2 := false
r_6_2 if {
	every a in input.sql.user_assemblies { upper(a.permission_set_desc) == "SAFE_ACCESS" }
}

default e_6_2 := false
e_6_2 if {
	is_array(input.sql.user_assemblies)
}

violations contains "6.2: evidence missing — sql.user_assemblies not collected" if {
	"6.2" in in_scope
	not e_6_2
}

violations contains "6.2: Ensure 'CLR Assembly Permission Set' is set to 'SAFE_ACCESS' for All CLR Assemblies" if {
	"6.2" in in_scope
	e_6_2
	not r_6_2
}

# 7.1 (Automated, Level 1 - Database Engine; Level 1 - AWS RDS)
default r_7_1 := false
r_7_1 if {
	every k in input.sql.symmetric_keys { upper(k.algorithm_desc) in {"AES_128", "AES_192", "AES_256"} }
}

default e_7_1 := false
e_7_1 if {
	is_array(input.sql.symmetric_keys)
}

violations contains "7.1: evidence missing — sql.symmetric_keys not collected" if {
	"7.1" in in_scope
	not e_7_1
}

violations contains "7.1: Ensure 'Symmetric Key encryption algorithm' is set to 'AES_128' or higher in non-system databases" if {
	"7.1" in in_scope
	e_7_1
	not r_7_1
}

# 7.2 (Automated, Level 1 - Database Engine; Level 1 - AWS RDS)
default r_7_2 := false
r_7_2 if {
	every k in input.sql.asymmetric_keys { to_number(k.key_length) >= 2048 }
}

default e_7_2 := false
e_7_2 if {
	is_array(input.sql.asymmetric_keys)
}

violations contains "7.2: evidence missing — sql.asymmetric_keys not collected" if {
	"7.2" in in_scope
	not e_7_2
}

violations contains "7.2: Ensure Asymmetric Key Size is set to 'greater than or equal to 2048' in non-system databases" if {
	"7.2" in in_scope
	e_7_2
	not r_7_2
}

# 7.3 (Automated, Level 2 - Database Engine)
default r_7_3 := false
r_7_3 if {
	count(input.sql.unencrypted_backups) == 0
}

default e_7_3 := false
e_7_3 if {
	is_array(input.sql.unencrypted_backups)
}

violations contains "7.3: evidence missing — sql.unencrypted_backups not collected" if {
	"7.3" in in_scope
	not e_7_3
}

violations contains "7.3: Ensure Database Backups are Encrypted" if {
	"7.3" in in_scope
	e_7_3
	not r_7_3
}

# 7.4 (Automated, Level 2 - Database Engine)
default r_7_4 := false
r_7_4 if {
	count(input.sql.connection_encrypt_options) > 0
	every o in input.sql.connection_encrypt_options { upper(sprintf("%v", [o])) == "TRUE" }
}

default e_7_4 := false
e_7_4 if {
	is_array(input.sql.connection_encrypt_options)
}

violations contains "7.4: evidence missing — sql.connection_encrypt_options not collected" if {
	"7.4" in in_scope
	not e_7_4
}

violations contains "7.4: Ensure Network Encryption is Configured and Enabled" if {
	"7.4" in in_scope
	e_7_4
	not r_7_4
}

# 7.5 (Automated, Level 2 - Database Engine)
default r_7_5 := false
r_7_5 if {
	count(input.sql.databases_without_tde) == 0
}

default e_7_5 := false
e_7_5 if {
	is_array(input.sql.databases_without_tde)
}

violations contains "7.5: evidence missing — sql.databases_without_tde not collected" if {
	"7.5" in in_scope
	not e_7_5
}

violations contains "7.5: Ensure Databases are Encrypted with TDE" if {
	"7.5" in in_scope
	e_7_5
	not r_7_5
}

# 8.1 (Manual, Level 1 - Database Engine)
default r_8_1 := false
r_8_1 if {
	input.sql.attest.browser_service_reviewed == true
}

violations contains "8.1: Ensure 'SQL Server Browser Service' is configured correctly (manual review not attested)" if {
	"8.1" in in_scope
	not r_8_1
}

violations contains "CIS SQL Server 2025: FAIL-CLOSED - facts 'input.sql' were not supplied; the instance was not evaluated" if {
	not input.sql
}

sections := {
 "1": "Installation, Updates and Patches",
 "2": "Surface Area Reduction",
 "3": "Authentication and Authorization",
 "4": "Password Policies",
 "5": "Auditing and Logging",
 "6": "Application Development",
 "7": "Encryption",
 "8": "Appendix: Additional Considerations"
}

# id -> CIS title, level, Automated/Manual status and the workbook profiles it belongs to
