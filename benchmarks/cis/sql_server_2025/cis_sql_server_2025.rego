compliance_report := {
	"benchmark": "CIS Microsoft SQL Server 2025 Benchmark v1.0.0",
	"profile": {"platform": platform, "level": level},
	"total_controls": count(in_scope),
	"standard_total": 49,
	"standard_total_source": "CIS Microsoft SQL Server 2025 Benchmark v1.0.0, recommendations counted from the CIS workbook",
	"sections": sections,
	"compliant": compliant,
	"violation_count": count(violations),
	"violations": violations,
}
