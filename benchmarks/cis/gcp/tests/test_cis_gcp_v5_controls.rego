failing(inp) := f if {
	f := data.cis_gcp_foundations.failing_controls with input as inp with time.now_ns as now_ns
}

msgs(inp) := v if {
	v := data.cis_gcp_foundations.violations with input as inp with time.now_ns as now_ns
}

cid(m) := regex.find_n(`^[0-9]+(\.[0-9]+)*`, m, 1)[0]

without(k) := json.remove(good, [k])

test_good_fixture_is_compliant if {
	data.cis_gcp_foundations.compliant with input as good with time.now_ns as now_ns
}

test_good_fixture_report_counts if {
	s := data.cis_gcp_foundations.compliance_summary with input as good with time.now_ns as now_ns
	s.total_controls == 93
	s.passing_controls == 93
	s.failing_controls == 0
}

