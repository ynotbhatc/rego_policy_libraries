package cis_pfsense_test

import rego.v1

# CIS pfSense Firewall Benchmark v1.1.1: a pass, fail and (config-backed controls) evidence-missing
# test for every recommendation. Generated by scratchpad pf_gen_tests.py; good_input passes all 33.

good_input := {
	"system": {
		"hostname": "fw01",
		"domain": "example.org",
		"dnsserver": ["10.0.0.53"],
		"timezone": "Europe/London",
		"timeservers": "0.pool.ntp.org 1.pool.ntp.org",
		"disableconsolemenu": "",
		"sshguard_threshold": "20",
		"sshguard_blocktime": "600",
		"authserver": [{
			"name": "corp-ldap",
			"type": "ldap",
		}],
		"webgui": {
			"protocol": "https",
			"session_timeout": "10",
		},
	},
	"filter": {"rule": [
		{
			"type": "pass",
			"interface": "lan",
			"descr": "web",
			"source": {"network": "lan"},
			"destination": {
				"address": "10.0.0.5",
				"port": "443",
			},
			"protocol": "tcp",
			"log": "",
		},
		{
			"type": "pass",
			"interface": "lan",
			"descr": "ping",
			"source": {"network": "lan"},
			"destination": {"address": "10.0.0.5"},
			"protocol": "icmp",
			"icmptype": "echoreq",
			"log": "",
		},
		{
			"type": "block",
			"interface": "wan",
			"descr": "deny",
			"source": {"any": ""},
			"destination": {"any": ""},
			"log": "",
		},
	]},
	"snmpd": {
		"trapenable": "",
		"trapserver": "10.0.0.9",
	},
	"unbound": {
		"enable": "",
		"dnssec": "",
	},
	"syslogd": {
		"enable": "1",
		"remoteserver": "10.0.0.8:514",
	},
	"hasync": {"synchronizetoip": "10.0.0.2"},
	"openvpn": {"openvpn-server": [{
		"vpnid": "1",
		"description": "ra",
		"mode": "server_tls_user",
		"authmode": "corp-ldap",
		"data_ciphers": "AES-256-GCM,CHACHA20-POLY1305",
		"digest": "SHA256",
	}]},
	"sshd_config": "# Banner none\nBanner /etc/issue.net\n",
	"motd": "Authorized use only.\n",
	"attest": {
		"autoconfigbackup_enabled": true,
		"default_accounts_secured": true,
		"local_accounts_disabled": true,
		"admin_default_password_changed": true,
		"unused_rules_reviewed": true,
		"net_snmp_secured": true,
		"vpn_portal_certificate_trusted": true,
	},
}

fails(id, inp) if {
	v := data.cis_pfsense.violations with input as inp
	some x in v
	startswith(x, concat("", [id, ":"]))
}

missing(id, inp) if {
	v := data.cis_pfsense.violations with input as inp
	some x in v
	startswith(x, concat("", [id, ": evidence missing"]))
}

test_good_input_is_fully_compliant if {
	a := data.cis_pfsense.compliance_assessment with input as good_input
	a.compliant == true
	count(a.violations) == 0
	a.summary.compliance_percentage == 100
}

test_1_1_pass if not fails("1.1", good_input)

test_1_1_fail if {
	inp := json.patch(good_input, [{"op": "replace", "path": "/sshd_config", "value": "Banner none\n"}])
	fails("1.1", inp)
	not missing("1.1", inp)
}

test_1_1_fail_2 if {
	inp := json.patch(good_input, [{"op": "replace", "path": "/sshd_config", "value": "#Banner /etc/issue.net\n"}])
	fails("1.1", inp)
	not missing("1.1", inp)
}

test_1_1_evidence_missing if missing("1.1", json.remove(good_input, ["sshd_config"]))

test_1_2_pass if not fails("1.2", good_input)

test_1_2_fail if {
	inp := json.patch(good_input, [{"op": "replace", "path": "/attest/autoconfigbackup_enabled", "value": false}])
	fails("1.2", inp)
	not missing("1.2", inp)
}

test_1_2_not_attested_on_empty_input if fails("1.2", {"system": {}})

