# ── Edge cases ──
# Behaviour beyond the per-control pass/fail/missing set.

# The collector defaults filter to {"rule": []}; with no MVC rules either, that is no
# evidence, not a clean rule base.
test_empty_rule_list_misses_every_rule_control if {
	inp := json.patch(json.remove(good_input, ["OPNsense/Firewall"]), [{"op": "replace", "path": "/filter", "value": {"rule": []}}])
	every id in ["4.1.2", "4.1.3", "4.1.4", "4.1.8", "6.1", "6.2"] { missing(id, inp) }
}

# MVC-only rule base (26.x factory layout) counts as collected.
test_mvc_rules_alone_are_evidence if {
	inp := json.remove(good_input, ["filter"])
	not missing("4.1.3", inp)
	not fails("4.1.3", inp)
}

# The factory "LAN net to any" rule is broad (4.1.2) but not literal any -> any (4.1.3).
test_factory_lan_rule_is_4_1_2_not_4_1_3 if {
	inp := json.patch(good_input, [{"op": "add", "path": "/OPNsense/Firewall/Filter/rules/rule/-", "value": {
		"enabled": "1", "action": "pass", "interface": "lan", "protocol": "any",
		"source_net": "lan", "destination_net": "any", "log": "0",
		"description": "Default allow LAN to any rule",
	}}])
	fails("4.1.2", inp)
	not fails("4.1.3", inp)
}

# 4.1.2 passes on broad rules once their justification is attested.
test_4_1_2_broad_rule_passes_when_attested if {
	inp := json.patch(good_input, [
		{"op": "replace", "path": "/filter/rule/0/source", "value": {"any": "1"}},
		{"op": "add", "path": "/attest/broad_permit_rules_justified", "value": true},
	])
	not fails("4.1.2", inp)
}

# 4.1.8 passes on floating rules once their justification is attested.
test_4_1_8_floating_rule_passes_when_attested if {
	inp := json.patch(good_input, [
		{"op": "replace", "path": "/OPNsense/Firewall/Filter/rules/rule/1/interface", "value": "lan,opt1"},
		{"op": "add", "path": "/attest/floating_rules_justified", "value": true},
	])
	not fails("4.1.8", inp)
}

# Disabled rules are ignored (legacy: disabled flag; MVC: enabled "0").
test_disabled_rules_ignored if {
	inp := json.patch(good_input, [
		{"op": "add", "path": "/filter/rule/-", "value": {"type": "pass", "disabled": "1", "interface": "lan", "source": {"any": ""}, "destination": {"any": ""}}},
		{"op": "add", "path": "/OPNsense/Firewall/Filter/rules/rule/-", "value": {"enabled": "0", "action": "block", "interface": "lan", "source_net": "any", "destination_net": "(self)", "log": "0", "description": "off"}},
	])
	not fails("4.1.3", inp)
	not fails("6.1", inp)
}

# A non-management deny rule without logging fails 6.1 only.
test_6_2_ignores_non_management_deny if {
	inp := json.patch(good_input, [{"op": "replace", "path": "/OPNsense/Firewall/Filter/rules/rule/1/log", "value": "0"}])
	fails("6.1", inp)
	not fails("6.2", inp)
}

# 1.6: IPv6 allowed but attested as required passes.
test_1_6_ipv6_attested_passes if {
	inp := json.patch(good_input, [
		{"op": "replace", "path": "/OPNsense/Interfaces/settings/disableipv6", "value": "0"},
		{"op": "add", "path": "/attest/ipv6_required", "value": true},
	])
	not fails("1.6", inp)
}

# 1.6 on a <= 25.7 config: no MVC interface settings, system.ipv6allow absent => IPv6 off.
test_1_6_legacy_ipv6_off_passes if not fails("1.6", json.remove(good_input, ["OPNsense/Interfaces"]))

# 1.2: an unset backup count means the OPNsense default (100), which passes.
test_1_2_unset_backupcount_passes if not fails("1.2", json.remove(good_input, ["system/backupcount"]))

# MVC booleans: "" is not on (an MVC flag()-style check would fail open here).
test_mvc_empty_string_is_not_on if fails("5.2.1", json.patch(good_input, [{"op": "replace", "path": "/OPNsense/unboundplus/general/dnssec", "value": ""}]))

# Attestation must be the boolean true, not a truthy string.
test_attestation_requires_boolean_true if fails("3.1", json.patch(good_input, [{"op": "replace", "path": "/attest/local_accounts_disabled", "value": "true"}]))

# A single repeated element arrives as an object, not a list.
test_single_rule_object_accepted if {
	inp := json.patch(good_input, [{"op": "replace", "path": "/filter/rule", "value": {
		"type": "pass", "interface": "lan", "descr": "one", "source": {"network": "lan"},
		"destination": {"address": "10.0.0.5", "port": "443"}, "protocol": "tcp", "log": "1",
	}}])
	not fails("4.1.2", inp)
	not missing("4.1.2", inp)
}

test_main_good_input_passes_all if {
	r := data.cis_opnsense.main.compliance_report with input as good_input
	r.passed_controls == 29
	r.compliant == true
	r.compliance_percentage == 100
}

# Time servers given as a list (not the space-separated config.xml string) are accepted.
test_5_1_1_timeservers_list_accepted if not fails("5.1.1", json.patch(good_input, [{"op": "replace", "path": "/system/timeservers", "value": ["0.pool.ntp.org", "1.pool.ntp.org"]}]))

# 1.6: without the MVC subtree the release is unknown, so an absent ipv6allow is not evidence.
test_1_6_system_without_mvc_is_evidence_missing if missing("1.6", json.remove(good_input, ["OPNsense"]))

# A legacy rule whose source element is empty (null) is unrestricted.
test_legacy_null_source_is_any if fails("4.1.2", json.patch(good_input, [{"op": "replace", "path": "/filter/rule/0/source", "value": null}]))
