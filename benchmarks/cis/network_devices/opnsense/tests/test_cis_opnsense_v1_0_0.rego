package cis_opnsense_test

import rego.v1

# CIS OPNsense Benchmark v1.0.0: a pass and a fail test for every recommendation, plus an
# evidence-missing test for each config-backed one. Generated by scratchpad opn_gen_tests.py;
# good_input (real OPNsense config.xml layout) passes all 29.

good_input := {
	"system": {
		"hostname": "fw-edge-01",
		"domain": "example.org",
		"dnsserver": ["10.0.0.53"],
		"timezone": "Europe/London",
		"timeservers": "0.pool.ntp.org 1.pool.ntp.org",
		"backupcount": "10",
		"disableconsolemenu": "1",
		"authserver": [
			{
				"name": "corp-ldap",
				"type": "ldap",
			},
			{
				"name": "totp",
				"type": "totp",
			},
		],
		"webgui": {
			"protocol": "https",
			"ssl-hsts": "1",
			"session_timeout": "10",
			"port": "8443",
		},
	},
	"ntpd": {"prefer": "0.pool.ntp.org"},
	"filter": {"rule": [{
		"type": "pass",
		"interface": "lan",
		"descr": "LAN-WEB-01 lan to web server",
		"source": {"network": "lan"},
		"destination": {
			"address": "10.0.0.5",
			"port": "443",
		},
		"protocol": "tcp",
		"log": "1",
	}]},
	"OPNsense": {
		"Firewall": {"Filter": {"rules": {"rule": [
			{
				"enabled": "1",
				"action": "block",
				"interface": "lan",
				"direction": "in",
				"protocol": "TCP",
				"source_net": "lan",
				"destination_net": "(self)",
				"destination_port": "22",
				"log": "1",
				"interfacenot": "0",
				"description": "MGMT-DENY-01 lan to firewall ssh",
			},
			{
				"enabled": "1",
				"action": "block",
				"interface": "opt1",
				"direction": "in",
				"protocol": "any",
				"source_net": "opt1",
				"destination_net": "lan",
				"destination_port": "",
				"log": "1",
				"interfacenot": "0",
				"description": "ZONE-DENY-01 guest to lan",
			},
		]}}},
		"Interfaces": {"settings": {"disableipv6": "1"}},
		"unboundplus": {"general": {
			"enabled": "1",
			"dnssec": "1",
		}},
		"Syslog": {
			"general": {"enabled": "1"},
			"destinations": {"destination": [{
				"enabled": "1",
				"transport": "udp4",
				"hostname": "10.0.0.8",
				"port": "514",
				"description": "siem",
			}]},
		},
	},
	"sshd_config": "# Banner none\nBanner /usr/local/etc/ssh/banner\n",
	"motd": "Authorized use only.\n",
	"attest": {
		"default_accounts_secured": true,
		"local_accounts_disabled": true,
		"default_root_password_changed": true,
		"default_deny_internal_interfaces": true,
		"aliases_used": true,
		"rules_on_ingress_interface": true,
		"standard_rule_ordering": true,
		"vpn_method_reviewed": true,
		"rule_descriptions_standardized": true,
	},
}

fails(id, inp) if {
	v := data.cis_opnsense.violations with input as inp
	some x in v
	startswith(x, concat("", [id, ":"]))
}

missing(id, inp) if {
	v := data.cis_opnsense.violations with input as inp
	some x in v
	startswith(x, concat("", [id, ": evidence missing"]))
}

test_good_input_is_fully_compliant if {
	a := data.cis_opnsense.compliance_assessment with input as good_input
	a.compliant == true
	count(a.violations) == 0
	a.summary.compliance_percentage == 100
	a.summary.total_controls == 29
}

test_1_1_pass if not fails("1.1", good_input)

test_1_1_fail if {
	inp := json.patch(good_input, [{"op": "replace", "path": "/sshd_config", "value": "Banner none\n"}])
	fails("1.1", inp)
	not missing("1.1", inp)
}

test_1_1_fail_2 if {
	inp := json.patch(good_input, [{"op": "replace", "path": "/sshd_config", "value": "#Banner /etc/issue\n"}])
	fails("1.1", inp)
	not missing("1.1", inp)
}

test_1_1_evidence_missing if missing("1.1", json.remove(good_input, ["sshd_config"]))

test_1_2_pass if not fails("1.2", good_input)

test_1_2_fail if {
