_failed_ids := {id | some v in violations; id := split(v, ":")[0]}

_level_ids(l) := {id | some id in in_scope; recommendations[id].level == l}

_section_ids(s) := {id | some id in in_scope; recommendations[id].section == s}

section_results := {
	"control_plane": {"name": "Control plane components", "total": count(_section_ids(1)), "failed": count(_section_ids(1) & _failed_ids), "violations": control_plane_violations},
	"etcd": {"name": "etcd", "total": count(_section_ids(2)), "failed": count(_section_ids(2) & _failed_ids), "violations": etcd_violations},
	"control_plane_config": {"name": "Control plane configuration", "total": count(_section_ids(3)), "failed": count(_section_ids(3) & _failed_ids), "violations": control_plane_config_violations},
	"worker_nodes": {"name": "Worker nodes", "total": count(_section_ids(4)), "failed": count(_section_ids(4) & _failed_ids), "violations": worker_nodes_violations},
	"policies": {"name": "Policies", "total": count(_section_ids(5)), "failed": count(_section_ids(5) & _failed_ids), "violations": policies_violations},
}

default _pct := 0

_pct := round(((count(in_scope) - count(_failed_ids)) * 100000) / count(in_scope)) / 1000 if count(in_scope) > 0

compliance_report := {
	"framework": "cis_kubernetes",
	"benchmark": "CIS Kubernetes Benchmark v2.1.0",
	"version": "v2.1.0",
	"profile": {"level": level, "roles": sort([r | some r in node_roles])},
	"total_controls": count(in_scope),
	"benchmark_total_controls": count(recommendations),
	"standard_total": 134,
	"standard_total_source": "CIS Kubernetes Benchmark v2.1.0, recommendations counted from the CIS workbook",
	"failed_controls": count(_failed_ids),
	"passed_controls": count(in_scope) - count(_failed_ids),
	"compliance_percentage": _pct,
	"level_1": {"total": count(_level_ids(1)), "failed": count(_level_ids(1) & _failed_ids)},
	"level_2": {"total": count(_level_ids(2)), "failed": count(_level_ids(2) & _failed_ids)},
	"section_results": section_results,
	"compliant": compliant,
	"violation_count": count(violations),
	"violations": violations,
}
