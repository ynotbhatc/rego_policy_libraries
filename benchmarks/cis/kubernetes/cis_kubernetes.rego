		"level": 1,
		"assessment": "Manual",
		"profiles": ["Level 1 - Master Node"],
		"check": "attestation",
		"section": 5,
	},
	"5.2.13": {
		"title": "admission policy must keep unmasked procMount containers out except where approved",
		"level": 1,
		"assessment": "Manual",
		"profiles": ["Level 1 - Master Node"],
		"check": "attestation",
		"section": 5,
	},
	"5.3.1": {
		"title": "the CNI plugin in use must enforce ingress and egress NetworkPolicy",
