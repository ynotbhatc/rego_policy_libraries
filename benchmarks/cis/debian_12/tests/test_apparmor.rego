package cis_debian_12.apparmor_test

import rego.v1

# Generated by tools/cis_generators/gen_debian_12.py: a pass and a fail case for every recommendation,
# plus an evidence-missing case for every Automated one. Assertions key on '<id>: ' (colon included).

test_1_3_1_1_pass if {
	vs := data.cis_debian_12.apparmor.violations with input as {"packages": {"apparmor": true, "apparmor-utils": true}}
	count([v | some v in vs; startswith(v, "1.3.1.1: ")]) == 0
}

test_1_3_1_1_fail if {
	vs := data.cis_debian_12.apparmor.violations with input as {"packages": {"apparmor": false, "apparmor-utils": true}}
	count([v | some v in vs; startswith(v, "1.3.1.1: ")]) > 0
	not "1.3.1.1: evidence missing — packages[apparmor,apparmor-utils] not collected" in vs
}

test_1_3_1_1_evidence_missing if {
	vs := data.cis_debian_12.apparmor.violations with input as {}
	"1.3.1.1: evidence missing — packages[apparmor,apparmor-utils] not collected" in vs
}

