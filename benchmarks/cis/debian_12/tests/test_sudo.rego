package cis_debian_12.sudo_test

import rego.v1

# Generated by tools/cis_generators/gen_debian_12.py: a pass and a fail case for every recommendation,
# plus an evidence-missing case for every Automated one. Assertions key on '<id>: ' (colon included).

test_5_2_1_pass if {
	vs := data.cis_debian_12.sudo.violations with input as {"packages": {"sudo": false, "sudo-ldap": true}}
	count([v | some v in vs; startswith(v, "5.2.1: ")]) == 0
}

test_5_2_1_fail if {
	vs := data.cis_debian_12.sudo.violations with input as {"packages": {"sudo": false, "sudo-ldap": false}}
	count([v | some v in vs; startswith(v, "5.2.1: ")]) > 0
	not "5.2.1: evidence missing — packages[sudo,sudo-ldap] not collected" in vs
}

test_5_2_1_evidence_missing if {
	vs := data.cis_debian_12.sudo.violations with input as {}
	"5.2.1: evidence missing — packages[sudo,sudo-ldap] not collected" in vs
}

