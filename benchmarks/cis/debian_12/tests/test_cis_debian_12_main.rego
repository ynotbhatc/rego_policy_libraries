package cis_debian_12.main_test

import rego.v1

# Generated by tools/cis_generators/gen_debian_12.py: roll-up and bridge smoke tests.

test_every_recommendation_in_table if {
	count(data.cis_debian_12.controls) == 331
	count([c | some c in data.cis_debian_12.controls; c.assessment == "Manual"]) == 15
}

test_empty_input_fails_closed if {
	r := data.cis_debian_12.main.compliance_report with input as {}
	count(object.keys(r)) == 18
	every k in ["framework", "benchmark", "version", "profile", "total_controls", "standard_total", "controls_basis", "passed_controls", "failed_controls", "compliance_percentage", "section_compliance_percentage", "compliant", "violations", "violation_count", "section_results", "sections_not_assessed", "missing_inputs", "assessment_coverage_percentage"] { k in object.keys(r) }
	r.compliant == false
	r.total_controls == 331
	r.failed_controls == r.total_controls
	r.passed_controls == 0
	r.violation_count == count(r.violations)
	some v in r.violations
	startswith(v, "FAIL-CLOSED")
}

test_profile_level1_server_count if {
	r := data.cis_debian_12.main.compliance_report with input as {"profile": "level1_server"}
	r.profile == "level1_server"
	r.total_controls == 257
	r.standard_total == 331
	r.failed_controls == r.total_controls
}

test_profile_level2_server_count if {
	r := data.cis_debian_12.main.compliance_report with input as {"profile": "level2_server"}
	r.profile == "level2_server"
	r.total_controls == 331
	r.standard_total == 331
	r.failed_controls == r.total_controls
}

test_profile_level1_workstation_count if {
	r := data.cis_debian_12.main.compliance_report with input as {"profile": "level1_workstation"}
	r.profile == "level1_workstation"
	r.total_controls == 246
	r.standard_total == 331
	r.failed_controls == r.total_controls
}

test_profile_level2_workstation_count if {
	r := data.cis_debian_12.main.compliance_report with input as {"profile": "level2_workstation"}
	r.profile == "level2_workstation"
	r.total_controls == 323
	r.standard_total == 331
	r.failed_controls == r.total_controls
}

test_unknown_profile_is_not_selected_and_evaluates_everything if {
	r := data.cis_debian_12.main.compliance_report with input as {"profile": "bogus"}
	r.profile == "unrecognised"
	r.total_controls == 331
	r.compliant == false
	r.failed_controls == r.total_controls
	count([v | some v in r.violations; startswith(v, "PROFILE NOT SELECTED: ")]) == 1
}

test_absent_or_mistyped_profile_is_not_selected_and_never_compliant if {
	every p in [null, 1, true, [], {}, "", "Level1_Server", "level_1_server"] {
		r := data.cis_debian_12.main.compliance_report with input as {"profile": p, "attest": {"x": true}}
		r.profile == "unrecognised"
		r.compliant == false
		r.total_controls == 331
		count([v | some v in r.violations; startswith(v, "PROFILE NOT SELECTED: ")]) == 1
	}
	r0 := data.cis_debian_12.main.compliance_report with input as {"attest": {"x": true}}
	r0.profile == "unrecognised"
	r0.compliant == false
}

test_unselected_profile_with_nothing_failed_withholds_the_percentage if {
	r := data.cis_debian_12.main.compliance_report with input as {"attest": {"x": true}} with data.cis_debian_12.failing_ids as set()
	r.compliant == false
	r.failed_controls == 0
	r.passed_controls + r.failed_controls == r.total_controls
	r.compliance_percentage == null
	startswith(r.compliance_percentage_reason, "no profile selected")
}

test_one_attested_control_passes if {
	r := data.cis_debian_12.main.compliance_report with input as {"attest": {"apt_sources_signed_by_reviewed": true}}
	r.passed_controls == 1
	r.failed_controls == r.total_controls - 1
	r.compliant == false
}

test_unassessed_sections_listed if {
	r := data.cis_debian_12.main.compliance_report with input as {"ssh": {"sshd_config_raw": "permitrootlogin no"}}
	not "ssh" in r.sections_not_assessed
	"auditd" in r.sections_not_assessed
	r.assessment_coverage_percentage < 100
}

test_level2_violation_hidden_in_level1_profile if {
	vs := data.cis_debian_12.all_violations with input as {"profile": "level1_server"}
	count([v | some v in vs; startswith(v, "6.2.1.1: ")]) == 0
	vs2 := data.cis_debian_12.all_violations with input as {"profile": "level2_server"}
	count([v | some v in vs2; startswith(v, "6.2.1.1: ")]) > 0
}

# Semantic review 2026-11-13: a section with no applicable controls at the selected profile adds no NOT ASSESSED message.
test_no_not_assessed_message_for_section_without_applicable_controls if {
	r := data.cis_debian_12.main.compliance_report with input as {"ssh": {"sshd_config_raw": "permitrootlogin no"}, "profile": "level1_server"}
	"auditd" in r.sections_not_assessed
	every v in r.violations {
		not startswith(v, "NOT ASSESSED: auditd")
	}
}

test_not_assessed_message_kept_for_applicable_section if {
	r := data.cis_debian_12.main.compliance_report with input as {"ssh": {"sshd_config_raw": "permitrootlogin no"}, "profile": "level1_server"}
	some v in r.violations
	startswith(v, "NOT ASSESSED: ")
}

# #300 type traps: a non-number must not pass p_5_2_6.
test_p_5_2_6_number_type_traps if {
	data.cis_debian_12.sudo.p_5_2_6 with input as {"sudo": {"sudoers_raw": "", "default_timestamp_timeout": 15}}
	not data.cis_debian_12.sudo.p_5_2_6 with input as {"sudo": {"sudoers_raw": "", "default_timestamp_timeout": "1"}}
	not data.cis_debian_12.sudo.p_5_2_6 with input as {"sudo": {"sudoers_raw": "", "default_timestamp_timeout": null}}
	not data.cis_debian_12.sudo.p_5_2_6 with input as {"sudo": {"sudoers_raw": "", "default_timestamp_timeout": "not-a-number"}}
}
