test_1_6_1_pass if {
	vs := data.cis_debian_12.banners.violations with input as {"initial_setup": {"motd_exists": true, "motd_content": "Authorized uses only.", "motd_extra_files": [{"path": "/etc/motd.d/10-notice", "content": "Monitored."}]}}
