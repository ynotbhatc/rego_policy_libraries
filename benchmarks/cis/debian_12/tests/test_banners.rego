	vs := data.cis_debian_12.banners.violations with input as {"initial_setup": {"motd_exists": false, "motd_extra_files": [{"path": "/etc/update-motd.d/10-uname", "content": "Debian GNU/Linux 12 \\r"}]}}
	count([v | some v in vs; startswith(v, "1.6.1: ")]) > 0
	not "1.6.1: evidence missing — initial_setup.motd_exists/motd_content/motd_extra_files not collected" in vs
}

test_1_6_1_evidence_missing if {
	vs := data.cis_debian_12.banners.violations with input as {}
