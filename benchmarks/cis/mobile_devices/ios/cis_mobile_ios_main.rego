# METADATA
# title: "CIS Apple iOS 27 Benchmark v1.0.0 - compliance_report entrypoint"
# custom:
#   class: security
#   framework: cis_mobile_devices
#   source: cis
#   domains: [mobile, ios]
#   coverage:
#     checks: 0
#     cited: 0
#     density: orchestrator
#     basis: role
#     tested: true
#     entrypoint: compliance_report
#     guard: self
#     as_of: v2.4.2
package cis.mobile.ios.main

# OPA query path: /v1/data/cis/mobile/ios/main/compliance_report
# Thin bridge over data.cis.mobile.ios (generated by tools/cis_generators/gen_ios_27.py). That package fails closed per recommendation;
# this adds the fields every cis_*.main report carries and an explicit notice on empty input.

import data.cis.mobile.ios as bench
import rego.v1

default _facts_supplied := false

_facts_supplied if count(object.keys(input)) > 0

_total := count(bench.in_scope)

_failed_ids := {id | some v in bench.violations; id := split(v, ":")[0]; id in bench.in_scope}

_failed := count(_failed_ids)

default _pct := 0

_pct := round(((_total - _failed) * 100) / _total) if _total > 0

_no_facts_msg := "FAIL-CLOSED: no facts supplied for cis.mobile.ios — the assessment could not be evaluated. This is NOT a passing result; check that fact collection ran and produced input."

_report_violations := array.concat(sort([v | some v in bench.violations]), [_no_facts_msg]) if not _facts_supplied

_report_violations := sort([v | some v in bench.violations]) if _facts_supplied

compliant := bench.compliant

violations := bench.violations

compliance_report := object.union(bench.compliance_report, {
	"framework": "cis.mobile.ios",
	"version": "v1.0.0",
	"facts_supplied": _facts_supplied,
	"controls_basis": "recommendations of CIS Apple iOS 27 Benchmark v1.0.0 in the selected profile (input.cis_profile.ownership and level)",
	"total_controls": _total,
	"passed_controls": _total - _failed,
	"failed_controls": _failed,
	"compliance_percentage": _pct,
	"violations": _report_violations,
	"violation_count": count(_report_violations),
})
