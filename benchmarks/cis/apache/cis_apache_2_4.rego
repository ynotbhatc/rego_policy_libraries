_v_request_limits contains "10.4: required value of the LimitRequestBody Directive is 102400 or Less but not 0" if {
	_applies("10.4")
	e_10_4
	not r_10_4
}

# 11.1 (Automated, Level 2)
default r_11_1 := false

r_11_1 if {
	input.apache.selinux.enabled == true
	lower(input.apache.selinux.current_mode) == "enforcing"
	lower(input.apache.selinux.config_mode) == "enforcing"
}

default e_11_1 := false

e_11_1 if {
	is_object(input.apache.selinux)
	is_boolean(input.apache.selinux.enabled)
}

_v_selinux contains "11.1: evidence missing — apache.selinux not collected" if {
	_applies("11.1")
	not e_11_1
}

_v_selinux contains "11.1: SELinux must be turned on in Enforcing Mode" if {
	_applies("11.1")
	e_11_1
	not r_11_1
}

# 11.2 (Manual, Level 2) -- Manual in the workbook; decidable from configuration, so checked like Automated
default r_11_2 := false

r_11_2 if {
	every t in input.apache.selinux.httpd_process_types { t == "httpd_t" }
}

default e_11_2 := false

e_11_2 if {
	is_array(input.apache.selinux.httpd_process_types)
	count(input.apache.selinux.httpd_process_types) > 0
}

_v_selinux contains "11.2: evidence missing — apache.selinux.httpd_process_types not collected" if {
	_applies("11.2")
	not e_11_2
}

_v_selinux contains "11.2: checked condition — Apache Processes Run in the httpd_t Confined Context" if {
	_applies("11.2")
	e_11_2
	not r_11_2
}

# 11.3 (Automated, Level 2)
default r_11_3 := false

r_11_3 if {
	input.apache.selinux.httpd_t_permissive == false
}

default e_11_3 := false

e_11_3 if {
	is_boolean(input.apache.selinux.httpd_t_permissive)
}

_v_selinux contains "11.3: evidence missing — apache.selinux.httpd_t_permissive not collected" if {
	_applies("11.3")
	not e_11_3
}

_v_selinux contains "11.3: the httpd_t Type must be Not in Permissive Mode" if {
	_applies("11.3")
	e_11_3
	not r_11_3
}

# 11.4 (Manual, Level 2) -- Manual in the workbook; decidable from configuration, so checked like Automated
default r_11_4 := false

r_11_4 if {
	every b in input.apache.selinux.enabled_httpd_booleans { b in _approved_booleans }
}

default e_11_4 := false

e_11_4 if {
	is_array(input.apache.selinux.enabled_httpd_booleans)
	is_array(input.apache.selinux.approved_httpd_booleans)
}

_v_selinux contains "11.4: evidence missing — apache.selinux.{enabled_httpd_booleans,approved_httpd_booleans} not collected" if {
	_applies("11.4")
	not e_11_4
}

_v_selinux contains "11.4: Only the Necessary SELinux Booleans must be turned on" if {
	_applies("11.4")
	e_11_4
	not r_11_4
}

# 12.1 (Automated, Level 2)
default r_12_1 := false

r_12_1 if {
	input.apache.apparmor.enabled == true
}

default e_12_1 := false

e_12_1 if {
	is_boolean(input.apache.apparmor.enabled)
}

_v_apparmor contains "12.1: evidence missing — apache.apparmor.enabled not collected" if {
	_applies("12.1")
	not e_12_1
}

_v_apparmor contains "12.1: the AppArmor Framework must be turned on" if {
	_applies("12.1")
	e_12_1
	not r_12_1
}

# 12.2 (Manual, Level 2) -- Manual in the workbook; decidable from configuration, so checked like Automated
default r_12_2 := false

r_12_2 if {
	input.apache.apparmor.profile.present == true
	count(input.apache.apparmor.profile.wildcard_root_rules) == 0
}

default e_12_2 := false

e_12_2 if {
	is_object(input.apache.apparmor.profile)
	is_array(input.apache.apparmor.profile.wildcard_root_rules)
}

_v_apparmor contains "12.2: evidence missing — apache.apparmor.profile not collected" if {
	_applies("12.2")
	not e_12_2
}

_v_apparmor contains "12.2: the Apache AppArmor Profile must be explicitly configured Properly" if {
	_applies("12.2")
	e_12_2
	not r_12_2
}

# 12.3 (Automated, Level 2)
default r_12_3 := false

r_12_3 if {
	every p in input.apache.apparmor.apache_processes { p.confinement == "enforce" }
}

default e_12_3 := false

e_12_3 if {
	is_array(input.apache.apparmor.apache_processes)
	count(input.apache.apparmor.apache_processes) > 0
}

_v_apparmor contains "12.3: evidence missing — apache.apparmor.apache_processes not collected" if {
	_applies("12.3")
	not e_12_3
}

_v_apparmor contains "12.3: Apache AppArmor Profile must be in Enforce Mode" if {
	_applies("12.3")
	e_12_3
	not r_12_3
}

