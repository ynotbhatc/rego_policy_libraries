package cis_openshift_4

# CIS Red Hat OpenShift Container Platform Benchmark v2.0.0. Generated by tools/cis_generators/gen_openshift.py from the CIS workbook: do not edit
# by hand, regenerate. Replaces the hand-written module (156 declared controls, abstract input.openshift booleans)
# that lived in this directory; the package name and the cis_openshift.main entrypoint are unchanged.
#
# 115 recommendations, every one in the benchmark (13 Automated, 102 Manual); ids, status and profile
# are read from the workbook. `recommendations` lists each id with its level, status and profile.
# - 101 are decided from collected facts and fail closed: facts not collected =>
#   "<id>: evidence missing — <field> not collected".
# - 88 of those are Manual in the workbook but their audit is an oc query, file stat or object
#   comparison, so they are checked like Automated ones.
# - 3 of the fact checks also need an attestation for the part of the audit that is a judgement:
#   3.2.1, 5.1.1, 5.5.1
# - 14 need a human judgement and read an attestation boolean under input.attest (not attested => violation):
#   1.2.19, 3.2.2, 4.2.1, 4.2.8, 5.1.2, 5.1.3, 5.1.4, 5.1.5, 5.1.6, 5.2.10, 5.3.1, 5.4.2, 5.7.1, 5.7.3
#
# Profiles: Level 1 (99) and Level 2 (16). input.cis_profile.level selects 1 or 2 (default 2; Level 2
# includes Level 1). A recommendation outside the selection raises nothing and is not counted in total_controls.
#
# Input contract. Shapes follow the CIS Kubernetes module (benchmarks/cis/kubernetes) and the DISA OpenShift STIG
# module (benchmarks/stig/openshift_4) where the fact is the same, so one collector feeds them; "NEW" marks the
# paths this module adds. Audits run per node, per pod or per etcd member: every entry of a list must pass, and an
# empty list counts as not collected.
#   files.<group>[]                  : {path, mode, owner, group}; mode is an octal STRING ("0600"), compared with bit
#                                      masks. Groups shared with cis_kubernetes: manifests (kube-apiserver-pod,
#                                      kube-controller-manager-pod, kube-scheduler-pod, etcd-pod), cni (multus and
#                                      openshift-sdn files), etcd_data (/var/lib/etcd/member), pki (everything under
#                                      */secrets* in the static-pod certs and resources trees), kubelet_service,
#                                      kube_proxy_kubeconfig (/config/kube-proxy-config.yaml in the sdn pods),
#                                      kubelet_kubeconfig, kubelet_client_ca, kubelet_config_yaml (the kubelet
#                                      config.json); NEW: ovs (Open vSwitch files), node_kubeconfig
#                                      (/etc/kubernetes/kubeconfig), scheduler_kubeconfig, controller_manager_kubeconfig
#   kube_proxy.running               : bool; false (no openshift-sdn pods) passes 4.1.3 and 4.1.4
#   etcd.members[]                   : NEW {name, flags}; flags = the etcd command line of each member, flag name ->
#                                      string ("--a_b" == "a-b"; a flag under two spellings is ambiguous and fails)
#   kubelet.nodes[]                  : NEW {name, config}; config = .kubeletconfig from /api/v1/nodes/<node>/proxy/configz
#   openshift.kube_apiserver_config  : NEW parsed config.yaml of configmap config in openshift-kube-apiserver
#                                      (apiServerArguments: name -> [string], servingInfo, serviceAccountPublicKeyFiles)
#   openshift.openshift_apiserver_config : NEW parsed config.yaml of configmap config in openshift-apiserver
#   openshift.kube_controller_manager_config : NEW parsed config.yaml of configmap config in
#                                      openshift-kube-controller-manager (extendedArguments: name -> [string])
#   openshift.kube_controller_manager_pod / openshift.kube_scheduler_pod : NEW parsed pod.yaml of the
#                                      kube-controller-manager-pod / kube-scheduler-pod configmaps
#   openshift.kubeapiserver          : NEW kubeapiservers.operator.openshift.io/cluster (spec.observedConfig,
#                                      spec.unsupportedConfigOverrides)
#   openshift.openshiftapiserver     : NEW openshiftapiservers.operator.openshift.io/cluster (spec.observedConfig,
#                                      status.conditions)
#   openshift.apiserver              : NEW apiservers.config.openshift.io/cluster (spec.tlsSecurityProfile)
#   openshift.ingresscontroller_default : NEW ingresscontroller/default in openshift-ingress-operator (status.tlsProfile)
#   openshift.authentication_cliconfig : NEW parsed v4-0-config-system-cliconfig of openshift-authentication
#   openshift.image_config           : NEW image.config.openshift.io/cluster
#   openshift.openshift_apiserver_serving_cert : NEW {type, data_keys[]} of secret serving-cert in openshift-apiserver
#   openshift.kube_apiserver_endpoint_ports[] / openshift.openshift_apiserver_endpoint_ports[] /
#   openshift.kube_apiserver_container_ports[] : NEW port numbers
#   openshift.metrics_probes.<c>     : NEW {unauthenticated, service_account, cluster_admin} HTTP status of a GET on the
#                                      /metrics endpoint, c = kube_apiserver | kube_controller_manager | kube_scheduler |
#                                      kube_scheduler_pod_ip (401 and 403 both count as denied)
#   openshift.audit_logs             : NEW {kube_apiserver_file_present, openshift_apiserver_file_present,
#                                      kube_apiserver_node_logs, openshift_apiserver_node_logs} booleans
#   openshift.unauthenticated_cluster_role_bindings[] : NEW names of ClusterRoleBindings with system:unauthenticated
#   openshift.cluster_admin_bindings[] : NEW {name, subjects[{kind, name}]} ClusterRoleBindings to cluster-admin
#   openshift.pods_without_seccomp_profile[] : NEW namespace/name of non-system pods with no pod seccompProfile
#   scc.items[]                      : NEW the SecurityContextConstraints objects (oc get scc -o json .items)
#   api_server.audit_profile         : APIServer spec.audit.profile (STIG OpenShift contract)
#   oauth.identity_providers[]       : OAuth cluster spec.identityProviders (STIG OpenShift contract)
#   cluster.kubeadmin_user_exists    : bool, secret kubeadmin in kube-system exists (STIG OpenShift contract)
#   network_policies.namespaces_without_policy[], secrets.env_var_usage_count,
#   cluster.namespace_resources.default : as in cis_kubernetes ("service/kubernetes" style names)
#   collection_status.<query>        : "ok" when the cluster query ran to completion: network_policies,
#                                      secret_env_scan, namespace_resources, and NEW scc, cluster_admin_bindings,
#                                      unauthenticated_bindings, pod_seccomp
#   attest.<key>                     : attestation booleans

import rego.v1

default compliant := false

compliant if {
	count(in_scope) > 0
	count(violations) == 0
}

violations := sort([m | some m in _all_violations])

# Section 1: Control plane components
control_plane_violations := sort([m | some m in _v_control_plane])

_all_violations contains m if some m in _v_control_plane

# Section 2: etcd
etcd_violations := sort([m | some m in _v_etcd])

_all_violations contains m if some m in _v_etcd

# Section 3: Control plane configuration
control_plane_config_violations := sort([m | some m in _v_control_plane_config])

_all_violations contains m if some m in _v_control_plane_config

# Section 4: Worker nodes
worker_nodes_violations := sort([m | some m in _v_worker_nodes])

_all_violations contains m if some m in _v_worker_nodes

# Section 5: Policies
policies_violations := sort([m | some m in _v_policies])

_all_violations contains m if some m in _v_policies

# ── profile ──────────────────────────────────────────────────────────────────
default _cis_profile := {}

_cis_profile := p if {
	p := input.cis_profile
	is_object(p)
}

default level := 2

level := 1 if _cis_profile.level == 1

_selected_profiles := {sprintf("Level %d", [l]) | some l in numbers.range(1, level)}

in_scope contains id if {
	some id, r in recommendations
	some p in r.profiles
	p in _selected_profiles
}

_applies(id) if id in in_scope

# ── values ───────────────────────────────────────────────────────────────────
_nonempty(s) if {
	is_string(s)
	trim_space(s) != ""
}

_bool(v) := "true" if lower(trim_space(v)) in {"1", "t", "true"}

_bool(v) := "false" if lower(trim_space(v)) in {"0", "f", "false"}

_port(p) := p if is_number(p)

_port(p) := to_number(p) if {
	is_string(p)
	regex.match(`^[0-9]+$`, p)
}

# ── OpenShift objects and config files under input.openshift ─────────────────
_obj(name) := o if {
	o := object.get(input, ["openshift", name], null)
	is_object(o)
}

_collected(name) if _obj(name)

# <field>[<name>] of a parsed OpenShift config file as a list of strings: [] when the argument is absent, undefined
# when the file was not collected or the value is not a list of strings (a malformed value fails every check).
_arg(o, field, name) := [] if {
	m := object.get(_obj(o), field, {})
	is_object(m)
	not name in object.keys(m)
}

_arg(o, field, name) := l if {
	l := _obj(o)[field][name]
	is_array(l)
	every x in l { is_string(x) }
}

_kas(name) := _arg("kube_apiserver_config", "apiServerArguments", name)

_oas(name) := _arg("openshift_apiserver_config", "apiServerArguments", name)

_kcm(name) := _arg("kube_controller_manager_config", "extendedArguments", name)

# comma-separated entries of a list argument as a set
_list_set(l) := {trim_space(x) | some e in l; some x in split(e, ","); trim_space(x) != ""}

_kas_set(name) := _list_set(_kas(name))

# the argument is readable and does not list <x>
_kas_lacks(name, x) if {
	s := _kas_set(name)
	not x in s
}

_all_eq(l, v) if {
	count(l) > 0
	every x in l { trim_space(x) == v }
}

_all_nonempty(l) if {
	count(l) > 0
	every x in l { _nonempty(x) }
}

_all_num_min(l, n) if {
	count(l) > 0
	every x in l {
		regex.match(`^[0-9]+$`, trim_space(x))
		to_number(trim_space(x)) >= n
	}
}

_all_true(l) if {
	count(l) > 0
	every x in l { _bool(x) == "true" }
}

# an optional boolean argument: absent, or every value true
_absent_or_true(l) if every x in l { _bool(x) == "true" }

# feature gates of the kube-apiserver operator's observed configuration ("Name=bool" entries)
_op_args(name) := [] if {
	m := object.get(_obj("kubeapiserver"), ["spec", "observedConfig", "apiServerArguments"], {})
	is_object(m)
	not name in object.keys(m)
}

_op_args(name) := l if {
	l := _obj("kubeapiserver").spec.observedConfig.apiServerArguments[name]
	is_array(l)
	every x in l { is_string(x) }
}

_gate_vals(name) := [_gate_val(p) |
	some e in _list_set(_op_args("feature-gates"))
	p := split(e, "=")
	trim_space(p[0]) == name
]

_gate_val(p) := b if {
	count(p) == 2
	b := _bool(p[1])
}

_gate_val(p) := "invalid" if count(p) != 2

_gate_val(p) := "invalid" if {
	count(p) == 2
	not _bool(p[1])
}

# never switched off (an absent gate keeps its default)
_gate_never_false(name) if {
	vals := _gate_vals(name)
	every v in vals { v == "true" }
}

_gate_never_true(name) if {
	vals := _gate_vals(name)
	every v in vals { v == "false" }
}

_ports_all(name, port) if {
	l := object.get(input, ["openshift", name], null)
	is_array(l)
	count(l) > 0
	every p in l { _port(p) == port }
}

_ports_collected(name) if {
	l := object.get(input, ["openshift", name], null)
	is_array(l)
	count(l) > 0
}

_serving_cert_ok if {
	s := _obj("openshift_apiserver_serving_cert")
	s.type == "kubernetes.io/tls"
	is_array(s.data_keys)
	"tls.crt" in s.data_keys
	"tls.key" in s.data_keys
}

# ── metrics endpoint probes ──────────────────────────────────────────────────
_probe(c) := p if {
	p := object.get(input, ["openshift", "metrics_probes", c], null)
	is_object(p)
	every k in ["unauthenticated", "service_account", "cluster_admin"] { is_number(p[k]) }
}

_denied(code) if code in {401, 403}

_probe_protected(c) if {
	p := _probe(c)
	_denied(p.unauthenticated)
	_denied(p.service_account)
	p.cluster_admin == 200
}

_container(o, cname) := c if {
	some c in _obj(o).spec.containers
	c.name == cname
}

_healthz(p) if trim_prefix(p, "/") == "healthz"

_probes_healthz(o, cname) if {
	c := _container(o, cname)
	_healthz(c.livenessProbe.httpGet.path)
	_healthz(c.readinessProbe.httpGet.path)
}

# every whitespace-separated token of a container's command and args
_container_tokens(o, cname) := toks if {
	c := _container(o, cname)
	words := array.concat(object.get(c, "command", []), object.get(c, "args", []))
	toks := [t | some a in words; is_string(a); some t in regex.split(`\s+`, trim_space(a)); t != ""]
}

_scheduler_no_bind_or_port if {
	toks := _container_tokens("kube_scheduler_pod", "kube-scheduler")
	every t in toks { not regex.match(`^--?(bind-address|port)(=|$)`, t) }
}

# ── TLS ──────────────────────────────────────────────────────────────────────
_tls_ok(v) if v in {"VersionTLS12", "VersionTLS13"}

_tls_profile := object.get(_obj("apiserver"), ["spec", "tlsSecurityProfile"], null)

# absent or empty means the Intermediate default
_tls_profile_ok if _tls_profile in {null, {}}

_tls_profile_ok if _tls_profile.type in {"Intermediate", "Modern"}

_tls_profile_ok if {
	_tls_profile.type == "Custom"
	_tls_ok(_tls_profile.custom.minTLSVersion)
}

_strong_go := {"TLS_AES_128_GCM_SHA256", "TLS_AES_256_GCM_SHA384", "TLS_CHACHA20_POLY1305_SHA256", "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256", "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384", "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305", "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256", "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256", "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384", "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305", "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256", "TLS_RSA_WITH_AES_128_GCM_SHA256", "TLS_RSA_WITH_AES_256_GCM_SHA384"}

_strong_openssl := {"AES128-GCM-SHA256", "AES256-GCM-SHA384", "ECDHE-ECDSA-AES128-GCM-SHA256", "ECDHE-ECDSA-AES256-GCM-SHA384", "ECDHE-ECDSA-CHACHA20-POLY1305", "ECDHE-RSA-AES128-GCM-SHA256", "ECDHE-RSA-AES256-GCM-SHA384", "ECDHE-RSA-CHACHA20-POLY1305", "TLS_AES_128_GCM_SHA256", "TLS_AES_256_GCM_SHA384", "TLS_CHACHA20_POLY1305_SHA256"}

_suites_strong(l) if {
	is_array(l)
	count(l) > 0
	every s in l { s in _strong_go }
}

# ── etcd members, kubelet nodes, SCCs ────────────────────────────────────────
default _etcd_members_collected := false

_etcd_members_collected if {
	ms := input.etcd.members
	is_array(ms)
	count(ms) > 0
	every m in ms { is_object(m.flags) }
}

# etcd normalises flag names ("--a_b" == "a-b"); a value is read only when exactly one key normalises to it
_norm(k) := replace(trim_left(k, "-"), "_", "-")

_mkeys(m, name) := [k | some k, _ in m.flags; _norm(k) == name]

_munset(m, name) if count(_mkeys(m, name)) == 0

_mfl(m, name) := v if {
	ks := _mkeys(m, name)
	count(ks) == 1
	v := m.flags[ks[0]]
	is_string(v)
}

_m_nonempty(m, name) if _nonempty(_mfl(m, name))

_m_true(m, name) if _bool(_mfl(m, name)) == "true"

_m_not_true(m, name) if _munset(m, name)

_m_not_true(m, name) if _bool(_mfl(m, name)) == "false"

_m_is(m, name, v) if trim_space(_mfl(m, name)) == v

default _kubelet_nodes_collected := false

_kubelet_nodes_collected if {
	ns := input.kubelet.nodes
	is_array(ns)
	count(ns) > 0
	every n in ns { is_object(n.config) }
}

# streamingConnectionIdleTimeout: absent or null keeps the 4h default; 0 disables the timeout
_idle_ok(c) if not "streamingConnectionIdleTimeout" in object.keys(c)

_idle_ok(c) if c.streamingConnectionIdleTimeout == null

_idle_ok(c) if {
	v := c.streamingConnectionIdleTimeout
	is_string(v)
	time.parse_duration_ns(v) > 0
}

default _kube_proxy_files_collected := false

_kube_proxy_files_collected if input.kube_proxy.running == false

_kube_proxy_files_collected if {
	input.kube_proxy.running == true
	count(_files("kube_proxy_kubeconfig")) > 0
}

default _scc_collected := false

_scc_collected if {
	is_array(input.scc.items)
	count(input.scc.items) > 0
	input.collection_status.scc == "ok"
}

_default_ns_allowed(r) if {
	is_string(r)
	regex.match(`^(?i)service/[^/]*(openshift|kubernetes)[^/]*$`, r)
}

_unauthenticated_default := {"self-access-reviewers", "system:oauth-token-deleters", "system:openshift:public-info-viewer", "system:public-info-viewer", "system:scope-impersonation", "system:webhooks"}

# ── files ────────────────────────────────────────────────────────────────────
# a collected, non-empty file list (an empty list proves nothing)
_files(g) := fs if {
	fs := object.get(input, ["files", g], null)
	is_array(fs)
	count(fs) > 0
}

_base(p) := b if {
	parts := split(trim_right(p, "/"), "/")
	b := parts[count(parts) - 1]
}

_stem(p) := regex.replace(_base(p), `\.(yaml|yml|json|manifest)$`, "")

# entries whose file name (less a manifest extension) is <stem>
_named(g, stem) := [x | some x in _files(g); is_string(x.path); _stem(x.path) == stem]

_has_named(g, stem) if count(_named(g, stem)) > 0

_owned(x, owner, group) if {
	x.owner == owner
	x.group == group
}

_pki_certs(g) := [x | some x in _files(g); is_string(x.path); endswith(x.path, ".crt")]

_pki_keys(g) := [x | some x in _files(g); is_string(x.path); endswith(x.path, ".key")]

# Parse an octal permission STRING ("600", "0600", "0o600") to an integer. A number is ambiguous (644 decimal
# or octal?) and anything else is not a mode: both are undefined, so the check fails.
octal(s) := n if {
	is_string(s)
	t := trim_prefix(lower(trim_space(s)), "0o")
	regex.match(`^[0-7]{1,4}$`, t)
	p := concat("", [substring("0000", 0, 4 - count(t)), t])
	ds := [to_number(substring(p, i, 1)) | some i in numbers.range(0, 3)]
	n := ((ds[0] * 512) + (ds[1] * 64)) + ((ds[2] * 8) + ds[3])
}

# true when mode sets no permission bit (setuid, setgid and sticky included) beyond max
mode_within(mode, max) if bits.and(octal(mode), bits.and(bits.negate(octal(max)), 4095)) == 0

# 1.1.1 (Manual, Level 1) -- Manual in the workbook; decidable from configuration, so checked like Automated
default r_1_1_1 := false

r_1_1_1 if {
	every f in _named("manifests", "kube-apiserver-pod") { mode_within(f.mode, "600") }
}

default e_1_1_1 := false

e_1_1_1 if {
	_has_named("manifests", "kube-apiserver-pod")
}

_v_control_plane contains "1.1.1: evidence missing — files.manifests entry for kube-apiserver-pod not collected" if {
	_applies("1.1.1")
	not e_1_1_1
}

_v_control_plane contains "1.1.1: kube-apiserver static pod specification file mode must be 600 or stricter" if {
	_applies("1.1.1")
	e_1_1_1
	not r_1_1_1
}

# 1.1.2 (Manual, Level 1) -- Manual in the workbook; decidable from configuration, so checked like Automated
default r_1_1_2 := false

r_1_1_2 if {
	every f in _named("manifests", "kube-apiserver-pod") { _owned(f, "root", "root") }
}

default e_1_1_2 := false

e_1_1_2 if {
	_has_named("manifests", "kube-apiserver-pod")
}

_v_control_plane contains "1.1.2: evidence missing — files.manifests entry for kube-apiserver-pod not collected" if {
	_applies("1.1.2")
	not e_1_1_2
}

_v_control_plane contains "1.1.2: kube-apiserver static pod specification file must be owned by root:root" if {
	_applies("1.1.2")
	e_1_1_2
	not r_1_1_2
}

# 1.1.3 (Manual, Level 1) -- Manual in the workbook; decidable from configuration, so checked like Automated
default r_1_1_3 := false

r_1_1_3 if {
	every f in _named("manifests", "kube-controller-manager-pod") { mode_within(f.mode, "600") }
}

default e_1_1_3 := false

e_1_1_3 if {
	_has_named("manifests", "kube-controller-manager-pod")
}

_v_control_plane contains "1.1.3: evidence missing — files.manifests entry for kube-controller-manager-pod not collected" if {
	_applies("1.1.3")
	not e_1_1_3
}

_v_control_plane contains "1.1.3: kube-controller-manager static pod specification file mode must be 600 or stricter" if {
	_applies("1.1.3")
	e_1_1_3
	not r_1_1_3
}

# 1.1.4 (Manual, Level 1) -- Manual in the workbook; decidable from configuration, so checked like Automated
default r_1_1_4 := false

r_1_1_4 if {
	every f in _named("manifests", "kube-controller-manager-pod") { _owned(f, "root", "root") }
}

default e_1_1_4 := false

e_1_1_4 if {
	_has_named("manifests", "kube-controller-manager-pod")
}

_v_control_plane contains "1.1.4: evidence missing — files.manifests entry for kube-controller-manager-pod not collected" if {
	_applies("1.1.4")
	not e_1_1_4
}

_v_control_plane contains "1.1.4: kube-controller-manager static pod specification file must be owned by root:root" if {
	_applies("1.1.4")
	e_1_1_4
	not r_1_1_4
}

# 1.1.5 (Manual, Level 1) -- Manual in the workbook; decidable from configuration, so checked like Automated
default r_1_1_5 := false

r_1_1_5 if {
	every f in _named("manifests", "kube-scheduler-pod") { mode_within(f.mode, "600") }
}

default e_1_1_5 := false

e_1_1_5 if {
	_has_named("manifests", "kube-scheduler-pod")
}

_v_control_plane contains "1.1.5: evidence missing — files.manifests entry for kube-scheduler-pod not collected" if {
	_applies("1.1.5")
	not e_1_1_5
}

_v_control_plane contains "1.1.5: kube-scheduler static pod specification file mode must be 600 or stricter" if {
	_applies("1.1.5")
	e_1_1_5
	not r_1_1_5
}

# 1.1.6 (Manual, Level 1) -- Manual in the workbook; decidable from configuration, so checked like Automated
