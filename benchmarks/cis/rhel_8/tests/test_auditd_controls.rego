# every recommendation of the section satisfied at once (the inputs above merged)
test_auditd_section_compliant_on_merged_good_input if {
	vs := data.cis_rhel8.auditd.violations with input as {"packages": {"audit": true, "audit-libs": true}, "boot_security": {"kernel_args": ["ro audit=1 audit_backlog_limit=8192"]}, "bootloader": {"grub_config": "GRUB_CMDLINE_LINUX=\"audit=1 audit_backlog_limit=8192\""}, "services": {"sshd.service": {"state": "running", "status": "enabled"}, "auditd.service": {"state": "running", "status": "enabled"}}, "auditd": {"config": "max_log_file = 8\nmax_log_file_action = keep_logs\ndisk_full_action = halt\ndisk_error_action = syslog\nspace_left_action = email\nadmin_space_left_action = single\nlog_group = adm", "rules": ["-w /etc/sudoers -p wa -k k", "-w /etc/sudoers.d -p wa -k k", "-a always,exit -F arch=b64 -S execve -C euid!=uid -F auid!=unset -k k", "-a always,exit -F arch=b32 -S execve -C euid!=uid -F auid!=unset -k k", "-w /var/log/sudo.log -p wa -k k", "-w /etc/localtime -p wa -k k", "-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k k", "-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime -k k", "-w /etc/issue -p wa -k k", "-w /etc/issue.net -p wa -k k", "-w /etc/hosts -p wa -k k", "-w /etc/hostname -p wa -k k", "-w /etc/sysconfig/network -p wa -k k", "-w /etc/sysconfig/network-scripts -p wa -k k", "-w /etc/NetworkManager -p wa -k k", "-a always,exit -F arch=b64 -S sethostname,setdomainname -k k", "-a always,exit -F arch=b32 -S sethostname,setdomainname -k k", "-a always,exit -F path=/usr/bin/su -F perm=x -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b64 -S creat,open,openat,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b32 -S creat,open,openat,truncate,ftruncate -F exit=-EACCES -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b64 -S creat,open,openat,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b32 -S creat,open,openat,truncate,ftruncate -F exit=-EPERM -F auid>=1000 -F auid!=unset -k k", "-w /etc/group -p wa -k k", "-w /etc/passwd -p wa -k k", "-w /etc/gshadow -p wa -k k", "-w /etc/shadow -p wa -k k", "-w /etc/security/opasswd -p wa -k k", "-w /etc/nsswitch.conf -p wa -k k", "-w /etc/pam.conf -p wa -k k", "-w /etc/pam.d -p wa -k k", "-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b64 -S chown,fchown,lchown,fchownat -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b32 -S chown,fchown,lchown,fchownat -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b32 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b32 -S mount -F auid>=1000 -F auid!=unset -k k", "-w /var/run/utmp -p wa -k k", "-w /var/log/wtmp -p wa -k k", "-w /var/log/btmp -p wa -k k", "-w /var/log/lastlog -p wa -k k", "-w /var/run/faillock -p wa -k k", "-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=unset -k k", "-w /etc/selinux -p wa -k k", "-w /usr/share/selinux -p wa -k k", "-a always,exit -F path=/usr/bin/chcon -F perm=x -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F path=/usr/bin/setfacl -F perm=x -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F path=/usr/bin/chacl -F perm=x -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F path=/usr/sbin/usermod -F perm=x -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F path=/usr/bin/kmod -F perm=x -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid!=unset -k k", "-D", "-c", "-e 2"], "active_rules": ["-w /etc