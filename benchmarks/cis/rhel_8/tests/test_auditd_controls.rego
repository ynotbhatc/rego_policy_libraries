txattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b32 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b32 -S mount -F auid>=1000 -F auid!=unset -k k", "-w /var/run/utmp -p wa -k k", "-w /var/log/wtmp -p wa -k k", "-w /var/log/btmp -p wa -k k", "-w /var/log/lastlog -p wa -k k", "-w /var/run/faillock -p wa -k k", "-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=unset -k k", "-w /etc/selinux -p wa -k k", "-w /usr/share/selinux -p wa -k k", "-a always,exit -F path=/usr/bin/chcon -F perm=x -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F path=/usr/bin/setfacl -F perm=x -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F path=/usr/bin/chacl -F perm=x -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F path=/usr/sbin/usermod -F perm=x -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F path=/usr/bin/kmod -F perm=x -F auid>=1000 -F auid!=unset -k k", "-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid!=unset -k k"], "privileged_commands": ["/usr/bin/su"], "log_dir_permissions": {"mode": "0750"}, "log_permissions": {"mode": "0600", "pw_name": "root", "gr_name": "adm"}, "config_permissions": [{"stat": {"path": "/etc/audit/auditd.conf", "mode": "0640", "pw_name": "root", "gr_name": "root"}}], "tools_permissions": [{"stat": {"path": "/usr/sbin/auditctl", "mode": "0755", "pw_name": "root", "gr_name": "root"}}]}, "sudo": {"sudoers_content": "Defaults logfile=\"/var/log/sudo.log\""}, "attest": {"audit_rules_running_match_disk": true}}
