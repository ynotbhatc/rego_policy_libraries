# every recommendation of the section satisfied at once (the inputs above merged)
test_logging_section_compliant_on_merged_good_input if {
	vs := data.cis_rhel8.logging.violations with input as {"journald": {"service_active": true, "forward_to_syslog": "yes", "storage_mode": "persistent", "compress_enabled": "yes"}, "attest": {"journald_file_access_reviewed": true, "journald_rotation_reviewed": true, "journal_remote_authentication_configured": true, "rsyslog_logging_rules_reviewed": true, "rsyslog_remote_host_configured": true, "logrotate_reviewed": true}, "packages": {"systemd-journal-remote": true}, "services": {"sshd.service": {"state": "running", "status": "enabled"}, "systemd-journal-upload.service": {"state": "running", "status": "enabled"}, "systemd-journal-remote.socket": {"state": "inactive", "status": "not-found"}, "systemd-journal-remote.service": {"state": "inactive", "status": "not-found"}}, "rsyslog": {"installed": true, "service_enabled": true, "service_active": true, "file_create_mode": "0640", "config_raw": "*.* /var/log/messages"}, "log_file_permissions": {"analysis": [{"file": "/var/log/messages", "actual_mode": "0600", "actual_owner": "root", "actual_group": "root"}, {"file": "/var/log/wtmp", "actual_mode": "0664", "actual_owner": "root", "actual_group": "utmp"}, {"file": "/var/log/chrony/measurements.log", "actual_mode": "0640", "actual_owner": "chrony", "actual_group": "chrony", "owner_has_login_shell": false}]}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_logging_violations_carry_section_ids if {
	vs := data.cis_rhel8.logging.violations with input as {}
	every v in vs { split(v, ":")[0] in ["6.2.1.1.1", "6.2.1.1.2", "6.2.1.1.3", "6.2.1.1.4", "6.2.1.1.5", "6.2.1.1.6", "6.2.1.2.1", "6.2.1.2.2", "6.2.1.2.3", "6.2.1.2.4", "6.2.2.1", "6.2.2.2", "6.2.2.3", "6.2.2.4", "6.2.2.5", "6.2.2.6", "6.2.2.7", "6.2.2.8", "6.2.3.1"] }
}

# the logging method: rsyslog active makes the journald-only recommendations not applicable, and the reverse
test_rsyslog_method_journal_upload_not_applicable if {
	vs := data.cis_rhel8.logging.violations with input as {"rsyslog": {"installed": true, "service_active": true}}
	count([v | some v in vs; startswith(v, "6.2.1.2.1: ")]) == 0
	count([v | some v in vs; startswith(v, "6.2.1.2.3: ")]) == 0
	count([v | some v in vs; startswith(v, "6.2.1.1.4: ")]) == 0
}

test_journald_method_rsyslog_not_applicable if {
	vs := data.cis_rhel8.logging.violations with input as {"rsyslog": {"installed": false}}
	count([v | some v in vs; startswith(v, "6.2.2.1: ")]) == 0
	count([v | some v in vs; startswith(v, "6.2.2.3: ")]) == 0
	count([v | some v in vs; startswith(v, "6.2.1.2.1: ")]) > 0
}

test_rsyslog_method_forward_to_syslog_required if {
	vs := data.cis_rhel8.logging.violations with input as {"rsyslog": {"service_active": true}, "journald": {"forward_to_syslog": "no"}}
	count([v | some v in vs; startswith(v, "6.2.2.3: not met")]) > 0
}

test_remote_receive_module_with_params_flagged if {
	vs := data.cis_rhel8.logging.violations with input as {"rsyslog": {"installed": true, "service_active": true, "config_raw": "module(load=\"imtcp\" MaxSessions=\"500\")\n"}}
	count([v | some v in vs; startswith(v, "6.2.2.7: not met")]) > 0
}

test_remote_receive_commented_not_flagged if {
	vs := data.cis_rhel8.logging.violations with input as {"rsyslog": {"installed": true, "service_active": true, "config_raw": "#module(load=\"imtcp\")\n*.* /var/log/messages\n"}}
	count([v | some v in vs; startswith(v, "6.2.2.7: ")]) == 0
}

test_log_file_owned_by_login_user_fails if {
	vs := data.cis_rhel8.logging.violations with input as {"log_file_permissions": {"analysis": [{"file": "/var/log/messages", "actual_mode": "0640", "actual_owner": "alice", "actual_group": "root"}]}}
	count([v | some v in vs; startswith(v, "6.2.3.1: not met")]) > 0
}
