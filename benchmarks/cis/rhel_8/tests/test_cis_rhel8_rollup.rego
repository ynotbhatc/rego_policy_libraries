package cis_rhel8.main_test

import rego.v1

# Generated by tools/cis_generators/gen_rhel_8.py: roll-up and bridge tests for CIS Red Hat Enterprise Linux 8 Benchmark v4.0.0.

test_every_recommendation_in_table if {
	count(data.cis_rhel8.controls) == 322
	count([c | some c in data.cis_rhel8.controls; c.assessment == "Manual"]) == 23
	data.cis_rhel8.standard_total == 322
}

test_empty_input_fails_closed if {
	r := data.cis_rhel8.main.compliance_report with input as {}
	count(object.keys(r)) == 20
	every k in ["framework", "benchmark", "version", "profile", "total_controls", "standard_total", "controls_basis", "passed_controls", "failed_controls", "compliance_percentage", "section_compliance_percentage", "compliant", "violations", "section_results", "sections_not_assessed", "missing_inputs", "assessment_coverage_percentage", "control_results", "control_result_counts", "violation_count"] { k in object.keys(r) }
	r.compliant == false
	r.profile == "unrecognised"
	r.total_controls == 322
	r.failed_controls == r.total_controls
	r.passed_controls == 0
	some v in r.violations
	startswith(v, "FAIL-CLOSED: no facts supplied")
}

test_profile_level1_server_count if {
	r := data.cis_rhel8.main.compliance_report with input as {"profile": "level1_server"}
	r.profile == "level1_server"
	r.total_controls == 257
	r.standard_total == 322
	r.failed_controls == r.total_controls
}

test_profile_level2_server_count if {
	r := data.cis_rhel8.main.compliance_report with input as {"profile": "level2_server"}
	r.profile == "level2_server"
	r.total_controls == 322
	r.standard_total == 322
	r.failed_controls == r.total_controls
}

test_profile_level1_workstation_count if {
	r := data.cis_rhel8.main.compliance_report with input as {"profile": "level1_workstation"}
	r.profile == "level1_workstation"
	r.total_controls == 252
	r.standard_total == 322
	r.failed_controls == r.total_controls
}

test_profile_level2_workstation_count if {
	r := data.cis_rhel8.main.compliance_report with input as {"profile": "level2_workstation"}
	r.profile == "level2_workstation"
	r.total_controls == 317
	r.standard_total == 322
	r.failed_controls == r.total_controls
}

test_legacy_profile_values_map_to_server_profiles if {
	r1 := data.cis_rhel8.main.compliance_report with input as {"profile": "level1"}
	r1.profile == "level1_server"
	r1.total_controls == 257
	r2 := data.cis_rhel8.main.compliance_report with input as {"profile": "level2"}
	r2.profile == "level2_server"
	r2.total_controls == 322
}

# No default profile: absent, null, not a string or an unknown name puts every recommendation in scope,
# says so in one PROFILE NOT SELECTED violation, and is never compliant.
test_unrecognised_profile_is_a_finding_and_scopes_every_recommendation if {
	every bad in [{}, {"profile": null}, {"profile": "bogus"}, {"profile": "Level2_Server"}, {"profile": ""}, {"profile": 2}, {"profile": true}, {"profile": ["level1_server"]}] {
		r := data.cis_rhel8.main.compliance_report with input as object.union({"attest": {"gpg_keys_reviewed": true}}, bad)
		r.profile == "unrecognised"
		r.total_controls == 322
		r.compliant == false
		count([v | some v in r.violations; startswith(v, "PROFILE NOT SELECTED: ")]) == 1
		count([c | some c in r.control_results; c.status == "not_applicable"]) == 0
	}
}

test_profile_finding_names_the_problem if {
	ra := data.cis_rhel8.main.compliance_report with input as {"attest": {}}
	some a in ra.violations
	startswith(a, "PROFILE NOT SELECTED: evidence missing — profile not collected")
	rb := data.cis_rhel8.main.compliance_report with input as {"profile": 2}
	some b in rb.violations
	startswith(b, "PROFILE NOT SELECTED: profile is not a string (got number)")
	rc := data.cis_rhel8.main.compliance_report with input as {"profile": "bogus"}
	some c in rc.violations
	startswith(c, "PROFILE NOT SELECTED: profile \"bogus\" is not a recognised profile")
}

test_recognised_profile_has_no_profile_finding if {
	every p in ["level1_server", "level2_server", "level1_workstation", "level2_workstation", "level1", "level2"] {
		r := data.cis_rhel8.main.compliance_report with input as {"profile": p}
		count([v | some v in r.violations; startswith(v, "PROFILE NOT SELECTED")]) == 0
	}
}

test_one_attested_control_passes if {
	r := data.cis_rhel8.main.compliance_report with input as {"attest": {"gpg_keys_reviewed": true}}
	r.passed_controls == 1
	r.failed_controls == r.total_controls - 1
	r.compliant == false
}

test_level2_violation_hidden_in_level1_profile if {
	vs := data.cis_rhel8.all_violations with input as {"profile": "level1_server"}
	count([v | some v in vs; startswith(v, "6.3.1.1: ")]) == 0
	vs2 := data.cis_rhel8.all_violations with input as {"profile": "level2_server"}
	count([v | some v in vs2; startswith(v, "6.3.1.1: ")]) > 0
}

test_every_violation_parses_to_a_control if {
	vs := data.cis_rhel8.all_violations with input as {"profile": "level2_server"}
	every v in vs { split(v, ":")[0] in object.keys(data.cis_rhel8.controls) }
	mvs := data.cis_rhel8.module_violations with input as {}
	every _, mv in mvs {
		every v in mv { split(v, ":")[0] in object.keys(data.cis_rhel8.controls) }
	}
}

test_l2_view_is_level2_server_only if {
	r := data.cis_rhel8.l2.compliance_report with input as {}
	r.total_controls == 65
	r.compliant == false
	l2v := data.cis_rhel8.l2.violations with input as {}
	every v in l2v { data.cis_rhel8.controls[split(v, ":")[0]].levels.server == 2 }
}
