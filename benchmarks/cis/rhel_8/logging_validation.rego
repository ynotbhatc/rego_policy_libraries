default p_6_2_3_1 := false

p_6_2_3_1 if {
	every f in input.log_file_permissions.analysis { log_file_ok(f) }
}

violations contains "6.2.3.1: evidence missing — log_file_permissions.analysis not collected" if not e_6_2_3_1

violations contains "6.2.3.1: not met — access to all logfiles must have been configured" if {
	e_6_2_3_1
	not p_6_2_3_1
}

