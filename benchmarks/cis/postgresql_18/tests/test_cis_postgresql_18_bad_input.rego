test_every_fixture_boolean_is_covered if {
	in_fixture := {pointer(path) |
		walk(green, [path, v])
		is_boolean(v)
	}
	in_fixture == object.keys(bool_facts) | {"/postgresql/ssl/enabled"}
}

_wrong_type_msg(f, bad) := sprintf(f.wrong, [type_name(bad)]) if contains(f.wrong, "%s")

_wrong_type_msg(f, _) := f.wrong if not contains(f.wrong, "%s")

test_boolean_of_another_type_does_not_pass if {
	ids := {f.id | some f in bool_facts}
	every bad in ["true", "false", "yes", "no", 0, 1] {
		inp := set_all(object.keys(bool_facts), bad)
		r := report(inp)
		fails(r, ids)
		count(ids & passed(inp)) == 0
		every _, f in bool_facts {
			_wrong_type_msg(f, bad) in r.violations
		}
	}
}

test_boolean_null_does_not_pass if {
	ids := {f.id | some f in bool_facts}
	inp := set_all(object.keys(bool_facts), null)
	r := report(inp)
	fails(r, ids)
	count(ids & passed(inp)) == 0
	every _, f in bool_facts {
		f.absent in r.violations
	}
}

test_boolean_removed_does_not_pass if {
	ids := {f.id | some f in bool_facts}
	inp := drop_all(object.keys(bool_facts))
	r := report(inp)
	fails(r, ids)
	count(ids & passed(inp)) == 0
	every _, f in bool_facts {
		f.absent in r.violations
	}
}

# `ssl` is a boolean setting: PostgreSQL writes it as on / off and reads on, true, yes and 1 as on (Server
# Configuration, Setting Parameters, Boolean values). Every other value, and no value, fails 6.8.
test_ssl_setting_on_values_pass if {
	every v in [true, 1, "on", "ON", "true", "yes"] {
		report(set_all(["/postgresql/ssl/enabled"], v)).compliant == true
	}
}

test_ssl_setting_other_values_fail if {
	every bad in [null, false, "false", "no", "off", 0, "", "garbage", [true]] {
		inp := set_all(["/postgresql/ssl/enabled"], bad)
		r := report(inp)
		fails(r, {"6.8"})
		not "6.8" in passed(inp)
	}
	fails(report(drop_all(["/postgresql/ssl/enabled"])), {"6.8"})
}

