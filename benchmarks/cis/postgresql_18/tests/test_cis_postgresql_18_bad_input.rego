test_list_fact_of_another_type_does_not_pass if {
	ids := {f.id | some f in list_facts}
	every bad in ["", {}, null, 0, false, "none"] {
		inp := set_all(object.keys(list_facts), bad)
		r := report(inp)
		fails(r, ids)
		count(ids & passed(inp)) == 0
		every _, f in list_facts {
			f.absent in r.violations
		}
