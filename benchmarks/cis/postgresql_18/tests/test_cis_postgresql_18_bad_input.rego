package cis.postgresql_18_bad_input_test

import rego.v1

# Generated by gen_postgresql_18.py. Bad evidence never passes, through the framework-key entrypoint.
# Each test replaces every fact of one kind at once (all booleans, all numbers, all lists) with one bad value
# and then checks, fact by fact, that the fact's own recommendation is not passed and that the finding names
# that fact. One evaluation per bad value keeps the file fast; the per-recommendation tests in
# test_cis_postgresql_18_controls.rego change one fact at a time.

green := data.cis.postgresql_18_test.green

report(inp) := r if {
	r := data.cis_postgresql_18.main.compliance_report with input as inp
}

passed(inp) := p if {
	p := data.cis.postgresql_18.passed with input as inp
}

set_all(paths, v) := json.patch(green, [op | some p in paths; op := object.union({"op": "add", "path": p}, {"value": v})])

drop_all(paths) := json.patch(green, [op | some p in paths; op := {"op": "remove", "path": p}])

# not compliant, and the counts agree: a recommendation with a finding is never also counted as passed
fails(r, ids) if {
	r.compliant == false
	r.failed_controls == count(ids)
	r.passed_controls + r.failed_controls == r.total_controls
	r.compliance_percentage < 100
	count(r.violations) >= r.failed_controls
}

pointer(path) := concat("", [sprintf("/%v", [k]) | some k in path])

test_green_fixture_passes if {
	r := report(green)
	r.compliant == true
	r.failed_controls == 0
	r.passed_controls == r.total_controls
	r.compliance_percentage == 100
}

test_empty_input_fails if {
	every inp in [{}, {"postgresql": {}}, {"postgresql": null}, {"postgresql": "true"}] {
		r := report(inp)
		r.compliant == false
		r.passed_controls == 0
		r.failed_controls == r.total_controls
	}
}

