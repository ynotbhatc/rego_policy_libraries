number_facts := {
	"/postgresql/cluster/check_db_dir_rc": {
		"id": "1.4",
		"wrong": "1.4: postgresql.cluster.check_db_dir_rc is not a number (got %s)",
	},
	"/postgresql/roles/0/connection_limit": {
		"id": "5.5",
		"wrong": "5.5: postgresql.roles[0].connection_limit is not a number (got %s)",
	},
	"/postgresql/roles/1/connection_limit": {
		"id": "5.5",
		"wrong": "5.5: postgresql.roles[1].connection_limit is not a number (got %s)",
	},
}

test_every_fixture_number_is_covered if {
	in_fixture := {pointer(path) |
		walk(green, [path, v])
		is_number(v)
	}
	in_fixture == object.keys(number_facts)
}

test_number_of_another_type_does_not_pass if {
	ids := {f.id | some f in number_facts}
	every bad in ["10", "-1", "", true, [10], {"value": 10}] {
		inp := set_all(object.keys(number_facts), bad)
		r := report(inp)
		fails(r, ids)
		count(ids & passed(inp)) == 0
		every _, f in number_facts {
			sprintf(f.wrong, [type_name(bad)]) in r.violations
		}
	}
}

