package cis_postgresql_18.main_test

import rego.v1

# Generated by gen_postgresql_18.py: the framework-key contract on empty input and with one attested control.

test_report_is_this_version if {
	r := data.cis_postgresql_18.main.compliance_report with input as {}
	r.benchmark == "CIS PostgreSQL 18 Benchmark v1.0.0"
	r.total_controls == 72
	r.framework == "cis_postgresql_18"
}

test_empty_input_fails_closed if {
	r := data.cis_postgresql_18.main.compliance_report with input as {}
	r.compliant == false
	r.passed_controls == 0
	r.failed_controls == r.total_controls
	r.violation_count == count(r.violations)
	some v in r.violations
	startswith(v, "FAIL-CLOSED: no facts supplied for cis_postgresql_18")
}

test_counts_are_consistent_on_empty_input if {
	r := data.cis_postgresql_18.main.compliance_report with input as {}
	r.failed_controls >= 0
	r.failed_controls <= r.total_controls
	is_array(r.violations)
}

test_attested_control_counts_as_passed if {
	r := data.cis_postgresql_18.main.compliance_report with input as {"postgresql": {"attest": {"latest_security_patches_applied": true}}}
	r.passed_controls == 1
	r.failed_controls == r.total_controls - 1
	not "FAIL-CLOSED: no facts supplied for cis_postgresql_18 — the assessment could not be evaluated. This is NOT a passing result; check that fact collection ran and produced input." in r.violations
}
