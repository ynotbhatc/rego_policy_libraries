# 6.3.3.1 (Automated; Level 2 - Server, Level 2 - Workstation)
# an audit rule must record changes to system administration scope (sudoers)
default e_6_3_3_1 := false

e_6_3_3_1 if {
	is_array(input.auditd.rules)
	count(input.auditd.rules) > 0
	is_array(input.auditd.active_rules)
	count(input.auditd.active_rules) > 0
}

default p_6_3_3_1 := false

p_6_3_3_1 if {
	every src in ["rules", "active_rules"] { audit8_watch(src, "/etc/sudoers", "wa") }
	every src in ["rules", "active_rules"] { audit8_watch(src, "/etc/sudoers.d", "wa") }
}

violations contains "6.3.3.1: evidence missing — auditd.rules/active_rules not collected" if not e_6_3_3_1

violations contains "6.3.3.1: not met — an audit rule must record changes to system administration scope (sudoers)" if {
	e_6_3_3_1
	not p_6_3_3_1
}

# 6.3.3.2 (Automated; Level 2 - Server, Level 2 - Workstation)
# actions as another user must be always logged
default e_6_3_3_2 := false

e_6_3_3_2 if {
	is_array(input.auditd.rules)
	count(input.auditd.rules) > 0
	is_array(input.auditd.active_rules)
	count(input.auditd.active_rules) > 0
}

default p_6_3_3_2 := false

p_6_3_3_2 if {
