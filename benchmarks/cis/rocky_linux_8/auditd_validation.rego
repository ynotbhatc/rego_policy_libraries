default e_6_3_2_3 := false

e_6_3_2_3 if {
	text_collected(input.auditd.config)
}

default p_6_3_2_3 := false

p_6_3_2_3 if {
	lower(conf_last(input.auditd.config, "disk_full_action")) in {"halt", "single"}
	lower(conf_last(input.auditd.config, "disk_error_action")) in {"syslog", "single", "halt"}
}

violations contains "6.3.2.3: evidence missing — auditd.config not collected" if not e_6_3_2_3

