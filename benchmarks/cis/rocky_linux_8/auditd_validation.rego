p_6_3_3_4 if {
	every src in ["rules", "active_rules"] { audit8_watch(src, "/etc/localtime", "wa") }
	every src in ["rules", "active_rules"] { every s in ["adjtimex", "settimeofday", "clock_settime"] { every a in ["b32", "b64"] { audit8_syscall(src, s, [], a) } } }
