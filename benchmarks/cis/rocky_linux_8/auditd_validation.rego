# 6.3.3.5 (Automated; Level 2 - Server, Level 2 - Workstation)
# an audit rule must record events that modify the system's network environment
default e_6_3_3_5 := false

e_6_3_3_5 if {
	is_array(input.auditd.rules)
	count(input.auditd.rules) > 0
	is_array(input.auditd.active_rules)
	count(input.auditd.active_rules) > 0
}

default p_6_3_3_5 := false

p_6_3_3_5 if {
	every src in ["rules", "active_rules"] { audit8_watch(src, "/etc/issue", "wa") }
	every src in ["rules", "active_rules"] { audit8_watch(src, "/etc/issue.net", "wa") }
	every src in ["rules", "active_rules"] { audit8_watch(src, "/etc/hosts", "wa") }
	every src in ["rules", "active_rules"] { audit8_watch(src, "/etc/hostname", "wa") }
	every src in ["rules", "active_rules"] { audit8_watch(src, "/etc/sysconfig/network", "wa") }
	every src in ["rules", "active_rules"] { audit8_watch(src, "/etc/sysconfig/network-scripts", "wa") }
	every src in ["rules", "active_rules"] { audit8_watch(src, "/etc/NetworkManager", "wa") }
	every src in ["rules", "active_rules"] { every s in ["sethostname", "setdomainname"] { every a in ["b32", "b64"] { audit8_syscall(src, s, [], a) } } }
}

violations contains "6.3.3.5: evidence missing — auditd.rules/active_rules not collected" if not e_6_3_3_5

violations contains "6.3.3.5: not met — an audit rule must record events that modify the system's network environment" if {
	e_6_3_3_5
	not p_6_3_3_5
}

# 6.3.3.6 (Automated; Level 2 - Server, Level 2 - Workstation)
# an audit rule must record use of privileged commands
default e_6_3_3_6 := false

e_6_3_3_6 if {
