	count(input.auditd.rules) > 0
	is_array(input.auditd.active_rules)
	count(input.auditd.active_rules) > 0
	is_array(input.auditd.privileged_commands)
	count(input.auditd.privileged_commands) > 0
}

default p_6_3_3_6 := false

p_6_3_3_6 if {
	every c in input.auditd.privileged_commands { every src in ["rules", "active_rules"] { audit8_watch(src, c, "x") } }
}

violations contains "6.3.3.6: evidence missing — auditd.rules/active_rules not collected" if not e_6_3_3_6

violations contains "6.3.3.6: not met — an audit rule must record use of privileged commands" if {
	e_6_3_3_6
	not p_6_3_3_6
}

