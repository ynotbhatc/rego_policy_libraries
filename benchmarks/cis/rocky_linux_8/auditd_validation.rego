}

default p_6_3_2_4 := false

p_6_3_2_4 if {
	lower(conf_last(input.auditd.config, "space_left_action")) in {"email", "exec", "single", "halt"}
	lower(conf_last(input.auditd.config, "admin_space_left_action")) in {"single", "halt"}
}

violations contains "6.3.2.4: evidence missing — auditd.config not collected" if not e_6_3_2_4

violations contains "6.3.2.4: not met — system warns when audit logs must be low on space" if {
