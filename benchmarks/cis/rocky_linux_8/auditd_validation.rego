package cis_rocky_linux_8.auditd

# CIS Rocky Linux 8 Benchmark v3.0.0, Section 6.3: System Auditing (auditd).
# Generated by tools/cis_generators/gen_rocky_linux_8.py from the CIS workbook; do not edit by hand.
# Each recommendation: e_<id> (facts collected), p_<id> (requirement met). Automated checks fail
# closed with '<id>: evidence missing — <field> not collected'; Manual ones need input.attest.<name>.
# Roll-up: package cis_rocky_linux_8 (section key section_4_1_auditd); profile scoping happens there, this package reports
# every recommendation of the section.

import rego.v1

default compliant := false

compliant if count(violations) == 0

controls := ["6.3.1.1", "6.3.1.2", "6.3.1.3", "6.3.1.4", "6.3.2.1", "6.3.2.2", "6.3.2.3", "6.3.2.4", "6.3.3.1", "6.3.3.2", "6.3.3.3", "6.3.3.4", "6.3.3.5", "6.3.3.6", "6.3.3.7", "6.3.3.8", "6.3.3.9", "6.3.3.10", "6.3.3.11", "6.3.3.12", "6.3.3.13", "6.3.3.14", "6.3.3.15", "6.3.3.16", "6.3.3.17", "6.3.3.18", "6.3.3.19", "6.3.3.20", "6.3.3.21", "6.3.3.22", "6.3.4.1", "6.3.4.2", "6.3.4.3", "6.3.4.4", "6.3.4.5", "6.3.4.6", "6.3.4.7", "6.3.4.8", "6.3.4.9", "6.3.4.10"]

# report shape of the earlier module (callers read report.compliant / total_violations / violations)
report := {
	"compliant": compliant,
	"total_violations": count(violations),
	"violations": violations,
	"controls": controls,
	"compliance_summary": {"overall_compliant": compliant, "controls_evaluated": count(controls)},
	"collection_timestamp": object.get(input, ["collection_timestamp"], null),
}

# Parse an octal permission string ("644", "0644", "0o644") to an integer; undefined if not octal.
octal(s) := n if {
	t := trim_prefix(lower(trim_space(sprintf("%v", [s]))), "0o")
	regex.match(`^[0-7]{1,4}$`, t)
	p := concat("", [substring("0000", 0, 4 - count(t)), t])
	ds := [to_number(substring(p, i, 1)) | some i in numbers.range(0, 3)]
	n := ((ds[0] * 512) + (ds[1] * 64)) + ((ds[2] * 8) + ds[3])
}

# true when mode grants nothing beyond max (both octal strings)
mode_within(mode, max) if bits.and(octal(mode), bits.and(bits.negate(octal(max)), 4095)) == 0

# Active (non-blank, non-comment) lines of a configuration text.
active_lines(text) := [l |
	some raw in split(text, "\n")
	l := trim_space(raw)
	l != ""
	not startswith(l, "#")
]

# a collected text: a non-blank string ("" is not evidence)
text_collected(t) if {
	is_string(t)
	trim_space(t) != ""
}

regex_in_text(text, re) if {
	some l in active_lines(text)
	regex.match(re, l)
}

# Values of a `key = value` / `key value` directive (key is a case-insensitive regex); last one wins.
conf_values(text, key_re) := [trim(m[1], "\"' ") |
	some l in active_lines(text)
	some m in regex.find_all_string_submatch_n(concat("", ["(?i)^", key_re, `(?:\s*=\s*|\s+)(.*?)\s*$`]), l, 1)
]

conf_last(text, key_re) := vs[count(vs) - 1] if {
	vs := conf_values(text, key_re)
	count(vs) > 0
}

num(v) := to_number(trim_space(sprintf("%v", [v]))) if regex.match(`^\s*-?[0-9]+\s*$`, sprintf("%v", [v]))

# ── packages / services ──
services_collected if {
	is_object(input.services)
	count(input.services) > 0
}

unit_on(u) if input.services[u].status == "enabled"

unit_on(u) if lower(input.services[u].state) in {"running", "active"}

# every unit named for an installed package is reported in the inventory
unit_set_reported(p, _) if input.packages[p] == false

unit_set_reported(p, us) if {
	input.packages[p] == true
	every u in us { unit_reported(u) }
}

unit_reported(u) if {
	is_string(input.services[u].status)
	input.services[u].status != ""
}

unit_set_off(p, _) if input.packages[p] == false

unit_set_off(p, us) if {
	input.packages[p] == true
	every u in us { not unit_on(u) }
}

unit_enabled_active(u) if {
	input.services[u].status == "enabled"
	lower(input.services[u].state) in {"running", "active"}
}

# tmp.mount masked or disabled means systemd will not mount /tmp at boot
tmp_mount_unit_off if input.services["tmp.mount"].status in {"masked", "disabled"}

# ── kernel modules: {module, disabled, loaded, available?}; "unknown" proves nothing ──
kmod_evidence(e) if is_boolean(e.available)

kmod_evidence(e) if {
	is_boolean(e.disabled)
	is_boolean(e.loaded)
}

kmod_unavailable(e) if e.available == false

kmod_unavailable(e) if {
	e.disabled == true
	e.loaded == false
}

# ── mounts ──
mounts_collected if {
	is_array(input.ansible_facts.ansible_mounts)
	count(input.ansible_facts.ansible_mounts) > 0
}

mounts_at(path) := [m | some m in input.ansible_facts.ansible_mounts; m.mount == path]

mounted(path) if count(mounts_at(path)) > 0

mount_opts(m) := split(m.options, ",") if is_string(m.options)

mount_opts(m) := m.options if is_array(m.options)

# ── file lists ──
list_item_ok(f, mk, ok, gk, max, owners, groups) if {
	mode_within(f[mk], max)
	f[ok] in owners
	f[gk] in groups
}

# ── sshd: first occurrence wins (sshd semantics); `sshd -T` prints effective values ──
ssh_collected if {
	is_string(input.ssh.sshd_config_raw)
	trim_space(input.ssh.sshd_config_raw) != ""
}

sshd_pairs := [[lower(m[1]), trim_space(m[2])] |
	some l in active_lines(input.ssh.sshd_config_raw)
	some m in regex.find_all_string_submatch_n(`^([A-Za-z0-9]+)(?:\s*=\s*|\s+)(.*)$`, l, 1)
]

sshd_first(key) := vs[0] if {
	vs := [p[1] | some p in sshd_pairs; p[0] == key]
	count(vs) > 0
}

# effective value: `sshd -T` prints every directive, so a missing directive means the effective
# configuration was not collected (a raw sshd_config misses /usr/etc/ssh and sshd_config.d)
sshd_value(key) := sshd_first(key)

sshd_list(key) := [trim_space(x) | some x in split(lower(sshd_value(key)), ",")]

# seconds from an sshd time value ("60", "60s", "1m")
sshd_seconds(v) := to_number(v) if regex.match(`^[0-9]+$`, v)

sshd_seconds(v) := to_number(trim_suffix(v, "s")) if regex.match(`^[0-9]+s$`, v)

sshd_seconds(v) := to_number(trim_suffix(v, "m")) * 60 if regex.match(`^[0-9]+m$`, v)

# ── sysctl: running values from the mapper's analysis list (rhel_9 shape) ──
sysctl_running(p) := [sprintf("%v", [e.current_value]) |
	some e in object.get(input, ["sysctl_parameters", "analysis"], [])
	e.parameter == p
	e.current_value != null
]

audit_rule_lines := [l |
	some r in input.auditd.active_rules
	l := trim_space(r)
	l != ""
	not startswith(l, "#")
]

audit_toks(l) := regex.split(`\s+`, l)

audit_path_tok(l, p) if {
	toks := audit_toks(l)
	some t in toks
	t in {concat("", ["path=", p]), concat("", ["dir=", p]), concat("", ["path=", p, "/"]), concat("", ["dir=", p, "/"])}
}

audit_path_tok(l, p) if {
	toks := audit_toks(l)
	some i, t in toks
	t == "-w"
	toks[i + 1] in {p, concat("", [p, "/"])}
}

audit_perm(l) := substring(t, 5, -1) if {
	some t in audit_toks(l)
	startswith(t, "perm=")
}

audit_perm(l) := toks[i + 1] if {
	toks := audit_toks(l)
	some i, t in toks
	t == "-p"
}

audit_watch(p, perm) if {
	some l in audit_rule_lines
	audit_path_tok(l, p)
	pv := audit_perm(l)
	every i in numbers.range(0, count(perm) - 1) { contains(pv, substring(perm, i, 1)) }
}

line_syscalls(l) := {x |
	toks := audit_toks(l)
	some i, t in toks
	t == "-S"
	some x in split(toks[i + 1], ",")
}

audit_unset := `auid!=(unset|-1|4294967295)(\s|$)`

audit_field(l, "auid") if {
	regex.match(`auid>=1000(\s|$)`, l)
	regex.match(audit_unset, l)
}

audit_field(l, "euid") if {
	regex.match(`(euid!=uid|uid!=euid)(\s|$)`, l)
	regex.match(audit_unset, l)
}

audit_field(l, "eacces") if {
	regex.match(`exit=-EACCES(\s|$)`, l)
	regex.match(`auid>=1000(\s|$)`, l)
	regex.match(audit_unset, l)
}

audit_field(l, "eperm") if {
	regex.match(`exit=-EPERM(\s|$)`, l)
	regex.match(`auid>=1000(\s|$)`, l)
	regex.match(audit_unset, l)
}

audit_syscall(s, fields) if {
	some l in audit_rule_lines
	regex.match(`^-a\s+(always,exit|exit,always)(\s|$)`, l)
	s in line_syscalls(l)
	every f in fields { audit_field(l, f) }
}

# the last `-e` line of the on-disk rules decides the enabled flag
audit_e_values := [m[1] |
	some r in input.auditd.rules
	some m in regex.find_all_string_submatch_n(`^\s*-e\s+([0-9])\b`, r, 1)
]

audit_last_e := audit_e_values[count(audit_e_values) - 1] if count(audit_e_values) > 0

sudo_logfiles contains f if {
	some l in active_lines(input.sudo.sudoers_content)
	regex.match(`^Defaults\b`, l)
	some m in regex.find_all_string_submatch_n(`logfile\s*=\s*("[^"]+"|'[^']+'|[^,\s]+)`, l, -1)
	f := trim(m[1], "\"'")
}

grub_cmdline_tokens := [t |
	some l in active_lines(input.bootloader.grub_config)
	some m in regex.find_all_string_submatch_n(`^GRUB_CMDLINE_LINUX="([^"]*)"`, l, 1)
	some t in regex.split(`\s+`, m[1])
	t != ""
]

grub_cmdline_has(re) if {
	some t in grub_cmdline_tokens
	regex.match(re, t)
}

# log_group unset: auditd's default root applies
audit_log_group_ok if not conf_last(input.auditd.config, "log_group")

audit_log_group_ok if lower(conf_last(input.auditd.config, "log_group")) in {"root", "audit"}

# 6.3.3: rules of one source, "rules" (on disk) or "active_rules" (auditctl -l); each matched rule needs a key
audit8_lines(src) := [l |
	some r in input.auditd[src]
	l := trim_space(r)
	l != ""
	not startswith(l, "#")
]

audit8_keyed(l) if regex.match(`(\s-k\s*\S+|\skey=\S+)\s*$`, l)

audit8_watch(src, p, perm) if {
	some l in audit8_lines(src)
	audit_path_tok(l, p)
	pv := audit_perm(l)
	every i in numbers.range(0, count(perm) - 1) { contains(pv, substring(perm, i, 1)) }
	audit8_keyed(l)
}

audit8_exec(src, p) if {
	some l in audit8_lines(src)
	regex.match(`^-a\s+(always,exit|exit,always)(\s|$)`, l)
	concat("", ["path=", p]) in audit_toks(l)
	contains(audit_perm(l), "x")
	audit_field(l, "auid")
	audit8_keyed(l)
}

audit8_syscall(src, s, fields, arch) if {
	some l in audit8_lines(src)
	regex.match(`^-a\s+(always,exit|exit,always)(\s|$)`, l)
	concat("", ["arch=", arch]) in audit_toks(l)
	s in line_syscalls(l)
	every f in fields { audit_field(l, f) }
	audit8_keyed(l)
}

audit_field(l, "unset") if regex.match(audit_unset, l)

# 6.3.1.2 / 6.3.1.3: kernel arguments of one boot entry
kernel_arg_has(a, re) if {
	some t in regex.split(`\s+`, a)
	regex.match(re, t)
}

backlog_ok(toks) if {
	some t in toks
	startswith(t, "audit_backlog_limit=")
	num(substring(t, 20, -1)) >= 8192
}

# 6.3.1.1 (Automated; Level 2 - Server, Level 2 - Workstation)
# auditd packages must be present
default e_6_3_1_1 := false

e_6_3_1_1 if {
	is_boolean(input.packages.audit)
	is_boolean(input.packages["audit-libs"])
}

default p_6_3_1_1 := false

p_6_3_1_1 if {
	input.packages.audit == true
	input.packages["audit-libs"] == true
}

violations contains "6.3.1.1: evidence missing — packages[audit,audit-libs] not collected" if not e_6_3_1_1

violations contains "6.3.1.1: not met — auditd packages must be present" if {
	e_6_3_1_1
	not p_6_3_1_1
}

# 6.3.1.2 (Automated; Level 2 - Server, Level 2 - Workstation)
# auditing for processes that start prior to auditd must be turned on
default e_6_3_1_2 := false

e_6_3_1_2 if {
	is_array(input.boot_security.kernel_args)
	count(input.boot_security.kernel_args) > 0
	text_collected(input.bootloader.grub_config)
}

default p_6_3_1_2 := false

p_6_3_1_2 if {
	every a in input.boot_security.kernel_args { kernel_arg_has(a, `^audit=1$`) }
	grub_cmdline_has(`^audit=1$`)
}

violations contains "6.3.1.2: evidence missing — boot_security.kernel_args/bootloader.grub_config not collected" if not e_6_3_1_2

violations contains "6.3.1.2: not met — auditing for processes that start prior to auditd must be turned on" if {
	e_6_3_1_2
	not p_6_3_1_2
}

# 6.3.1.3 (Automated; Level 2 - Server, Level 2 - Workstation)
# audit_backlog_limit must be explicitly configured
default e_6_3_1_3 := false

e_6_3_1_3 if {
	is_array(input.boot_security.kernel_args)
	count(input.boot_security.kernel_args) > 0
	text_collected(input.bootloader.grub_config)
}

default p_6_3_1_3 := false

p_6_3_1_3 if {
	every a in input.boot_security.kernel_args { backlog_ok(regex.split(`\s+`, a)) }
	backlog_ok(grub_cmdline_tokens)
}

violations contains "6.3.1.3: evidence missing — boot_security.kernel_args/bootloader.grub_config not collected" if not e_6_3_1_3

violations contains "6.3.1.3: not met — audit_backlog_limit must be explicitly configured" if {
	e_6_3_1_3
	not p_6_3_1_3
}

# 6.3.1.4 (Automated; Level 2 - Server, Level 2 - Workstation)
# auditd service must be turned on and active
default e_6_3_1_4 := false

e_6_3_1_4 if {
	services_collected
}

default p_6_3_1_4 := false

p_6_3_1_4 if {
	unit_enabled_active("auditd.service")
}

violations contains "6.3.1.4: evidence missing — services not collected" if not e_6_3_1_4

violations contains "6.3.1.4: not met — auditd service must be turned on and active" if {
	e_6_3_1_4
	not p_6_3_1_4
}

# 6.3.2.1 (Automated; Level 2 - Server, Level 2 - Workstation)
# audit log storage size must be explicitly configured
default e_6_3_2_1 := false

e_6_3_2_1 if {
	text_collected(input.auditd.config)
}

default p_6_3_2_1 := false

p_6_3_2_1 if {
	v := conf_last(input.auditd.config, "max_log_file")
	num(v) > 0
}

violations contains "6.3.2.1: evidence missing — auditd.config not collected" if not e_6_3_2_1

violations contains "6.3.2.1: not met — audit log storage size must be explicitly configured" if {
	e_6_3_2_1
	not p_6_3_2_1
}

# 6.3.2.2 (Automated; Level 2 - Server, Level 2 - Workstation)
# audit logs must be not automatically deleted
default e_6_3_2_2 := false

e_6_3_2_2 if {
	text_collected(input.auditd.config)
}

default p_6_3_2_2 := false

p_6_3_2_2 if {
	v := conf_last(input.auditd.config, "max_log_file_action")
