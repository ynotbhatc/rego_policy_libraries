profiles := {"level1_server": {"platform": "server", "level": 1}, "level2_server": {"platform": "server", "level": 2}, "level1_workstation": {"platform": "workstation", "level": 1}, "level2_workstation": {"platform": "workstation", "level": 2}}

profile_aliases := {"level1": "level1_server", "level2": "level2_server"}

default profile := "unrecognised"

profile := input.profile if input.profile in object.keys(profiles)

profile := profile_aliases[input.profile] if not input.profile in object.keys(profiles)

default profile_selected := false

profile_selected if profile in object.keys(profiles)

# What is in scope. Without a recognised profile nothing may be declared not applicable, so the scope is the
# one that holds every recommendation of the benchmark (Level 2 - Server; the generator checks that it does).
default scope := {"platform": "server", "level": 2}

scope := profiles[profile] if profile_selected

_profile_names := concat(", ", sort(object.keys(profiles)))

_profile_problem := "evidence missing — profile not collected" if object.get(input, "profile", null) == null

_profile_problem := sprintf("profile is not a string (got %s)", [type_name(input.profile)]) if {
	object.get(input, "profile", null) != null
	not is_string(input.profile)
}

_profile_problem := sprintf("profile %s is not a recognised profile", [json.marshal(input.profile)]) if {
	is_string(input.profile)
	not profile_selected
}

# reported next to the control violations (never one of them: it cites no recommendation id)
profile_violations := [] if {
	profile_selected
} else := [sprintf(
	"PROFILE NOT SELECTED: %s (send one of %s). No recommendation was declared out of scope: every one of the benchmark was evaluated, and the result is not a pass for any profile.",
	[_profile_problem, _profile_names],
)]

applies(c) if c.levels[scope.platform] <= scope.level

applicable_ids := {id | some id, c in controls; applies(c)}

module_violations := {
	"filesystem": filesystem.violations,
	"initial_setup": initial_setup.violations,
	"boot_security": boot_security.violations,
	"selinux": selinux.violations,
	"services": services.violations,
	"network": network.violations,
	"auditd": auditd.violations,
	"logging": logging.violations,
	"cron": cron.violations,
	"ssh": ssh.violations,
	"sudo": sudo.violations,
	"pam": pam.violations,
	"file_permissions": file_permissions.violations,
	"user_group": user_group.violations,
}

all_violations := sort([v |
	some _, vs in module_violations
	some v in vs
	split(v, ":")[0] in applicable_ids
])

failing_ids := {split(v, ":")[0] | some v in all_violations}

# =============================================================================
# ASSESSMENT COVERAGE — which sections received any of the input keys they read
# =============================================================================

section_inputs := {
	"section_1_1_filesystem": [
		"mount_options",
		"disabled_filesystem_modules",
		"usb_storage",
	],
	"section_1_initial_setup": [
		"initial_setup",
		"crypto_policy",
	],
	"section_1_4_1_5_6_1_boot_security": ["boot_security"],
	"section_1_6_selinux": ["selinux"],
	"section_2_services": [
		"chronyd",
		"client_packages",
		"autofs",
		"mta",
		"gui",
		"x11",
		"webserver",
	],
	"section_3_network": [
		"sysctl_parameters",
		"ipv6",
		"firewall",
		"wireless_interfaces",
		"disabled_network_modules",
	],
	"section_4_1_auditd": ["auditd"],
	"section_4_logging": [
		"rsyslog",
		"journald",
		"log_file_permissions",
	],
	"section_5_1_cron": ["cron"],
	"section_5_2_ssh": ["ssh"],
	"section_5_3_sudo": ["sudo"],
	"section_5_pam": ["pam"],
	"section_6_1_file_permissions": [
		"critical_files",
		"world_writable",
		"unowned_files",
		"ungrouped_files",
		"sticky_bit",
	],
	"section_6_2_user_group": ["user_group"],
}

# a section input counts as collected unless it is absent, null or false (null used to count as collected,
# so a nulled section was reported as assessed while a dropped one was NOT ASSESSED)
input_collected(k) if {
	v := object.get(input, k, null)
	v != null
	v != false
}

section_assessed(name) if {
	some k in section_inputs[name]
	input_collected(k)
}

# The lowest level, per platform, at which a recommendation reads one of the section's input keys (generated
# from what each recommendation reads, whichever module it is in). A section is required when the selected
# scope reaches that level; without a recognised profile the scope is the whole benchmark, so every section is.
section_required_from := {
	"section_1_1_filesystem": {
		"server": 1,
		"workstation": 1,
	},
	"section_1_initial_setup": {
		"server": 1,
		"workstation": 1,
	},
	"section_1_4_1_5_6_1_boot_security": {
		"server": 1,
		"workstation": 1,
	},
	"section_1_6_selinux": {
		"server": 1,
		"workstation": 1,
	},
	"section_2_services": {
		"server": 1,
		"workstation": 1,
	},
	"section_3_network": {
		"server": 1,
		"workstation": 1,
	},
	"section_4_1_auditd": {
		"server": 2,
		"workstation": 2,
	},
	"section_4_logging": {
		"server": 1,
		"workstation": 1,
	},
	"section_5_1_cron": {
		"server": 1,
		"workstation": 1,
	},
	"section_5_2_ssh": {
		"server": 1,
		"workstation": 1,
	},
	"section_5_3_sudo": {
		"server": 1,
		"workstation": 1,
	},
	"section_5_pam": {
		"server": 1,
		"workstation": 1,
	},
	"section_6_1_file_permissions": {
		"server": 1,
		"workstation": 1,
	},
	"section_6_2_user_group": {
		"server": 1,
		"workstation": 1,
	},
}

section_required(name) if scope.level >= section_required_from[name][scope.platform]

required_sections := sort([name | some name, _ in section_inputs; section_required(name)])

# the input keys a required section did not receive (nothing is missing from a section that is not required)
missing_inputs := {name: _missing_keys(name) | some name, _ in section_inputs}

_missing_keys(name) := [k | some k in section_inputs[name]; not input_collected(k)] if {
	section_required(name)
} else := []

not_assessed_sections := sort([name | some name in required_sections; not section_assessed(name)])

assessed_sections := count(required_sections) - count(not_assessed_sections)

default assessment_coverage_percentage := 0

assessment_coverage_percentage := round((assessed_sections * 100) / count(required_sections)) if count(required_sections) > 0

section_assessment := {name: {
	"required": section_required(name) == true,
	"assessed": section_assessed(name) == true,
	"missing_inputs": missing_inputs[name],
} |
	some name, _ in section_inputs
}

# =============================================================================
# SECTIONS (controls applicable to the selected profile)
# =============================================================================

section_ids(name) := {id | some id in applicable_ids; controls[id].section == name}

section_compliance := {name: {
	"compliant": count(section_ids(name) & failing_ids) == 0,
	"controls_covered": count(section_ids(name)),
	"violation_count": count([v | some v in all_violations; split(v, ":")[0] in section_ids(name)]),
} |
	some name, _ in section_inputs
	count(section_ids(name)) > 0
}

total_sections := count(section_compliance)

# A section counts as compliant only if it was actually assessed (fail-closed).
compliant_sections := count([name | some name, s in section_compliance; s.compliant == true; section_assessed(name)])

default compliance_percentage := 0

compliance_percentage := _capped_unless_compliant((compliant_sections * 100) / total_sections) if total_sections > 0

# 100 means compliant: a result that is not compliant never reads 100
_capped_unless_compliant(p) := p if {
	compliant
} else := min([p, 99.999])

total_controls_covered := count(applicable_ids)

default compliant := false

compliant if {
	count(object.keys(input)) > 0
	count(applicable_ids) > 0
	count(failing_ids) == 0
	count(not_assessed_sections) == 0
	profile_selected
}

# =============================================================================
# RISK ASSESSMENT AND RECOMMENDATIONS (the earlier module's shapes)
# =============================================================================

section_priority := {
	"section_5_2_ssh": "critical",
	"section_4_1_auditd": "critical",
	"section_1_6_selinux": "critical",
	"section_5_pam": "high",
	"section_5_3_sudo": "high",
	"section_4_logging": "high",
	"section_1_4_1_5_6_1_boot_security": "high",
	"section_5_1_cron": "medium",
	"section_6_2_user_group": "medium",
	"section_1_initial_setup": "medium",
}

critical_risks := [v | some v in all_violations; section_priority[controls[split(v, ":")[0]].section] == "critical"]

high_risks := [v | some v in all_violations; section_priority[controls[split(v, ":")[0]].section] == "high"]

overall_risk_level := "critical" if {
	count(critical_risks) > 0
} else := "high" if {
	count(high_risks) > 5
} else := "medium" if {
	count(all_violations) > 10
} else := "low"

generate_recommendations contains recommendation if {
	section_compliance.section_5_2_ssh.compliant == false
	recommendation := {
		"priority": "critical",
		"section": "SSH Server Configuration",
		"issue": sprintf("%d ssh violations found", [section_compliance.section_5_2_ssh.violation_count]),
		"action": "Harden SSH configuration per CIS guidelines",
		"controls": "CIS 5.1.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance.section_4_1_auditd.compliant == false
	recommendation := {
		"priority": "critical",
		"section": "System Auditing",
		"issue": sprintf("%d auditd violations found", [section_compliance.section_4_1_auditd.violation_count]),
		"action": "Configure auditd service and implement required audit rules",
		"controls": "CIS 6.3.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance.section_1_6_selinux.compliant == false
	recommendation := {
		"priority": "critical",
		"section": "SELinux Configuration",
		"issue": sprintf("%d selinux violations found", [section_compliance.section_1_6_selinux.violation_count]),
		"action": "Enable and configure SELinux in enforcing mode",
		"controls": "CIS 1.3.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance.section_5_pam.compliant == false
	recommendation := {
		"priority": "high",
		"section": "Password Authentication",
		"issue": sprintf("%d pam violations found", [section_compliance.section_5_pam.violation_count]),
		"action": "Configure password policies and PAM modules",
		"controls": "CIS 5.3.x, 5.4.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance.section_5_3_sudo.compliant == false
	recommendation := {
		"priority": "high",
		"section": "Privilege Escalation",
		"issue": sprintf("%d sudo violations found", [section_compliance.section_5_3_sudo.violation_count]),
		"action": "Harden sudo configuration and restrict su access",
		"controls": "CIS 5.2.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance.section_4_logging.compliant == false
	recommendation := {
		"priority": "high",
		"section": "Logging Configuration",
		"issue": sprintf("%d logging violations found", [section_compliance.section_4_logging.violation_count]),
		"action": "Configure journald or rsyslog (one logging method)",
		"controls": "CIS 6.2.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance.section_1_4_1_5_6_1_boot_security.compliant == false
	recommendation := {
		"priority": "high",
		"section": "Boot Security & AIDE",
		"issue": sprintf("%d boot_security violations found", [section_compliance.section_1_4_1_5_6_1_boot_security.violation_count]),
		"action": "Set bootloader password, enable AIDE, configure process hardening",
		"controls": "CIS 1.4.x, 1.5.x, 6.1.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance.section_5_1_cron.compliant == false
	recommendation := {
		"priority": "medium",
		"section": "Cron Configuration",
		"issue": sprintf("%d cron violations found", [section_compliance.section_5_1_cron.violation_count]),
		"action": "Set correct permissions on cron files and restrict access",
		"controls": "CIS 2.4.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance.section_6_2_user_group.compliant == false
	recommendation := {
		"priority": "medium",
		"section": "User and Group Settings",
		"issue": sprintf("%d user_group violations found", [section_compliance.section_6_2_user_group.violation_count]),
		"action": "Fix user account issues, duplicate UIDs/GIDs, and home directory permissions",
		"controls": "CIS 7.2.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance.section_1_initial_setup.compliant == false
	recommendation := {
		"priority": "medium",
		"section": "Initial Setup & Banners",
		"issue": sprintf("%d initial_setup violations found", [section_compliance.section_1_initial_setup.violation_count]),
		"action": "Configure warning banners, GPG keys, crypto policy and GNOME settings",
		"controls": "CIS 1.2.x, 1.6.x, 1.7.x, 1.8.x",
	}
}

overall_status := "compliant" if {
	compliant
} else := "non_compliant"

level2_ids := {id | some id, c in controls; object.get(c.levels, scope.platform, 0) == 2}

l2_violations_active := [v | some v in all_violations; split(v, ":")[0] in level2_ids] if {
	scope.level == 2
} else := []

default l2_compliant := false

l2_compliant if scope.level == 1

l2_compliant if {
	scope.level == 2
	count(l2_violations_active) == 0
}

executive_summary := {
	"overall_status": overall_status,
	"profile": profile,
	"compliance_score": compliance_percentage,
	"sections_evaluated": total_sections,
	"sections_compliant": compliant_sections,
	"total_violations": count(all_violations),
	"l1_violations": count(all_violations) - count(l2_violations_active),
	"l2_violations": count(l2_violations_active),
	"l2_compliant": l2_compliant,
	"critical_issues": count(critical_risks),
	"top_priorities": [rec | some rec in generate_recommendations; rec.priority == "critical"],
}

# Consumer endpoint — /v1/data/cis_rocky_linux_8/compliance_assessment (customer profiles query it)
compliance_assessment := {
	"framework": "CIS Rocky Linux 8 Benchmark v3.0.0",
	"compliant": compliant,
	"score": compliance_percentage,
	"total_controls": count(applicable_ids),
	"sections_evaluated": total_sections,
	"sections_compliant": compliant_sections,
	"violations": array.concat(all_violations, profile_violations),
	"violation_count": count(all_violations) + count(profile_violations),
	"summary": executive_summary,
}

# =============================================================================
# PER-CONTROL RESULTS: one object per recommendation, natural id order
# =============================================================================
#
# control_results[i] = {id, status, basis, in_scope, profile, evidence}. CONTROL_INDEX is the static half
# (written by the generator from the workbook's profiles and each logic entry's input paths; no benchmark text);
# the status is each section's control_status, or not_applicable outside the selected profile. It is read from
# the predicates the violation rules use, so it agrees with failed_controls and the violations by construction.

CONTROL_STATUSES := ["pass", "fail", "evidence_missing", "not_attested", "not_applicable"]

control_status := object.union_n([
	filesystem.control_status,
	initial_setup.control_status,
	boot_security.control_status,
	selinux.control_status,
	services.control_status,
	network.control_status,
	auditd.control_status,
	logging.control_status,
	cron.control_status,
	ssh.control_status,
	sudo.control_status,
	pam.control_status,
	file_permissions.control_status,
	user_group.control_status,
])

