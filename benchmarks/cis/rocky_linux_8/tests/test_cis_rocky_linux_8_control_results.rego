test_fixtures_pass_at_their_own_profile if {
	r2 := data.cis_rocky_linux_8.main.compliance_report with input as fixture_compliant
	r2.compliant == true
	r2.profile == "level2_server"
	r2.compliance_percentage == 100
	count(r2.violations) == 0
	r2.total_controls == 322
	r1 := data.cis_rocky_linux_8.main.compliance_report with input as fixture_compliant_level1_server
	r1.compliant == true
	r1.profile == "level1_server"
	r1.compliance_percentage == 100
	count(r1.violations) == 0
	r1.total_controls == 257
}

# the same facts with the profile removed or misspelt are not a pass, although every recommendation holds
test_compliant_fixture_without_a_recognised_profile_is_not_compliant if {
	every op in [{"op": "remove", "path": "/profile"}, {"op": "replace", "path": "/profile", "value": null}, {"op": "replace", "path": "/profile", "value": "level_2_server"}] {
		r := data.cis_rocky_linux_8.main.compliance_report with input as json.patch(fixture_compliant, [op])
		r.compliant == false
		count(r.violations) == 1
		startswith(r.violations[0], "PROFILE NOT SELECTED: ")
	}
}

# a Level 1 host whose profile is lost is evaluated against every recommendation, not passed at Level 1
test_level1_fixture_without_profile_fails_the_level2_recommendations if {
	r := data.cis_rocky_linux_8.main.compliance_report with input as json.remove(fixture_compliant_level1_server, ["/profile"])
	r.compliant == false
	r.total_controls == 322
	r.failed_controls > 0
	r.compliance_percentage < 100
}

test_control_results_compliant_fixture_every_recommendation_passes if {
	r := data.cis_rocky_linux_8.main.compliance_report with input as object.union(fixture_compliant, {"profile": "level2_server"})
	r.total_controls == 322
	count([c | some c in r.control_results; c.in_scope]) == r.total_controls
	count([c | some c in r.control_results; c.status in FAILING]) == r.failed_controls
	count([c | some c in r.control_results; c.status == "pass"]) == r.passed_controls
	sum([x | some x in r.control_result_counts]) == 322
	cited(r.violations) == failing(r.control_results)
	every c in r.control_results { c.status == "pass" }
}

test_control_results_mixed_input_every_status if {
	r := data.cis_rocky_linux_8.main.compliance_report with input as object.union(object.union(object.union(json.remove(fixture_compliant, ["user_group"]), {"disabled_filesystem_modules": {"modules": [{"module": "cramfs", "disabled": false, "loaded": false}]}}), {"attest": {"unused_filesystem_modules_reviewed": false}}), {"profile": "level1_server"})
	r.total_controls == 257
	count([c | some c in r.control_results; c.in_scope]) == r.total_controls
	count([c | some c in r.control_results; c.status in FAILING]) == r.failed_controls
	count([c | some c in r.control_results; c.status == "pass"]) == r.passed_controls
	sum([x | some x in r.control_result_counts]) == 322
	cited(r.violations) == failing(r.control_results)
	r.control_result_counts.pass > 0
	r.control_result_counts.fail > 0
	r.control_result_counts.evidence_missing > 0
	r.control_result_counts.not_attested > 0
	r.control_result_counts.not_applicable > 0
}
