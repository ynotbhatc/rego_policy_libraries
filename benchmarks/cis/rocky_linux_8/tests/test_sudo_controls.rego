package cis_rocky_linux_8.sudo_test

import rego.v1

# Generated by tools/cis_generators/gen_rocky_linux_8.py: a pass and a fail case for every recommendation, plus an evidence-missing
# case for every Automated one. Assertions key on '<id>: ' (colon included).

test_5_2_1_pass if {
	vs := data.cis_rocky_linux_8.sudo.violations with input as {"sudo": {"installed": true}}
	count([v | some v in vs; startswith(v, "5.2.1: ")]) == 0
}

test_5_2_1_fail if {
	vs := data.cis_rocky_linux_8.sudo.violations with input as {"sudo": {"installed": false}}
	count([v | some v in vs; startswith(v, "5.2.1: ")]) > 0
	not "5.2.1: evidence missing — sudo.installed not collected" in vs
}

test_5_2_1_evidence_missing if {
	vs := data.cis_rocky_linux_8.sudo.violations with input as {}
	"5.2.1: evidence missing — sudo.installed not collected" in vs
}

