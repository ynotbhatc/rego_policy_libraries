# every recommendation of the section satisfied at once (the inputs above merged)
test_sudo_section_compliant_on_merged_good_input if {
	vs := data.cis_rocky_linux_8.sudo.violations with input as {"sudo": {"installed": true, "sudoers_content": "Defaults use_pty\nroot ALL=(ALL) ALL\nDefaults logfile=\"/var/log/sudo.log\"\n%wheel ALL=(ALL) ALL\nDefaults use_pty\nDefaults timestamp_timeout=15", "logfile_exists": true, "su_restricted": true}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_sudo_violations_carry_section_ids if {
	vs := data.cis_rocky_linux_8.sudo.violations with input as {}
	every v in vs { split(v, ":")[0] in ["5.2.1", "5.2.2", "5.2.3", "5.2.4", "5.2.5", "5.2.6", "5.2.7"] }
}
