test_control_results_empty_input_nothing_passes if {
	r := data.cis_windows_10.main.compliance_report with input as {}
	every c in r.control_results { c.status in {"evidence_missing", "not_attested", "not_applicable"} }
	r.control_result_counts.pass == 0
}

test_control_results_compliant_fixture_all_only_pass_or_not_applicable if {
	r := data.cis_windows_10.main.compliance_report with input as data.cis_windows_10.fixtures_test.fixture_all
	every c in r.control_results { c.status in {"pass", "not_applicable"} }
	r.control_result_counts.pass == r.total_controls
}

test_control_results_scope_level1 if {
	r := data.cis_windows_10.main.compliance_report with input as {"cis_profile": {"level": 1, "bitlocker": false, "next_generation": false}}
	r.total_controls == 337
	count([c | some c in r.control_results; c.in_scope]) == r.total_controls
	count([c | some c in r.control_results; c.status in FAILING]) == r.failed_controls
}

