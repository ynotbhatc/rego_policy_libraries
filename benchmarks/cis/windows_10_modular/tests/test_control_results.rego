test_control_results_fields_and_statuses if {
	r := data.cis_windows_10.main.compliance_report with input as {}
	every c in r.control_results {
		c.status in {"pass", "fail", "evidence_missing", "not_attested", "not_applicable"}
		c.basis in {"evidence", "attestation"}
		c.in_scope == c.status != "not_applicable"
		is_array(c.profile)
		count(c.profile) > 0
		every k in object.keys(c) { k in {"id", "status", "basis", "in_scope", "profile", "evidence"} }
	}
}

test_control_results_agree_with_totals_empty_input if {
	r := data.cis_windows_10.main.compliance_report with input as {}
	count([c | some c in r.control_results; c.in_scope]) == r.total_controls
	count([c | some c in r.control_results; c.status in FAILING]) == r.failed_controls
	count([c | some c in r.control_results; c.status == "pass"]) == r.passed_controls
	sum([n | some n in r.control_result_counts]) == 501
	every s, n in r.control_result_counts { n == count([c | some c in r.control_results; c.status == s]) }
}

test_control_results_agree_with_violations_empty_input if {
	r := data.cis_windows_10.main.compliance_report with input as {}
	cited(r.violations) == failing(r.control_results)
}

test_control_results_evidence_known_empty_input if {
	r := data.cis_windows_10.main.compliance_report with input as {}
	every c in r.control_results { count(object.get(c, "evidence", [])) > 0 }
}

test_control_results_agree_with_totals_mixed_partial_input if {
	r := data.cis_windows_10.main.compliance_report with input as object.union(json.remove(data.cis_windows_10.fixtures_test.fixture_all, ["audit_policy", "attestations"]), {"registry": {"HKLM\\System\\CurrentControlSet\\Control\\SAM": {"RelaxMinimumPasswordLengthLimits": 2}}})
	count([c | some c in r.control_results; c.in_scope]) == r.total_controls
	count([c | some c in r.control_results; c.status in FAILING]) == r.failed_controls
	count([c | some c in r.control_results; c.status == "pass"]) == r.passed_controls
	sum([n | some n in r.control_result_counts]) == 501
	every s, n in r.control_result_counts { n == count([c | some c in r.control_results; c.status == s]) }
}

test_control_results_agree_with_violations_mixed_partial_input if {
	r := data.cis_windows_10.main.compliance_report with input as object.union(json.remove(data.cis_windows_10.fixtures_test.fixture_all, ["audit_policy", "attestations"]), {"registry": {"HKLM\\System\\CurrentControlSet\\Control\\SAM": {"RelaxMinimumPasswordLengthLimits": 2}}})
	cited(r.violations) == failing(r.control_results)
}

test_control_results_evidence_known_mixed_partial_input if {
	r := data.cis_windows_10.main.compliance_report with input as object.union(json.remove(data.cis_windows_10.fixtures_test.fixture_all, ["audit_policy", "attestations"]), {"registry": {"HKLM\\System\\CurrentControlSet\\Control\\SAM": {"RelaxMinimumPasswordLengthLimits": 2}}})
	every c in r.control_results { count(object.get(c, "evidence", [])) > 0 }
}

test_control_results_agree_with_totals_fixture_all if {
	r := data.cis_windows_10.main.compliance_report with input as data.cis_windows_10.fixtures_test.fixture_all
	count([c | some c in r.control_results; c.in_scope]) == r.total_controls
	count([c | some c in r.control_results; c.status in FAILING]) == r.failed_controls
	count([c | some c in r.control_results; c.status == "pass"]) == r.passed_controls
	sum([n | some n in r.control_result_counts]) == 501
	every s, n in r.control_result_counts { n == count([c | some c in r.control_results; c.status == s]) }
}

