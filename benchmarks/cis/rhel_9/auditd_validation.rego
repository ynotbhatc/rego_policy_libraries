# Ensure auditd packages are installed
default e_6_2_1_1 := false

e_6_2_1_1 if {
	is_boolean(input.packages.audit)
	is_boolean(input.packages["audit-libs"])
}

default p_6_2_1_1 := false

p_6_2_1_1 if {
	input.packages.audit == true
	input.packages["audit-libs"] == true
}

violations contains "6.2.1.1: evidence missing — packages[audit,audit-libs] not collected" if not e_6_2_1_1

violations contains "6.2.1.1: not met — Ensure auditd packages are installed" if {
	e_6_2_1_1
	not p_6_2_1_1
}

# 6.2.1.2 (Automated; Level 2 - Server, Level 2 - Workstation)
# Ensure auditing for processes that start prior to auditd is enabled
