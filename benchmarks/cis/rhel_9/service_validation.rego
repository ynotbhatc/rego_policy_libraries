# 2.3.3 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure chrony is not run as the root user
default e_2_3_3 := false

e_2_3_3 if {
	is_string(input.chronyd.sysconfig_options)
}

e_2_3_3 if {
	input.chronyd.installed == false
}

default p_2_3_3 := false

p_2_3_3 if {
	not regex.match(`(^|\s)-u\s+root\b`, input.chronyd.sysconfig_options)
}

p_2_3_3 if {
	input.chronyd.installed == false
}

violations contains "2.3.3: evidence missing — chronyd.sysconfig_options (or chronyd.installed) not collected" if not e_2_3_3

violations contains "2.3.3: not met — Ensure chrony is not run as the root user" if {
	e_2_3_3
	not p_2_3_3
}
