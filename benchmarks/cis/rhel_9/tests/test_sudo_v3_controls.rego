# every recommendation of the section satisfied at once (the inputs above merged)
test_v3_sudo_section_compliant_on_merged_good_input if {
	vs := data.cis_rhel9.sudo.violations with input as {"sudo": {"installed": true, "sudoers_mode": "0440", "sudoers_owner": "root", "sudoers_group": "root", "sudoers_d_files": [{"path": "/etc/sudoers.d/admins", "mode": "0440", "owner": "root", "group": "root"}], "sudoers_d_dir": {"mode": "0750", "owner": "root", "group": "root"}, "sudoers_content": "Defaults use_pty\nroot ALL=(ALL) ALL\nDefaults logfile=\"/var/log/sudo.log\"\n%wheel ALL=(ALL) ALL\nDefaults use_pty\nDefaults use_pty\nDefaults !visiblepw\nDefaults timestamp_timeout=15\nDefaults timestamp_type=tty", "logfile_exists": true, "su_restricted": true}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_v3_sudo_violations_carry_section_ids if {
	vs := data.cis_rhel9.sudo.violations with input as {}
	every v in vs { split(v, ":")[0] in ["5.2.1", "5.2.2", "5.2.3", "5.2.4", "5.2.5", "5.2.6", "5.2.7", "5.2.8", "5.2.9", "5.2.10", "5.2.11", "5.2.12"] }
}
