# every recommendation of the section satisfied at once (the inputs above merged)
test_v3_cron_section_compliant_on_merged_good_input if {
	vs := data.cis_rhel9.cron.violations with input as {"cron": {"crond_enabled": true, "crond_running": true, "crontab_mode": "0600", "crontab_owner": "root", "crontab_group": "root", "cron_hourly_mode": "0700", "cron_hourly_owner": "root", "cron_hourly_group": "root", "cron_daily_mode": "0700", "cron_daily_owner": "root", "cron_daily_group": "root", "cron_weekly_mode": "0700", "cron_weekly_owner": "root", "cron_weekly_group": "root", "cron_monthly_mode": "0700", "cron_monthly_owner": "root", "cron_monthly_group": "root", "cron_yearly_mode": "0700", "cron_yearly_owner": "root", "cron_yearly_group": "root", "cron_d_mode": "0700", "cron_d_owner": "root", "cron_d_group": "root", "cron_allow_exists": true, "cron_allow_mode": "0640", "cron_allow_owner": "root", "cron_allow_group": "root", "cron_deny_exists": false, "at_allow_exists": true, "at_allow_mode": "0640", "at_allow_owner": "root", "at_allow_group": "root", "at_deny_exists": false}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_v3_cron_violations_carry_section_ids if {
	vs := data.cis_rhel9.cron.violations with input as {}
	every v in vs { split(v, ":")[0] in ["2.4.1.1", "2.4.1.2", "2.4.1.3", "2.4.1.4", "2.4.1.5", "2.4.1.6", "2.4.1.7", "2.4.1.8", "2.4.1.9", "2.4.2.1"] }
}
