test_2_4_1_1_pass if {
	vs := data.cis_rhel9.cron.violations with input as {"cron": {"crond_enabled": true, "crond_running": true}}
	count([v | some v in vs; startswith(v, "2.4.1.1: ")]) == 0
}

test_2_4_1_1_fail if {
	vs := data.cis_rhel9.cron.violations with input as {"cron": {"crond_enabled": true, "crond_running": false}}
	count([v | some v in vs; startswith(v, "2.4.1.1: ")]) > 0
	not "2.4.1.1: evidence missing — cron.crond_enabled/crond_running not collected" in vs
}

test_2_4_1_1_evidence_missing if {
	vs := data.cis_rhel9.cron.violations with input as {}
	"2.4.1.1: evidence missing — cron.crond_enabled/crond_running not collected" in vs
}

