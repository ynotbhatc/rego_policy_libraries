# every recommendation of the section satisfied at once (the inputs above merged)
test_v3_services_section_compliant_on_merged_good_input if {
	vs := data.cis_rhel9.services.violations with input as {"packages": {"autofs": false, "avahi": false, "cockpit-ws": false, "dhcp-server": false, "bind": false, "dnsmasq": false, "samba": false, "vsftpd": false, "dovecot": false, "cyrus-imapd": false, "nfs-utils": false, "cups": false, "rpcbind": false, "rsync-daemon": false, "net-snmp": false, "telnet-server": false, "tftp-server": false, "squid": false, "httpd": false, "nginx": false, "xorg-x11-server-common": false, "xorg-x11-server-Xwayland": false, "ftp": false, "openldap-clients": false, "telnet": false, "tftp": false}, "mta": {"has_mta": true, "non_loopback_listeners": [], "inet_interfaces": "loopback-only"}, "gui": {"environment_installed": true, "default_target": "multi-user.target"}, "attest": {"listening_services_approved": true}, "chronyd": {"installed": true, "servers_configured": 0, "pools_configured": 1, "sysconfig_options": "-F 2"}}
	count(vs) == 0
}

# every violation names a recommendation of this section
