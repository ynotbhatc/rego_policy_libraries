# every recommendation of the section satisfied at once (the inputs above merged)
test_v3_boot_security_section_compliant_on_merged_good_input if {
	vs := data.cis_rhel9.boot_security.violations with input as {"boot_security": {"grub_password_set": true, "grub_password_hashed": true, "grub_cfg_mode": "0600", "grub_cfg_owner": "root", "grub_cfg_group": "root", "grub_files": [{"path": "/boot/grub2/grub.cfg", "mode": "0600", "owner": "root", "group": "root"}, {"path": "/boot/grub2/grubenv", "mode": "0600", "owner": "root", "group": "root"}], "rescue_auth_required": true, "emergency_auth_required": true, "kernel_args": ["ro crashkernel=1G audit=1"], "core_dumps_disabled_limits": true, "systemd_coredump_process_size_max": "0", "systemd_coredump_storage": "none", "aide_installed": true, "aide_cron_configured": false, "aide_timer_configured": true, "aide_audit_tool_options": {"auditctl": "p+i+n+u+g+s+b+acl+xattrs+sha512", "auditd": "p+i+n+u+g+s+b+acl+xattrs+sha512", "ausearch": "p+i+n+u+g+s+b+acl+xattrs+sha512", "aureport": "p+i+n+u+g+s+b+acl+xattrs+sha512", "autrace": "p+i+n+u+g+s+b+acl+xattrs+sha512", "augenrules": "p+i+n+u+g+s+b+acl+xattrs+sha512"}, "aide_report_urls": ["syslog:LOG_LOCAL0"]}, "sysctl_parameters": {"analysis": [{"parameter": "fs.protected_hardlinks", "current_value": "1"}, {"parameter": "fs.protected_symlinks", "current_value": "1"}, {"parameter": "fs.suid_dumpable", "current_value": "0"}, {"parameter": "kernel.dmesg_restrict", "current_value": "1"}, {"parameter": "kernel.kptr_restrict", "current_value": "1"}, {"parameter": "kernel.randomize_va_space", "current_value": "2"}, {"parameter": "kernel.yama.ptrace_scope", "current_value": "1"}], "persisted": {"fs.protected_hardlinks": "1", "fs.protected_symlinks": "1", "fs.suid_dumpable": "0", "kernel.dmesg_restrict": "1", "kernel.kptr_restrict": "1", "kernel.randomize_va_space": "2", "kernel.yama.ptrace_scope": "1"}}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_v3_boot_security_violations_carry_section_ids if {
	vs := data.cis_rhel9.boot_security.violations with input as {}
	every v in vs { split(v, ":")[0] in ["1.4.1", "1.4.2", "1.4.3", "1.4.4", "1.4.5", "1.5.1", "1.5.2", "1.5.3", "1.5.4", "1.5.5", "1.5.6", "1.5.7", "1.5.8", "1.5.9", "1.5.10", "6.3.1", "6.3.2", "6.3.3", "6.3.4"] }
}
