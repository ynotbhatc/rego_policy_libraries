# every recommendation of the section satisfied at once (the inputs above merged)
test_v3_ssh_section_compliant_on_merged_good_input if {
	vs := data.cis_rhel9.ssh.violations with input as {"ssh": {"config_permissions": {"mode": "0600", "pw_name": "root", "gr_name": "root"}, "dropin_permissions": [{"mode": "0600", "pw_name": "root", "gr_name": "root", "path": "/etc/ssh/sshd_config.d/50-redhat.conf"}], "dropin_dir_permissions": {"mode": "0700", "pw_name": "root", "gr_name": "root"}, "private_key_permissions": [{"stat": {"path": "/etc/ssh/ssh_host_ed25519_key", "mode": "0600", "pw_name": "root", "gr_name": "root"}}, {"stat": {"path": "/etc/ssh/ssh_host_rsa_key", "mode": "0640", "pw_name": "root", "gr_name": "ssh_keys"}}], "public_key_permissions": [{"path": "/etc/ssh/ssh_host_ed25519_key.pub", "mode": "0644", "pw_name": "root", "gr_name": "root"}], "sshd_config_raw": "port 22\nciphers aes256-gcm@openssh.com,aes256-ctr\nport 22\nkexalgorithms curve25519-sha256,ecdh-sha2-nistp256\nport 22\nmacs hmac-sha2-512-etm@openssh.com,hmac-sha2-256\nport 22\nallowgroups sshusers\nbanner /etc/issue.net\nclientaliveinterval 15\nclientalivecountmax 3\nport 22\ndisableforwarding yes\nport 22\ngssapiauthentication no\nport 22\nhostbasedauthentication no\nport 22\nignorerhosts yes\nport 22\nlogingracetime 60\nport 22\nloglevel VERBOSE\nport 22\nmaxauthtries 4\nport 22\nmaxstartups 10:30:60\nport 22\nmaxsessions 10\nport 22\npermitemptypasswords no\nport 22\npermitrootlogin no\nport 22\npermituserenvironment no\nport 22\nusepam yes", "banner_contains_sensitive_info": false}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_v3_ssh_violations_carry_section_ids if {
	vs := data.cis_rhel9.ssh.violations with input as {}
	every v in vs { split(v, ":")[0] in ["5.1.1", "5.1.2", "5.1.3", "5.1.4", "5.1.5", "5.1.6", "5.1.7", "5.1.8", "5.1.9", "5.1.10", "5.1.11", "5.1.12", "5.1.13", "5.1.14", "5.1.15", "5.1.16", "5.1.17", "5.1.18", "5.1.19", "5.1.20", "5.1.21", "5.1.22", "5.1.23"] }
}
