package cis_rhel9.selinux_test

import rego.v1

# Generated by tools/cis_generators/gen_rhel_9.py: a pass and a fail case for every recommendation, plus an evidence-missing
# case for every Automated one. Assertions key on '<id>: ' (colon included).

test_1_3_1_1_pass if {
	vs := data.cis_rhel9.selinux.violations with input as {"selinux": {"installed": true}}
	count([v | some v in vs; startswith(v, "1.3.1.1: ")]) == 0
}

test_1_3_1_1_fail if {
	vs := data.cis_rhel9.selinux.violations with input as {"selinux": {"installed": false}}
	count([v | some v in vs; startswith(v, "1.3.1.1: ")]) > 0
	not "1.3.1.1: evidence missing — selinux.installed not collected" in vs
}

test_1_3_1_1_evidence_missing if {
	vs := data.cis_rhel9.selinux.violations with input as {}
	"1.3.1.1: evidence missing — selinux.installed not collected" in vs
}

