# every recommendation of the section satisfied at once (the inputs above merged)
test_v3_selinux_section_compliant_on_merged_good_input if {
	vs := data.cis_rhel9.selinux.violations with input as {"selinux": {"installed": true, "grub_cmdline": "GRUB_CMDLINE_LINUX=\"quiet audit=1\"", "policy": "targeted", "mode": "enforcing", "config_mode": "enforcing", "mcstrans_installed": false, "setroubleshoot_installed": false}, "attest": {"no_unconfined_services": true}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_v3_selinux_violations_carry_section_ids if {
	vs := data.cis_rhel9.selinux.violations with input as {}
	every v in vs { split(v, ":")[0] in ["1.3.1.1", "1.3.1.2", "1.3.1.3", "1.3.1.4", "1.3.1.5", "1.3.1.6", "1.3.1.7", "1.3.1.8"] }
}
