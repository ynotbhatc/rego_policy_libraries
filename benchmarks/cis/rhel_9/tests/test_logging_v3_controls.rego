# every recommendation of the section satisfied at once (the inputs above merged)
test_v3_logging_section_compliant_on_merged_good_input if {
	vs := data.cis_rhel9.logging.violations with input as {"journald": {"service_active": true, "forward_to_syslog": "yes"}, "services": {"sshd.service": {"state": "running", "status": "enabled"}, "systemd-journal-remote.socket": {"state": "inactive", "status": "not-found"}, "systemd-journal-remote.service": {"state": "inactive", "status": "not-found"}}, "attest": {"journald_rotation_reviewed": true, "journald_file_access_reviewed": true, "rsyslog_logging_rules_reviewed": true, "rsyslog_remote_host_configured": true, "rsyslog_tls_ca_configured": true, "rsyslog_tls_client_cert_configured": true, "logrotate_reviewed": true}, "rsyslog": {"installed": true, "service_enabled": true, "service_active": true, "file_create_mode": "0640", "config_files": [{"path": "/etc/rsyslog.conf", "mode": "0640", "owner": "root", "group": "root"}], "d_dir": {"mode": "0755", "owner": "root", "group": "root"}, "work_dir": {"mode": "0700", "owner": "root", "group": "root"}, "config_raw": "*.* /var/log/messages\naction(type=\"omfwd\" target=\"loghost.example.com\" port=\"6514\" protocol=\"tcp\"\n  StreamDriver=\"gtls\" StreamDriverMode=\"1\" StreamDriverAuthMode=\"x509/name\")"}, "packages": {"rsyslog-gnutls": true, "rsyslog-openssl": false}, "log_file_permissions": {"analysis": [{"file": "/var/log/messages", "actual_mode": "0600", "actual_owner": "root", "actual_group": "root"}, {"file": "/var/log/wtmp", "actual_mode": "0664", "actual_owner": "root", "actual_group": "utmp"}]}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_v3_logging_violations_carry_section_ids if {
	vs := data.cis_rhel9.logging.violations with input as {}
	every v in vs { split(v, ":")[0] in ["6.1.1.1", "6.1.1.2", "6.1.1.3", "6.1.1.4", "6.1.1.5", "6.1.2.1", "6.1.2.2", "6.1.2.3", "6.1.2.4", "6.1.2.5", "6.1.2.6", "6.1.2.7", "6.1.2.8", "6.1.2.9", "6.1.2.10", "6.1.2.11", "6.1.2.12", "6.1.2.13", "6.1.2.14", "6.1.3.1"] }
}
