# every recommendation of the section satisfied at once (the inputs above merged)
test_v3_file_permissions_section_compliant_on_merged_good_input if {
	vs := data.cis_rhel9.file_permissions.violations with input as {"critical_files": {"analysis": [{"file": "/etc/other", "exists": true, "actual_mode": "0644", "actual_owner": "root", "actual_group": "root"}, {"file": "/etc/passwd", "exists": true, "actual_mode": "0644", "actual_owner": "root", "actual_group": "root"}, {"file": "/etc/passwd-", "exists": true, "actual_mode": "0644", "actual_owner": "root", "actual_group": "root"}, {"file": "/etc/group", "exists": true, "actual_mode": "0644", "actual_owner": "root", "actual_group": "root"}, {"file": "/etc/group-", "exists": true, "actual_mode": "0644", "actual_owner": "root", "actual_group": "root"}, {"file": "/etc/shadow", "exists": true, "actual_mode": "0000", "actual_owner": "root", "actual_group": "root"}, {"file": "/etc/shadow-", "exists": true, "actual_mode": "0000", "actual_owner": "root", "actual_group": "root"}, {"file": "/etc/gshadow", "exists": true, "actual_mode": "0000", "actual_owner": "root", "actual_group": "root"}, {"file": "/etc/gshadow-", "exists": true, "actual_mode": "0000", "actual_owner": "root", "actual_group": "root"}, {"file": "/etc/shells", "exists": true, "actual_mode": "0644", "actual_owner": "root", "actual_group": "root"}, {"file": "/etc/security/opasswd", "exists": true, "actual_mode": "0600", "actual_owner": "root", "actual_group": "root"}, {"file": "/etc/security/opasswd.old", "exists": false}]}, "world_writable": {"files": [], "count": 0}, "sticky_bit": {"world_writable_without_sticky": []}, "unowned_files": {"files": [], "count": 0}, "ungrouped_files": {"files": [], "count": 0}, "attest": {"suid_sgid_files_reviewed": true}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_v3_file_permissions_violations_carry_section_ids if {
	vs := data.cis_rhel9.file_permissions.violations with input as {}
	every v in vs { split(v, ":")[0] in ["7.1.1", "7.1.2", "7.1.3", "7.1.4", "7.1.5", "7.1.6", "7.1.7", "7.1.8", "7.1.9", "7.1.10", "7.1.11", "7.1.12", "7.1.13"] }
}
