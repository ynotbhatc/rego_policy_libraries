test_v3_legacy_profile_values_map_to_server_profiles if {
	r1 := data.cis_rhel9.main.compliance_report with input as {"profile": "level1"}
	r1.profile == "level1_server"
	r1.total_controls == 263
	r2 := data.cis_rhel9.main.compliance_report with input as {"profile": "level2"}
	r2.profile == "level2_server"
	r2.total_controls == 352
}

test_v3_unknown_profile_defaults_to_level1_server if {
	r := data.cis_rhel9.main.compliance_report with input as {"profile": "bogus"}
	r.profile == "level1_server"
	r.total_controls == 263
}

test_v3_one_attested_control_passes if {
	r := data.cis_rhel9.main.compliance_report with input as {"attest": {"gpg_keys_reviewed": true}}
	r.passed_controls == 1
	r.failed_controls == r.total_controls - 1
	r.compliant == false
}

test_v3_level2_violation_hidden_in_level1_profile if {
	vs := data.cis_rhel9.all_violations with input as {"profile": "level1_server"}
	count([v | some v in vs; startswith(v, "6.2.1.1: ")]) == 0
	vs2 := data.cis_rhel9.all_violations with input as {"profile": "level2_server"}
	count([v | some v in vs2; startswith(v, "6.2.1.1: ")]) > 0
}

test_v3_every_violation_parses_to_a_control if {
	vs := data.cis_rhel9.all_violations with input as {"profile": "level2_server"}
	every v in vs { split(v, ":")[0] in object.keys(data.cis_rhel9.controls) }
	mvs := data.cis_rhel9.module_violations with input as {}
	every _, mv in mvs {
		every v in mv { split(v, ":")[0] in object.keys(data.cis_rhel9.controls) }
	}
}

test_v3_l2_view_is_level2_server_only if {
	r := data.cis_rhel9.l2.compliance_report with input as {}
	r.total_controls == 89
	r.compliant == false
	l2v := data.cis_rhel9.l2.violations with input as {}
	every v in l2v { data.cis_rhel9.controls[split(v, ":")[0]].levels.server == 2 }
}
