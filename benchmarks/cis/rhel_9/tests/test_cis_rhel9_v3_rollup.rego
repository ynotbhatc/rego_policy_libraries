package cis_rhel9.main_test

import rego.v1

# Generated by tools/cis_generators/gen_rhel_9.py: roll-up and bridge tests for CIS Red Hat Enterprise Linux 9 Benchmark v3.0.0.

test_v3_every_recommendation_in_table if {
	count(data.cis_rhel9.controls) == 352
	count([c | some c in data.cis_rhel9.controls; c.assessment == "Manual"]) == 23
	data.cis_rhel9.standard_total == 352
}

test_v3_empty_input_fails_closed if {
	r := data.cis_rhel9.main.compliance_report with input as {}
	count(object.keys(r)) == 17
	every k in ["framework", "benchmark", "version", "profile", "total_controls", "standard_total", "controls_basis", "passed_controls", "failed_controls", "compliance_percentage", "section_compliance_percentage", "compliant", "violations", "section_results", "sections_not_assessed", "missing_inputs", "assessment_coverage_percentage"] { k in object.keys(r) }
	r.compliant == false
	r.total_controls == 263
	r.failed_controls == r.total_controls
	r.passed_controls == 0
	some v in r.violations
	startswith(v, "FAIL-CLOSED: no facts supplied")
}

test_v3_profile_level1_server_count if {
	r := data.cis_rhel9.main.compliance_report with input as {"profile": "level1_server"}
	r.profile == "level1_server"
	r.total_controls == 263
	r.standard_total == 352
	r.failed_controls == r.total_controls
}

