# every recommendation of the section satisfied at once (the inputs above merged)
test_v3_pam_section_compliant_on_merged_good_input if {
	vs := data.cis_rhel9.pam.violations with input as {"pam": {"package_versions": {"pam": "1.5.1-14.el9", "authselect": "1.2.6-1.el9", "libpwquality": "1.4.4-8.el9"}, "authselect_profile": "sssd", "authselect_check_valid": true, "system_auth": "auth        required      pam_faillock.so preauth silent\nauth        sufficient    pam_unix.so\nauth        required      pam_faillock.so authfail\naccount     required      pam_faillock.so\naccount     required      pam_unix.so\npassword    requisite     pam_pwquality.so local_users_only\npassword    required      pam_pwhistory.so use_authtok\npassword    sufficient    pam_unix.so sha512 shadow use_authtok\nsession     required      pam_unix.so", "password_auth": "auth        required      pam_faillock.so preauth silent\nauth        sufficient    pam_unix.so\nauth        required      pam_faillock.so authfail\naccount     required      pam_faillock.so\naccount     required      pam_unix.so\npassword    requisite     pam_pwquality.so local_users_only\npassword    required      pam_pwhistory.so use_authtok\npassword    sufficient    pam_unix.so sha512 shadow use_authtok\nsession     required      pam_unix.so", "faillock_conf_raw": "deny = 5\nunlock_time = 900\ndeny = 5\neven_deny_root\nroot_unlock_time = 60", "pwquality_conf_raw": "difok = 2\nminlen = 14\nmaxrepeat = 3\nmaxsequence = 3\ndictcheck = 1\nminlen = 14\nenforce_for_root", "pwhistory_conf_raw": "remember = 24\nremember = 24\nenforce_for_root", "pass_max_days": 365, "pass_warn_age": 7, "encrypt_method": "SHA512", "inactive_days": 30, "system_accounts_with_login_shell": [], "tmout": 900, "tmout_readonly_exported": true, "login_defs_umask": "027", "default_umask": "027"}, "attest": {"password_complexity_reviewed": true, "minimum_password_days_reviewed": true}, "user_group": {"shadow_entries": [{"user": "alice", "has_password": true, "max_days": 365, "warn_days": 7, "inactive": 30, "last_change": 19000}], "uid_zero_accounts": ["root"], "gid_zero_accounts": ["root", "sync"], "gid_zero_groups": ["root"], "root_password_status": "PS", "root_path": "/usr/sbin:/usr/bin", "root_path_nonexistent_dirs": [], "root_path_writable_dirs": [], "root_path_entries": [{"path": "/usr/bin", "owner": "root", "mode": "0755"}], "root_umask": "0027", "unlocked_accounts_without_shell": [], "shells_content": "/bin/bash\n/bin/sh"}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_v3_pam_violations_carry_section_ids if {
	vs := data.cis_rhel9.pam.violations with input as {}
	every v in vs { split(v, ":")[0] in ["5.3.1.1", "5.3.1.2", "5.3.1.3", "5.3.2.1", "5.3.2.2", "5.3.2.3", "5.3.2.4", "5.3.2.5", "5.3.3.1.1", "5.3.3.1.2", "5.3.3.1.3", "5.3.3.2.1", "5.3.3.2.2", "5.3.3.2.3", "5.3.3.2.4", "5.3.3.2.5", "5.3.3.2.6", "5.3.3.2.7", "5.3.3.3.1", "5.3.3.3.2", "5.3.3.3.3", "5.3.3.4.1", "5.3.3.4.2", "5.3.3.4.3", "5.3.3.4.4", "5.4.1.1", "5.4.1.2", "5.4.1.3", "5.4.1.4", "5.4.1.5", "5.4.1.6", "5.4.2.1", "5.4.2.2", "5.4.2.3", "5.4.2.4", "5.4.2.5", "5.4.2.6", "5.4.2.7", "5.4.2.8", "5.4.3.1", "5.4.3.2", "5.4.3.3", "5.4.3.4"] }
}
