test_7_2_1_pass if {
	vs := data.cis_rhel9.user_group.violations with input as {"user_group": {"users_without_shadow": []}}
	count([v | some v in vs; startswith(v, "7.2.1: ")]) == 0
}

test_7_2_1_fail if {
	vs := data.cis_rhel9.user_group.violations with input as {"user_group": {"users_without_shadow": ["bob"]}}
	count([v | some v in vs; startswith(v, "7.2.1: ")]) > 0
	not "7.2.1: evidence missing — user_group.users_without_shadow not collected" in vs
}

