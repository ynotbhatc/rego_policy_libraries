	vs := data.cis_rhel9.initial_setup.violations with input as {"initial_setup": {"gdm_xdmcp_enabled": false, "gdm_installed": true}}
	count([v | some v in vs; startswith(v, "1.8.6: ")]) == 0
}

test_1_8_6_fail if {
	vs := data.cis_rhel9.initial_setup.violations with input as {"initial_setup": {"gdm_xdmcp_enabled": true, "gdm_installed": true}}
	count([v | some v in vs; startswith(v, "1.8.6: ")]) > 0
	not "1.8.6: evidence missing — initial_setup.gdm_installed/gdm_xdmcp_enabled not collected" in vs
}

test_1_8_6_evidence_missing if {
	vs := data.cis_rhel9.initial_setup.violations with input as {"initial_setup": {"gdm_installed": true}}
	"1.8.6: evidence missing — initial_setup.gdm_installed/gdm_xdmcp_enabled not collected" in vs
}

test_1_8_7_pass if {
	vs := data.cis_rhel9.initial_setup.violations with input as {"initial_setup": {"gdm_wayland_disabled": false, "gdm_installed": true}}
	count([v | some v in vs; startswith(v, "1.8.7: ")]) == 0
}

test_1_8_7_fail if {
	vs := data.cis_rhel9.initial_setup.violations with input as {"initial_setup": {"gdm_wayland_disabled": true, "gdm_installed": true}}
	count([v | some v in vs; startswith(v, "1.8.7: ")]) > 0
	not "1.8.7: evidence missing — initial_setup.gdm_installed/gdm_wayland_disabled not collected" in vs
}

test_1_8_7_evidence_missing if {
	vs := data.cis_rhel9.initial_setup.violations with input as {"initial_setup": {"gdm_installed": true}}
	"1.8.7: evidence missing — initial_setup.gdm_installed/gdm_wayland_disabled not collected" in vs
}

# every recommendation of the section satisfied at once (the inputs above merged)
test_v3_initial_setup_section_compliant_on_merged_good_input if {
	vs := data.cis_rhel9.initial_setup.violations with input as {"attest": {"gpg_keys_reviewed": true, "repositories_reviewed": true, "updates_installed": true, "crypto_policy_chacha20_ssh_reviewed": true, "crypto_policy_etm_ssh_reviewed": true}, "initial_setup": {"global_gpgcheck_enabled": true, "repos_without_gpgcheck": [], "enabled_repos": ["baseos"], "dnf_conf_raw": "[main]\nrepo_gpgcheck=1\n[main]\ninstall_weak_deps=False", "crypto_policy": "DEFAULT:PQ", "motd_exists": true, "motd_contains_sensitive_info": false, "issue_exists": true, "issue_contains_sensitive_info": false, "issue_net_exists": true, "issue_net_contains_sensitive_info": false, "motd_mode": "0644", "motd_owner": "root", "motd_group": "root", "issue_mode": "0644", "issue_owner": "root", "issue_group": "root", "issue_net_mode": "0644", "issue_net_owner": "root", "issue_net_group": "root", "gdm_banner_configured": true, "gdm_banner_override_allowed": false, "gdm_installed": true, "gdm_disable_user_list": true, "gdm_disable_user_list_override_allowed": false, "gdm_idle_delay": 900, "gdm_lock_delay": 5, "gdm_lock_override_allowed": false, "gdm_automount_disabled": true, "gdm_automount_open_disabled": true, "gdm_automount_override_allowed": false, "gdm_autorun_never_enabled": true, "gdm_autorun_override_allowed": false, "gdm_xdmcp_enabled": false, "gdm_wayland_disabled": false}, "crypto_policy": {"current_pol_raw": "hash = SHA2-256 SHA2-384\nsign = RSA-PSS-SHA2-256\nhash@RPM = SHA2-256 SHA1\nsha1_in_certs = 0\nmac = HMAC-SHA2-256 UMAC-128\ncipher = AES-256-GCM AES-128-GCM\ncipher@openssh-server = AES-256-GCM", "pq_module_available": true}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_v3_initial_setup_violations_carry_section_ids if {
	vs := data.cis_rhel9.initial_setup.violations with input as {}
	every v in vs { split(v, ":")[0] in ["1.2.1.1", "1.2.1.2", "1.2.1.3", "1.2.1.4", "1.2.1.5", "1.2.2.1", "1.6.1", "1.6.2", "1.6.3", "1.6.4", "1.6.5", "1.6.6", "1.6.7", "1.7.1", "1.7.2", "1.7.3", "1.7.4", "1.7.5", "1.7.6", "1.8.1", "1.8.2", "1.8.3", "1.8.4", "1.8.5", "1.8.6", "1.8.7"] }
