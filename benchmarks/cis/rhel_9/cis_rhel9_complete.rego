profiles := {"level1_server": {"platform": "server", "level": 1}, "level2_server": {"platform": "server", "level": 2}, "level1_workstation": {"platform": "workstation", "level": 1}, "level2_workstation": {"platform": "workstation", "level": 2}}

profile_aliases := {"level1": "level1_server", "level2": "level2_server"}

default profile := "level1_server"

profile := input.profile if input.profile in object.keys(profiles)

profile := profile_aliases[input.profile] if not input.profile in object.keys(profiles)

applies(c) if c.levels[profiles[profile].platform] <= profiles[profile].level

applicable_ids := {id | some id, c in controls; applies(c)}

module_violations := {
	"filesystem": filesystem.violations,
	"initial_setup": initial_setup.violations,
	"boot_security": boot_security.violations,
	"selinux": selinux.violations,
	"services": services.violations,
	"network": network.violations,
	"auditd": auditd.violations,
	"logging": logging.violations,
	"cron": cron.violations,
	"ssh": ssh.violations,
	"sudo": sudo.violations,
	"pam": pam.violations,
	"file_permissions": file_permissions.violations,
	"user_group": user_group.violations,
}

all_violations := sort([v |
	some _, vs in module_violations
	some v in vs
	split(v, ":")[0] in applicable_ids
])

failing_ids := {split(v, ":")[0] | some v in all_violations}

# =============================================================================
# ASSESSMENT COVERAGE — which sections received any of the input keys they read
# =============================================================================

section_inputs := {
 "section_1_1_filesystem": [
  "mount_options",
  "disabled_filesystem_modules",
  "separate_partitions",
  "usb_storage",
  "sticky_bit"
 ],
 "section_1_2_1_7_1_8_initial_setup": [
  "initial_setup",
  "crypto_policy"
 ],
 "section_1_3_1_4_1_5_boot_security": [
  "boot_security"
 ],
 "section_1_6_selinux": [
  "selinux"
 ],
 "section_2_services": [
  "unnecessary_services",
  "time_synchronization",
  "chronyd",
  "client_packages",
  "autofs",
  "mta",
  "gui",
  "x11",
  "webserver"
 ],
 "section_3_network": [
  "sysctl_parameters",
  "ip_forwarding",
  "ipv6",
  "firewall",
  "wireless_interfaces",
  "disabled_network_modules"
 ],
 "section_4_1_auditd": [
  "auditd"
 ],
 "section_4_2_logging": [
  "rsyslog",
  "journald",
  "log_file_permissions"
 ],
 "section_5_1_cron": [
  "cron"
 ],
 "section_5_2_ssh": [
  "ssh"
 ],
 "section_5_3_sudo": [
  "sudo"
 ],
 "section_5_4_5_5_pam": [
  "pam"
 ],
 "section_6_1_file_permissions": [
  "suid_files",
  "critical_files",
  "world_writable",
  "unowned_files",
  "ungrouped_files"
 ],
 "section_6_2_user_group": [
  "user_group"
 ]
}

section_assessed(name) if {
	some k in section_inputs[name]
	input[k]
}

missing_inputs := {name: [k | some k in section_inputs[name]; not input[k]] | some name, _ in section_inputs}

not_assessed_sections := sort([name | some name, _ in section_inputs; not section_assessed(name)])

assessed_sections := count(section_inputs) - count(not_assessed_sections)

assessment_coverage_percentage := round((assessed_sections * 100) / count(section_inputs))

section_assessment := {name: {"assessed": section_assessed(name) == true, "missing_inputs": missing_inputs[name]} |
	some name, _ in section_inputs
}

# =============================================================================
# SECTIONS (controls applicable to the selected profile)
# =============================================================================

section_ids(name) := {id | some id in applicable_ids; controls[id].section == name}

section_compliance := {name: {
	"compliant": count(section_ids(name) & failing_ids) == 0,
	"controls_covered": count(section_ids(name)),
	"violation_count": count([v | some v in all_violations; split(v, ":")[0] in section_ids(name)]),
} |
	some name, _ in section_inputs
	count(section_ids(name)) > 0
}

total_sections := count(section_compliance)

# A section counts as compliant only if it was actually assessed (fail-closed).
compliant_sections := count([name | some name, s in section_compliance; s.compliant == true; section_assessed(name)])

default compliance_percentage := 0

compliance_percentage := (compliant_sections * 100) / total_sections if total_sections > 0

total_controls_covered := count(applicable_ids)

default compliant := false

compliant if {
	count(object.keys(input)) > 0
	count(applicable_ids) > 0
	count(failing_ids) == 0
	count(not_assessed_sections) == 0
}

# =============================================================================
# RISK ASSESSMENT AND RECOMMENDATIONS (v2.0.0 shapes)
# =============================================================================

section_priority := {
 "section_5_2_ssh": "critical",
 "section_4_1_auditd": "critical",
 "section_1_6_selinux": "critical",
 "section_5_4_5_5_pam": "high",
 "section_5_3_sudo": "high",
 "section_4_2_logging": "high",
 "section_1_3_1_4_1_5_boot_security": "high",
 "section_5_1_cron": "medium",
 "section_6_2_user_group": "medium",
 "section_1_2_1_7_1_8_initial_setup": "medium"
}

critical_risks := [v | some v in all_violations; section_priority[controls[split(v, ":")[0]].section] == "critical"]

high_risks := [v | some v in all_violations; section_priority[controls[split(v, ":")[0]].section] == "high"]

overall_risk_level := "critical" if {
	count(critical_risks) > 0
} else := "high" if {
	count(high_risks) > 5
} else := "medium" if {
	count(all_violations) > 10
} else := "low"

generate_recommendations contains recommendation if {
	section_compliance["section_5_2_ssh"].compliant == false
	recommendation := {
		"priority": "critical",
		"section": "SSH Server Configuration",
		"issue": sprintf("%d ssh violations found", [section_compliance["section_5_2_ssh"].violation_count]),
		"action": "Harden SSH configuration per CIS guidelines",
		"controls": "CIS 5.1.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance["section_4_1_auditd"].compliant == false
	recommendation := {
		"priority": "critical",
		"section": "System Auditing",
		"issue": sprintf("%d auditd violations found", [section_compliance["section_4_1_auditd"].violation_count]),
		"action": "Configure auditd service and implement required audit rules",
		"controls": "CIS 6.2.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance["section_1_6_selinux"].compliant == false
	recommendation := {
		"priority": "critical",
		"section": "SELinux Configuration",
		"issue": sprintf("%d selinux violations found", [section_compliance["section_1_6_selinux"].violation_count]),
		"action": "Enable and configure SELinux in enforcing mode",
		"controls": "CIS 1.3.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance["section_5_4_5_5_pam"].compliant == false
	recommendation := {
		"priority": "high",
		"section": "Password Authentication",
		"issue": sprintf("%d pam violations found", [section_compliance["section_5_4_5_5_pam"].violation_count]),
		"action": "Configure password policies and PAM modules",
		"controls": "CIS 5.3.x, 5.4.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance["section_5_3_sudo"].compliant == false
	recommendation := {
		"priority": "high",
		"section": "Privilege Escalation",
		"issue": sprintf("%d sudo violations found", [section_compliance["section_5_3_sudo"].violation_count]),
		"action": "Harden sudo configuration and restrict su access",
		"controls": "CIS 5.2.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance["section_4_2_logging"].compliant == false
	recommendation := {
		"priority": "high",
		"section": "Logging Configuration",
		"issue": sprintf("%d logging violations found", [section_compliance["section_4_2_logging"].violation_count]),
		"action": "Configure rsyslog and journald properly",
		"controls": "CIS 6.1.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance["section_1_3_1_4_1_5_boot_security"].compliant == false
	recommendation := {
		"priority": "high",
		"section": "Boot Security & AIDE",
		"issue": sprintf("%d boot_security violations found", [section_compliance["section_1_3_1_4_1_5_boot_security"].violation_count]),
		"action": "Set bootloader password, enable AIDE, configure process hardening",
		"controls": "CIS 1.4.x, 1.5.x, 6.3.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance["section_5_1_cron"].compliant == false
	recommendation := {
		"priority": "medium",
		"section": "Cron Configuration",
		"issue": sprintf("%d cron violations found", [section_compliance["section_5_1_cron"].violation_count]),
		"action": "Set correct permissions on cron files and restrict access",
		"controls": "CIS 2.4.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance["section_6_2_user_group"].compliant == false
	recommendation := {
		"priority": "medium",
		"section": "User and Group Settings",
		"issue": sprintf("%d user_group violations found", [section_compliance["section_6_2_user_group"].violation_count]),
		"action": "Fix user account issues, duplicate UIDs/GIDs, and home directory permissions",
		"controls": "CIS 7.2.x",
	}
}

generate_recommendations contains recommendation if {
	section_compliance["section_1_2_1_7_1_8_initial_setup"].compliant == false
	recommendation := {
		"priority": "medium",
		"section": "Initial Setup & Banners",
		"issue": sprintf("%d initial_setup violations found", [section_compliance["section_1_2_1_7_1_8_initial_setup"].violation_count]),
		"action": "Configure warning banners, GPG keys, crypto policy and GNOME settings",
		"controls": "CIS 1.2.x, 1.6.x, 1.7.x, 1.8.x",
	}
}

overall_status := "compliant" if {
	compliant
} else := "non_compliant"

level2_ids := {id | some id, c in controls; object.get(c.levels, profiles[profile].platform, 0) == 2}

l2_violations_active := [v | some v in all_violations; split(v, ":")[0] in level2_ids] if {
	profiles[profile].level == 2
} else := []

default l2_compliant := false

l2_compliant if profiles[profile].level == 1

l2_compliant if {
	profiles[profile].level == 2
	count(l2_violations_active) == 0
}

executive_summary := {
	"overall_status": overall_status,
	"profile": profile,
	"compliance_score": compliance_percentage,
	"sections_evaluated": total_sections,
	"sections_compliant": compliant_sections,
	"total_violations": count(all_violations),
	"l1_violations": count(all_violations) - count(l2_violations_active),
	"l2_violations": count(l2_violations_active),
	"l2_compliant": l2_compliant,
	"critical_issues": count(critical_risks),
	"top_priorities": [rec | some rec in generate_recommendations; rec.priority == "critical"],
}

# Consumer endpoint — /v1/data/cis_rhel9/compliance_assessment (customer profiles query it)
compliance_assessment := {
	"framework": "CIS Red Hat Enterprise Linux 9 Benchmark v3.0.0",
	"compliant": compliant,
	"score": compliance_percentage,
	"total_controls": count(applicable_ids),
	"sections_evaluated": total_sections,
	"sections_compliant": compliant_sections,
	"violations": all_violations,
	"violation_count": count(all_violations),
	"summary": executive_summary,
}

# =============================================================================
# EXTENDED HARDENING (STIG / NIST / EDA drift detection) — separate from the CIS score
# =============================================================================

extended_violations := array.concat(
	array.concat(
		[v | some v in storage_encryption.violations],
		[v | some v in certificate_validation.violations],
	),
	[v | some v in authorized_keys.violations],
)

default hardening_compliant := false

hardening_compliant if {
	storage_encryption.compliant
	certificate_validation.compliant
	authorized_keys.compliant
}

default fully_hardened_compliant := false

fully_hardened_compliant if {
	compliant
	hardening_compliant
}

extended_hardening_summary := {
	"hardening_compliant": hardening_compliant,
	"fully_hardened_compliant": fully_hardened_compliant,
	"extended_violation_count": count(extended_violations),
	"modules": {
		"storage_encryption": {
			"compliant": storage_encryption.compliant,
			"violations": count(storage_encryption.violations),
			"standards": ["STIG RHEL-09-231xxx", "STIG RHEL-09-672xxx", "NIST SC-28"],
		},
		"certificate_validation": {
			"compliant": certificate_validation.compliant,
			"violations": count(certificate_validation.violations),
			"standards": ["NIST SC-17", "NIST IA-5"],
		},
		"authorized_keys": {
			"compliant": authorized_keys.compliant,
			"violations": count(authorized_keys.violations),
			"standards": ["STIG RHEL-09-255xxx", "NIST IA-3"],
		},
	},
}

generate_recommendations contains recommendation if {
	not storage_encryption.compliant
	recommendation := {
		"priority": "critical",
		"section": "Storage Encryption",
		"issue": sprintf("%d storage encryption violations found", [count(storage_encryption.violations)]),
		"action": "Enable LUKS encryption on data partitions, encrypt swap, verify FIPS mode",
		"controls": "STIG RHEL-09-231xxx / NIST SC-28",
	}
}

generate_recommendations contains recommendation if {
	not certificate_validation.compliant
	recommendation := {
		"priority": "high",
		"section": "Certificate and PKI",
		"issue": sprintf("%d certificate violations found", [count(certificate_validation.violations)]),
		"action": "Renew expired/expiring certificates, remove weak keys, audit trust store",
		"controls": "NIST SC-17 / IA-5",
	}
}

generate_recommendations contains recommendation if {
	not authorized_keys.compliant
	recommendation := {
		"priority": "critical",
		"section": "SSH Authorized Keys",
		"issue": sprintf("%d authorized_keys violations found", [count(authorized_keys.violations)]),
		"action": "Remove unauthorized keys, fix permissions, enforce approved-key baseline",
		"controls": "STIG RHEL-09-255xxx / NIST IA-3",
	}
}
