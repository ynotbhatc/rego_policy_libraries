package cis_rhel9.selinux

# CIS Red Hat Enterprise Linux 9 Benchmark v3.0.0, Section 1.3: Mandatory Access Control (SELinux).
# Generated by tools/cis_generators/gen_rhel_9.py from the CIS workbook; do not edit by hand.
# Each recommendation: e_<id> (facts collected), p_<id> (requirement met). Automated checks fail
# closed with '<id>: evidence missing — <field> not collected'; Manual ones need input.attest.<name>.
# Roll-up: package cis_rhel9 (section key section_1_6_selinux); profile scoping happens there, this package reports
# every recommendation of the section.

import rego.v1

default compliant := false

compliant if count(violations) == 0

controls := ["1.3.1.1", "1.3.1.2", "1.3.1.3", "1.3.1.4", "1.3.1.5", "1.3.1.6", "1.3.1.7", "1.3.1.8"]

# v2.0.0 report shape (callers read report.compliant / total_violations / violations)
report := {
	"compliant": compliant,
	"total_violations": count(violations),
	"violations": violations,
	"controls": controls,
	"compliance_summary": {"overall_compliant": compliant, "controls_evaluated": count(controls)},
	"collection_timestamp": object.get(input, ["collection_timestamp"], null),
}

# Parse an octal permission string ("644", "0644", "0o644") to an integer; undefined if not octal.
octal(s) := n if {
	t := trim_prefix(lower(trim_space(sprintf("%v", [s]))), "0o")
	regex.match(`^[0-7]{1,4}$`, t)
	p := concat("", [substring("0000", 0, 4 - count(t)), t])
	ds := [to_number(substring(p, i, 1)) | some i in numbers.range(0, 3)]
	n := ((ds[0] * 512) + (ds[1] * 64)) + ((ds[2] * 8) + ds[3])
}

# true when mode grants nothing beyond max (both octal strings)
mode_within(mode, max) if bits.and(octal(mode), bits.and(bits.negate(octal(max)), 4095)) == 0

# Active (non-blank, non-comment) lines of a configuration text.
active_lines(text) := [l |
	some raw in split(text, "\n")
	l := trim_space(raw)
	l != ""
	not startswith(l, "#")
]

# a collected text: a non-blank string ("" is not evidence)
text_collected(t) if {
	is_string(t)
	trim_space(t) != ""
}

regex_in_text(text, re) if {
	some l in active_lines(text)
	regex.match(re, l)
}

# Values of a `key = value` / `key value` directive (key is a case-insensitive regex); last one wins.
conf_values(text, key_re) := [trim(m[1], "\"' ") |
	some l in active_lines(text)
	some m in regex.find_all_string_submatch_n(concat("", ["(?i)^", key_re, `(?:\s*=\s*|\s+)(.*?)\s*$`]), l, 1)
]

conf_last(text, key_re) := vs[count(vs) - 1] if {
	vs := conf_values(text, key_re)
	count(vs) > 0
}

num(v) := to_number(trim_space(sprintf("%v", [v]))) if regex.match(`^\s*-?[0-9]+\s*$`, sprintf("%v", [v]))

# ── packages / services ──
services_collected if {
	is_object(input.services)
	count(input.services) > 0
}

unit_on(u) if input.services[u].status == "enabled"

unit_on(u) if lower(input.services[u].state) in {"running", "active"}

# every unit named for an installed package is reported in the inventory
unit_set_reported(p, _) if input.packages[p] == false

unit_set_reported(p, us) if {
	input.packages[p] == true
	every u in us { unit_reported(u) }
}

unit_reported(u) if {
	is_string(input.services[u].status)
	input.services[u].status != ""
}

unit_set_off(p, _) if input.packages[p] == false

unit_set_off(p, us) if {
	input.packages[p] == true
	every u in us { not unit_on(u) }
}

unit_enabled_active(u) if {
	input.services[u].status == "enabled"
	lower(input.services[u].state) in {"running", "active"}
}

# tmp.mount masked or disabled means systemd will not mount /tmp at boot
tmp_mount_unit_off if input.services["tmp.mount"].status in {"masked", "disabled"}

# ── kernel modules: {module, disabled, loaded, available?}; "unknown" proves nothing ──
kmod_evidence(e) if is_boolean(e.available)

kmod_evidence(e) if {
	is_boolean(e.disabled)
	is_boolean(e.loaded)
}

kmod_unavailable(e) if e.available == false

kmod_unavailable(e) if {
	e.disabled == true
	e.loaded == false
}

# ── mounts ──
mounts_collected if {
	is_array(input.ansible_facts.ansible_mounts)
	count(input.ansible_facts.ansible_mounts) > 0
}

mounts_at(path) := [m | some m in input.ansible_facts.ansible_mounts; m.mount == path]

mounted(path) if count(mounts_at(path)) > 0

mount_opts(m) := split(m.options, ",") if is_string(m.options)

mount_opts(m) := m.options if is_array(m.options)

# ── file lists ──
list_item_ok(f, mk, ok, gk, max, owners, groups) if {
	mode_within(f[mk], max)
	f[ok] in owners
	f[gk] in groups
}

# ── sshd: first occurrence wins (sshd semantics); `sshd -T` prints effective values ──
ssh_collected if {
	is_string(input.ssh.sshd_config_raw)
	trim_space(input.ssh.sshd_config_raw) != ""
}

sshd_pairs := [[lower(m[1]), trim_space(m[2])] |
	some l in active_lines(input.ssh.sshd_config_raw)
	some m in regex.find_all_string_submatch_n(`^([A-Za-z0-9]+)(?:\s*=\s*|\s+)(.*)$`, l, 1)
]

sshd_first(key) := vs[0] if {
	vs := [p[1] | some p in sshd_pairs; p[0] == key]
	count(vs) > 0
}

# effective value: `sshd -T` prints every directive, so a missing directive means the effective
# configuration was not collected (a raw sshd_config misses /usr/etc/ssh and sshd_config.d)
sshd_value(key) := sshd_first(key)

sshd_list(key) := [trim_space(x) | some x in split(lower(sshd_value(key)), ",")]

# seconds from an sshd time value ("60", "60s", "1m")
sshd_seconds(v) := to_number(v) if regex.match(`^[0-9]+$`, v)

sshd_seconds(v) := to_number(trim_suffix(v, "s")) if regex.match(`^[0-9]+s$`, v)

sshd_seconds(v) := to_number(trim_suffix(v, "m")) * 60 if regex.match(`^[0-9]+m$`, v)

# ── sysctl: running values from the mapper's analysis list (rhel_9 shape) ──
sysctl_running(p) := [sprintf("%v", [e.current_value]) |
	some e in object.get(input, ["sysctl_parameters", "analysis"], [])
	e.parameter == p
	e.current_value != null
]

# configured mode (/etc/selinux/config SELINUX=): selinux.config_mode, else the mapper's ansible_selinux
# helper rule: `not is_string(input.missing)` is undefined and never fires
selinux_own_config_mode if is_string(input.selinux.config_mode)

selinux_config_mode := input.selinux.config_mode if selinux_own_config_mode

selinux_config_mode := input.ansible_facts.ansible_selinux.config_mode if {
	not selinux_own_config_mode
	is_string(input.ansible_facts.ansible_selinux.config_mode)
}

# 1.3.1.1 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure SELinux is installed
default e_1_3_1_1 := false

e_1_3_1_1 if {
	is_boolean(input.selinux.installed)
}

default p_1_3_1_1 := false

p_1_3_1_1 if {
	input.selinux.installed == true
}

violations contains "1.3.1.1: evidence missing — selinux.installed not collected" if not e_1_3_1_1

violations contains "1.3.1.1: not met — Ensure SELinux is installed" if {
	e_1_3_1_1
	not p_1_3_1_1
}

# 1.3.1.2 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure SELinux is not disabled in bootloader configuration
default e_1_3_1_2 := false

e_1_3_1_2 if {
	text_collected(input.selinux.grub_cmdline)
}

default p_1_3_1_2 := false

p_1_3_1_2 if {
	not regex.match(`(^|[\s"])(selinux|enforcing)=0\b`, input.selinux.grub_cmdline)
}

violations contains "1.3.1.2: evidence missing — selinux.grub_cmdline not collected" if not e_1_3_1_2

violations contains "1.3.1.2: not met — Ensure SELinux is not disabled in bootloader configuration" if {
	e_1_3_1_2
	not p_1_3_1_2
}

# 1.3.1.3 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure SELinux policy is configured
default e_1_3_1_3 := false

e_1_3_1_3 if {
	text_collected(input.selinux.policy)
	input.selinux.policy != ""
}

default p_1_3_1_3 := false

p_1_3_1_3 if {
	lower(input.selinux.policy) in {"targeted", "mls"}
}

violations contains "1.3.1.3: evidence missing — selinux.policy not collected" if not e_1_3_1_3

violations contains "1.3.1.3: not met — Ensure SELinux policy is configured" if {
	e_1_3_1_3
	not p_1_3_1_3
}

# 1.3.1.4 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure the SELinux mode is not disabled
default e_1_3_1_4 := false

e_1_3_1_4 if {
	text_collected(input.selinux.mode)
	text_collected(selinux_config_mode)
}

default p_1_3_1_4 := false

p_1_3_1_4 if {
	lower(input.selinux.mode) in ["enforcing", "permissive"]
	lower(selinux_config_mode) in ["enforcing", "permissive"]
}

violations contains "1.3.1.4: evidence missing — selinux.mode/selinux.config_mode not collected" if not e_1_3_1_4

violations contains "1.3.1.4: not met — Ensure the SELinux mode is not disabled" if {
	e_1_3_1_4
	not p_1_3_1_4
}

# 1.3.1.5 (Automated; Level 2 - Server, Level 2 - Workstation)
# Ensure the SELinux mode is enforcing
default e_1_3_1_5 := false

e_1_3_1_5 if {
	text_collected(input.selinux.mode)
	text_collected(selinux_config_mode)
}

default p_1_3_1_5 := false

p_1_3_1_5 if {
	lower(input.selinux.mode) in ["enforcing"]
	lower(selinux_config_mode) in ["enforcing"]
}

violations contains "1.3.1.5: evidence missing — selinux.mode/selinux.config_mode not collected" if not e_1_3_1_5

violations contains "1.3.1.5: not met — Ensure the SELinux mode is enforcing" if {
	e_1_3_1_5
	not p_1_3_1_5
}

# 1.3.1.6 (Manual; Level 2 - Server, Level 2 - Workstation)
# Ensure no unconfined services exist
default p_1_3_1_6 := false

p_1_3_1_6 if {
	input.attest.no_unconfined_services == true
}

violations contains "1.3.1.6: manual review not attested — set attest.no_unconfined_services to true once reviewed (Ensure no unconfined services exist)" if not p_1_3_1_6

# 1.3.1.7 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure the MCS Translation Service (mcstrans) is not installed
default e_1_3_1_7 := false

e_1_3_1_7 if {
	is_boolean(input.selinux.mcstrans_installed)
}

default p_1_3_1_7 := false

p_1_3_1_7 if {
	input.selinux.mcstrans_installed == false
}

violations contains "1.3.1.7: evidence missing — selinux.mcstrans_installed not collected" if not e_1_3_1_7

violations contains "1.3.1.7: not met — Ensure the MCS Translation Service (mcstrans) is not installed" if {
	e_1_3_1_7
	not p_1_3_1_7
}

# 1.3.1.8 (Automated; Level 1 - Server)
# Ensure SETroubleshoot is not installed
default e_1_3_1_8 := false

e_1_3_1_8 if {
	is_boolean(input.selinux.setroubleshoot_installed)
}

default p_1_3_1_8 := false

p_1_3_1_8 if {
	input.selinux.setroubleshoot_installed == false
}

violations contains "1.3.1.8: evidence missing — selinux.setroubleshoot_installed not collected" if not e_1_3_1_8

