package cis_rhel9.sudo

# CIS Red Hat Enterprise Linux 9 Benchmark v3.0.0, Section 5.2: Privilege Escalation.
# Generated by tools/cis_generators/gen_rhel_9.py from the CIS workbook; do not edit by hand.
# Each recommendation: e_<id> (facts collected), p_<id> (requirement met). Automated checks fail
# closed with '<id>: evidence missing — <field> not collected'; Manual ones need input.attest.<name>.
# Roll-up: package cis_rhel9 (section key section_5_3_sudo); profile scoping happens there, this package reports
# every recommendation of the section.

import rego.v1

default compliant := false

compliant if count(violations) == 0

controls := ["5.2.1", "5.2.2", "5.2.3", "5.2.4", "5.2.5", "5.2.6", "5.2.7", "5.2.8", "5.2.9", "5.2.10", "5.2.11", "5.2.12"]

# v2.0.0 report shape (callers read report.compliant / total_violations / violations)
report := {
	"compliant": compliant,
	"total_violations": count(violations),
	"violations": violations,
	"controls": controls,
	"compliance_summary": {"overall_compliant": compliant, "controls_evaluated": count(controls)},
	"collection_timestamp": object.get(input, ["collection_timestamp"], null),
}

# Parse an octal permission string ("644", "0644", "0o644") to an integer; undefined if not octal.
octal(s) := n if {
	t := trim_prefix(lower(trim_space(sprintf("%v", [s]))), "0o")
	regex.match(`^[0-7]{1,4}$`, t)
	p := concat("", [substring("0000", 0, 4 - count(t)), t])
	ds := [to_number(substring(p, i, 1)) | some i in numbers.range(0, 3)]
	n := ((ds[0] * 512) + (ds[1] * 64)) + ((ds[2] * 8) + ds[3])
}

# true when mode grants nothing beyond max (both octal strings)
mode_within(mode, max) if bits.and(octal(mode), bits.and(bits.negate(octal(max)), 4095)) == 0

# Active (non-blank, non-comment) lines of a configuration text.
active_lines(text) := [l |
	some raw in split(text, "\n")
	l := trim_space(raw)
	l != ""
	not startswith(l, "#")
]

# a collected text: a non-blank string ("" is not evidence)
text_collected(t) if {
	is_string(t)
	trim_space(t) != ""
}

regex_in_text(text, re) if {
	some l in active_lines(text)
	regex.match(re, l)
}

# Values of a `key = value` / `key value` directive (key is a case-insensitive regex); last one wins.
conf_values(text, key_re) := [trim(m[1], "\"' ") |
	some l in active_lines(text)
	some m in regex.find_all_string_submatch_n(concat("", ["(?i)^", key_re, `(?:\s*=\s*|\s+)(.*?)\s*$`]), l, 1)
]

conf_last(text, key_re) := vs[count(vs) - 1] if {
	vs := conf_values(text, key_re)
	count(vs) > 0
}

num(v) := to_number(trim_space(sprintf("%v", [v]))) if regex.match(`^\s*-?[0-9]+\s*$`, sprintf("%v", [v]))

# ── packages / services ──
services_collected if {
	is_object(input.services)
	count(input.services) > 0
}

unit_on(u) if input.services[u].status == "enabled"

unit_on(u) if lower(input.services[u].state) in {"running", "active"}

# every unit named for an installed package is reported in the inventory
unit_set_reported(p, _) if input.packages[p] == false

unit_set_reported(p, us) if {
	input.packages[p] == true
	every u in us { unit_reported(u) }
}

unit_reported(u) if {
	is_string(input.services[u].status)
	input.services[u].status != ""
}

unit_set_off(p, _) if input.packages[p] == false

unit_set_off(p, us) if {
	input.packages[p] == true
	every u in us { not unit_on(u) }
}

unit_enabled_active(u) if {
	input.services[u].status == "enabled"
	lower(input.services[u].state) in {"running", "active"}
}

# tmp.mount masked or disabled means systemd will not mount /tmp at boot
tmp_mount_unit_off if input.services["tmp.mount"].status in {"masked", "disabled"}

# ── kernel modules: {module, disabled, loaded, available?}; "unknown" proves nothing ──
kmod_evidence(e) if is_boolean(e.available)

kmod_evidence(e) if {
	is_boolean(e.disabled)
	is_boolean(e.loaded)
}

kmod_unavailable(e) if e.available == false

kmod_unavailable(e) if {
	e.disabled == true
	e.loaded == false
}

# ── mounts ──
mounts_collected if {
	is_array(input.ansible_facts.ansible_mounts)
	count(input.ansible_facts.ansible_mounts) > 0
}

mounts_at(path) := [m | some m in input.ansible_facts.ansible_mounts; m.mount == path]

mounted(path) if count(mounts_at(path)) > 0

mount_opts(m) := split(m.options, ",") if is_string(m.options)

mount_opts(m) := m.options if is_array(m.options)

# ── file lists ──
list_item_ok(f, mk, ok, gk, max, owners, groups) if {
	mode_within(f[mk], max)
	f[ok] in owners
	f[gk] in groups
}

# ── sshd: first occurrence wins (sshd semantics); `sshd -T` prints effective values ──
ssh_collected if {
	is_string(input.ssh.sshd_config_raw)
	trim_space(input.ssh.sshd_config_raw) != ""
}

sshd_pairs := [[lower(m[1]), trim_space(m[2])] |
	some l in active_lines(input.ssh.sshd_config_raw)
	some m in regex.find_all_string_submatch_n(`^([A-Za-z0-9]+)(?:\s*=\s*|\s+)(.*)$`, l, 1)
]

sshd_first(key) := vs[0] if {
	vs := [p[1] | some p in sshd_pairs; p[0] == key]
	count(vs) > 0
}

# effective value: `sshd -T` prints every directive, so a missing directive means the effective
# configuration was not collected (a raw sshd_config misses /usr/etc/ssh and sshd_config.d)
sshd_value(key) := sshd_first(key)

sshd_list(key) := [trim_space(x) | some x in split(lower(sshd_value(key)), ",")]

# seconds from an sshd time value ("60", "60s", "1m")
sshd_seconds(v) := to_number(v) if regex.match(`^[0-9]+$`, v)

sshd_seconds(v) := to_number(trim_suffix(v, "s")) if regex.match(`^[0-9]+s$`, v)

sshd_seconds(v) := to_number(trim_suffix(v, "m")) * 60 if regex.match(`^[0-9]+m$`, v)

# ── sysctl: running values from the mapper's analysis list (rhel_9 shape) ──
sysctl_running(p) := [sprintf("%v", [e.current_value]) |
	some e in object.get(input, ["sysctl_parameters", "analysis"], [])
	e.parameter == p
	e.current_value != null
]

sudo_defaults_has(re) if {
	some l in active_lines(input.sudo.sudoers_content)
	regex.match(`^Defaults\b`, l)
	regex.match(re, l)
}

sudo_logfile if sudo_defaults_has(`(^|[\s,])logfile\s*=`)

sudo_timeouts := [num(m[1]) |
	some l in active_lines(input.sudo.sudoers_content)
	regex.match(`^Defaults\b`, l)
	some m in regex.find_all_string_submatch_n(`timestamp_timeout\s*=\s*(-?[0-9]+)`, l, -1)
]

# 5.2.1 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure sudo is installed
default e_5_2_1 := false

e_5_2_1 if {
	is_boolean(input.sudo.installed)
}

default p_5_2_1 := false

p_5_2_1 if {
	input.sudo.installed == true
}

violations contains "5.2.1: evidence missing — sudo.installed not collected" if not e_5_2_1

violations contains "5.2.1: not met — Ensure sudo is installed" if {
	e_5_2_1
	not p_5_2_1
}

# 5.2.2 (Automated; Level 1 - Server)
# Ensure access on sudoers configuration files is configured
default e_5_2_2 := false

e_5_2_2 if {
	input.sudo.sudoers_mode != null
	input.sudo.sudoers_owner != null
	input.sudo.sudoers_group != null
	is_array(input.sudo.sudoers_d_files)
}

default p_5_2_2 := false

p_5_2_2 if {
	mode_within(input.sudo.sudoers_mode, "0440")
	input.sudo.sudoers_owner == "root"
	input.sudo.sudoers_group == "root"
	every f in input.sudo.sudoers_d_files { mode_within(f.mode, "0440"); f.owner == "root"; f.group == "root" }
}

violations contains "5.2.2: evidence missing — sudo.sudoers_mode/sudoers_owner/sudoers_group/sudoers_d_files not collected" if not e_5_2_2

violations contains "5.2.2: not met — Ensure access on sudoers configuration files is configured" if {
	e_5_2_2
	not p_5_2_2
}

# 5.2.3 (Automated; Level 1 - Server)
# Ensure access on the /etc/sudoers.d directory is configured
default e_5_2_3 := false

e_5_2_3 if {
	input.sudo.sudoers_d_dir.mode != null
	input.sudo.sudoers_d_dir.owner != null
	input.sudo.sudoers_d_dir.group != null
}

default p_5_2_3 := false

p_5_2_3 if {
	mode_within(input.sudo.sudoers_d_dir.mode, "0750")
	input.sudo.sudoers_d_dir.owner in ["root"]
	input.sudo.sudoers_d_dir.group in ["root"]
}

violations contains "5.2.3: evidence missing — sudo.sudoers_d_dir.mode/sudo.sudoers_d_dir.owner/sudo.sudoers_d_dir.group not collected" if not e_5_2_3

violations contains "5.2.3: not met — Ensure access on the /etc/sudoers.d directory is configured" if {
	e_5_2_3
	not p_5_2_3
}

# 5.2.4 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure sudo commands use pty
default e_5_2_4 := false

e_5_2_4 if {
	text_collected(input.sudo.sudoers_content)
}

default p_5_2_4 := false

p_5_2_4 if {
	sudo_defaults_has(`(^|[\s,])use_pty\b`)
	not sudo_defaults_has(`!\s*use_pty\b`)
}

violations contains "5.2.4: evidence missing — sudo.sudoers_content not collected" if not e_5_2_4

violations contains "5.2.4: not met — Ensure sudo commands use pty" if {
	e_5_2_4
	not p_5_2_4
}

# 5.2.5 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure sudo log file exists
default e_5_2_5 := false

e_5_2_5 if {
	text_collected(input.sudo.sudoers_content)
}

default p_5_2_5 := false

p_5_2_5 if {
	sudo_logfile
	not input.sudo.logfile_exists == false
}

violations contains "5.2.5: evidence missing — sudo.sudoers_content/logfile_exists not collected" if not e_5_2_5

violations contains "5.2.5: not met — Ensure sudo log file exists" if {
	e_5_2_5
	not p_5_2_5
}

# 5.2.6 (Automated; Level 2 - Server, Level 2 - Workstation)
# Ensure users must provide password for escalation
default e_5_2_6 := false

e_5_2_6 if {
	text_collected(input.sudo.sudoers_content)
}

default p_5_2_6 := false

p_5_2_6 if {
	not regex_in_text(input.sudo.sudoers_content, "(^|[\\s:,])NOPASSWD\\s*:")
}

violations contains "5.2.6: evidence missing — sudo.sudoers_content not collected" if not e_5_2_6

violations contains "5.2.6: not met — Ensure users must provide password for escalation" if {
	e_5_2_6
	not p_5_2_6
}

# 5.2.7 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure re-authentication for privilege escalation is not disabled globally
default e_5_2_7 := false

e_5_2_7 if {
	text_collected(input.sudo.sudoers_content)
}

default p_5_2_7 := false

p_5_2_7 if {
	not regex_in_text(input.sudo.sudoers_content, "!authenticate\\b")
}

violations contains "5.2.7: evidence missing — sudo.sudoers_content not collected" if not e_5_2_7

violations contains "5.2.7: not met — Ensure re-authentication for privilege escalation is not disabled globally" if {
	e_5_2_7
	not p_5_2_7
}

# 5.2.8 (Automated; Level 1 - Server)
# Ensure sudo pwfeedback is configured
default e_5_2_8 := false

e_5_2_8 if {
	text_collected(input.sudo.sudoers_content)
}

default p_5_2_8 := false

p_5_2_8 if {
	not sudo_defaults_has(`(^|[\s,])pwfeedback\b`)
}

violations contains "5.2.8: evidence missing — sudo.sudoers_content not collected" if not e_5_2_8

violations contains "5.2.8: not met — Ensure sudo pwfeedback is configured" if {
	e_5_2_8
	not p_5_2_8
}

# 5.2.9 (Automated; Level 1 - Server)
# Ensure sudo visiblepw is configured
default e_5_2_9 := false

e_5_2_9 if {
	text_collected(input.sudo.sudoers_content)
}

default p_5_2_9 := false

p_5_2_9 if {
	not sudo_defaults_has(`(^|[\s,])visiblepw\b`)
}

violations contains "5.2.9: evidence missing — sudo.sudoers_content not collected" if not e_5_2_9

violations contains "5.2.9: not met — Ensure sudo visiblepw is configured" if {
	e_5_2_9
	not p_5_2_9
}

# 5.2.10 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure sudo timestamp_timeout is configured
default e_5_2_10 := false

e_5_2_10 if {
	text_collected(input.sudo.sudoers_content)
}

default p_5_2_10 := false

p_5_2_10 if {
	every t in sudo_timeouts { t >= 0; t <= 15 }
}

violations contains "5.2.10: evidence missing — sudo.sudoers_content not collected" if not e_5_2_10

violations contains "5.2.10: not met — Ensure sudo timestamp_timeout is configured" if {
	e_5_2_10
	not p_5_2_10
}

# 5.2.11 (Automated; Level 1 - Server)
# Ensure sudo timestamp_type is configured
default e_5_2_11 := false

e_5_2_11 if {
	text_collected(input.sudo.sudoers_content)
}

default p_5_2_11 := false

p_5_2_11 if {
	not regex_in_text(input.sudo.sudoers_content, "(?i)timestamp_type\\s*=\\s*global\\b")
}

violations contains "5.2.11: evidence missing — sudo.sudoers_content not collected" if not e_5_2_11

violations contains "5.2.11: not met — Ensure sudo timestamp_type is configured" if {
	e_5_2_11
	not p_5_2_11
}

# 5.2.12 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure access to the su command is restricted
default e_5_2_12 := false

e_5_2_12 if {
	is_boolean(input.sudo.su_restricted)
}

default p_5_2_12 := false

p_5_2_12 if {
	input.sudo.su_restricted == true
}

violations contains "5.2.12: evidence missing — sudo.su_restricted not collected" if not e_5_2_12

violations contains "5.2.12: not met — Ensure access to the su command is restricted" if {
