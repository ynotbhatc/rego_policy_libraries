# 6.1.2.7: module(load="imtcp" ...) and `input( type=` are remote-receive configuration; comments are not.
test_remote_receive_module_with_params_flagged if {
	vs := data.cis_ubuntu_22_04.logging.violations with input as {"rsyslog": {"installed": true, "config_raw": "module(load=\"imtcp\" MaxSessions=\"500\")\n"}}
	count([v | some v in vs; startswith(v, "6.1.2.7: not met")]) > 0
}

test_remote_receive_commented_out_not_flagged if {
	vs := data.cis_ubuntu_22_04.logging.violations with input as {"rsyslog": {"installed": true, "config_raw": "#module(load=\"imtcp\")\n*.* /var/log/syslog\n"}}
	count([v | some v in vs; startswith(v, "6.1.2.7: ")]) == 0
}
