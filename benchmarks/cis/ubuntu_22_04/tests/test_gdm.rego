# Lock entries are matched by key name; a host without GDM passes the GDM settings checks.
test_lock_entry_with_value_suffix_accepted if {
	vs := data.cis_ubuntu_22_04.gdm.violations with input as {"initial_setup": {"gdm_installed": true, "gdm_dconf_locks": ["automount=false", "automount-open=false"]}}
	count([v | some v in vs; startswith(v, "1.7.7: ")]) == 0
}

test_commented_lock_entry_not_counted if {
	vs := data.cis_ubuntu_22_04.gdm.violations with input as {"initial_setup": {"gdm_installed": true, "gdm_dconf_locks": ["/org/gnome/desktop/media-handling/automount", "# /org/gnome/desktop/media-handling/automount-open"]}}
	count([v | some v in vs; startswith(v, "1.7.7: not met")]) > 0
}

test_longer_key_name_is_not_the_lock if {
	vs := data.cis_ubuntu_22_04.gdm.violations with input as {"initial_setup": {"gdm_installed": true, "gdm_dconf_locks": ["/org/gnome/desktop/media-handling/autorun-never-x"]}}
	count([v | some v in vs; startswith(v, "1.7.9: not met")]) > 0
}

test_gdm_absent_passes_lock_checks if {
	vs := data.cis_ubuntu_22_04.gdm.violations with input as {"initial_setup": {"gdm_installed": false}}
	count([v | some v in vs; startswith(v, "1.7.5: ")]) == 0
}

test_no_dconf_profile_fails_banner if {
	vs := data.cis_ubuntu_22_04.gdm.violations with input as {"initial_setup": {"gdm_installed": true, "gdm_dconf_profile_exists": false, "gdm_banner_configured": true}}
	count([v | some v in vs; startswith(v, "1.7.2: not met")]) > 0
}
