	vs := data.cis_ubuntu_22_04.banners.violations with input as {"initial_setup": {"motd_exists": true, "motd_content": "Authorized uses only. All activity may be monitored.", "motd_extra_files": [{"path": "/etc/motd.d/10-site", "content": "Authorized uses only."}]}}
