# 1.6.1 judges /etc/motd.d files; the other message-of-the-day locations are not part of the 22.04 audit.
test_motd_d_file_with_release_text_flagged if {
	vs := data.cis_ubuntu_22_04.banners.violations with input as {"initial_setup": {"motd_exists": false, "motd_extra_files": [{"path": "/etc/motd.d/x", "content": "Ubuntu 22.04"}]}}
	count([v | some v in vs; startswith(v, "1.6.1: not met")]) > 0
}

test_run_motd_d_file_not_judged if {
	vs := data.cis_ubuntu_22_04.banners.violations with input as {"initial_setup": {"motd_exists": false, "motd_extra_files": [{"path": "/run/motd.d/x", "content": "Ubuntu 22.04"}]}}
	count([v | some v in vs; startswith(v, "1.6.1: ")]) == 0
}

test_motd_extra_files_not_collected_is_missing_evidence if {
	vs := data.cis_ubuntu_22_04.banners.violations with input as {"initial_setup": {"motd_exists": false}}
	count([v | some v in vs; startswith(v, "1.6.1: evidence missing")]) > 0
}
