# 1.3.1.3: complain mode is allowed; an unconfined process is not.
test_profiles_in_complain_mode_pass_not_disabled if {
	vs := data.cis_ubuntu_22_04.apparmor.violations with input as {"apparmor": {"profiles": {"loaded": 10, "enforce": 8, "complain": 2}, "processes": {"unconfined": 0}}}
	count([v | some v in vs; startswith(v, "1.3.1.3: ")]) == 0
}

test_unconfined_process_flagged if {
	vs := data.cis_ubuntu_22_04.apparmor.violations with input as {"apparmor": {"profiles": {"loaded": 10, "enforce": 10, "complain": 0}, "processes": {"unconfined": 1}}}
	count([v | some v in vs; startswith(v, "1.3.1.3: not met")]) > 0
}

test_complain_mode_fails_enforcing if {
