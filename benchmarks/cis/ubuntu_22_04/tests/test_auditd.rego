}

test_module_syscalls_b64_only_pass if {
	vs := data.cis_ubuntu_22_04.auditd.violations with input as {"auditd": {"active_rules": ["-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k kernel_modules", "-a always,exit -S all -F path=/usr/bin/kmod -F perm=x -F auid>=1000 -F auid!=-1 -F key=kernel_modules"], "rules": ["-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k kernel_modules", "-a always,exit -S all -F path=/usr/bin/kmod -F perm=x -F auid>=1000 -F auid!=-1 -F key=kernel_modules"], "kmod_target": "/usr/bin/kmod", "kmod_symlinks": {"/usr/sbin/lsmod": "/usr/bin/kmod", "/usr/sbin/rmmod": "/usr/bin/kmod", "/usr/sbin/insmod": "/usr/bin/kmod", "/usr/sbin/modinfo": "/usr/bin/kmod", "/usr/sbin/modprobe": "/usr/bin/kmod", "/usr/sbin/depmod": "/usr/bin/kmod"}}, "user_group": {"uid_min": 1000}}
	count([v | some v in vs; startswith(v, "6.2.3.19: ")]) == 0
}

test_kmod_symlink_elsewhere_flagged if {
	vs := data.cis_ubuntu_22_04.auditd.violations with input as {"auditd": {"active_rules": ["-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k kernel_modules", "-a always,exit -S all -F path=/usr/bin/kmod -F perm=x -F auid>=1000 -F auid!=-1 -F key=kernel_modules"], "rules": ["-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -F auid>=1000 -F auid!=unset -k kernel_modules", "-a always,exit -S all -F path=/usr/bin/kmod -F perm=x -F auid>=1000 -F auid!=-1 -F key=kernel_modules"], "kmod_target": "/usr/bin/kmod", "kmod_symlinks": {"/usr/sbin/lsmod": "/usr/bin/kmod", "/usr/sbin/rmmod": "/usr/bin/kmod", "/usr/sbin/insmod": "/opt/insmod", "/usr/sbin/modinfo": "/usr/bin/kmod", "/usr/sbin/modprobe": "/usr/bin/kmod", "/usr/sbin/depmod": "/usr/bin/kmod"}}, "user_group": {"uid_min": 1000}}
	count([v | some v in vs; startswith(v, "6.2.3.19: not met")]) > 0
}

test_networks_watch_does_not_cover_network if {
	vs := data.cis_ubuntu_22_04.auditd.violations with input as {"auditd": {"active_rules": ["-a always,exit -F arch=b32 -S sethostname,setdomainname -k system-locale", "-a always,exit -F arch=b64 -S sethostname,setdomainname -k system-locale", "-w /etc/issue -p wa -k system-locale", "-w /etc/issue.net -p wa -k system-locale", "-w /etc/hosts -p wa -k system-locale", "-w /etc/networks -p wa -k system-locale", "-w /etc/netplan -p wa -k system-locale"], "rules": ["-a always,exit -F arch=b32 -S sethostname,setdomainname -k system-locale", "-a always,exit -F arch=b64 -S sethostname,setdomainname -k system-locale", "-w /etc/issue -p wa -k system-locale", "-w /etc/issue.net -p wa -k system-locale", "-w /etc/hosts -p wa -k system-locale", "-w /etc/networks -p wa -k system-locale", "-w /etc/netplan -p wa -k system-locale"]}, "user_group": {"uid_min": 1000}}
	count([v | some v in vs; startswith(v, "6.2.3.5: not met")]) > 0
}
