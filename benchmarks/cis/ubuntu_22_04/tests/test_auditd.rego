# 6.2.3: a rule is required in the running and the on-disk rules, with a key, for both listed architectures.
test_mount_rule_running_only_flagged if {
	vs := data.cis_ubuntu_22_04.auditd.violations with input as {"auditd": {"active_rules": ["-a always,exit -F arch=b32 -S mount -F auid>=1000 -F auid!=unset -k mounts", "-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=unset -k mounts"], "rules": []}, "user_group": {"uid_min": 1000}}
	count([v | some v in vs; startswith(v, "6.2.3.10: not met")]) > 0
}

test_mount_rule_both_sets_passes if {
	vs := data.cis_ubuntu_22_04.auditd.violations with input as {"auditd": {"active_rules": ["-a always,exit -F arch=b32 -S mount -F auid>=1000 -F auid!=unset -k mounts", "-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=unset -k mounts"], "rules": ["-a always,exit -F arch=b32 -S mount -F auid>=1000 -F auid!=unset -k mounts", "-a always,exit -F arch=b64 -S mount -F auid>=1000 -F auid!=unset -k mounts"]}, "user_group": {"uid_min": 1000}}
