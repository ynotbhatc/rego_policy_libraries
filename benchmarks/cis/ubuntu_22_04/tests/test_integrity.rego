	vs := data.cis_ubuntu_22_04.integrity.violations with input as {"aide": {"audit_tool_options": {"auditctl": "", "auditd": "", "ausearch": "", "aureport": "", "autrace": "", "augenrules": ""}}}
	count([v | some v in vs; startswith(v, "6.3.3: ")]) > 0
