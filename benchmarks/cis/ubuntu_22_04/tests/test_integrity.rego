package cis_ubuntu_22_04.integrity_test

import rego.v1

# Generated by tools/cis_generators/gen_ubuntu_22_04.py: a pass and a fail case for every recommendation,
# plus an evidence-missing case for every Automated one. Assertions key on '<id>: ' (colon included).

test_6_3_1_pass if {
	vs := data.cis_ubuntu_22_04.integrity.violations with input as {"packages": {"aide": true, "aide-common": true}}
	count([v | some v in vs; startswith(v, "6.3.1: ")]) == 0
}

test_6_3_1_fail if {
	vs := data.cis_ubuntu_22_04.integrity.violations with input as {"packages": {"aide": false, "aide-common": true}}
	count([v | some v in vs; startswith(v, "6.3.1: ")]) > 0
	not "6.3.1: evidence missing — packages[aide,aide-common] not collected" in vs
}

test_6_3_1_evidence_missing if {
	vs := data.cis_ubuntu_22_04.integrity.violations with input as {}
	"6.3.1: evidence missing — packages[aide,aide-common] not collected" in vs
}

test_6_3_2_pass if {
	vs := data.cis_ubuntu_22_04.integrity.violations with input as {"aide": {"cron_raw": "0 5 * * * root /usr/bin/aide.wrapper --config /etc/aide/aide.conf --check"}}
	count([v | some v in vs; startswith(v, "6.3.2: ")]) == 0
}

test_6_3_2_fail if {
	vs := data.cis_ubuntu_22_04.integrity.violations with input as {"aide": {"cron_raw": "0 5 * * * root /usr/bin/updatedb", "aidecheck": {"service_unit_file_state": "disabled", "timer_unit_file_state": "disabled", "timer_active_state": "inactive"}}}
	count([v | some v in vs; startswith(v, "6.3.2: ")]) > 0
	not "6.3.2: evidence missing — aide.cron_raw/aide.aidecheck/aide.collected not collected" in vs
}

test_6_3_2_evidence_missing if {
	vs := data.cis_ubuntu_22_04.integrity.violations with input as {}
	"6.3.2: evidence missing — aide.cron_raw/aide.aidecheck/aide.collected not collected" in vs
}

test_6_3_2_hollow_evidence_not_a_pass if {
	vs := data.cis_ubuntu_22_04.integrity.violations with input as {"aide": {"cron_raw": ""}}
	count([v | some v in vs; startswith(v, "6.3.2: ")]) > 0
}

test_6_3_3_pass if {
	vs := data.cis_ubuntu_22_04.integrity.violations with input as {"aide": {"audit_tool_options": {"auditctl": "p+i+n+u+g+s+b+acl+xattrs+sha512", "auditd": "p+i+n+u+g+s+b+acl+xattrs+sha512", "ausearch": "p+i+n+u+g+s+b+acl+xattrs+sha512", "aureport": "p+i+n+u+g+s+b+acl+xattrs+sha512", "autrace": "p+i+n+u+g+s+b+acl+xattrs+sha512", "augenrules": "p+i+n+u+g+s+b+acl+xattrs+sha512"}}}
