	data.cis_windows_11.lib.results["5.3"] == "fail" with input as object.union(data.cis_windows_11.fixtures_test.fixture_all, {"registry": {"HKLM\\SYSTEM\\CurrentControlSet\\Services\\Browser": {"Start": 2}}})
}

