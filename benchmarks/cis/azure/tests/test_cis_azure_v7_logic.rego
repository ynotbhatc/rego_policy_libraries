package cis_azure.v7_logic_test

import rego.v1

import data.cis_azure as b

# Edge cases: open sources, port ranges and lists, empty versus absent lists, missing properties, nested ARM properties, alert scoping. Generated by tools/cis_generators/gen_azure.py; regenerate, do not edit.

green := data.cis_azure.v7_controls_test.green

_has_id(vs, id) if {
	some v in vs
	startswith(v, concat("", [id, ":"]))
}

test_nsg_range_covering_rdp if {
	inp := json.patch(green, [{"op": "add", "path": "/network_security_groups/0/securityRules/-", "value": {"name": "a", "priority": 300, "direction": "Inbound", "access": "Allow", "protocol": "Tcp", "sourceAddressPrefix": "Internet", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "3380-3390"}}])
	vs := b.violations with input as inp
	_has_id(vs, "7.1.1")
	not _has_id(vs, "7.1.5")
	not _has_id(vs, "7.1.4")
}

test_nsg_range_beside_rdp if {
	inp := json.patch(green, [{"op": "add", "path": "/network_security_groups/0/securityRules/-", "value": {"name": "a", "priority": 300, "direction": "Inbound", "access": "Allow", "protocol": "Tcp", "sourceAddressPrefix": "Internet", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "3390-4000"}}])
	vs := b.violations with input as inp
	not _has_id(vs, "7.1.1")
}

test_nsg_udp_not_rdp if {
	inp := json.patch(green, [{"op": "add", "path": "/network_security_groups/0/securityRules/-", "value": {"name": "a", "priority": 300, "direction": "Inbound", "access": "Allow", "protocol": "Udp", "sourceAddressPrefix": "*", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "3389"}}])
	vs := b.violations with input as inp
	not _has_id(vs, "7.1.1")
}

test_nsg_any_protocol_any_port if {
	inp := json.patch(green, [{"op": "add", "path": "/network_security_groups/0/securityRules/-", "value": {"name": "a", "priority": 300, "direction": "Inbound", "access": "Allow", "protocol": "*", "sourceAddressPrefix": "0.0.0.0/0", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "*"}}])
	vs := b.violations with input as inp
	_has_id(vs, "7.1.1")
	_has_id(vs, "7.1.2")
	_has_id(vs, "7.1.3")
	_has_id(vs, "7.1.4")
	_has_id(vs, "7.1.5")
	_has_id(vs, "7.1.6")
}

test_nsg_ipv6_any_in_prefix_list if {
	inp := json.patch(green, [{"op": "add", "path": "/network_security_groups/0/securityRules/-", "value": {"name": "a", "priority": 300, "direction": "Inbound", "access": "Allow", "protocol": "Tcp", "sourceAddressPrefix": null, "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": null, "sourceAddressPrefixes": ["10.0.0.0/8", "::/0"], "destinationPortRanges": ["22", "8443"]}}])
	vs := b.violations with input as inp
	_has_id(vs, "7.1.5")
	not _has_id(vs, "7.1.3")
}

test_nsg_private_source if {
	inp := json.patch(green, [{"op": "add", "path": "/network_security_groups/0/securityRules/-", "value": {"name": "a", "priority": 300, "direction": "Inbound", "access": "Allow", "protocol": "*", "sourceAddressPrefix": "192.0.2.0/24", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "*"}}])
	vs := b.violations with input as inp
	not _has_id(vs, "7.1.1")
	not _has_id(vs, "7.1.5")
	not _has_id(vs, "7.1.6")
}

test_nsg_outbound_ignored if {
	inp := json.patch(green, [{"op": "add", "path": "/network_security_groups/0/securityRules/-", "value": {"name": "a", "priority": 300, "direction": "Outbound", "access": "Allow", "protocol": "*", "sourceAddressPrefix": "*", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "*"}}])
	vs := b.violations with input as inp
	not _has_id(vs, "7.1.1")
	not _has_id(vs, "7.1.5")
}

test_nsg_deny_ignored if {
	inp := json.patch(green, [{"op": "add", "path": "/network_security_groups/0/securityRules/-", "value": {"name": "a", "priority": 300, "direction": "Inbound", "access": "Deny", "protocol": "*", "sourceAddressPrefix": "Internet", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "22"}}])
	vs := b.violations with input as inp
	not _has_id(vs, "7.1.5")
}

test_nsg_rule_missing_protocol if {
	inp := json.patch(green, [{"op": "add", "path": "/network_security_groups/0/securityRules/-", "value": {"name": "half", "access": "Allow", "direction": "Inbound", "sourceAddressPrefix": "*", "destinationPortRange": "22"}}])
	vs := b.violations with input as inp
	_has_id(vs, "7.1.1")
	_has_id(vs, "7.1.5")
}

test_nsg_allow_after_deny_all if {
	inp := json.patch(green, [{"op": "add", "path": "/network_security_groups/0/securityRules/-", "value": {"name": "late", "priority": 4090, "direction": "Inbound", "access": "Allow", "protocol": "Tcp", "sourceAddressPrefix": "10.0.0.0/8", "sourcePortRange": "*", "destinationAddressPrefix": "*", "destinationPortRange": "8080"}}])
	vs := b.violations with input as inp
	_has_id(vs, "7.8")
	not _has_id(vs, "7.1.1")
}

test_empty_lists_pass if {
	inp := json.patch(green, [
		{"op": "add", "path": "/storage_accounts", "value": []},
		{"op": "add", "path": "/network_security_groups", "value": []},
		{"op": "add", "path": "/key_vaults", "value": []},
		{"op": "add", "path": "/application_gateways", "value": []},
	])
	vs := b.violations with input as inp
	count(vs) == 0
}

test_absent_list_is_evidence_missing if {
	inp := json.patch(green, [{"op": "remove", "path": "/storage_accounts"}])
	vs := b.violations with input as inp
	"9.2.4: evidence missing — input.storage_accounts not collected" in vs
}

test_missing_property_is_a_finding if {
	inp := json.patch(green, [{"op": "remove", "path": "/storage_accounts/0/minimumTlsVersion"}, {"op": "remove", "path": "/key_vaults/0/enablePurgeProtection"}])
	vs := b.violations with input as inp
	_has_id(vs, "9.2.4")
	_has_id(vs, "8.3.8")
}

test_storage_tls13_minimum_meets_9_2_4 if {
	inp := json.patch(green, [{"op": "replace", "path": "/storage_accounts/0/minimumTlsVersion", "value": "TLS1_3"}])
	vs := b.violations with input as inp
	not _has_id(vs, "9.2.4")
}

test_storage_tls11_minimum_fails_9_2_4 if {
	inp := json.patch(green, [{"op": "replace", "path": "/storage_accounts/0/minimumTlsVersion", "value": "TLS1_1"}])
	vs := b.violations with input as inp
	_has_id(vs, "9.2.4")
}

test_nested_properties_shape if {
	inp := json.patch(green, [{"op": "add", "path": "/storage_accounts", "value": [{
		"name": "starm", "kind": "StorageV2", "properties": {
			"publicNetworkAccess": "Disabled", "networkAcls": {"defaultAction": "Deny"}, "defaultToOAuthAuthentication": true,
			"supportsHttpsTrafficOnly": true, "minimumTlsVersion": "TLS1_2", "allowBlobPublicAccess": false,
		},
		"blob_service_properties": {"properties": {"deleteRetentionPolicy": {"enabled": true, "days": 14}}},
	}]}])
	vs := b.violations with input as inp
	count(vs) == 0
}

test_narrow_alert_scope_needs_recorded_decision if {
	inp := json.patch(green, [
		{"op": "add", "path": "/activity_log_alerts/2/scopes", "value": ["/subscriptions/00000000-0000-0000-0000-000000000001/resourceGroups/rg-core"]},
		{"op": "add", "path": "/activity_log_alerts/0/scopes", "value": ["/subscriptions/00000000-0000-0000-0000-000000000001/resourceGroups/rg-core"]},
	])
	vs := b.violations with input as inp
	_has_id(vs, "6.1.2.3")
	_has_id(vs, "6.1.2.1")
	inp2 := json.patch(inp, [{"op": "add", "path": "/attest/activity_log_alert_scopes_recorded", "value": true}])
	vs2 := b.violations with input as inp2
	not _has_id(vs2, "6.1.2.3")
	_has_id(vs2, "6.1.2.1")
}

test_alert_for_other_subscription_does_not_count if {
	inp := json.patch(green, [{"op": "add", "path": "/activity_log_alerts/0/scopes", "value": ["/subscriptions/99999999-0000-0000-0000-000000000000"]}])
	vs := b.violations with input as inp
	_has_id(vs, "6.1.2.1")
}

test_owner_count_bounds if {
	four := json.patch(green, [
		{"op": "add", "path": "/role_assignments/-", "value": {"roleDefinitionName": "Owner", "scope": "/subscriptions/00000000-0000-0000-0000-000000000001", "principalId": "p-4"}},
		{"op": "add", "path": "/role_assignments/-", "value": {"roleDefinitionName": "Owner", "scope": "/subscriptions/00000000-0000-0000-0000-000000000001", "principalId": "p-5"}},
	])
	_has_id(b.violations, "5.7") with input as four
	three := json.patch(green, [{"op": "add", "path": "/role_assignments/-", "value": {"roleDefinitionName": "Owner", "scope": "/subscriptions/00000000-0000-0000-0000-000000000001", "principalId": "p-4"}}])
	not _has_id(b.violations, "5.7") with input as three
}

test_ddos_skips_nat_gateway_ip if {
	inp := json.patch(green, [{"op": "add", "path": "/public_ip_addresses/-", "value": {"name": "pip-bare"}}])
	_has_id(b.violations, "8.5") with input as inp
}

test_flow_log_retention_zero_is_unlimited if {
	inp := json.patch(green, [{"op": "add", "path": "/flow_logs/0/retentionPolicy/days", "value": 0}])
	not _has_id(b.violations, "7.6") with input as inp
}

test_disabled_nsg_flow_log_out_of_scope if {
	inp := json.patch(green, [{"op": "add", "path": "/flow_logs/1/enabled", "value": false}, {"op": "add", "path": "/flow_logs/1/retentionPolicy/days", "value": 7}])
	not _has_id(b.violations, "7.12") with input as inp
}

# #300 type traps: a non-number retention days must not pass blob soft delete.
test_blob_soft_delete_number_type_traps if {
	not "9.1.1: Soft Delete for Blobs on Azure Blob Storage Storage Accounts must be turned on — storage account sa1 does not keep deleted blobs for at least 7 days" in data.cis_azure._messages with input as {"storage_accounts": [{"name": "sa1", "kind": "StorageV2", "blob_service_properties": {"deleteRetentionPolicy": {"enabled": true, "days": 7}}}]}
	"9.1.1: Soft Delete for Blobs on Azure Blob Storage Storage Accounts must be turned on — storage account sa1 does not keep deleted blobs for at least 7 days" in data.cis_azure._messages with input as {"storage_accounts": [{"name": "sa1", "kind": "StorageV2", "blob_service_properties": {"deleteRetentionPolicy": {"enabled": true, "days": "30"}}}]}
	"9.1.1: Soft Delete for Blobs on Azure Blob Storage Storage Accounts must be turned on — storage account sa1 does not keep deleted blobs for at least 7 days" in data.cis_azure._messages with input as {"storage_accounts": [{"name": "sa1", "kind": "StorageV2", "blob_service_properties": {"deleteRetentionPolicy": {"enabled": true, "days": null}}}]}
	"9.1.1: Soft Delete for Blobs on Azure Blob Storage Storage Accounts must be turned on — storage account sa1 does not keep deleted blobs for at least 7 days" in data.cis_azure._messages with input as {"storage_accounts": [{"name": "sa1", "kind": "StorageV2", "blob_service_properties": {"deleteRetentionPolicy": {"enabled": true, "days": "not-a-number"}}}]}
}
