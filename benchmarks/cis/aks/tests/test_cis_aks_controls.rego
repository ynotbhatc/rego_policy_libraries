package cis_aks_test

import rego.v1

import data.cis_aks as b
import data.cis_aks.main as bridge

# Generated per-recommendation tests for CIS Azure Kubernetes Service (AKS) Benchmark v2.1.0: every recommendation has a pass test (green input) and a
# fail test; fact-based checks also have an evidence-missing test; attestations fail when false or absent.
# Profile, report-contract and check-specific tests come first. Generated by tools/cis_generators/gen_aks.py.

green := {
	"kubelet": {
		"flags": {
			"config": "/etc/default/kubeletconfig.json",
			"kubeconfig": "/var/lib/kubelet/kubeconfig",
		},
		"config": {
			"authentication": {
				"anonymous": {"enabled": false},
				"x509": {"clientCAFile": "/etc/kubernetes/certs/ca.crt"},
			},
			"authorization": {"mode": "Webhook"},
			"readOnlyPort": 0,
			"makeIPTablesUtilChains": true,
			"eventRecordQPS": 50,
			"rotateCertificates": true,
			"serverTLSBootstrap": true,
		},
	},
	"files": {
		"kubelet_kubeconfig": [{
			"path": "/var/lib/kubelet/kubeconfig",
			"mode": "0600",
			"owner": "root",
			"group": "root",
		}],
		"azure_json": [{
			"path": "/etc/kubernetes/azure.json",
