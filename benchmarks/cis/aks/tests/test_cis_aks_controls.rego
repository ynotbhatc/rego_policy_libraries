					"enableNodePublicIP": null,
				},
			],
			"securityProfile": {
				"kubernetesResourceObjectEncryptionProfile": {"infrastructureEncryption": "Enabled"},
				"azureKeyVaultKms": {"enabled": true},
			},
			"aadProfile": {
				"managed": true,
				"enableAzureRbac": true,
				"tenantId": "11111111-2222-3333-4444-555555555555",
			},
			"disableLocalAccounts": true,
			"networkProfile": {
				"networkPlugin": "azure",
				"networkPluginMode": "overlay",
				"networkPolicy": "cilium",
				"networkDataplane": "cilium",
			},
		},
		"subscription_tenant_id": "11111111-2222-3333-4444-555555555555",
	},
	"pod_security": {
		"privileged_containers": [],
		"host_pid_pods": [],
		"host_ipc_pods": [],
		"host_network_pods": [],
		"privilege_escalation_containers": [],
		"namespaces_without_enforcement": [],
	},
	"service_accounts": {
		"default": [
			{
				"namespace": "default",
				"automount_token": false,
				"role_bindings": [],
			},
			{
				"namespace": "kube-system",
				"automount_token": false,
				"role_bindings": [],
			},
		],
		"unneeded_token_mounts": [],
	},
	"network_policies": {"namespaces_without_policy": []},
	"secrets": {"env_var_usage_count": 0},
	"cluster": {"namespace_resources": {"default": [
		"service/kubernetes",
		"serviceaccount/default",
		"configmap/kube-root-ca.crt",
	]}},
	"collection_status": {
		"default_service_accounts": "ok",
		"service_account_token_mounts": "ok",
		"secret_env_scan": "ok",
		"namespace_resources": "ok",
		"pod_security": "ok",
		"network_policies": "ok",
	},
	"attest": {
		"control_plane_logs_routed": true,
		"cluster_admin_bindings_reviewed": true,
		"secret_access_reviewed": true,
		"rbac_wildcards_reviewed": true,
		"pod_create_access_reviewed": true,
		"bind_impersonate_escalate_reviewed": true,
		"persistent_volume_create_access_reviewed": true,
		"node_proxy_access_reviewed": true,
		"csr_approval_access_reviewed": true,
		"webhook_config_access_reviewed": true,
		"service_account_token_create_access_reviewed": true,
		"external_secret_storage_reviewed": true,
		"namespace_boundaries_reviewed": true,
		"pod_security_contexts_reviewed": true,
		"image_vulnerability_scanning_active": true,
		"acr_access_scoped": true,
		"acr_cluster_pull_only": true,
		"approved_registries_enforced": true,
		"dedicated_workload_service_accounts": true,
		"external_workloads_use_https": true,
