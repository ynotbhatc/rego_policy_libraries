package cis_suse16.crypto_policy

# CIS SUSE Linux Enterprise 16 Benchmark v1.0.0, Section 1.6: System-wide Crypto Policy.
# Generated by tools/cis_generators/gen_suse_16.py from the CIS workbook; do not edit by hand.
# Each recommendation: e_<id> (facts collected), p_<id> (requirement met). Automated checks fail
# closed with '<id>: evidence missing — <field> not collected'; Manual ones need input.attest.<name>.

import rego.v1

default compliant := false

compliant if count(violations) == 0

controls := ["1.6.1", "1.6.2", "1.6.3", "1.6.4", "1.6.5", "1.6.6", "1.6.7"]

# Parse an octal permission string ("644", "0644", "0o644") to an integer; undefined if not octal.
octal(s) := n if {
	t := trim_prefix(lower(trim_space(sprintf("%v", [s]))), "0o")
	regex.match(`^[0-7]{1,4}$`, t)
	p := concat("", [substring("0000", 0, 4 - count(t)), t])
	ds := [to_number(substring(p, i, 1)) | some i in numbers.range(0, 3)]
	n := ((ds[0] * 512) + (ds[1] * 64)) + ((ds[2] * 8) + ds[3])
}

# true when mode grants nothing beyond max (both octal strings)
mode_within(mode, max) if bits.and(octal(mode), bits.and(bits.negate(octal(max)), 4095)) == 0

# Active (non-blank, non-comment) lines of a configuration text.
active_lines(text) := [l |
	some raw in split(text, "\n")
	l := trim_space(raw)
	l != ""
	not startswith(l, "#")
]

# a collected text: a non-blank string ("" is not evidence)
text_collected(t) if {
	is_string(t)
	trim_space(t) != ""
}

regex_in_text(text, re) if {
	some l in active_lines(text)
	regex.match(re, l)
}

# Values of a `key = value` / `key value` directive (key is a case-insensitive regex); last one wins.
conf_values(text, key_re) := [trim(m[1], "\"' ") |
	some l in active_lines(text)
	some m in regex.find_all_string_submatch_n(concat("", ["(?i)^", key_re, `(?:\s*=\s*|\s+)(.*?)\s*$`]), l, 1)
]

conf_last(text, key_re) := vs[count(vs) - 1] if {
	vs := conf_values(text, key_re)
	count(vs) > 0
}

num(v) := to_number(trim_space(sprintf("%v", [v]))) if regex.match(`^\s*-?[0-9]+\s*$`, sprintf("%v", [v]))

# ── packages / services ──
services_collected if {
	is_object(input.services)
	count(input.services) > 0
}

unit_on(u) if input.services[u].status == "enabled"

unit_on(u) if lower(input.services[u].state) in {"running", "active"}

# every unit named for an installed package is reported in the inventory
unit_set_reported(p, _) if input.packages[p] == false

unit_set_reported(p, us) if {
	input.packages[p] == true
	every u in us { unit_reported(u) }
}

unit_reported(u) if {
	is_string(input.services[u].status)
	input.services[u].status != ""
}

unit_set_off(p, _) if input.packages[p] == false

unit_set_off(p, us) if {
	input.packages[p] == true
	every u in us { not unit_on(u) }
}

unit_enabled_active(u) if {
	input.services[u].status == "enabled"
	lower(input.services[u].state) in {"running", "active"}
}

# tmp.mount masked or disabled means systemd will not mount /tmp at boot
tmp_mount_unit_off if input.services["tmp.mount"].status in {"masked", "disabled"}

# ── kernel modules: {module, disabled, loaded, available?}; "unknown" proves nothing ──
kmod_evidence(e) if is_boolean(e.available)

kmod_evidence(e) if {
	is_boolean(e.disabled)
	is_boolean(e.loaded)
}

kmod_unavailable(e) if e.available == false

kmod_unavailable(e) if {
	e.disabled == true
	e.loaded == false
}

# ── mounts ──
mounts_collected if {
	is_array(input.ansible_facts.ansible_mounts)
	count(input.ansible_facts.ansible_mounts) > 0
}

mounts_at(path) := [m | some m in input.ansible_facts.ansible_mounts; m.mount == path]

mounted(path) if count(mounts_at(path)) > 0

mount_opts(m) := split(m.options, ",") if is_string(m.options)

mount_opts(m) := m.options if is_array(m.options)

# ── file lists ──
list_item_ok(f, mk, ok, gk, max, owners, groups) if {
	mode_within(f[mk], max)
	f[ok] in owners
	f[gk] in groups
}

# ── sshd: first occurrence wins (sshd semantics); `sshd -T` prints effective values ──
ssh_collected if {
	is_string(input.ssh.sshd_config_raw)
	trim_space(input.ssh.sshd_config_raw) != ""
}

sshd_pairs := [[lower(m[1]), trim_space(m[2])] |
	some l in active_lines(input.ssh.sshd_config_raw)
	some m in regex.find_all_string_submatch_n(`^([A-Za-z0-9]+)(?:\s*=\s*|\s+)(.*)$`, l, 1)
]

sshd_first(key) := vs[0] if {
	vs := [p[1] | some p in sshd_pairs; p[0] == key]
	count(vs) > 0
}

# effective value: `sshd -T` prints every directive, so a missing directive means the effective
# configuration was not collected (a raw sshd_config misses /usr/etc/ssh and sshd_config.d)
sshd_value(key) := sshd_first(key)

sshd_list(key) := [trim_space(x) | some x in split(lower(sshd_value(key)), ",")]

# seconds from an sshd time value ("60", "60s", "1m")
sshd_seconds(v) := to_number(v) if regex.match(`^[0-9]+$`, v)

sshd_seconds(v) := to_number(trim_suffix(v, "s")) if regex.match(`^[0-9]+s$`, v)

sshd_seconds(v) := to_number(trim_suffix(v, "m")) * 60 if regex.match(`^[0-9]+m$`, v)

# ── /etc/passwd, /etc/group (rhel_9 fields user_group.passwd_content / group_content) ──
rows(text) := [f |
	some l in active_lines(text)
	f := split(l, ":")
]

passwd_rows := [f | some f in rows(input.user_group.passwd_content); count(f) >= 7]

group_rows := [f | some f in rows(input.user_group.group_content); count(f) >= 3]

valid_shells := {s |
	some s in active_lines(input.user_group.shells_content)
	not regex.match(`/nologin$`, s)
}

# CURRENT.pol: a hash/sign line that still enables SHA1 (a leading "-" removes it)
sha1_hash_or_sign_enabled if {
	some l in active_lines(input.crypto_policy.current_pol_raw)
	some m in regex.find_all_string_submatch_n(`^([^=]*)=(.*)$`, l, 1)
	regex.match(`(hash|sign)`, m[1])
	contains(m[2], "SHA1")
	not regex.match(`^\s*-\s*([^#]+)?SHA1`, m[2])
}

# the cipher list SSH uses: the cipher@openssh / cipher@libssh override when present, else the global one
ssh_cipher_lines := [m[3] |
	some l in active_lines(input.crypto_policy.current_pol_raw)
	some m in regex.find_all_string_submatch_n(`(?i)^cipher@(lib|open)ssh(-server|-client)?\s*=\s*(.*)$`, l, 1)
]

ssh_cipher_has(x) if {
	count(ssh_cipher_lines) > 0
	some v in ssh_cipher_lines
	contains(lower(v), x)
}

ssh_cipher_has(x) if {
	count(ssh_cipher_lines) == 0
	contains(lower(conf_last(input.crypto_policy.current_pol_raw, "cipher")), x)
}

# 1.6.1 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure crypto-policies-scripts package is installed
default e_1_6_1 := false

e_1_6_1 if {
	is_boolean(input.packages["crypto-policies-scripts"])
}

default p_1_6_1 := false

p_1_6_1 if {
	input.packages["crypto-policies-scripts"] == true
}

violations contains "1.6.1: evidence missing — packages.crypto-policies-scripts not collected" if not e_1_6_1

violations contains "1.6.1: not met — Ensure crypto-policies-scripts package is installed" if {
	e_1_6_1
	not p_1_6_1
}

# 1.6.2 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure system wide crypto policy is not legacy
default e_1_6_2 := false

e_1_6_2 if {
	text_collected(input.initial_setup.crypto_policy)
}

default p_1_6_2 := false

p_1_6_2 if {
	not regex.match(`(?i)^\s*LEGACY\b`, input.initial_setup.crypto_policy)
}

violations contains "1.6.2: evidence missing — initial_setup.crypto_policy not collected" if not e_1_6_2

violations contains "1.6.2: not met — Ensure system wide crypto policy is not legacy" if {
	e_1_6_2
	not p_1_6_2
}

# 1.6.3 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure system wide crypto policy is not set in sshd configuration
default e_1_6_3 := false

e_1_6_3 if {
	text_collected(input.crypto_policy.sysconfig_ssh_raw)
}

e_1_6_3 if {
	input.crypto_policy.sysconfig_ssh_exists == false
}

default p_1_6_3 := false

p_1_6_3 if {
	not regex_in_text(input.crypto_policy.sysconfig_ssh_raw, "(?i)^CRYPTO_POLICY\\s*=")
}

p_1_6_3 if {
	input.crypto_policy.sysconfig_ssh_exists == false
}

violations contains "1.6.3: evidence missing — crypto_policy.sysconfig_ssh_raw/sysconfig_ssh_exists not collected" if not e_1_6_3

violations contains "1.6.3: not met — Ensure system wide crypto policy is not set in sshd configuration" if {
	e_1_6_3
	not p_1_6_3
}

# 1.6.4 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure system wide crypto policy disables sha1 hash and signature support
default e_1_6_4 := false

e_1_6_4 if {
	text_collected(input.crypto_policy.current_pol_raw)
}

default p_1_6_4 := false

p_1_6_4 if {
	not sha1_hash_or_sign_enabled
	conf_last(input.crypto_policy.current_pol_raw, "sha1_in_certs") == "0"
}

violations contains "1.6.4: evidence missing — crypto_policy.current_pol_raw not collected" if not e_1_6_4

violations contains "1.6.4: not met — Ensure system wide crypto policy disables sha1 hash and signature support" if {
	e_1_6_4
	not p_1_6_4
}

# 1.6.5 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure system wide crypto policy macs are configured
default e_1_6_5 := false

e_1_6_5 if {
	text_collected(input.crypto_policy.current_pol_raw)
}

default p_1_6_5 := false

p_1_6_5 if {
	not regex_in_text(input.crypto_policy.current_pol_raw, "(?i)(^mac\\s*=\\s*([^#]+)?-128|hmac-sha1)")
}

violations contains "1.6.5: evidence missing — crypto_policy.current_pol_raw not collected" if not e_1_6_5

violations contains "1.6.5: not met — Ensure system wide crypto policy macs are configured" if {
	e_1_6_5
	not p_1_6_5
}

# 1.6.6 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure system wide crypto policy disables cbc for ssh
default e_1_6_6 := false

e_1_6_6 if {
	text_collected(input.crypto_policy.current_pol_raw)
}

default p_1_6_6 := false

p_1_6_6 if {
	not ssh_cipher_has("-cbc")
}

violations contains "1.6.6: evidence missing — crypto_policy.current_pol_raw not collected" if not e_1_6_6

violations contains "1.6.6: not met — Ensure system wide crypto policy disables cbc for ssh" if {
	e_1_6_6
	not p_1_6_6
}

# 1.6.7 (Automated; Level 1 - Server, Level 1 - Workstation)
# Ensure system wide crypto policy disables chacha20-poly1305 for ssh
default e_1_6_7 := false

e_1_6_7 if {
	text_collected(input.crypto_policy.current_pol_raw)
}

default p_1_6_7 := false

p_1_6_7 if {
	not ssh_cipher_has("chacha20-poly1305")
}

violations contains "1.6.7: evidence missing — crypto_policy.current_pol_raw not collected" if not e_1_6_7

violations contains "1.6.7: not met — Ensure system wide crypto policy disables chacha20-poly1305 for ssh" if {
	e_1_6_7
	not p_1_6_7
}
