package cis_suse16.main_test

import rego.v1

# Generated by tools/cis_generators/gen_suse_16.py: roll-up and bridge smoke tests.

test_every_recommendation_in_table if {
	count(data.cis_suse16.controls) == 336
	count([c | some c in data.cis_suse16.controls; c.assessment == "Manual"]) == 21
}

test_empty_input_fails_closed if {
	r := data.cis_suse16.main.compliance_report with input as {}
	count(object.keys(r)) == 17
	every k in ["framework", "benchmark", "version", "profile", "total_controls", "standard_total", "controls_basis", "passed_controls", "failed_controls", "compliance_percentage", "section_compliance_percentage", "compliant", "violations", "section_results", "sections_not_assessed", "missing_inputs", "assessment_coverage_percentage"] { k in object.keys(r) }
	r.compliant == false
	r.total_controls == 336
	r.failed_controls == r.total_controls
	r.passed_controls == 0
	some v in r.violations
	startswith(v, "FAIL-CLOSED")
}

test_profile_level1_server_count if {
	r := data.cis_suse16.main.compliance_report with input as {"profile": "level1_server"}
	r.profile == "level1_server"
	r.total_controls == 255
	r.standard_total == 336
	r.failed_controls == r.total_controls
}

test_profile_level2_server_count if {
	r := data.cis_suse16.main.compliance_report with input as {"profile": "level2_server"}
	r.profile == "level2_server"
	r.total_controls == 336
	r.standard_total == 336
	r.failed_controls == r.total_controls
}

test_profile_level1_workstation_count if {
	r := data.cis_suse16.main.compliance_report with input as {"profile": "level1_workstation"}
	r.profile == "level1_workstation"
	r.total_controls == 249
	r.standard_total == 336
	r.failed_controls == r.total_controls
}

test_profile_level2_workstation_count if {
	r := data.cis_suse16.main.compliance_report with input as {"profile": "level2_workstation"}
	r.profile == "level2_workstation"
	r.total_controls == 331
	r.standard_total == 336
	r.failed_controls == r.total_controls
}

test_unknown_profile_is_not_selected_and_evaluates_everything if {
	r := data.cis_suse16.main.compliance_report with input as {"profile": "bogus"}
	r.profile == "unrecognised"
	r.total_controls == 336
	r.compliant == false
	r.failed_controls == r.total_controls
	count([v | some v in r.violations; startswith(v, "PROFILE NOT SELECTED: ")]) == 1
}

test_absent_or_mistyped_profile_is_not_selected_and_never_compliant if {
	every p in [null, 1, true, [], {}, "", "Level1_Server", "level_1_server"] {
		r := data.cis_suse16.main.compliance_report with input as {"profile": p, "attest": {"x": true}}
		r.profile == "unrecognised"
		r.compliant == false
		r.total_controls == 336
		count([v | some v in r.violations; startswith(v, "PROFILE NOT SELECTED: ")]) == 1
	}
	r0 := data.cis_suse16.main.compliance_report with input as {"attest": {"x": true}}
	r0.profile == "unrecognised"
	r0.compliant == false
	r0.compliance_percentage < 100
}

test_one_attested_control_passes if {
	r := data.cis_suse16.main.compliance_report with input as {"attest": {"gpg_keys_reviewed": true}}
	r.passed_controls == 1
	r.failed_controls == r.total_controls - 1
	r.compliant == false
}

test_unassessed_sections_listed if {
	r := data.cis_suse16.main.compliance_report with input as {"ssh": {"sshd_config_raw": "permitrootlogin no"}}
	not "ssh" in r.sections_not_assessed
	"auditd" in r.sections_not_assessed
	r.assessment_coverage_percentage < 100
}

test_level2_violation_hidden_in_level1_profile if {
	vs := data.cis_suse16.all_violations with input as {"profile": "level1_server"}
	count([v | some v in vs; startswith(v, "6.2.1.1: ")]) == 0
	vs2 := data.cis_suse16.all_violations with input as {"profile": "level2_server"}
	count([v | some v in vs2; startswith(v, "6.2.1.1: ")]) > 0
}

# Round 4 (2026-11-24): with every recommendation passing but no profile selected the report is not compliant,
# passed + failed == total, and the percentage is null with a reason, never 100 beside compliant == false.
test_unselected_profile_with_nothing_failed_withholds_the_percentage if {
	r := data.cis_suse16.main.compliance_report with input as {"attest": {"x": true}} with data.cis_suse16.failing_ids as set()
	r.compliant == false
	r.failed_controls == 0
	r.passed_controls == r.total_controls
	r.passed_controls + r.failed_controls == r.total_controls
	r.compliance_percentage == null
	startswith(r.compliance_percentage_reason, "no profile selected")
}

test_percentage_is_a_number_when_a_control_failed if {
	r := data.cis_suse16.main.compliance_report with input as {"attest": {"x": true}}
	r.failed_controls > 0
	is_number(r.compliance_percentage)
	not "compliance_percentage_reason" in object.keys(r)
}
