	vs := data.cis_suse16.filesystem.violations with input as {"ansible_facts": {"ansible_mounts": [{"mount": "/", "fstype": "xfs", "options": "rw"}, {"mount": "/var/log/audit", "fstype": "xfs", "options": "rw,nodev,nosuid"}]}}
	count([v | some v in vs; startswith(v, "1.1.2.7.4: ")]) > 0
	not "1.1.2.7.4: evidence missing — ansible_facts.ansible_mounts not collected" in vs
}

test_1_1_2_7_4_evidence_missing if {
	vs := data.cis_suse16.filesystem.violations with input as {}
	"1.1.2.7.4: evidence missing — ansible_facts.ansible_mounts not collected" in vs
}

test_1_1_2_7_4_hollow_evidence_not_a_pass if {
	vs := data.cis_suse16.filesystem.violations with input as {"ansible_facts": {"ansible_mounts": []}}
	count([v | some v in vs; startswith(v, "1.1.2.7.4: ")]) > 0
}
