default r_5_4_4 := false

r_5_4_4 if {
	input.attest.external_workloads_use_https == true
}

_v_managed_service contains "5.4.4: externally exposed workloads must serve HTTPS with valid certificates (manual review not attested)" if {
	_applies("5.4.4")
	not r_5_4_4
}

# 5.5.1 (Manual, Level 2) -- Manual in the workbook; decidable from configuration, so checked like Automated
default r_5_5_1 := false

r_5_5_1 if {
	_cv(["aadProfile", "managed"]) == true
	_cv(["aadProfile", "enableAzureRbac"]) == true
	_cv(["disableLocalAccounts"]) == true
	_same_tenant
}

default e_5_5_1 := false

e_5_5_1 if {
	_cluster_has("aadProfile")
	is_string(input.aks.subscription_tenant_id)
}

_v_managed_service contains "5.5.1: evidence missing — aks.cluster.aadProfile / aks.subscription_tenant_id not collected" if {
	_applies("5.5.1")
	not e_5_5_1
}

_v_managed_service contains "5.5.1: Entra ID managed integration with Azure RBAC for Kubernetes authorization must be on in the subscription's tenant, with local accounts disabled" if {
	_applies("5.5.1")
	e_5_5_1
	not r_5_5_1
}

