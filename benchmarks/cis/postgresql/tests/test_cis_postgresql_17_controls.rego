package cis.postgresql_17_test

import rego.v1

import data.cis.postgresql_17 as b

# Generated by gen_postgresql_17.py: every recommendation has a pass and a fail case, every Automated one an
# evidence-missing case; the green fixture below satisfies the whole benchmark.

green := {"postgresql": {
	"attest": {
		"authorized_package_repositories": true,
		"only_required_packages_installed": true,
		"latest_security_patches_applied": true,
		"file_permissions_mask_correct": true,
		"service_file_has_no_passwords": true,
		"syslog_facility_correct": true,
		"interactive_login_disabled": true,
		"sudo_configured_correctly": true,
		"excessive_admin_privileges_revoked": true,
		"unused_accounts_locked": true,
		"excessive_dml_privileges_revoked": true,
		"row_level_security_configured": true,
		"predefined_roles_used": true,
		"login_accounts_have_passwords": true,
		"no_passwords_on_command_line": true,
		"bound_to_ip_address": true,
		"local_socket_login_configured": true,
		"host_tcp_login_configured": true,
		"password_complexity_configured": true,
		"runtime_parameter_attack_vectors_reviewed": true,
		"postmaster_parameters_configured": true,
		"sighup_parameters_configured": true,
		"superuser_parameters_configured": true,
		"user_parameters_configured": true,
		"pgcrypto_configured": true,
		"replication_only_user_used": true,
		"replication_command_logging_configured": true,
		"base_backups_functional": true,
		"streaming_replication_parameters_configured": true,
		"subdirectories_outside_data_cluster": true,
		"miscellaneous_settings_correct": true,
	},
	"service": {"enabled": true},
	"cluster": {
		"initialized": true,
		"check_db_dir_rc": 0,
	},
	"system": {
		"pgpassword_profile_files": [],
		"pgpassword_processes": [],
		"psql_history_files": [{
			"path": "/home/doug/.psql_history",
			"symlink_target": "/dev/null",
		}],
	},
	"file_permissions": {"extension_directory": {
		"path": "/usr/pgsql-17/share/extension",
		"owner": "root",
		"group": "root",
		"mode": "0755",
	}},
	"logging": {
		"log_destination": "csvlog,stderr",
		"logging_collector": "on",
		"log_directory": "/var/log/postgres",
		"log_filename": "postgresql-%Y%m%d.log",
		"log_file_mode": "0600",
		"log_truncate_on_rotation": "on",
		"log_rotation_age": "1d",
		"log_rotation_size": "1GB",
		"syslog_sequence_numbers": "on",
		"syslog_split_messages": "on",
		"syslog_ident": "postgres",
		"log_min_messages": "warning",
		"log_min_error_statement": "error",
		"debug_print_parse": "off",
		"debug_print_rewritten": "off",
		"debug_print_plan": "off",
		"debug_pretty_print": "on",
		"log_connections": "on",
		"log_disconnections": "on",
		"log_error_verbosity": "verbose",
		"log_hostname": "off",
		"log_line_prefix": "%m [%p]: [%l-1] db=%d,user=%u,app=%a,client=%h ",
		"log_statement": "ddl",
		"log_timezone": "UTC",
	},
	"settings": {"shared_preload_libraries": "pgaudit,pg_stat_statements"},
	"pgaudit": {"log": "ddl, write"},
	"security_definer_functions": [{
		"schema": "public",
		"name": "audit_fn",
		"prosecdef": true,
	}],
	"policy": {
		"authorized_security_definer_functions": ["public.audit_fn"],
		"authorized_superusers": ["postgres"],
	},
	"available_extensions": [
		"set_user",
		"pgaudit",
	],
	"superuser_login_roles": ["postgres"],
	"roles": [
		{
			"name": "postgres",
			"connection_limit": 10,
		},
		{
			"name": "pg_monitor",
			"connection_limit": -1,
		},
	],
	"backend_settings": {
		"ignore_system_indexes": "off",
		"jit_debugging_support": "off",
		"jit_profiling_support": "off",
		"log_connections": "on",
		"log_disconnections": "on",
		"post_auth_delay": "0",
	},
	"cryptography": {
		"fips_140_2_enabled": true,
		"openssl_fips_mode": true,
	},
	"ssl": {
		"enabled": true,
		"non_ssl_client_connections": [],
		"ssl_min_protocol_version": "TLSv1.3",
		"ssl_ciphers": "ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384",
		"tls12_unapproved_cipher_sessions": [],
	},
	"authentication": {"pg_hba_entries": [
		{
			"connection_type": "local",
			"auth_method": "peer",
		},
		{
			"connection_type": "hostssl",
			"auth_method": "scram-sha-256",
		},
	]},
	"archive_settings": {
		"archive_mode": "on",
		"archive_command": "pgbackrest --stanza=main archive-push %p",
		"archive_library": "",
	},
	"backup_methods": [
		"pgbackrest",
		"pg_dump",
	],
}}

_has_prefix(vs, p) if {
	some v in vs
	startswith(v, p)
}

test_green_is_compliant if {
	r := b.compliance_report with input as green
	r.compliant == true
	r.violations_count == 0
	r.passed_controls == 72
}

test_total_controls if {
	r := b.compliance_report with input as {}
	r.total_controls == 72
	r.standard_total == 72
	r.automated_controls + r.manual_controls == 72
}

test_failing_control_keeps_report_populated if {
	inp := json.patch(green, [{"op": "replace", "path": "/postgresql/logging/log_hostname", "value": "on"}])
	r := b.compliance_report with input as inp
	r.compliant == false
	r.violations_count == 1
	r.sections.logging.violations == 1
	r.sections.logging.controls == 26
	r.sections.installation.violations == 0
}

test_nothing_passes_on_empty_input if {
	count(b.passed) == 0 with input as {}
	count(b.passed) == 0 with input as {"postgresql": {"attest": {}}}
}

test_section_control_counts if {
	s := b.compliance_report.sections with input as {}
	s.installation.controls == 7
	s.directory_file_permissions.controls == 4
	s.logging.controls == 26
	s.user_access.controls == 10
	s.connection_ssl.controls == 6
	s.postgresql_settings.controls == 11
	s.replication.controls == 5
	s.special_requirements.controls == 3
}

# 1.1 Ensure packages are obtained from authorized repositories
test_1_1_pass if {
	"1.1" in b.passed with input as green
}

test_1_1_fail_not_attested if {
	inp := json.patch(green, [{"op": "replace", "path": "/postgresql/attest/authorized_package_repositories", "value": false}])
	not "1.1" in b.passed with input as inp
	vs := b.violations with input as inp
	_has_prefix(vs, "1.1: ")
}

test_1_1_fail_attest_absent if {
	inp := json.patch(green, [{"op": "remove", "path": "/postgresql/attest/authorized_package_repositories"}])
	not "1.1" in b.passed with input as inp
}

