# 6.1 (Manual)
passed contains "6.1" if input.postgresql.attest.runtime_parameter_attack_vectors_reviewed == true

# 6.2 (Automated)
missing contains {"id": "6.2", "field": "postgresql.backend_settings"} if not _nonempty_obj(["postgresql", "backend_settings"])

passed contains "6.2" if {
	pg := input.postgresql
	b := pg.backend_settings
	_off(b.ignore_system_indexes)
	_off(b.jit_debugging_support)
	_off(b.jit_profiling_support)
	_on(b.log_connections)
	_on(b.log_disconnections)
	regex.match(`^\s*0+\s*(ms|s|min)?\s*$`, sprintf("%v", [b.post_auth_delay]))
}

