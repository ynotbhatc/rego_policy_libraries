	pg.ssl.ssl_min_protocol_version in {"TLSv1.2", "TLSv1.3"}
}

# 6.10 (Automated)
missing contains {"id": "6.10", "field": "postgresql.ssl.ssl_ciphers"} if not _present(["postgresql", "ssl", "ssl_ciphers"])

missing contains {"id": "6.10", "field": "postgresql.ssl.tls12_unapproved_cipher_sessions"} if not _is_arr(["postgresql", "ssl", "tls12_unapproved_cipher_sessions"])

passed contains "6.10" if {
	pg := input.postgresql
	cs := _cipher_list(pg.ssl.ssl_ciphers)
	count(cs) > 0
	every c in cs { c in _approved_ciphers }
	count(pg.ssl.tls12_unapproved_cipher_sessions) == 0
}

