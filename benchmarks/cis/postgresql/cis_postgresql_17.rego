	"4.10": {"title": "Ensure all accounts that can log in have passwords", "section": "4", "profiles": ["Level 1 - PostgreSQL"], "level": 1, "assessment": "Manual", "attest": "login_accounts_have_passwords"},
	"5.1": {"title": "Do Not Specify Passwords in the Command Line", "section": "5", "profiles": ["Level 1 - PostgreSQL"], "level": 1, "assessment": "Manual", "attest": "no_passwords_on_command_line"},
	"5.2": {"title": "Ensure PostgreSQL is Bound to an IP Address", "section": "5", "profiles": ["Level 1 - PostgreSQL"], "level": 1, "assessment": "Manual", "attest": "bound_to_ip_address"},
	"5.3": {"title": "Ensure login via \"local\" UNIX Domain Socket is configured correctly", "section": "5", "profiles": ["Level 1 - PostgreSQL on Linux"], "level": 1, "assessment": "Manual", "attest": "local_socket_login_configured"},
	"5.4": {"title": "Ensure login via \"host\" TCP/IP Socket is configured correctly", "section": "5", "profiles": ["Level 1 - PostgreSQL on Linux"], "level": 1, "assessment": "Manual", "attest": "host_tcp_login_configured"},
