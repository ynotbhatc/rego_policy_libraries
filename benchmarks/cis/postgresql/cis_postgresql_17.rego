# 6.8 (Automated)
missing contains {"id": "6.8", "field": "postgresql.ssl.enabled"} if not _present(["postgresql", "ssl", "enabled"])

missing contains {"id": "6.8", "field": "postgresql.authentication.pg_hba_entries"} if not _is_arr(["postgresql", "authentication", "pg_hba_entries"])

missing contains {"id": "6.8", "field": "postgresql.ssl.non_ssl_client_connections"} if not _is_arr(["postgresql", "ssl", "non_ssl_client_connections"])

passed contains "6.8" if {
	pg := input.postgresql
	_on(pg.ssl.enabled)
	is_array(pg.authentication.pg_hba_entries)
	count([e | some e in pg.authentication.pg_hba_entries; lower(e.connection_type) in {"host", "hostnossl"}]) == 0
	count(pg.ssl.non_ssl_client_connections) == 0
}

