	"6.11": {"title": "Ensure the pgcrypto extension is installed and configured correctly", "section": "6", "profiles": ["Level 1 - PostgreSQL"], "level": 1, "assessment": "Manual", "attest": "pgcrypto_configured"},
	"7.1": {"title": "Ensure a replication-only user is created and used for streaming replication", "section": "7", "profiles": ["Level 1 - PostgreSQL"], "level": 1, "assessment": "Manual", "attest": "replication_only_user_used"},
	"7.2": {"title": "Ensure logging of replication commands is configured", "section": "7", "profiles": ["Level 1 - PostgreSQL"], "level": 1, "assessment": "Manual", "attest": "replication_command_logging_configured"},
	"7.3": {"title": "Ensure base backups are configured and functional", "section": "7", "profiles": ["Level 1 - PostgreSQL"], "level": 1, "assessment": "Manual", "attest": "base_backups_functional"},
	"7.4": {"title": "Ensure WAL archiving is configured and functional", "section": "7", "profiles": ["Level 1 - PostgreSQL on Linux"], "level": 1, "assessment": "Automated"},
	"7.5": {"title": "Ensure streaming replication parameters are configured correctly", "section": "7", "profiles": ["Level 1 - PostgreSQL"], "level": 1, "assessment": "Manual", "attest": "streaming_replication_parameters_configured"},
	"8.1": {"title": "Ensure PostgreSQL subdirectory locations are outside the data cluster", "section": "8", "profiles": ["Level 1 - PostgreSQL"], "level": 1, "assessment": "Manual", "attest": "subdirectories_outside_data_cluster"},
	"8.2": {"title": "Ensure the backup and restore tool, 'pgBackRest', is installed and configured", "section": "8", "profiles": ["Level 1 - PostgreSQL on Linux"], "level": 1, "assessment": "Automated"},
	"8.3": {"title": "Ensure miscellaneous configuration settings are correct", "section": "8", "profiles": ["Level 1 - PostgreSQL"], "level": 1, "assessment": "Manual", "attest": "miscellaneous_settings_correct"},
}

# ── helpers ──────────────────────────────────────────────────────────────────
# Evidence presence. Called with literal paths so a missing key is a false result, never an undefined argument.
_present(p) if object.get(input, p, null) != null

_is_arr(p) if is_array(object.get(input, p, null))

_nonempty_obj(p) if {
	o := object.get(input, p, null)
	is_object(o)
	count(o) > 0
}

# SHOW-style booleans: "on"/"off" as PostgreSQL prints them; true/false and yes/no/1/0 are accepted as well.
_on(v) if lower(sprintf("%v", [v])) in {"on", "true", "yes", "1"}

_off(v) if lower(sprintf("%v", [v])) in {"off", "false", "no", "0"}

_nonempty_string(s) if {
	is_string(s)
	trim_space(s) != ""
}

# A list setting arrives as a comma-separated string (SHOW output) or as an array.
_as_list(v) := [lower(trim_space(x)) | some x in v; trim_space(x) != ""] if is_array(v)

_as_list(v) := [lower(trim_space(x)) | some x in split(v, ","); trim_space(x) != ""] if is_string(v)

# Organization logging/authorization policy (optional): input.postgresql.policy.*
_policy := p if {
	p := input.postgresql.policy
	is_object(p)
} else := {}

_policy_list(k) := l if {
	l := _policy[k]
	is_array(l)
} else := []

_policy_match(k, _) if not _policy[k]

_policy_match(k, v) if _policy[k] == v

# Parse an octal permission string ("644", "0644", "0o644") to an integer; undefined if not octal.
octal(s) := n if {
	t := trim_prefix(lower(trim_space(sprintf("%v", [s]))), "0o")
	regex.match(`^[0-7]{1,4}$`, t)
	p := concat("", [substring("0000", 0, 4 - count(t)), t])
	ds := [to_number(substring(p, i, 1)) | some i in numbers.range(0, 3)]
	n := ((ds[0] * 512) + (ds[1] * 64)) + ((ds[2] * 8) + ds[3])
}

# true when mode grants nothing beyond max (both octal strings)
mode_within(mode, max) if bits.and(octal(mode), bits.and(bits.negate(octal(max)), 4095)) == 0

# PostgreSQL time setting to minutes; a bare number is minutes (log_rotation_age's unit).
_duration_minutes(raw) := m if {
	parts := regex.find_all_string_submatch_n(`^\s*([0-9]+)\s*(ms|s|min|h|d)?\s*$`, sprintf("%v", [raw]), 1)[0]
	mult := {"": 1, "ms": 1 / 60000, "s": 1 / 60, "min": 1, "h": 60, "d": 1440}[parts[2]]
	m := to_number(parts[1]) * mult
}

# PostgreSQL size setting ("10MB", "1GB", "512kB"; a bare number is kB) to kB.
size_to_kb(raw) := kb if {
	m := regex.find_all_string_submatch_n(`^\s*([0-9]+)\s*(kB|MB|GB|TB)?\s*$`, sprintf("%v", [raw]), 1)[0]
	mult := {"": 1, "kB": 1, "MB": 1024, "GB": 1048576, "TB": 1073741824}[m[2]]
	kb := to_number(m[1]) * mult
}

# Message levels from most to least verbose; "at least <level>" = that level or a more verbose one.
_levels := ["debug5", "debug4", "debug3", "debug2", "debug1", "info", "notice", "warning", "error", "log", "fatal", "panic"]

_level_at_most(v, max) if {
	some i, l in _levels
	l == lower(v)
	some j, k in _levels
	k == max
	i <= j
}

# log_line_prefix escapes in use (padding like %-10u normalised; %% is a literal percent).
_prefix_escapes(s) := {concat("", ["%", substring(t, count(t) - 1, 1)]) | some t in regex.find_n(`%-?[0-9]*.`, s, -1)}

_syslog_only if {
	dests := _as_list(input.postgresql.logging.log_destination)
	count(dests) > 0
	every d in dests {
		d in {"syslog", "eventlog"}
	}
}

_required_prefix_escapes := {"%u", "%d", "%a", "%h"} if {
	_syslog_only
} else := {"%m", "%p", "%l", "%d", "%u", "%a", "%h"}

_log_timezone_ok(tz) if upper(tz) in {"GMT", "UTC", "ETC/GMT", "ETC/UTC"}

_log_timezone_ok(tz) if tz in _policy_list("log_timezones")

# pgaudit.log classes the organization requires; the benchmark's own example (ddl, write) when no policy is given.
_pgaudit_required := [lower(c) | some c in _policy_list("pgaudit_log_classes")] if {
	count(_policy_list("pgaudit_log_classes")) > 0
} else := ["ddl", "write"]

_pgaudit_covers(classes, r) if r in classes

_pgaudit_covers(classes, r) if {
	"all" in classes
	not concat("", ["-", r]) in classes
}

_secdef(f) if f.prosecdef == true

_secdef(f) if lower(sprintf("%v", [f.prosecdef])) in {"t", "true"}

_unauthorized_secdef(f) if {
	_secdef(f)
	not sprintf("%s.%s", [f.schema, f.name]) in _policy_list("authorized_security_definer_functions")
}

_approved_ciphers := {
	"ECDHE-ECDSA-AES256-GCM-SHA384",
	"ECDHE-RSA-AES256-GCM-SHA384",
	"ECDHE-ECDSA-AES128-GCM-SHA256",
	"ECDHE-RSA-AES128-GCM-SHA256",
}

_cipher_list(s) := [c | some c in regex.split(`[:, ]+`, trim_space(s)); c != ""]

_archive_value_set(v) if {
	is_string(v)
	t := trim_space(v)
	t != ""
	t != "(disabled)"
}

_archive_target_set(a) if _archive_value_set(a.archive_command)

_archive_target_set(a) if _archive_value_set(a.archive_library)

# ── per-recommendation logic ─────────────────────────────────────────────────
# 1.1 (Manual)
passed contains "1.1" if input.postgresql.attest.authorized_package_repositories == true

# 1.2 (Manual)
passed contains "1.2" if input.postgresql.attest.only_required_packages_installed == true

# 1.3 (Automated)
missing contains {"id": "1.3", "field": "postgresql.service.enabled"} if not _present(["postgresql", "service", "enabled"])

passed contains "1.3" if {
	pg := input.postgresql
	pg.service.enabled == true
}

# 1.4 (Automated)
missing contains {"id": "1.4", "field": "postgresql.cluster.initialized"} if not _present(["postgresql", "cluster", "initialized"])

missing contains {"id": "1.4", "field": "postgresql.cluster.check_db_dir_rc"} if not _present(["postgresql", "cluster", "check_db_dir_rc"])

passed contains "1.4" if {
	pg := input.postgresql
	pg.cluster.initialized == true
	pg.cluster.check_db_dir_rc == 0
}

# 1.5 (Manual)
passed contains "1.5" if input.postgresql.attest.latest_security_patches_applied == true

# 1.6 (Automated)
missing contains {"id": "1.6", "field": "postgresql.system.pgpassword_profile_files"} if not _is_arr(["postgresql", "system", "pgpassword_profile_files"])

passed contains "1.6" if {
	pg := input.postgresql
	count(pg.system.pgpassword_profile_files) == 0
}

# 1.7 (Automated)
missing contains {"id": "1.7", "field": "postgresql.system.pgpassword_processes"} if not _is_arr(["postgresql", "system", "pgpassword_processes"])

passed contains "1.7" if {
	pg := input.postgresql
	count(pg.system.pgpassword_processes) == 0
}

# 2.1 (Manual)
passed contains "2.1" if input.postgresql.attest.file_permissions_mask_correct == true

# 2.2 (Automated)
missing contains {"id": "2.2", "field": "postgresql.file_permissions.extension_directory"} if not _nonempty_obj(["postgresql", "file_permissions", "extension_directory"])

passed contains "2.2" if {
	pg := input.postgresql
	d := pg.file_permissions.extension_directory
	d.owner == "root"
	d.group == "root"
	octal(d.mode) == octal("0755")
}

# 2.3 (Automated)
missing contains {"id": "2.3", "field": "postgresql.system.psql_history_files"} if not _is_arr(["postgresql", "system", "psql_history_files"])

passed contains "2.3" if {
	pg := input.postgresql
	is_array(pg.system.psql_history_files)
	every f in pg.system.psql_history_files {
		f.symlink_target == "/dev/null"
	}
}

# 2.4 (Manual)
passed contains "2.4" if input.postgresql.attest.service_file_has_no_passwords == true

# 3.1.2 (Automated)
missing contains {"id": "3.1.2", "field": "postgresql.logging.log_destination"} if not _present(["postgresql", "logging", "log_destination"])

passed contains "3.1.2" if {
	pg := input.postgresql
	dests := _as_list(pg.logging.log_destination)
	count(dests) > 0
	every d in dests { d in {"stderr", "csvlog", "jsonlog", "syslog", "eventlog"} }
	every r in _policy_list("log_destinations") { lower(r) in dests }
}

