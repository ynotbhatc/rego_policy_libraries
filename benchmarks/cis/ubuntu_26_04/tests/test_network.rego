	count([v | some v in vs; startswith(v, "3.3.2.7: ")]) > 0
	not "3.3.2.7: evidence missing — sysctl/sysctl_persisted[net.ipv6.conf.all.accept_ra] not collected" in vs
}

test_3_3_2_7_evidence_missing if {
	vs := data.cis_ubuntu_26_04.network.violations with input as {}
	"3.3.2.7: evidence missing — sysctl/sysctl_persisted[net.ipv6.conf.all.accept_ra] not collected" in vs
}

test_3_3_2_7_hollow_evidence_not_a_pass if {
	vs := data.cis_ubuntu_26_04.network.violations with input as {"sysctl": {"net.ipv6.conf.all.accept_ra": ""}, "sysctl_persisted": {"net.ipv6.conf.all.accept_ra": ""}}
	count([v | some v in vs; startswith(v, "3.3.2.7: ")]) > 0
}

test_3_3_2_8_pass if {
	vs := data.cis_ubuntu_26_04.network.violations with input as {"sysctl": {"net.ipv6.conf.default.accept_ra": "0"}, "sysctl_persisted": {"net.ipv6.conf.default.accept_ra": "0"}}
	count([v | some v in vs; startswith(v, "3.3.2.8: ")]) == 0
}

test_3_3_2_8_fail if {
	vs := data.cis_ubuntu_26_04.network.violations with input as {"sysctl": {"net.ipv6.conf.default.accept_ra": "0"}, "sysctl_persisted": {"net.ipv6.conf.default.accept_ra": "99"}}
	count([v | some v in vs; startswith(v, "3.3.2.8: ")]) > 0
	not "3.3.2.8: evidence missing — sysctl/sysctl_persisted[net.ipv6.conf.default.accept_ra] not collected" in vs
}

test_3_3_2_8_evidence_missing if {
	vs := data.cis_ubuntu_26_04.network.violations with input as {}
	"3.3.2.8: evidence missing — sysctl/sysctl_persisted[net.ipv6.conf.default.accept_ra] not collected" in vs
}

test_3_3_2_8_hollow_evidence_not_a_pass if {
	vs := data.cis_ubuntu_26_04.network.violations with input as {"sysctl": {"net.ipv6.conf.default.accept_ra": ""}, "sysctl_persisted": {"net.ipv6.conf.default.accept_ra": ""}}
	count([v | some v in vs; startswith(v, "3.3.2.8: ")]) > 0
}
