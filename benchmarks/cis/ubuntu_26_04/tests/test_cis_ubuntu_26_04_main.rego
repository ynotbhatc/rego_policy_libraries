package cis_ubuntu_26_04.main_test

import rego.v1

# Generated by tools/cis_generators/gen_ubuntu_26_04.py: roll-up and bridge smoke tests.

test_every_recommendation_in_table if {
	count(data.cis_ubuntu_26_04.controls) == 350
	count([c | some c in data.cis_ubuntu_26_04.controls; c.assessment == "Manual"]) == 17
}

test_empty_input_fails_closed if {
	r := data.cis_ubuntu_26_04.main.compliance_report with input as {}
	count(object.keys(r)) == 17
	every k in ["framework", "benchmark", "version", "profile", "total_controls", "standard_total", "controls_basis", "passed_controls", "failed_controls", "compliance_percentage", "section_compliance_percentage", "compliant", "violations", "section_results", "sections_not_assessed", "missing_inputs", "assessment_coverage_percentage"] { k in object.keys(r) }
	r.compliant == false
	r.total_controls == 274
	r.failed_controls == r.total_controls
	r.passed_controls == 0
	some v in r.violations
	startswith(v, "FAIL-CLOSED")
}

test_profile_level1_server_count if {
	r := data.cis_ubuntu_26_04.main.compliance_report with input as {"profile": "level1_server"}
	r.profile == "level1_server"
	r.total_controls == 274
	r.standard_total == 350
	r.failed_controls == r.total_controls
}

test_profile_level2_server_count if {
	r := data.cis_ubuntu_26_04.main.compliance_report with input as {"profile": "level2_server"}
	r.profile == "level2_server"
	r.total_controls == 350
	r.standard_total == 350
	r.failed_controls == r.total_controls
}

test_profile_level1_workstation_count if {
	r := data.cis_ubuntu_26_04.main.compliance_report with input as {"profile": "level1_workstation"}
	r.profile == "level1_workstation"
	r.total_controls == 265
	r.standard_total == 350
	r.failed_controls == r.total_controls
}

test_profile_level2_workstation_count if {
	r := data.cis_ubuntu_26_04.main.compliance_report with input as {"profile": "level2_workstation"}
	r.profile == "level2_workstation"
	r.total_controls == 347
	r.standard_total == 350
	r.failed_controls == r.total_controls
}

test_unknown_profile_defaults_to_level1_server if {
	r := data.cis_ubuntu_26_04.main.compliance_report with input as {"profile": "bogus"}
	r.profile == "level1_server"
	r.total_controls == 274
}

test_one_attested_control_passes if {
	r := data.cis_ubuntu_26_04.main.compliance_report with input as {"attest": {"apt_sources_signed_by_reviewed": true}}
	r.passed_controls == 1
	r.failed_controls == r.total_controls - 1
	r.compliant == false
}

test_unassessed_sections_listed if {
	r := data.cis_ubuntu_26_04.main.compliance_report with input as {"ssh": {"sshd_config_raw": "permitrootlogin no"}}
	not "ssh" in r.sections_not_assessed
	"auditd" in r.sections_not_assessed
	r.assessment_coverage_percentage < 100
}

test_level2_violation_hidden_in_level1_profile if {
	vs := data.cis_ubuntu_26_04.all_violations with input as {"profile": "level1_server"}
	count([v | some v in vs; startswith(v, "6.2.1.1: ")]) == 0
	vs2 := data.cis_ubuntu_26_04.all_violations with input as {"profile": "level2_server"}
	count([v | some v in vs2; startswith(v, "6.2.1.1: ")]) > 0
}
