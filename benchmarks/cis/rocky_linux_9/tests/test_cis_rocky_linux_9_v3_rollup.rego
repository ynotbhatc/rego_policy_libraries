test_v3_profile_finding_names_the_problem if {
	ra := data.cis_rocky_linux_9.main.compliance_report with input as {"attest": {}}
	some a in ra.violations
	startswith(a, "PROFILE NOT SELECTED: evidence missing — profile not collected")
	rb := data.cis_rocky_linux_9.main.compliance_report with input as {"profile": 2}
	some b in rb.violations
	startswith(b, "PROFILE NOT SELECTED: profile is not a string (got number)")
	rc := data.cis_rocky_linux_9.main.compliance_report with input as {"profile": "bogus"}
	some c in rc.violations
	startswith(c, "PROFILE NOT SELECTED: profile \"bogus\" is not a recognised profile")
}

test_v3_recognised_profile_has_no_profile_finding if {
	every p in ["level1_server", "level2_server", "level1_workstation", "level2_workstation", "level1", "level2"] {
		r := data.cis_rocky_linux_9.main.compliance_report with input as {"profile": p}
		count([v | some v in r.violations; startswith(v, "PROFILE NOT SELECTED")]) == 0
	}
}

test_v3_one_attested_control_passes if {
	r := data.cis_rocky_linux_9.main.compliance_report with input as {"attest": {"gpg_keys_reviewed": true}}
	r.passed_controls == 1
	r.failed_controls == r.total_controls - 1
	r.compliant == false
}

test_v3_level2_violation_hidden_in_level1_profile if {
	vs := data.cis_rocky_linux_9.all_violations with input as {"profile": "level1_server"}
	count([v | some v in vs; startswith(v, "6.2.1.1: ")]) == 0
	vs2 := data.cis_rocky_linux_9.all_violations with input as {"profile": "level2_server"}
	count([v | some v in vs2; startswith(v, "6.2.1.1: ")]) > 0
}

test_v3_every_violation_parses_to_a_control if {
	vs := data.cis_rocky_linux_9.all_violations with input as {"profile": "level2_server"}
	every v in vs { split(v, ":")[0] in object.keys(data.cis_rocky_linux_9.controls) }
	mvs := data.cis_rocky_linux_9.module_violations with input as {}
	every _, mv in mvs {
		every v in mv { split(v, ":")[0] in object.keys(data.cis_rocky_linux_9.controls) }
	}
}

test_v3_l2_view_is_level2_server_only if {
	r := data.cis_rocky_linux_9.l2.compliance_report with input as {}
	r.total_controls == 89
	r.compliant == false
	l2v := data.cis_rocky_linux_9.l2.violations with input as {}
	every v in l2v { data.cis_rocky_linux_9.controls[split(v, ":")[0]].levels.server == 2 }
}
