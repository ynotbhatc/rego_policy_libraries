# every violation names a recommendation of this section
test_user_group_violations_carry_section_ids if {
	vs := data.cis_amazon_linux_2023.user_group.violations with input as {}
	every v in vs { split(v, ":")[0] in ["6.2.1", "6.2.2", "6.2.3", "6.2.4", "6.2.5", "6.2.6", "6.2.7", "6.2.8", "6.2.9", "6.2.10", "6.2.11"] }
