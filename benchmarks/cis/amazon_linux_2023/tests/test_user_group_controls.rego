test_6_2_1_pass if {
	vs := data.cis_amazon_linux_2023.user_group.violations with input as {"user_group": {"users_without_shadow": []}}
	count([v | some v in vs; startswith(v, "6.2.1: ")]) == 0
}

test_6_2_1_fail if {
	vs := data.cis_amazon_linux_2023.user_group.violations with input as {"user_group": {"users_without_shadow": ["bob"]}}
	count([v | some v in vs; startswith(v, "6.2.1: ")]) > 0
	not "6.2.1: evidence missing — user_group.users_without_shadow not collected" in vs
}

