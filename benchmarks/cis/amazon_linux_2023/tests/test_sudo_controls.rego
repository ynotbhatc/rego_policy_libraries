package cis_amazon_linux_2023.sudo_test

import rego.v1

# Generated by tools/cis_generators/gen_amazon_linux_2023.py: a pass and a fail case for every recommendation, plus an evidence-missing
# case for every Automated one. Assertions key on '<id>: ' (colon included).

test_4_3_1_pass if {
	vs := data.cis_amazon_linux_2023.sudo.violations with input as {"sudo": {"installed": true}}
	count([v | some v in vs; startswith(v, "4.3.1: ")]) == 0
}

test_4_3_1_fail if {
	vs := data.cis_amazon_linux_2023.sudo.violations with input as {"sudo": {"installed": false}}
	count([v | some v in vs; startswith(v, "4.3.1: ")]) > 0
	not "4.3.1: evidence missing — sudo.installed not collected" in vs
}

test_4_3_1_evidence_missing if {
	vs := data.cis_amazon_linux_2023.sudo.violations with input as {}
	"4.3.1: evidence missing — sudo.installed not collected" in vs
}

