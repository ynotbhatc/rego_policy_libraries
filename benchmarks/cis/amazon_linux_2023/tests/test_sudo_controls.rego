# every recommendation of the section satisfied at once (the inputs above merged)
test_sudo_section_compliant_on_merged_good_input if {
	vs := data.cis_amazon_linux_2023.sudo.violations with input as {"sudo": {"installed": true, "sudoers_content": "Defaults use_pty\nroot ALL=(ALL) ALL\nDefaults logfile=\"/var/log/sudo.log\"\nDefaults use_pty\nDefaults timestamp_timeout=15", "logfile_exists": true}, "pam": {"su_config_raw": "auth required pam_wheel.so use_uid group=sugroup"}, "user_group": {"group_members": {"sugroup": []}}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_sudo_violations_carry_section_ids if {
	vs := data.cis_amazon_linux_2023.sudo.violations with input as {}
	every v in vs { split(v, ":")[0] in ["4.3.1", "4.3.2", "4.3.3", "4.3.4", "4.3.5", "4.3.6"] }
}
