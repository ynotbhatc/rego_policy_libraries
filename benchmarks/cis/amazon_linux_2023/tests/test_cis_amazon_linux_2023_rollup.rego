package cis_amazon_linux_2023.main_test

import rego.v1

# Generated by tools/cis_generators/gen_amazon_linux_2023.py: roll-up, bridge and deprecated-view tests for CIS Amazon Linux 2023 Benchmark v1.0.0.

test_every_recommendation_in_table if {
	count(data.cis_amazon_linux_2023.controls) == 243
	count([c | some c in data.cis_amazon_linux_2023.controls; c.assessment == "Manual"]) == 26
	count([c | some c in data.cis_amazon_linux_2023.controls; c.level == 1]) == 179
	data.cis_amazon_linux_2023.standard_total == 243
}

test_empty_input_fails_closed if {
	r := data.cis_amazon_linux_2023.main.compliance_report with input as {}
	count(object.keys(r)) == 18
	every k in ["framework", "benchmark", "version", "profile", "total_controls", "standard_total", "controls_basis", "passed_controls", "failed_controls", "compliance_percentage", "section_compliance_percentage", "compliant", "violations", "violation_count", "section_results", "sections_not_assessed", "missing_inputs", "assessment_coverage_percentage"] { k in object.keys(r) }
	r.compliant == false
	r.total_controls == 243
	r.failed_controls == r.total_controls
	r.passed_controls == 0
	some v in r.violations
	startswith(v, "FAIL-CLOSED: no facts supplied")
}

test_profile_level1_server_count if {
	r := data.cis_amazon_linux_2023.main.compliance_report with input as {"profile": "level1_server"}
	r.profile == "level1_server"
	r.total_controls == 179
	r.standard_total == 243
	r.failed_controls == r.total_controls
}

test_profile_level2_server_count if {
	r := data.cis_amazon_linux_2023.main.compliance_report with input as {"profile": "level2_server"}
	r.profile == "level2_server"
	r.total_controls == 243
	r.standard_total == 243
	r.failed_controls == r.total_controls
}

test_short_profile_values_map_to_server_profiles if {
	r1 := data.cis_amazon_linux_2023.main.compliance_report with input as {"profile": "level1"}
	r1.profile == "level1_server"
	r1.total_controls == 179
	r2 := data.cis_amazon_linux_2023.main.compliance_report with input as {"profile": "level2"}
	r2.profile == "level2_server"
	r2.total_controls == 243
}

test_unknown_profile_is_not_selected_and_evaluates_everything if {
	r := data.cis_amazon_linux_2023.main.compliance_report with input as {"profile": "bogus"}
	r.profile == "unrecognised"
	r.total_controls == 243
	r.compliant == false
	r.failed_controls == r.total_controls
	count([v | some v in r.violations; startswith(v, "PROFILE NOT SELECTED: ")]) == 1
}

test_absent_or_mistyped_profile_is_not_selected_and_never_compliant if {
	every p in [null, 1, true, [], {}, "", "Level1_Server", "level_1_server"] {
		r := data.cis_amazon_linux_2023.main.compliance_report with input as {"profile": p, "attest": {"x": true}}
		r.profile == "unrecognised"
		r.compliant == false
		r.total_controls == 243
		count([v | some v in r.violations; startswith(v, "PROFILE NOT SELECTED: ")]) == 1
	}
	r0 := data.cis_amazon_linux_2023.main.compliance_report with input as {"attest": {"x": true}}
	r0.profile == "unrecognised"
	r0.compliant == false
	r0.compliance_percentage < 100
}

test_one_attested_control_passes if {
	r := data.cis_amazon_linux_2023.main.compliance_report with input as {"attest": {"gpg_keys_reviewed": true}}
	r.passed_controls == 1
	r.failed_controls == r.total_controls - 1
	r.compliant == false
}

test_level2_violation_hidden_in_level1_profile if {
	vs := data.cis_amazon_linux_2023.all_violations with input as {"profile": "level1_server"}
	count([v | some v in vs; startswith(v, "5.2.1.1: ")]) == 0
	vs2 := data.cis_amazon_linux_2023.all_violations with input as {"profile": "level2_server"}
	count([v | some v in vs2; startswith(v, "5.2.1.1: ")]) > 0
}

test_every_violation_parses_to_a_control if {
	vs := data.cis_amazon_linux_2023.all_violations with input as {"profile": "level2_server"}
	every v in vs { split(v, ":")[0] in object.keys(data.cis_amazon_linux_2023.controls) }
	mvs := data.cis_amazon_linux_2023.module_violations with input as {}
	every _, mv in mvs {
		every v in mv { split(v, ":")[0] in object.keys(data.cis_amazon_linux_2023.controls) }
	}
}

test_partial_input_lists_sections_not_assessed if {
	r := data.cis_amazon_linux_2023.main.compliance_report with input as {"ssh": {"sshd_config_raw": "permitrootlogin no"}}
	r.compliant == false
	not "section_5_2_ssh" in r.sections_not_assessed
	"section_4_1_auditd" in r.sections_not_assessed
	r.failed_controls <= r.total_controls
}

# the deprecated cis.amazon_linux_2023 view (read by the compliance repo's assessment playbook)
test_deprecated_view_mirrors_the_bridge if {
	s := data.cis.amazon_linux_2023.compliance_summary with input as {}
	r := data.cis_amazon_linux_2023.main.compliance_report with input as {}
	s.deprecated == true
	s.total_controls == r.total_controls
	s.failing_controls == r.failed_controls
	s.passing_controls == r.passed_controls
	s.compliance_percentage == r.compliance_percentage
	vs := data.cis.amazon_linux_2023.violations with input as {}
	count(vs) == count(r.violations)
	not data.cis.amazon_linux_2023.compliant with input as {}
}

# Round 4 (2026-11-24): with every recommendation passing but no profile selected the report is not compliant,
# passed + failed == total, and the percentage is null with a reason, never 100 beside compliant == false.
test_unselected_profile_with_nothing_failed_withholds_the_percentage if {
	r := data.cis_amazon_linux_2023.main.compliance_report with input as {"attest": {"x": true}} with data.cis_amazon_linux_2023.failing_ids as set()
	r.compliant == false
	r.failed_controls == 0
	r.passed_controls == r.total_controls
	r.passed_controls + r.failed_controls == r.total_controls
	r.compliance_percentage == null
	startswith(r.compliance_percentage_reason, "no profile selected")
}

test_percentage_is_a_number_when_a_control_failed if {
	r := data.cis_amazon_linux_2023.main.compliance_report with input as {"attest": {"x": true}}
	r.failed_controls > 0
	is_number(r.compliance_percentage)
	not "compliance_percentage_reason" in object.keys(r)
}
