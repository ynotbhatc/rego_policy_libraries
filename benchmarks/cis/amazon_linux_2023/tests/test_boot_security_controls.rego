# Generated by tools/cis_generators/gen_amazon_linux_2023.py: a pass and a fail case for every recommendation, plus an evidence-missing
# case for every Automated one. Assertions key on '<id>: ' (colon included).

test_1_3_1_pass if {
	vs := data.cis_amazon_linux_2023.boot_security.violations with input as {"boot_security": {"aide_installed": true}}
	count([v | some v in vs; startswith(v, "1.3.1: ")]) == 0
}

test_1_3_1_fail if {
	vs := data.cis_amazon_linux_2023.boot_security.violations with input as {"boot_security": {"aide_installed": false}}
	count([v | some v in vs; startswith(v, "1.3.1: ")]) > 0
	not "1.3.1: evidence missing — boot_security.aide_installed not collected" in vs
}

test_1_3_1_evidence_missing if {
	vs := data.cis_amazon_linux_2023.boot_security.violations with input as {}
	"1.3.1: evidence missing — boot_security.aide_installed not collected" in vs
}

