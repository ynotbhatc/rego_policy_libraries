# every recommendation of the section satisfied at once (the inputs above merged)
test_network_section_compliant_on_merged_good_input if {
	vs := data.cis_amazon_linux_2023.network.violations with input as {"attest": {"ipv6_status_identified": true, "firewalld_services_ports_reviewed": true, "nftables_established_connections_reviewed": true}, "disabled_network_modules": {"modules": [{"module": "dccp", "disabled": true, "loaded": false}, {"module": "sctp", "disabled": true, "loaded": false}, {"module": "rds", "disabled": true, "loaded": false}, {"module": "tipc", "disabled": true, "loaded": false}]}, "sysctl_parameters": {"analysis": [{"parameter": "net.ipv4.ip_forward", "current_value": "0"}, {"parameter": "net.ipv6.conf.all.forwarding", "current_value": "0"}, {"parameter": "net.ipv4.conf.all.send_redirects", "current_value": "0"}, {"parameter": "net.ipv4.conf.default.send_redirects", "current_value": "0"}, {"parameter": "net.ipv4.conf.all.accept_source_route", "current_value": "0"}, {"parameter": "net.ipv4.conf.default.accept_source_route", "current_value": "0"}, {"parameter": "net.ipv6.conf.all.accept_source_route", "current_value": "0"}, {"parameter": "net.ipv6.conf.default.accept_source_route", "current_value": "0"}, {"parameter": "net.ipv4.conf.all.accept_redirects", "current_value": "0"}, {"parameter": "net.ipv4.conf.default.accept_redirects", "current_value": "0"}, {"parameter": "net.ipv6.conf.all.accept_redirects", "current_value": "0"}, {"parameter": "net.ipv6.conf.default.accept_redirects", "current_value": "0"}, {"parameter": "net.ipv4.conf.all.secure_redirects", "current_value": "0"}, {"parameter": "net.ipv4.conf.default.secure_redirects", "current_value": "0"}, {"parameter": "net.ipv4.conf.all.log_martians", "current_value": "1"}, {"parameter": "net.ipv4.conf.default.log_martians", "current_value": "1"}, {"parameter": "net.ipv4.icmp_echo_ignore_broadcasts", "current_value": "1"}, {"parameter": "net.ipv4.icmp_ignore_bogus_error_responses", "current_value": "1"}, {"parameter": "net.ipv4.conf.all.rp_filter", "current_value": "1"}, {"parameter": "net.ipv4.conf.default.rp_filter", "current_value": "1"}, {"parameter": "net.ipv4.tcp_syncookies", "current_value": "1"}, {"parameter": "net.ipv6.conf.all.accept_ra", "current_value": "0"}, {"parameter": "net.ipv6.conf.default.accept_ra", "current_value": "0"}], "persisted": {"net.ipv4.ip_forward": "0", "net.ipv6.conf.all.forwarding": "0", "net.ipv4.conf.all.send_redirects": "0", "net.ipv4.conf.default.send_redirects": "0", "net.ipv4.conf.all.accept_source_route": "0", "net.ipv4.conf.default.accept_source_route": "0", "net.ipv6.conf.all.accept_source_route": "0", "net.ipv6.conf.default.accept_source_route": "0", "net.ipv4.conf.all.accept_redirects": "0", "net.ipv4.conf.default.accept_redirects": "0", "net.ipv6.conf.all.accept_redirects": "0", "net.ipv6.conf.default.accept_redirects": "0", "net.ipv4.conf.all.secure_redirects": "0", "net.ipv4.conf.default.secure_redirects": "0", "net.ipv4.conf.all.log_martians": "1", "net.ipv4.conf.default.log_martians": "1", "net.ipv4.icmp_echo_ignore_broadcasts": "1", "net.ipv4.icmp_ignore_bogus_error_responses": "1", "net.ipv4.conf.all.rp_filter": "1", "net.ipv4.conf.default.rp_filter": "1", "net.ipv4.tcp_syncookies": "1", "net.ipv6.conf.all.accept_ra": "0", "net.ipv6.conf.default.accept_ra": "0"}}, "packages": {"nftables": true, "firewalld": false}, "services": {"nftables.service": {"state": "running", "status": "enabled"}}, "firewall": {"nft_ruleset_raw": "table inet filter {\n\tchain input {\n\t\ttype filter hook input priority filter; policy drop;\n\t\tiif \"lo\" accept\n\t\tip saddr 127.0.0.0/8 counter packets 0 bytes 0 drop\n\t\tip6 saddr ::1 counter packets 0 bytes 0 drop\n\t\tct state established,related accept\n\t}\n\tchain forward {\n\t\ttype filter hook forward priority filter; policy drop;\n\t}\n\tchain output {\n\t\ttype filter hook output priority filter; policy accept;\n\t}\n}"}, "ipv6": {"disabled": false}}
	count(vs) == 0
