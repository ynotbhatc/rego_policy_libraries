	vs := data.cis_amazon_linux_2023.auditd.violations with input as {"auditd": {"tools_permissions": [{"stat": {"path": "/usr/sbin/auditctl", "mode": "0755", "pw_name": "adm", "gr_name": "root"}}]}}
