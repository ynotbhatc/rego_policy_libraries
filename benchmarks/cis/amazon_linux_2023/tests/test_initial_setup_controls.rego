test_1_2_1_pass if {
	vs := data.cis_amazon_linux_2023.initial_setup.violations with input as {"attest": {"gpg_keys_reviewed": true}}
	count([v | some v in vs; startswith(v, "1.2.1: ")]) == 0
}

test_1_2_1_fail if {
	vs := data.cis_amazon_linux_2023.initial_setup.violations with input as {"attest": {"gpg_keys_reviewed": false}}
