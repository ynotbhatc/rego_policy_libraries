}

# every violation names a recommendation of this section
test_initial_setup_violations_carry_section_ids if {
	vs := data.cis_amazon_linux_2023.initial_setup.violations with input as {}
	every v in vs { split(v, ":")[0] in ["1.2.1", "1.2.2", "1.2.3", "1.2.4", "1.7.1", "1.7.2", "1.7.3", "1.7.4", "1.7.5", "1.7.6", "1.8", "1.9"] }
