# every recommendation of the section satisfied at once (the inputs above merged)
test_initial_setup_section_compliant_on_merged_good_input if {
	vs := data.cis_amazon_linux_2023.initial_setup.violations with input as {"attest": {"gpg_keys_reviewed": true, "repositories_reviewed": true, "repo_gpgcheck_reviewed": true, "updates_installed": true}, "initial_setup": {"global_gpgcheck_enabled": true, "repos_without_gpgcheck": [], "enabled_repos": ["baseos"], "motd_exists": true, "motd_contains_sensitive_info": false, "issue_exists": true, "issue_contains_sensitive_info": false, "issue_net_exists": true, "issue_net_contains_sensitive_info": false, "motd_mode": "0644", "motd_owner": "root", "motd_group": "root", "issue_mode": "0644", "issue_owner": "root", "issue_group": "root", "issue_net_mode": "0644", "issue_net_owner": "root", "issue_net_group": "root", "crypto_policy": "DEFAULT"}}
