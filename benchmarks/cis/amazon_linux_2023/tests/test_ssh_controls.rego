# every recommendation of the section satisfied at once (the inputs above merged)
test_ssh_section_compliant_on_merged_good_input if {
	vs := data.cis_amazon_linux_2023.ssh.violations with input as {"ssh": {"config_permissions": {"mode": "0600", "pw_name": "root", "gr_name": "root"}, "private_key_permissions": [{"stat": {"path": "/etc/ssh/ssh_host_ed25519_key", "mode": "0600", "pw_name": "root", "gr_name": "root"}}, {"stat": {"path": "/etc/ssh/ssh_host_rsa_key", "mode": "0640", "pw_name": "root", "gr_name": "ssh_keys"}}], "public_key_permissions": [{"path": "/etc/ssh/ssh_host_ed25519_key.pub", "mode": "0644", "pw_name": "root", "gr_name": "root"}], "sshd_config_raw": "port 22\nallowgroups sshusers\nport 22\nloglevel VERBOSE\nport 22\nusepam yes\nport 22\npermitrootlogin no\nport 22\nhostbasedauthentication no\nport 22\npermitemptypasswords no\nport 22\npermituserenvironment no\nport 22\nignorerhosts yes\nport 22\nx11forwarding no\nport 22\nallowtcpforwarding no\nport 22\nbanner /etc/issue.net\nport 22\nmaxauthtries 4\nport 22\nmaxstartups 10:30:60\nport 22\nmaxsessions 10\nport 22\nlogingracetime 60\nclientaliveinterval 15\nclientalivecountmax 3", "crypto_policy_override_raw": "OPTIONS=\"-u0\""}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_ssh_violations_carry_section_ids if {
	vs := data.cis_amazon_linux_2023.ssh.violations with input as {}
	every v in vs { split(v, ":")[0] in ["4.2.1", "4.2.2", "4.2.3", "4.2.4", "4.2.5", "4.2.6", "4.2.7", "4.2.8", "4.2.9", "4.2.10", "4.2.11", "4.2.12", "4.2.13", "4.2.14", "4.2.15", "4.2.16", "4.2.17", "4.2.18", "4.2.19", "4.2.20"] }
}
