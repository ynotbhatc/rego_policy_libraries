	count([v | some v in vs; startswith(v, "4.6.3: ")]) == 0
}

test_4_6_3_fail if {
	vs := data.cis_amazon_linux_2023.pam.violations with input as {"pam": {"tmout": 0, "tmout_readonly_exported": true}}
	count([v | some v in vs; startswith(v, "4.6.3: ")]) > 0
	not "4.6.3: evidence missing — pam.tmout/tmout_readonly_exported not collected" in vs
}

test_4_6_3_evidence_missing if {
	vs := data.cis_amazon_linux_2023.pam.violations with input as {"pam": {"tmout": 900}}
	"4.6.3: evidence missing — pam.tmout/tmout_readonly_exported not collected" in vs
}

test_4_6_4_pass if {
	vs := data.cis_amazon_linux_2023.pam.violations with input as {"pam": {"root_gid": 0}}
	count([v | some v in vs; startswith(v, "4.6.4: ")]) == 0
}

test_4_6_4_fail if {
	vs := data.cis_amazon_linux_2023.pam.violations with input as {"pam": {"root_gid": 10}}
	count([v | some v in vs; startswith(v, "4.6.4: ")]) > 0
	not "4.6.4: evidence missing — pam.root_gid not collected" in vs
}

test_4_6_4_evidence_missing if {
	vs := data.cis_amazon_linux_2023.pam.violations with input as {}
	"4.6.4: evidence missing — pam.root_gid not collected" in vs
}

test_4_6_5_pass if {
	vs := data.cis_amazon_linux_2023.pam.violations with input as {"pam": {"default_umask": "027"}}
	count([v | some v in vs; startswith(v, "4.6.5: ")]) == 0
}

test_4_6_5_fail if {
	vs := data.cis_amazon_linux_2023.pam.violations with input as {"pam": {"default_umask": "022"}}
	count([v | some v in vs; startswith(v, "4.6.5: ")]) > 0
	not "4.6.5: evidence missing — pam.default_umask not collected" in vs
}

test_4_6_5_evidence_missing if {
	vs := data.cis_amazon_linux_2023.pam.violations with input as {}
	"4.6.5: evidence missing — pam.default_umask not collected" in vs
}

test_4_6_5_hollow_evidence_not_a_pass if {
	vs := data.cis_amazon_linux_2023.pam.violations with input as {"pam": {"default_umask": ""}}
	count([v | some v in vs; startswith(v, "4.6.5: ")]) > 0
}

test_4_6_6_pass if {
	vs := data.cis_amazon_linux_2023.pam.violations with input as {"attest": {"root_password_set": true}}
	count([v | some v in vs; startswith(v, "4.6.6: ")]) == 0
}

test_4_6_6_fail if {
	vs := data.cis_amazon_linux_2023.pam.violations with input as {"attest": {"root_password_set": false}}
	count([v | some v in vs; startswith(v, "4.6.6: ")]) > 0
}

# every recommendation of the section satisfied at once (the inputs above merged)
test_pam_section_compliant_on_merged_good_input if {
	vs := data.cis_amazon_linux_2023.pam.violations with input as {"attest": {"custom_authselect_profile_used": true, "root_password_set": true}, "pam": {"system_auth": "auth        required      pam_faillock.so preauth silent\nauth        sufficient    pam_unix.so\nauth        required      pam_faillock.so authfail\naccount     required      pam_faillock.so\naccount     required      pam_unix.so\npassword    requisite     pam_pwquality.so local_users_only\npassword    required      pam_pwhistory.so use_authtok\npassword    sufficient    pam_unix.so sha512 shadow use_authtok\nsession     required      pam_unix.so\nauth        required      pam_faillock.so preauth silent\nauth        sufficient    pam_unix.so\nauth        required      pam_faillock.so authfail\naccount     required      pam_faillock.so\naccount     required      pam_unix.so\npassword    requisite     pam_pwquality.so local_users_only\npassword    required      pam_pwhistory.so use_authtok remember=5\npassword    sufficient    pam_unix.so sha512 shadow use_authtok\nsession     required      pam_unix.so\nauth        required      pam_faillock.so preauth silent\nauth        sufficient    pam_unix.so\nauth        required      pam_faillock.so authfail\naccount     required      pam_faillock.so\naccount     required      pam_unix.so\npassword    requisite     pam_pwquality.so local_users_only\npassword    required      pam_pwhistory.so use_authtok\npassword    sufficient    pam_unix.so sha512 shadow use_authtok\nsession     required      pam_unix.so", "password_auth": "auth        required      pam_faillock.so preauth silent\nauth        sufficient    pam_unix.so\nauth        required      pam_faillock.so authfail\naccount     required      pam_faillock.so\naccount     required      pam_unix.so\npassword    requisite     pam_pwquality.so local_users_only\npassword    required      pam_pwhistory.so use_authtok\npassword    sufficient    pam_unix.so sha512 shadow use_authtok\nsession     required      pam_unix.so", "pwquality_conf_raw": "minlen = 14", "faillock_conf_raw": "deny = 5\nunlock_time = 900", "libuser_conf_raw": "[defaults]\ncrypt_style = sha512", "encrypt_method": "SHA512", "pass_max_days": 365, "pass_min_days": 1, "pass_warn_age": 7, "inactive_days": 30, "system_accounts_with_login_shell": [], "tmout": 900, "tmout_readonly_exported": true, "root_gid": 0, "default_umask": "027"}, "user_group": {"shadow_entries": [{"user": "alice", "has_password": true, "max_days": 365, "min_days": 1, "warn_days": 7, "inactive": 30, "last_change": 19000}], "unlocked_accounts_without_shell": []}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_pam_violations_carry_section_ids if {
	vs := data.cis_amazon_linux_2023.pam.violations with input as {}
	every v in vs { split(v, ":")[0] in ["4.4.1", "4.4.2", "4.5.1", "4.5.2", "4.5.3", "4.5.4", "4.6.1.1", "4.6.1.2", "4.6.1.3", "4.6.1.4", "4.6.1.5", "4.6.2", "4.6.3", "4.6.4", "4.6.5", "4.6.6"] }
}
