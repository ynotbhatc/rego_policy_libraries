# every recommendation of the section satisfied at once (the inputs above merged)
test_services_section_compliant_on_merged_good_input if {
	vs := data.cis_amazon_linux_2023.services.violations with input as {"chronyd": {"installed": true, "servers_configured": 0, "pools_configured": 1}, "packages": {"xorg-x11-server-common": false, "avahi": false, "cups": false, "dhcp-server": false, "bind": false, "vsftpd": false, "tftp-server": false, "httpd": false, "nginx": false, "dovecot": false, "cyrus-imapd": false, "samba": false, "squid": false, "net-snmp": true, "telnet-server": false, "dnsmasq": false, "nfs-utils": true, "rpcbind": true, "rsync-daemon": true, "telnet": false, "openldap-clients": false, "ftp": false}, "services": {"sshd.service": {"state": "running", "status": "enabled"}, "snmpd.service": {"state": "inactive", "status": "masked"}, "nfs-server.service": {"state": "inactive", "status": "masked"}, "rpcbind.service": {"state": "inactive", "status": "masked"}, "rpcbind.socket": {"state": "inactive", "status": "masked"}, "rsyncd.service": {"state": "inactive", "status": "masked"}}, "mta": {"has_mta": true, "non_loopback_listeners": [], "inet_interfaces": "loopback-only"}, "attest": {"listening_services_approved": true}}
	count(vs) == 0
}

# every violation names a recommendation of this section
test_services_violations_carry_section_ids if {
	vs := data.cis_amazon_linux_2023.services.violations with input as {}
	every v in vs { split(v, ":")[0] in ["2.1.1", "2.1.2", "2.2.1", "2.2.2", "2.2.3", "2.2.4", "2.2.5", "2.2.6", "2.2.7", "2.2.8", "2.2.9", "2.2.10", "2.2.11", "2.2.12", "2.2.13", "2.2.14", "2.2.15", "2.2.16", "2.2.17", "2.2.18", "2.3.1", "2.3.2", "2.3.3", "2.4"] }
}
