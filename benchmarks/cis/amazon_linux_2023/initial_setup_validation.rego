	is_array(input.initial_setup.repos_without_gpgcheck)
	is_array(input.initial_setup.enabled_repos)
}

default p_1_2_2 := false

p_1_2_2 if {
	input.initial_setup.global_gpgcheck_enabled == true
	count(input.initial_setup.repos_without_gpgcheck) == 0
}

violations contains "1.2.2: evidence missing — initial_setup.global_gpgcheck_enabled/repos_without_gpgcheck/enabled_repos not collected" if not e_1_2_2

violations contains "1.2.2: not met — gpgcheck must be globally activated" if {
	e_1_2_2
	not p_1_2_2
