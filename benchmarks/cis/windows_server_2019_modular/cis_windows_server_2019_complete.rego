# CIS Microsoft Windows Server 2019 Benchmark v5.0.0
# METADATA
# title: "CIS Microsoft Windows Server 2019 Benchmark v5.0.0 - every section, aggregated"
# custom:
#   class: security
#   framework: cis_windows_server_2019_modular
#   source: cis
#   domains: [windows]
#   coverage:
#     checks: 1
#     cited: 1
#     density: orchestrator
#     basis: role
#     tested: true
#     entrypoint: none
#     guard: n/a
#     as_of: v2.4.2
package cis_windows_server_2019

import data.cis_windows_server_2019.attestation
import data.cis_windows_server_2019.account_policies
import data.cis_windows_server_2019.local_policies
import data.cis_windows_server_2019.system_services
import data.cis_windows_server_2019.firewall
import data.cis_windows_server_2019.advanced_audit
import data.cis_windows_server_2019.admin_templates_computer
import data.cis_windows_server_2019.admin_templates_user
import rego.v1

BENCHMARK_TOTAL_CONTROLS := 400

section_reports := [
	account_policies.compliance_report,
	local_policies.compliance_report,
	system_services.compliance_report,
	firewall.compliance_report,
	advanced_audit.compliance_report,
	admin_templates_computer.compliance_report,
	admin_templates_user.compliance_report,
]

_tables := [
	account_policies.controls,
	local_policies.controls,
	system_services.controls,
	firewall.controls,
	advanced_audit.controls,
	admin_templates_computer.controls,
	admin_templates_user.controls,
]

# Static: every recommendation with a check row, whatever the facts or profile. check_cis_coverage.py reads
# this (with empty input) to prove the rows and the attestation ledger partition the benchmark.
evaluated_control_ids := sort([cid | some t in _tables; some cid; _ = t[cid]])

results := object.union_n([r.results | some r in section_reports])

applicable_ids := {cid | some cid; s := results[cid]; s != "not_applicable"} | attestation.in_scope_ids

passed_ids := {cid | some cid; s := results[cid]; s == "pass"} | attestation.passed_ids

failed_ids := {cid | some cid; s := results[cid]; s == "fail"}

not_assessed_ids := {cid | some cid; s := results[cid]; s == "not_assessed"}

# Unattested Manual recommendations count against the host: unverified is not passed.
unattested_ids := attestation.in_scope_ids - attestation.passed_ids

all_violations := array.concat(
	[v | some r in section_reports; some v in r.violations],
	[v | some v in attestation.violation],
)

# Sections that could assess nothing in scope, and the inputs each one lacked.
not_assessed_sections := [r.name |
	some r in section_reports
	count(r.in_scope) > 0
	count(r.assessed) == 0
]

missing_inputs := {r.name: r.missing_inputs |
	some r in section_reports
	count(r.missing_inputs) > 0
}

section_compliance := {r.name: {
	"in_scope": count(r.in_scope),
	"passed": count(r.passed),
	"failed": count(r.failed),
	"not_assessed": count(r.not_assessed),
} | some r in section_reports}

# ---------------------------------------------------------------------------------------------------------------
# The contract ansible/playbooks/cis_windows_server_2019_assessment.yml reads:
#   POST /v1/data/cis_windows_server_2019/compliance_assessment
#   -> summary.{overall_compliance, compliance_percentage, total_violations, risk_level, critical_issues,
#      high_issues, sections_compliant, sections_total}, section_compliance, violations, risk_breakdown.
# Every figure comes from main.compliance_report, so the two endpoints cannot disagree; an empty input is
# reported non-compliant with the FAIL-CLOSED violation, never as a pass.
#
# CIS assigns no severity. The risk breakdown is therefore about evidence: "critical" lists recommendations that
# could not be assessed (input not collected, role not supplied, Manual one not attested -- unverified is the
# worst outcome for an auditor), "high" lists recommendations assessed and failed.
# ---------------------------------------------------------------------------------------------------------------

_report := data.cis_windows_server_2019.main.compliance_report

default compliant := false

compliant := _report.compliant

_evidence_gaps := [v |
	some v in _report.violations
	_is_gap(v)
]

_is_gap(v) if contains(v, "evidence missing")

_is_gap(v) if contains(v, "requires operator attestation")

_is_gap(v) if contains(v, "not admissible evidence")

_is_gap(v) if startswith(v, "FAIL-CLOSED")

_is_gap(v) if startswith(v, "NOT ASSESSED")

_failures := [v |
	some v in _report.violations
	not _is_gap(v)
]

_legacy_sections := {name: object.union(s, {
	"compliant": (s.failed + s.not_assessed) == 0,
	"violation_count": s.failed + s.not_assessed,
}) |
	some name
	s := section_compliance[name]
}

_sections_compliant := count([name | some name; s := _legacy_sections[name]; s.in_scope > 0; s.compliant])

_sections_in_scope := count([name | some name; s := _legacy_sections[name]; s.in_scope > 0])

overall_status := "compliant" if {
	_report.compliant
} else := "non_compliant" if {
	_report.compliance_percentage >= 80
} else := "critical"

overall_risk_level := "critical" if {
	count(_evidence_gaps) > 0
} else := "high" if {
	count(_failures) > 5
} else := "medium" if {
	count(_failures) > 0
} else := "low"

executive_summary := {
	"overall_compliance": overall_status,
	"compliance_percentage": _report.compliance_percentage,
	"total_violations": count(_report.violations),
	"risk_level": overall_risk_level,
	"critical_issues": count(_evidence_gaps),
	"high_issues": count(_failures),
	"sections_compliant": _sections_compliant,
	"sections_total": _sections_in_scope,
	"total_controls": _report.total_controls,
	"passed_controls": _report.passed_controls,
	"failed_controls": _report.failed_controls,
	"benchmark": _report.benchmark,
	"profile": _report.profile,
}

compliance_assessment := {
	"summary": executive_summary,
	"section_compliance": _legacy_sections,
	"violations": _report.violations,
	"risk_breakdown": {
		"critical": _evidence_gaps,
		"high": _failures,
	},
}
