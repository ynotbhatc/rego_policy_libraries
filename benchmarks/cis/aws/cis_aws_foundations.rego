_ev_6_2 if {
	present("network_acls")
}

_messages contains "6.2: evidence missing — input.network_acls not collected" if {
	_in_scope("6.2")
	not _ev_6_2
}

_messages contains sprintf("6.2: No network ACL opens administration ports to the internet — network ACL %s allows 0.0.0.0/0 to port %d (rules %v)", [nm(x, "NetworkAclId"), port, sort(nacl_exposed(x, port))]) if {
	_in_scope("6.2")
	_ev_6_2
	some x in input.network_acls
	some port in admin_ports
	count(nacl_exposed(x, port)) > 0
}

_messages contains sprintf("6.2: No network ACL opens administration ports to the internet — network ACL %s has an entry without rule number, action, protocol or direction", [nm(x, "NetworkAclId")]) if {
	_in_scope("6.2")
	_ev_6_2
	some x in input.network_acls
	some e in x.Entries
	not nacl_entry_collected(e)
}

_messages contains sprintf("6.2: No network ACL opens administration ports to the internet — network ACL %s: Entries not collected", [nm(x, "NetworkAclId")]) if {
	_in_scope("6.2")
	_ev_6_2
	some x in input.network_acls
	not has_list(x, "Entries")
}

