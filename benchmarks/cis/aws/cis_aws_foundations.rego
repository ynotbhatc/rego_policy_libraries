}

_messages contains sprintf("2.10: Console users have MFA — user %s has a console password and no active MFA device", [nm(x, "user")]) if {
	_in_scope("2.10")
	_ev_2_10
	some x in input.credential_report
	truthy(x.password_enabled)
	not truthy(object.get(x, "mfa_active", null))
}

