_has_id(vs, id) if {
	some v in vs
	startswith(v, concat("", [id, ":"]))
}

test_green_input_is_compliant if {
	vs := b.violations with input as green
	count(vs) == 0
}

test_2_1_1_pass if {
	vs := b.violations with input as green
	not _has_id(vs, "2.1.1")
}

test_2_1_1_fail if {
	inp := json.patch(green, [{"op": "add", "path": "/attest/org_root_access_centralized", "value": false}])
	vs := b.violations with input as inp
	"2.1.1: Organization root access is handled centrally (manual review not attested: set input.attest.org_root_access_centralized to true)" in vs
}

test_2_1_1_not_attested_when_absent if {
	inp := json.patch(green, [{"op": "remove", "path": "/attest/org_root_access_centralized"}])
	vs := b.violations with input as inp
	"2.1.1: Organization root access is handled centrally (manual review not attested: set input.attest.org_root_access_centralized to true)" in vs
}

