test_nacl_deny_before_allow_passes if {
	inp := json.patch(green, [{"op": "remove", "path": "/network_acls/0/Entries/0"}, {"op": "add", "path": "/network_acls/0/Entries/-", "value": {"RuleNumber": 90, "Protocol": "6", "RuleAction": "deny", "Egress": false, "CidrBlock": "0.0.0.0/0", "PortRange": {"From": 22, "To": 22}}}, {"op": "add", "path": "/network_acls/0/Entries/-", "value": {"RuleNumber": 91, "Protocol": "6", "RuleAction": "deny", "Egress": false, "CidrBlock": "0.0.0.0/0", "PortRange": {"From": 3389, "To": 3389}}}, {"op": "add", "path": "/network_acls/0/Entries/-", "value": {"RuleNumber": 92, "Protocol": "17", "RuleAction": "deny", "Egress": false, "CidrBlock": "0.0.0.0/0", "PortRange": {"From": 22, "To": 22}}}, {"op": "add", "path": "/network_acls/0/Entries/-", "value": {"RuleNumber": 93, "Protocol": "17", "RuleAction": "deny", "Egress": false, "CidrBlock": "0.0.0.0/0", "PortRange": {"From": 3389, "To": 3389}}}, {"op": "add", "path": "/network_acls/0/Entries/-", "value": {"RuleNumber": 100, "Protocol": "-1", "RuleAction": "allow", "Egress": false, "CidrBlock": "0.0.0.0/0"}}])
	vs := b.violations with input as inp
	not _has_id(vs, "6.2")
}

