# Edge cases: port ranges and protocols, ordered NACL rules, policy document shapes, dates, empty versus absent lists, none-configured shapes. Generated by tools/cis_generators/gen_aws.py; regenerate, do not edit.

green := data.cis_aws.v7_controls_test.green

_has_id(vs, id) if {
	some v in vs
	startswith(v, concat("", [id, ":"]))
}

test_sg_range_covering_rdp if {
	inp := json.patch(green, [{"op": "add", "path": "/security_groups/0/IpPermissions/-", "value": {"IpProtocol": "tcp", "FromPort": 3380, "ToPort": 3390, "IpRanges": [{"CidrIp": "0.0.0.0/0"}], "Ipv6Ranges": []}}])
	vs := b.violations with input as inp
	_has_id(vs, "6.3")
	not _has_id(vs, "6.4")
}

