}
ok_AUDIT_A_c_1b if {
	v := fact("profile_parameters", "icm/HTTP/logging_0")
	regex.match(`PREFIX=\/`, v)
	regex.match(`LOGFILE=(\/usr\/sap|\/sapmnt|\w:\\usr\\sap)[\/\\](\w{3})[\/\\](\w{3,12})[\/\\](log[\/\\])(http-)(\w{3})-(\w{3,12})(-\%y\%m)`, v)
	regex.match(`MAXSIZEKB=10000`, v)
	regex.match(`SWITCHTF=month`, v)
	regex.match(`LOGFORMAT=\%t \%a \%u - "\%r" \%s \%b \%Lms \%{[Hh]ost}i \%P \%w1 \%w2 \%y1 \%y2`, v)
}
ok_AUDIT_A_c_1b if {
	v := fact("profile_parameters", "icm/HTTP/logging_0")
	regex.match(`PREFIX=\/`, v)
	regex.match(`LOGFILE=http_%y_%m.log`, v)
	regex.match(`MAXFILES=2`, v)
	regex.match(`MAXSIZEKB=50000`, v)
	regex.match(`SWITCHTF=month`, v)
	regex.match(`LOGFORMAT=%t %a %u1 \"%r\" %s %b %Lms %{[Hh]ost}i %w1 %w2`, v)
}

