package nispom.main

import rego.v1

framework := "32 CFR Part 117 — National Industrial Security Program Operating Manual (NISPOM)"

source := {
	"publication": "Code of Federal Regulations, Title 32, Part 117 (annual edition, revised as of July 1, 2025)",
