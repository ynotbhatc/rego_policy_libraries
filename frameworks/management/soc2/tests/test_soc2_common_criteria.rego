_row(r, id) := [x | some x in r.control_results; x.id == id][0]

test_cc1_1_pass if {
	r := main.compliance_report with input as fixture
	_row(r, "CC1.1").status == "pass"
	_row(r, "CC1.1").findings == []
}

test_cc1_1_fail if {
	inp := json.patch(fixture, [{"op": "replace", "path": "/soc2/attestations/CC1.1/attested", "value": false}])
	r := main.compliance_report with input as inp
	_row(r, "CC1.1").status == "fail"
	r.compliant == false
	"CC1.1" in r.failed_criteria
}

test_cc1_1_evidence_missing if {
	inp := json.remove(fixture, ["/soc2/attestations/CC1.1"])
	r := main.compliance_report with input as inp
	_row(r, "CC1.1").status == "not_assessed"
	_row(r, "CC1.1").reason == "attestation_missing"
	r.compliant == false
}

