package pci_dss.network_security.requirement_1_test

import rego.v1

# Roll-up behaviour (validation 2026-10-17). Controls are mocked with `with ... as` so these tests
# pin the aggregation logic independent of the evidence schema. The control under test is left
# unmocked and evaluated against an empty input, i.e. it is genuinely failing.

test_all_controls_pass_is_compliant_and_full_score if {
	data.pci_dss.network_security.requirement_1.pci_requirement_1_compliant with data.pci_dss.network_security.requirement_1.network_security_policies_established as true with data.pci_dss.network_security.requirement_1.network_security_roles_defined as true with data.pci_dss.network_security.requirement_1.network_security_controls_maintained as true with data.pci_dss.network_security.requirement_1.firewall_configuration_standards as true with data.pci_dss.network_security.requirement_1.firewall_rules_documented as true with data.pci_dss.network_security.requirement_1.network_connections_controlled as true with data.pci_dss.network_security.requirement_1.inbound_traffic_restricted as true with data.pci_dss.network_security.requirement_1.outbound_traffic_restricted as true with data.pci_dss.network_security.requirement_1.direct_internet_access_prohibited as true with data.pci_dss.network_security.requirement_1.network_segmentation_implemented as true with data.pci_dss.network_security.requirement_1.dmz_properly_configured as true with data.pci_dss.network_security.requirement_1.nat_implemented as true with data.pci_dss.network_security.requirement_1.multi_tenant_isolation as true with data.pci_dss.network_security.requirement_1.openshift_network_policies_cde as true with data.pci_dss.network_security.requirement_1.service_mesh_pci_security as true with data.pci_dss.network_security.requirement_1.container_network_isolation as true with data.pci_dss.network_security.requirement_1.openshift_sdn_security as true with data.pci_dss.network_security.requirement_1.cloud_security_groups_configured as true with data.pci_dss.network_security.requirement_1.vpc_configuration_secure as true with data.pci_dss.network_security.requirement_1.cloud_waf_implemented as true with data.pci_dss.network_security.requirement_1.network_traffic_monitoring as true with data.pci_dss.network_security.requirement_1.network_access_logging as true with data.pci_dss.network_security.requirement_1.network_security_correlation as true
	data.pci_dss.network_security.requirement_1.pci_requirement_1_score == 100 with data.pci_dss.network_security.requirement_1.network_security_policies_established as true with data.pci_dss.network_security.requirement_1.network_security_roles_defined as true with data.pci_dss.network_security.requirement_1.network_security_controls_maintained as true with data.pci_dss.network_security.requirement_1.firewall_configuration_standards as true with data.pci_dss.network_security.requirement_1.firewall_rules_documented as true with data.pci_dss.network_security.requirement_1.network_connections_controlled as true with data.pci_dss.network_security.requirement_1.inbound_traffic_restricted as true with data.pci_dss.network_security.requirement_1.outbound_traffic_restricted as true with data.pci_dss.network_security.requirement_1.direct_internet_access_prohibited as true with data.pci_dss.network_security.requirement_1.network_segmentation_implemented as true with data.pci_dss.network_security.requirement_1.dmz_properly_configured as true with data.pci_dss.network_security.requirement_1.nat_implemented as true with data.pci_dss.network_security.requirement_1.multi_tenant_isolation as true with data.pci_dss.network_security.requirement_1.openshift_network_policies_cde as true with data.pci_dss.network_security.requirement_1.service_mesh_pci_security as true with data.pci_dss.network_security.requirement_1.container_network_isolation as true with data.pci_dss.network_security.requirement_1.openshift_sdn_security as true with data.pci_dss.network_security.requirement_1.cloud_security_groups_configured as true with data.pci_dss.network_security.requirement_1.vpc_configuration_secure as true with data.pci_dss.network_security.requirement_1.cloud_waf_implemented as true with data.pci_dss.network_security.requirement_1.network_traffic_monitoring as true with data.pci_dss.network_security.requirement_1.network_access_logging as true with data.pci_dss.network_security.requirement_1.network_security_correlation as true
}

test_one_failing_control_gives_partial_score_and_populated_findings if {
	score := data.pci_dss.network_security.requirement_1.pci_requirement_1_score with data.pci_dss.network_security.requirement_1.network_security_policies_established as true with data.pci_dss.network_security.requirement_1.network_security_roles_defined as true with data.pci_dss.network_security.requirement_1.network_security_controls_maintained as true with data.pci_dss.network_security.requirement_1.firewall_configuration_standards as true with data.pci_dss.network_security.requirement_1.firewall_rules_documented as true with data.pci_dss.network_security.requirement_1.network_connections_controlled as true with data.pci_dss.network_security.requirement_1.inbound_traffic_restricted as true with data.pci_dss.network_security.requirement_1.outbound_traffic_restricted as true with data.pci_dss.network_security.requirement_1.direct_internet_access_prohibited as true with data.pci_dss.network_security.requirement_1.network_segmentation_implemented as true with data.pci_dss.network_security.requirement_1.dmz_properly_configured as true with data.pci_dss.network_security.requirement_1.multi_tenant_isolation as true with data.pci_dss.network_security.requirement_1.openshift_network_policies_cde as true with data.pci_dss.network_security.requirement_1.service_mesh_pci_security as true with data.pci_dss.network_security.requirement_1.container_network_isolation as true with data.pci_dss.network_security.requirement_1.openshift_sdn_security as true with data.pci_dss.network_security.requirement_1.cloud_security_groups_configured as true with data.pci_dss.network_security.requirement_1.vpc_configuration_secure as true with data.pci_dss.network_security.requirement_1.cloud_waf_implemented as true with data.pci_dss.network_security.requirement_1.network_traffic_monitoring as true with data.pci_dss.network_security.requirement_1.network_access_logging as true with data.pci_dss.network_security.requirement_1.network_security_correlation as true
	score > 0
	score < 100
	f := data.pci_dss.network_security.requirement_1.pci_requirement_1_findings with data.pci_dss.network_security.requirement_1.network_security_policies_established as true with data.pci_dss.network_security.requirement_1.network_security_roles_defined as true with data.pci_dss.network_security.requirement_1.network_security_controls_maintained as true with data.pci_dss.network_security.requirement_1.firewall_configuration_standards as true with data.pci_dss.network_security.requirement_1.firewall_rules_documented as true with data.pci_dss.network_security.requirement_1.network_connections_controlled as true with data.pci_dss.network_security.requirement_1.inbound_traffic_restricted as true with data.pci_dss.network_security.requirement_1.outbound_traffic_restricted as true with data.pci_dss.network_security.requirement_1.direct_internet_access_prohibited as true with data.pci_dss.network_security.requirement_1.network_segmentation_implemented as true with data.pci_dss.network_security.requirement_1.dmz_properly_configured as true with data.pci_dss.network_security.requirement_1.multi_tenant_isolation as true with data.pci_dss.network_security.requirement_1.openshift_network_policies_cde as true with data.pci_dss.network_security.requirement_1.service_mesh_pci_security as true with data.pci_dss.network_security.requirement_1.container_network_isolation as true with data.pci_dss.network_security.requirement_1.openshift_sdn_security as true with data.pci_dss.network_security.requirement_1.cloud_security_groups_configured as true with data.pci_dss.network_security.requirement_1.vpc_configuration_secure as true with data.pci_dss.network_security.requirement_1.cloud_waf_implemented as true with data.pci_dss.network_security.requirement_1.network_traffic_monitoring as true with data.pci_dss.network_security.requirement_1.network_access_logging as true with data.pci_dss.network_security.requirement_1.network_security_correlation as true
	count(f) > 0
	not data.pci_dss.network_security.requirement_1.pci_requirement_1_compliant with data.pci_dss.network_security.requirement_1.network_security_policies_established as true with data.pci_dss.network_security.requirement_1.network_security_roles_defined as true with data.pci_dss.network_security.requirement_1.network_security_controls_maintained as true with data.pci_dss.network_security.requirement_1.firewall_configuration_standards as true with data.pci_dss.network_security.requirement_1.firewall_rules_documented as true with data.pci_dss.network_security.requirement_1.network_connections_controlled as true with data.pci_dss.network_security.requirement_1.inbound_traffic_restricted as true with data.pci_dss.network_security.requirement_1.outbound_traffic_restricted as true with data.pci_dss.network_security.requirement_1.direct_internet_access_prohibited as true with data.pci_dss.network_security.requirement_1.network_segmentation_implemented as true with data.pci_dss.network_security.requirement_1.dmz_properly_configured as true with data.pci_dss.network_security.requirement_1.multi_tenant_isolation as true with data.pci_dss.network_security.requirement_1.openshift_network_policies_cde as true with data.pci_dss.network_security.requirement_1.service_mesh_pci_security as true with data.pci_dss.network_security.requirement_1.container_network_isolation as true with data.pci_dss.network_security.requirement_1.openshift_sdn_security as true with data.pci_dss.network_security.requirement_1.cloud_security_groups_configured as true with data.pci_dss.network_security.requirement_1.vpc_configuration_secure as true with data.pci_dss.network_security.requirement_1.cloud_waf_implemented as true with data.pci_dss.network_security.requirement_1.network_traffic_monitoring as true with data.pci_dss.network_security.requirement_1.network_access_logging as true with data.pci_dss.network_security.requirement_1.network_security_correlation as true
}

test_multi_tenant_applicable_with_isolation_evidence_passes if {
	data.pci_dss.network_security.requirement_1.multi_tenant_isolation with input as {"pci": {"multi_tenant": {"applicable": true, "each_entity_isolated": true, "cannot_access_others": true, "documented": true}}}
}

test_multi_tenant_applicable_without_isolation_fails if {
	not data.pci_dss.network_security.requirement_1.multi_tenant_isolation with input as {"pci": {"multi_tenant": {"applicable": true, "each_entity_isolated": false, "cannot_access_others": true, "documented": true}}}
}

test_multi_tenant_not_applicable_passes_and_missing_flag_fails if {
	data.pci_dss.network_security.requirement_1.multi_tenant_isolation with input as {"pci": {"multi_tenant": {"applicable": false}}}
	not data.pci_dss.network_security.requirement_1.multi_tenant_isolation with input as {}
}
