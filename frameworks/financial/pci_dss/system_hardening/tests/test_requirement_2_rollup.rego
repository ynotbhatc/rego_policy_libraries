test_wireless_security_configured_missing_scope_flag_does_not_pass if {
	not data.pci_dss.system_hardening.requirement_2.wireless_security_configured with input as {}
}

test_wireless_security_configured_explicit_not_in_scope_passes if {
	data.pci_dss.system_hardening.requirement_2.wireless_security_configured with input as {"pci": {"wireless": {"in_scope_for_cde": false}}}
}
