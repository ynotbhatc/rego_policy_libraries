package pci_dss.system_hardening.requirement_2_test

import rego.v1

# Roll-up behaviour (validation 2026-10-17). Controls are mocked with `with ... as` so these tests
# pin the aggregation logic independent of the evidence schema. The control under test is left
# unmocked and evaluated against an empty input, i.e. it is genuinely failing.

test_all_controls_pass_is_compliant_and_full_score if {
	data.pci_dss.system_hardening.requirement_2.pci_requirement_2_compliant with data.pci_dss.system_hardening.requirement_2.system_hardening_policies_established as true with data.pci_dss.system_hardening.requirement_2.system_hardening_roles_defined as true with data.pci_dss.system_hardening.requirement_2.configuration_standards_maintained as true with data.pci_dss.system_hardening.requirement_2.default_passwords_changed as true with data.pci_dss.system_hardening.requirement_2.unnecessary_functionality_removed as true with data.pci_dss.system_hardening.requirement_2.single_primary_function_enforced as true with data.pci_dss.system_hardening.requirement_2.known_vulnerabilities_mitigated as true with data.pci_dss.system_hardening.requirement_2.hardening_standards_applied as true with data.pci_dss.system_hardening.requirement_2.os_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.database_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.network_device_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.non_console_admin_access_encrypted as true with data.pci_dss.system_hardening.requirement_2.wireless_security_configured as true
	data.pci_dss.system_hardening.requirement_2.pci_requirement_2_score == 100 with data.pci_dss.system_hardening.requirement_2.system_hardening_policies_established as true with data.pci_dss.system_hardening.requirement_2.system_hardening_roles_defined as true with data.pci_dss.system_hardening.requirement_2.configuration_standards_maintained as true with data.pci_dss.system_hardening.requirement_2.default_passwords_changed as true with data.pci_dss.system_hardening.requirement_2.unnecessary_functionality_removed as true with data.pci_dss.system_hardening.requirement_2.single_primary_function_enforced as true with data.pci_dss.system_hardening.requirement_2.known_vulnerabilities_mitigated as true with data.pci_dss.system_hardening.requirement_2.hardening_standards_applied as true with data.pci_dss.system_hardening.requirement_2.os_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.database_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.network_device_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.non_console_admin_access_encrypted as true with data.pci_dss.system_hardening.requirement_2.wireless_security_configured as true
}

test_one_failing_control_gives_partial_score_and_populated_findings if {
	score := data.pci_dss.system_hardening.requirement_2.pci_requirement_2_score with data.pci_dss.system_hardening.requirement_2.system_hardening_policies_established as true with data.pci_dss.system_hardening.requirement_2.system_hardening_roles_defined as true with data.pci_dss.system_hardening.requirement_2.configuration_standards_maintained as true with data.pci_dss.system_hardening.requirement_2.default_passwords_changed as true with data.pci_dss.system_hardening.requirement_2.unnecessary_functionality_removed as true with data.pci_dss.system_hardening.requirement_2.single_primary_function_enforced as true with data.pci_dss.system_hardening.requirement_2.hardening_standards_applied as true with data.pci_dss.system_hardening.requirement_2.os_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.database_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.network_device_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.non_console_admin_access_encrypted as true with data.pci_dss.system_hardening.requirement_2.wireless_security_configured as true
	score > 0
	score < 100
	f := data.pci_dss.system_hardening.requirement_2.pci_requirement_2_findings with data.pci_dss.system_hardening.requirement_2.system_hardening_policies_established as true with data.pci_dss.system_hardening.requirement_2.system_hardening_roles_defined as true with data.pci_dss.system_hardening.requirement_2.configuration_standards_maintained as true with data.pci_dss.system_hardening.requirement_2.default_passwords_changed as true with data.pci_dss.system_hardening.requirement_2.unnecessary_functionality_removed as true with data.pci_dss.system_hardening.requirement_2.single_primary_function_enforced as true with data.pci_dss.system_hardening.requirement_2.hardening_standards_applied as true with data.pci_dss.system_hardening.requirement_2.os_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.database_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.network_device_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.non_console_admin_access_encrypted as true with data.pci_dss.system_hardening.requirement_2.wireless_security_configured as true
	count(f) > 0
	not data.pci_dss.system_hardening.requirement_2.pci_requirement_2_compliant with data.pci_dss.system_hardening.requirement_2.system_hardening_policies_established as true with data.pci_dss.system_hardening.requirement_2.system_hardening_roles_defined as true with data.pci_dss.system_hardening.requirement_2.configuration_standards_maintained as true with data.pci_dss.system_hardening.requirement_2.default_passwords_changed as true with data.pci_dss.system_hardening.requirement_2.unnecessary_functionality_removed as true with data.pci_dss.system_hardening.requirement_2.single_primary_function_enforced as true with data.pci_dss.system_hardening.requirement_2.hardening_standards_applied as true with data.pci_dss.system_hardening.requirement_2.os_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.database_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.network_device_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.non_console_admin_access_encrypted as true with data.pci_dss.system_hardening.requirement_2.wireless_security_configured as true
}

