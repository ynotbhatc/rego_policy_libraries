	not data.pci_dss.system_hardening.requirement_2.pci_requirement_2_compliant with data.pci_dss.system_hardening.requirement_2.system_hardening_policies_established as true with data.pci_dss.system_hardening.requirement_2.system_hardening_roles_defined as true with data.pci_dss.system_hardening.requirement_2.configuration_standards_maintained as true with data.pci_dss.system_hardening.requirement_2.default_passwords_changed as true with data.pci_dss.system_hardening.requirement_2.unnecessary_functionality_removed as true with data.pci_dss.system_hardening.requirement_2.single_primary_function_enforced as true with data.pci_dss.system_hardening.requirement_2.known_vulnerabilities_mitigated as true with data.pci_dss.system_hardening.requirement_2.hardening_standards_applied as true with data.pci_dss.system_hardening.requirement_2.os_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.database_hardening_complete as true with data.pci_dss.system_hardening.requirement_2.non_console_admin_access_encrypted as true with data.pci_dss.system_hardening.requirement_2.wireless_security_configured as true
