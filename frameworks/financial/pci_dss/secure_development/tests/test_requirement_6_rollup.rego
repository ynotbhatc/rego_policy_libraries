	data.pci_dss.secure_development.requirement_6.pci_requirement_6_compliant with data.pci_dss.secure_development.requirement_6.secure_development_policies_established as true with data.pci_dss.secure_development.requirement_6.secure_development_roles_defined as true with data.pci_dss.secure_development.requirement_6.secure_sdlc_implemented as true with data.pci_dss.secure_development.requirement_6.developer_security_training as true with data.pci_dss.secure_development.requirement_6.preproduction_security_testing as true with data.pci_dss.secure_development.requirement_6.bespoke_code_review as true with data.pci_dss.secure_development.requirement_6.injection_attacks_prevented as true with data.pci_dss.secure_development.requirement_6.xss_attacks_prevented as true with data.pci_dss.secure_development.requirement_6.authentication_attacks_prevented as true with data.pci_dss.secure_development.requirement_6.memory_corruption_prevented as true with data.pci_dss.secure_development.requirement_6.insecure_cryptography_prevented as true with data.pci_dss.secure_development.requirement_6.security_patch_management as true with data.pci_dss.secure_development.requirement_6.vulnerability_identification as true with data.pci_dss.secure_development.requirement_6.software_inventory_maintained as true with data.pci_dss.secure_development.requirement_6.waf_implemented as true with data.pci_dss.secure_development.requirement_6.web_app_pen_testing as true with data.pci_dss.secure_development.requirement_6.sast_dast_implemented as true with data.pci_dss.secure_development.requirement_6.software_composition_analysis as true
