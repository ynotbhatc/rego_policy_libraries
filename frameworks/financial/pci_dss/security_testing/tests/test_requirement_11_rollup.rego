package pci_dss.security_testing.requirement_11_test

import rego.v1

# Roll-up behaviour (validation 2026-10-17). Controls are mocked with `with ... as` so these tests
# pin the aggregation logic independent of the evidence schema. The control under test is left
# unmocked and evaluated against an empty input, i.e. it is genuinely failing.

test_all_controls_pass_is_compliant_and_full_score if {
	data.pci_dss.security_testing.requirement_11.pci_requirement_11_compliant with data.pci_dss.security_testing.requirement_11.security_testing_policies_established as true with data.pci_dss.security_testing.requirement_11.security_testing_roles_defined as true with data.pci_dss.security_testing.requirement_11.wireless_access_point_testing as true with data.pci_dss.security_testing.requirement_11.internal_vulnerability_scanning as true with data.pci_dss.security_testing.requirement_11.external_vulnerability_scanning as true with data.pci_dss.security_testing.requirement_11.vulnerability_remediation as true with data.pci_dss.security_testing.requirement_11.penetration_testing as true with data.pci_dss.security_testing.requirement_11.pen_test_remediation as true with data.pci_dss.security_testing.requirement_11.segmentation_testing as true with data.pci_dss.security_testing.requirement_11.ids_ips_deployed as true with data.pci_dss.security_testing.requirement_11.file_integrity_monitoring as true with data.pci_dss.security_testing.requirement_11.payment_page_integrity as true
	data.pci_dss.security_testing.requirement_11.pci_requirement_11_score == 100 with data.pci_dss.security_testing.requirement_11.security_testing_policies_established as true with data.pci_dss.security_testing.requirement_11.security_testing_roles_defined as true with data.pci_dss.security_testing.requirement_11.wireless_access_point_testing as true with data.pci_dss.security_testing.requirement_11.internal_vulnerability_scanning as true with data.pci_dss.security_testing.requirement_11.external_vulnerability_scanning as true with data.pci_dss.security_testing.requirement_11.vulnerability_remediation as true with data.pci_dss.security_testing.requirement_11.penetration_testing as true with data.pci_dss.security_testing.requirement_11.pen_test_remediation as true with data.pci_dss.security_testing.requirement_11.segmentation_testing as true with data.pci_dss.security_testing.requirement_11.ids_ips_deployed as true with data.pci_dss.security_testing.requirement_11.file_integrity_monitoring as true with data.pci_dss.security_testing.requirement_11.payment_page_integrity as true
}

test_one_failing_control_gives_partial_score_and_populated_findings if {
	score := data.pci_dss.security_testing.requirement_11.pci_requirement_11_score with data.pci_dss.security_testing.requirement_11.security_testing_policies_established as true with data.pci_dss.security_testing.requirement_11.security_testing_roles_defined as true with data.pci_dss.security_testing.requirement_11.wireless_access_point_testing as true with data.pci_dss.security_testing.requirement_11.internal_vulnerability_scanning as true with data.pci_dss.security_testing.requirement_11.external_vulnerability_scanning as true with data.pci_dss.security_testing.requirement_11.vulnerability_remediation as true with data.pci_dss.security_testing.requirement_11.pen_test_remediation as true with data.pci_dss.security_testing.requirement_11.segmentation_testing as true with data.pci_dss.security_testing.requirement_11.ids_ips_deployed as true with data.pci_dss.security_testing.requirement_11.file_integrity_monitoring as true with data.pci_dss.security_testing.requirement_11.payment_page_integrity as true
	score > 0
	score < 100
	f := data.pci_dss.security_testing.requirement_11.pci_requirement_11_findings with data.pci_dss.security_testing.requirement_11.security_testing_policies_established as true with data.pci_dss.security_testing.requirement_11.security_testing_roles_defined as true with data.pci_dss.security_testing.requirement_11.wireless_access_point_testing as true with data.pci_dss.security_testing.requirement_11.internal_vulnerability_scanning as true with data.pci_dss.security_testing.requirement_11.external_vulnerability_scanning as true with data.pci_dss.security_testing.requirement_11.vulnerability_remediation as true with data.pci_dss.security_testing.requirement_11.pen_test_remediation as true with data.pci_dss.security_testing.requirement_11.segmentation_testing as true with data.pci_dss.security_testing.requirement_11.ids_ips_deployed as true with data.pci_dss.security_testing.requirement_11.file_integrity_monitoring as true with data.pci_dss.security_testing.requirement_11.payment_page_integrity as true
	count(f) > 0
	not data.pci_dss.security_testing.requirement_11.pci_requirement_11_compliant with data.pci_dss.security_testing.requirement_11.security_testing_policies_established as true with data.pci_dss.security_testing.requirement_11.security_testing_roles_defined as true with data.pci_dss.security_testing.requirement_11.wireless_access_point_testing as true with data.pci_dss.security_testing.requirement_11.internal_vulnerability_scanning as true with data.pci_dss.security_testing.requirement_11.external_vulnerability_scanning as true with data.pci_dss.security_testing.requirement_11.vulnerability_remediation as true with data.pci_dss.security_testing.requirement_11.pen_test_remediation as true with data.pci_dss.security_testing.requirement_11.segmentation_testing as true with data.pci_dss.security_testing.requirement_11.ids_ips_deployed as true with data.pci_dss.security_testing.requirement_11.file_integrity_monitoring as true with data.pci_dss.security_testing.requirement_11.payment_page_integrity as true
}

test_payment_page_integrity_missing_scope_flag_does_not_pass if {
	not data.pci_dss.security_testing.requirement_11.payment_page_integrity with input as {}
}

test_payment_page_integrity_explicit_not_in_scope_passes if {
	data.pci_dss.security_testing.requirement_11.payment_page_integrity with input as {"pci": {"ecommerce": {"payment_pages": {"in_scope": false}}}}
}
