package pci_dss.access_control.requirement_7_test

import rego.v1

# Roll-up behaviour (validation 2026-10-17). Controls are mocked with `with ... as` so these tests
# pin the aggregation logic independent of the evidence schema. The control under test is left
# unmocked and evaluated against an empty input, i.e. it is genuinely failing.

test_all_controls_pass_is_compliant_and_full_score if {
	data.pci_dss.access_control.requirement_7.pci_requirement_7_compliant with data.pci_dss.access_control.requirement_7.access_control_policies_established as true with data.pci_dss.access_control.requirement_7.access_control_roles_defined as true with data.pci_dss.access_control.requirement_7.least_privilege_access_model as true with data.pci_dss.access_control.requirement_7.rbac_implemented as true with data.pci_dss.access_control.requirement_7.job_function_based_access as true with data.pci_dss.access_control.requirement_7.privileged_access_managed as true with data.pci_dss.access_control.requirement_7.third_party_access_managed as true with data.pci_dss.access_control.requirement_7.user_access_reviews as true with data.pci_dss.access_control.requirement_7.application_system_accounts_managed as true with data.pci_dss.access_control.requirement_7.access_control_system as true
	data.pci_dss.access_control.requirement_7.pci_requirement_7_score == 100 with data.pci_dss.access_control.requirement_7.access_control_policies_established as true with data.pci_dss.access_control.requirement_7.access_control_roles_defined as true with data.pci_dss.access_control.requirement_7.least_privilege_access_model as true with data.pci_dss.access_control.requirement_7.rbac_implemented as true with data.pci_dss.access_control.requirement_7.job_function_based_access as true with data.pci_dss.access_control.requirement_7.privileged_access_managed as true with data.pci_dss.access_control.requirement_7.third_party_access_managed as true with data.pci_dss.access_control.requirement_7.user_access_reviews as true with data.pci_dss.access_control.requirement_7.application_system_accounts_managed as true with data.pci_dss.access_control.requirement_7.access_control_system as true
}

test_one_failing_control_gives_partial_score_and_populated_findings if {
	score := data.pci_dss.access_control.requirement_7.pci_requirement_7_score with data.pci_dss.access_control.requirement_7.access_control_policies_established as true with data.pci_dss.access_control.requirement_7.access_control_roles_defined as true with data.pci_dss.access_control.requirement_7.least_privilege_access_model as true with data.pci_dss.access_control.requirement_7.rbac_implemented as true with data.pci_dss.access_control.requirement_7.job_function_based_access as true with data.pci_dss.access_control.requirement_7.third_party_access_managed as true with data.pci_dss.access_control.requirement_7.user_access_reviews as true with data.pci_dss.access_control.requirement_7.application_system_accounts_managed as true with data.pci_dss.access_control.requirement_7.access_control_system as true
	score > 0
	score < 100
	f := data.pci_dss.access_control.requirement_7.pci_requirement_7_findings with data.pci_dss.access_control.requirement_7.access_control_policies_established as true with data.pci_dss.access_control.requirement_7.access_control_roles_defined as true with data.pci_dss.access_control.requirement_7.least_privilege_access_model as true with data.pci_dss.access_control.requirement_7.rbac_implemented as true with data.pci_dss.access_control.requirement_7.job_function_based_access as true with data.pci_dss.access_control.requirement_7.third_party_access_managed as true with data.pci_dss.access_control.requirement_7.user_access_reviews as true with data.pci_dss.access_control.requirement_7.application_system_accounts_managed as true with data.pci_dss.access_control.requirement_7.access_control_system as true
	count(f) > 0
	not data.pci_dss.access_control.requirement_7.pci_requirement_7_compliant with data.pci_dss.access_control.requirement_7.access_control_policies_established as true with data.pci_dss.access_control.requirement_7.access_control_roles_defined as true with data.pci_dss.access_control.requirement_7.least_privilege_access_model as true with data.pci_dss.access_control.requirement_7.rbac_implemented as true with data.pci_dss.access_control.requirement_7.job_function_based_access as true with data.pci_dss.access_control.requirement_7.third_party_access_managed as true with data.pci_dss.access_control.requirement_7.user_access_reviews as true with data.pci_dss.access_control.requirement_7.application_system_accounts_managed as true with data.pci_dss.access_control.requirement_7.access_control_system as true
}
