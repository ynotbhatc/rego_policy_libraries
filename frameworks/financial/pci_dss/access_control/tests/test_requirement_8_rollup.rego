package pci_dss.access_control.requirement_8_test

import rego.v1

# Roll-up behaviour (validation 2026-10-17). Controls are mocked with `with ... as` so these tests
# pin the aggregation logic independent of the evidence schema. The control under test is left
# unmocked and evaluated against an empty input, i.e. it is genuinely failing.

test_all_controls_pass_is_compliant_and_full_score if {
	data.pci_dss.access_control.requirement_8.pci_requirement_8_compliant with data.pci_dss.access_control.requirement_8.authentication_policies_established as true with data.pci_dss.access_control.requirement_8.authentication_roles_defined as true with data.pci_dss.access_control.requirement_8.unique_user_ids as true with data.pci_dss.access_control.requirement_8.account_lifecycle_managed as true with data.pci_dss.access_control.requirement_8.vendor_accounts_managed as true with data.pci_dss.access_control.requirement_8.password_requirements as true with data.pci_dss.access_control.requirement_8.first_use_password_change as true with data.pci_dss.access_control.requirement_8.authentication_factors_protected as true with data.pci_dss.access_control.requirement_8.mfa_for_cde_admin as true with data.pci_dss.access_control.requirement_8.mfa_for_remote_access as true with data.pci_dss.access_control.requirement_8.mfa_for_all_cde_access as true with data.pci_dss.access_control.requirement_8.mfa_system_secure as true with data.pci_dss.access_control.requirement_8.mfa_not_susceptible_to_replay as true with data.pci_dss.access_control.requirement_8.system_application_accounts as true
	data.pci_dss.access_control.requirement_8.pci_requirement_8_score == 100 with data.pci_dss.access_control.requirement_8.authentication_policies_established as true with data.pci_dss.access_control.requirement_8.authentication_roles_defined as true with data.pci_dss.access_control.requirement_8.unique_user_ids as true with data.pci_dss.access_control.requirement_8.account_lifecycle_managed as true with data.pci_dss.access_control.requirement_8.vendor_accounts_managed as true with data.pci_dss.access_control.requirement_8.password_requirements as true with data.pci_dss.access_control.requirement_8.first_use_password_change as true with data.pci_dss.access_control.requirement_8.authentication_factors_protected as true with data.pci_dss.access_control.requirement_8.mfa_for_cde_admin as true with data.pci_dss.access_control.requirement_8.mfa_for_remote_access as true with data.pci_dss.access_control.requirement_8.mfa_for_all_cde_access as true with data.pci_dss.access_control.requirement_8.mfa_system_secure as true with data.pci_dss.access_control.requirement_8.mfa_not_susceptible_to_replay as true with data.pci_dss.access_control.requirement_8.system_application_accounts as true
}

test_one_failing_control_gives_partial_score_and_populated_findings if {
	score := data.pci_dss.access_control.requirement_8.pci_requirement_8_score with data.pci_dss.access_control.requirement_8.authentication_policies_established as true with data.pci_dss.access_control.requirement_8.authentication_roles_defined as true with data.pci_dss.access_control.requirement_8.unique_user_ids as true with data.pci_dss.access_control.requirement_8.account_lifecycle_managed as true with data.pci_dss.access_control.requirement_8.vendor_accounts_managed as true with data.pci_dss.access_control.requirement_8.password_requirements as true with data.pci_dss.access_control.requirement_8.first_use_password_change as true with data.pci_dss.access_control.requirement_8.mfa_for_cde_admin as true with data.pci_dss.access_control.requirement_8.mfa_for_remote_access as true with data.pci_dss.access_control.requirement_8.mfa_for_all_cde_access as true with data.pci_dss.access_control.requirement_8.mfa_system_secure as true with data.pci_dss.access_control.requirement_8.mfa_not_susceptible_to_replay as true with data.pci_dss.access_control.requirement_8.system_application_accounts as true
	score > 0
	score < 100
	f := data.pci_dss.access_control.requirement_8.pci_requirement_8_findings with data.pci_dss.access_control.requirement_8.authentication_policies_established as true with data.pci_dss.access_control.requirement_8.authentication_roles_defined as true with data.pci_dss.access_control.requirement_8.unique_user_ids as true with data.pci_dss.access_control.requirement_8.account_lifecycle_managed as true with data.pci_dss.access_control.requirement_8.vendor_accounts_managed as true with data.pci_dss.access_control.requirement_8.password_requirements as true with data.pci_dss.access_control.requirement_8.first_use_password_change as true with data.pci_dss.access_control.requirement_8.mfa_for_cde_admin as true with data.pci_dss.access_control.requirement_8.mfa_for_remote_access as true with data.pci_dss.access_control.requirement_8.mfa_for_all_cde_access as true with data.pci_dss.access_control.requirement_8.mfa_system_secure as true with data.pci_dss.access_control.requirement_8.mfa_not_susceptible_to_replay as true with data.pci_dss.access_control.requirement_8.system_application_accounts as true
	count(f) > 0
	not data.pci_dss.access_control.requirement_8.pci_requirement_8_compliant with data.pci_dss.access_control.requirement_8.authentication_policies_established as true with data.pci_dss.access_control.requirement_8.authentication_roles_defined as true with data.pci_dss.access_control.requirement_8.unique_user_ids as true with data.pci_dss.access_control.requirement_8.account_lifecycle_managed as true with data.pci_dss.access_control.requirement_8.vendor_accounts_managed as true with data.pci_dss.access_control.requirement_8.password_requirements as true with data.pci_dss.access_control.requirement_8.first_use_password_change as true with data.pci_dss.access_control.requirement_8.mfa_for_cde_admin as true with data.pci_dss.access_control.requirement_8.mfa_for_remote_access as true with data.pci_dss.access_control.requirement_8.mfa_for_all_cde_access as true with data.pci_dss.access_control.requirement_8.mfa_system_secure as true with data.pci_dss.access_control.requirement_8.mfa_not_susceptible_to_replay as true with data.pci_dss.access_control.requirement_8.system_application_accounts as true
}

test_failing_mfa_not_susceptible_to_replay_blocks_compliance if {
	not data.pci_dss.access_control.requirement_8.pci_requirement_8_compliant with data.pci_dss.access_control.requirement_8.authentication_policies_established as true with data.pci_dss.access_control.requirement_8.authentication_roles_defined as true with data.pci_dss.access_control.requirement_8.unique_user_ids as true with data.pci_dss.access_control.requirement_8.account_lifecycle_managed as true with data.pci_dss.access_control.requirement_8.vendor_accounts_managed as true with data.pci_dss.access_control.requirement_8.password_requirements as true with data.pci_dss.access_control.requirement_8.first_use_password_change as true with data.pci_dss.access_control.requirement_8.authentication_factors_protected as true with data.pci_dss.access_control.requirement_8.mfa_for_cde_admin as true with data.pci_dss.access_control.requirement_8.mfa_for_remote_access as true with data.pci_dss.access_control.requirement_8.mfa_for_all_cde_access as true with data.pci_dss.access_control.requirement_8.mfa_system_secure as true with data.pci_dss.access_control.requirement_8.system_application_accounts as true
}
