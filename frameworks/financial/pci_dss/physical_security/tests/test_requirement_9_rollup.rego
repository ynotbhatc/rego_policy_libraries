package pci_dss.physical_security.requirement_9_test

import rego.v1

# Roll-up behaviour (validation 2026-10-17). Controls are mocked with `with ... as` so these tests
# pin the aggregation logic independent of the evidence schema. The control under test is left
# unmocked and evaluated against an empty input, i.e. it is genuinely failing.

test_all_controls_pass_is_compliant_and_full_score if {
	data.pci_dss.physical_security.requirement_9.pci_requirement_9_compliant with data.pci_dss.physical_security.requirement_9.physical_security_policies_established as true with data.pci_dss.physical_security.requirement_9.physical_security_roles_defined as true with data.pci_dss.physical_security.requirement_9.physical_access_controls as true with data.pci_dss.physical_security.requirement_9.badge_system as true with data.pci_dss.physical_security.requirement_9.public_network_jacks_disabled as true with data.pci_dss.physical_security.requirement_9.physical_access_authorization as true with data.pci_dss.physical_security.requirement_9.visitor_management as true with data.pci_dss.physical_security.requirement_9.physical_media_controls as true with data.pci_dss.physical_security.requirement_9.media_distribution_secured as true with data.pci_dss.physical_security.requirement_9.media_destruction as true with data.pci_dss.physical_security.requirement_9.disk_destruction as true with data.pci_dss.physical_security.requirement_9.poi_device_protection as true
	data.pci_dss.physical_security.requirement_9.pci_requirement_9_score == 100 with data.pci_dss.physical_security.requirement_9.physical_security_policies_established as true with data.pci_dss.physical_security.requirement_9.physical_security_roles_defined as true with data.pci_dss.physical_security.requirement_9.physical_access_controls as true with data.pci_dss.physical_security.requirement_9.badge_system as true with data.pci_dss.physical_security.requirement_9.public_network_jacks_disabled as true with data.pci_dss.physical_security.requirement_9.physical_access_authorization as true with data.pci_dss.physical_security.requirement_9.visitor_management as true with data.pci_dss.physical_security.requirement_9.physical_media_controls as true with data.pci_dss.physical_security.requirement_9.media_distribution_secured as true with data.pci_dss.physical_security.requirement_9.media_destruction as true with data.pci_dss.physical_security.requirement_9.disk_destruction as true with data.pci_dss.physical_security.requirement_9.poi_device_protection as true
}

test_one_failing_control_gives_partial_score_and_populated_findings if {
	score := data.pci_dss.physical_security.requirement_9.pci_requirement_9_score with data.pci_dss.physical_security.requirement_9.physical_security_policies_established as true with data.pci_dss.physical_security.requirement_9.physical_security_roles_defined as true with data.pci_dss.physical_security.requirement_9.physical_access_controls as true with data.pci_dss.physical_security.requirement_9.badge_system as true with data.pci_dss.physical_security.requirement_9.public_network_jacks_disabled as true with data.pci_dss.physical_security.requirement_9.physical_access_authorization as true with data.pci_dss.physical_security.requirement_9.physical_media_controls as true with data.pci_dss.physical_security.requirement_9.media_distribution_secured as true with data.pci_dss.physical_security.requirement_9.media_destruction as true with data.pci_dss.physical_security.requirement_9.disk_destruction as true with data.pci_dss.physical_security.requirement_9.poi_device_protection as true
	score > 0
	score < 100
	f := data.pci_dss.physical_security.requirement_9.pci_requirement_9_findings with data.pci_dss.physical_security.requirement_9.physical_security_policies_established as true with data.pci_dss.physical_security.requirement_9.physical_security_roles_defined as true with data.pci_dss.physical_security.requirement_9.physical_access_controls as true with data.pci_dss.physical_security.requirement_9.badge_system as true with data.pci_dss.physical_security.requirement_9.public_network_jacks_disabled as true with data.pci_dss.physical_security.requirement_9.physical_access_authorization as true with data.pci_dss.physical_security.requirement_9.physical_media_controls as true with data.pci_dss.physical_security.requirement_9.media_distribution_secured as true with data.pci_dss.physical_security.requirement_9.media_destruction as true with data.pci_dss.physical_security.requirement_9.disk_destruction as true with data.pci_dss.physical_security.requirement_9.poi_device_protection as true
	count(f) > 0
	not data.pci_dss.physical_security.requirement_9.pci_requirement_9_compliant with data.pci_dss.physical_security.requirement_9.physical_security_policies_established as true with data.pci_dss.physical_security.requirement_9.physical_security_roles_defined as true with data.pci_dss.physical_security.requirement_9.physical_access_controls as true with data.pci_dss.physical_security.requirement_9.badge_system as true with data.pci_dss.physical_security.requirement_9.public_network_jacks_disabled as true with data.pci_dss.physical_security.requirement_9.physical_access_authorization as true with data.pci_dss.physical_security.requirement_9.physical_media_controls as true with data.pci_dss.physical_security.requirement_9.media_distribution_secured as true with data.pci_dss.physical_security.requirement_9.media_destruction as true with data.pci_dss.physical_security.requirement_9.disk_destruction as true with data.pci_dss.physical_security.requirement_9.poi_device_protection as true
}

test_failing_public_network_jacks_disabled_blocks_compliance if {
	not data.pci_dss.physical_security.requirement_9.pci_requirement_9_compliant with data.pci_dss.physical_security.requirement_9.physical_security_policies_established as true with data.pci_dss.physical_security.requirement_9.physical_security_roles_defined as true with data.pci_dss.physical_security.requirement_9.physical_access_controls as true with data.pci_dss.physical_security.requirement_9.badge_system as true with data.pci_dss.physical_security.requirement_9.physical_access_authorization as true with data.pci_dss.physical_security.requirement_9.visitor_management as true with data.pci_dss.physical_security.requirement_9.physical_media_controls as true with data.pci_dss.physical_security.requirement_9.media_distribution_secured as true with data.pci_dss.physical_security.requirement_9.media_destruction as true with data.pci_dss.physical_security.requirement_9.disk_destruction as true with data.pci_dss.physical_security.requirement_9.poi_device_protection as true
}

test_poi_device_protection_missing_scope_flag_does_not_pass if {
	not data.pci_dss.physical_security.requirement_9.poi_device_protection with input as {}
}

test_poi_device_protection_explicit_not_in_scope_passes if {
	data.pci_dss.physical_security.requirement_9.poi_device_protection with input as {"pci": {"poi_devices": {"in_scope": false}}}
}
