	not data.pci_dss.logging_monitoring.requirement_10.pci_requirement_10_compliant with data.pci_dss.logging_monitoring.requirement_10.logging_policies_established as true with data.pci_dss.logging_monitoring.requirement_10.logging_roles_defined as true with data.pci_dss.logging_monitoring.requirement_10.required_events_logged as true with data.pci_dss.logging_monitoring.requirement_10.audit_log_data_elements as true with data.pci_dss.logging_monitoring.requirement_10.audit_log_protection as true with data.pci_dss.logging_monitoring.requirement_10.external_log_server as true with data.pci_dss.logging_monitoring.requirement_10.daily_log_review as true with data.pci_dss.logging_monitoring.requirement_10.automated_log_analysis as true with data.pci_dss.logging_monitoring.requirement_10.periodic_log_review as true with data.pci_dss.logging_monitoring.requirement_10.log_exceptions_followed_up as true with data.pci_dss.logging_monitoring.requirement_10.log_retention as true with data.pci_dss.logging_monitoring.requirement_10.time_synchronization as true with data.pci_dss.logging_monitoring.requirement_10.security_control_failure_detection as true with data.pci_dss.logging_monitoring.requirement_10.security_failure_response as true with data.pci_dss.logging_monitoring.requirement_10.siem_deployed as true
