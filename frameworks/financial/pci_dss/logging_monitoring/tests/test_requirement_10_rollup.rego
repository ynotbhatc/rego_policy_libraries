package pci_dss.logging_monitoring.requirement_10_test

import rego.v1

# Roll-up behaviour (validation 2026-10-17). Controls are mocked with `with ... as` so these tests
# pin the aggregation logic independent of the evidence schema. The control under test is left
# unmocked and evaluated against an empty input, i.e. it is genuinely failing.

test_all_controls_pass_is_compliant_and_full_score if {
	data.pci_dss.logging_monitoring.requirement_10.pci_requirement_10_compliant with data.pci_dss.logging_monitoring.requirement_10.logging_policies_established as true with data.pci_dss.logging_monitoring.requirement_10.logging_roles_defined as true with data.pci_dss.logging_monitoring.requirement_10.required_events_logged as true with data.pci_dss.logging_monitoring.requirement_10.audit_log_data_elements as true with data.pci_dss.logging_monitoring.requirement_10.audit_log_protection as true with data.pci_dss.logging_monitoring.requirement_10.external_log_server as true with data.pci_dss.logging_monitoring.requirement_10.daily_log_review as true with data.pci_dss.logging_monitoring.requirement_10.automated_log_analysis as true with data.pci_dss.logging_monitoring.requirement_10.periodic_log_review as true with data.pci_dss.logging_monitoring.requirement_10.log_exceptions_followed_up as true with data.pci_dss.logging_monitoring.requirement_10.log_retention as true with data.pci_dss.logging_monitoring.requirement_10.time_synchronization as true with data.pci_dss.logging_monitoring.requirement_10.time_data_protected as true with data.pci_dss.logging_monitoring.requirement_10.security_control_failure_detection as true with data.pci_dss.logging_monitoring.requirement_10.security_failure_response as true with data.pci_dss.logging_monitoring.requirement_10.siem_deployed as true
	data.pci_dss.logging_monitoring.requirement_10.pci_requirement_10_score == 100 with data.pci_dss.logging_monitoring.requirement_10.logging_policies_established as true with data.pci_dss.logging_monitoring.requirement_10.logging_roles_defined as true with data.pci_dss.logging_monitoring.requirement_10.required_events_logged as true with data.pci_dss.logging_monitoring.requirement_10.audit_log_data_elements as true with data.pci_dss.logging_monitoring.requirement_10.audit_log_protection as true with data.pci_dss.logging_monitoring.requirement_10.external_log_server as true with data.pci_dss.logging_monitoring.requirement_10.daily_log_review as true with data.pci_dss.logging_monitoring.requirement_10.automated_log_analysis as true with data.pci_dss.logging_monitoring.requirement_10.periodic_log_review as true with data.pci_dss.logging_monitoring.requirement_10.log_exceptions_followed_up as true with data.pci_dss.logging_monitoring.requirement_10.log_retention as true with data.pci_dss.logging_monitoring.requirement_10.time_synchronization as true with data.pci_dss.logging_monitoring.requirement_10.time_data_protected as true with data.pci_dss.logging_monitoring.requirement_10.security_control_failure_detection as true with data.pci_dss.logging_monitoring.requirement_10.security_failure_response as true with data.pci_dss.logging_monitoring.requirement_10.siem_deployed as true
}

test_one_failing_control_gives_partial_score_and_populated_findings if {
	score := data.pci_dss.logging_monitoring.requirement_10.pci_requirement_10_score with data.pci_dss.logging_monitoring.requirement_10.logging_policies_established as true with data.pci_dss.logging_monitoring.requirement_10.logging_roles_defined as true with data.pci_dss.logging_monitoring.requirement_10.required_events_logged as true with data.pci_dss.logging_monitoring.requirement_10.audit_log_data_elements as true with data.pci_dss.logging_monitoring.requirement_10.audit_log_protection as true with data.pci_dss.logging_monitoring.requirement_10.external_log_server as true with data.pci_dss.logging_monitoring.requirement_10.daily_log_review as true with data.pci_dss.logging_monitoring.requirement_10.automated_log_analysis as true with data.pci_dss.logging_monitoring.requirement_10.log_exceptions_followed_up as true with data.pci_dss.logging_monitoring.requirement_10.log_retention as true with data.pci_dss.logging_monitoring.requirement_10.time_synchronization as true with data.pci_dss.logging_monitoring.requirement_10.time_data_protected as true with data.pci_dss.logging_monitoring.requirement_10.security_control_failure_detection as true with data.pci_dss.logging_monitoring.requirement_10.security_failure_response as true with data.pci_dss.logging_monitoring.requirement_10.siem_deployed as true
	score > 0
	score < 100
	f := data.pci_dss.logging_monitoring.requirement_10.pci_requirement_10_findings with data.pci_dss.logging_monitoring.requirement_10.logging_policies_established as true with data.pci_dss.logging_monitoring.requirement_10.logging_roles_defined as true with data.pci_dss.logging_monitoring.requirement_10.required_events_logged as true with data.pci_dss.logging_monitoring.requirement_10.audit_log_data_elements as true with data.pci_dss.logging_monitoring.requirement_10.audit_log_protection as true with data.pci_dss.logging_monitoring.requirement_10.external_log_server as true with data.pci_dss.logging_monitoring.requirement_10.daily_log_review as true with data.pci_dss.logging_monitoring.requirement_10.automated_log_analysis as true with data.pci_dss.logging_monitoring.requirement_10.log_exceptions_followed_up as true with data.pci_dss.logging_monitoring.requirement_10.log_retention as true with data.pci_dss.logging_monitoring.requirement_10.time_synchronization as true with data.pci_dss.logging_monitoring.requirement_10.time_data_protected as true with data.pci_dss.logging_monitoring.requirement_10.security_control_failure_detection as true with data.pci_dss.logging_monitoring.requirement_10.security_failure_response as true with data.pci_dss.logging_monitoring.requirement_10.siem_deployed as true
	count(f) > 0
	not data.pci_dss.logging_monitoring.requirement_10.pci_requirement_10_compliant with data.pci_dss.logging_monitoring.requirement_10.logging_policies_established as true with data.pci_dss.logging_monitoring.requirement_10.logging_roles_defined as true with data.pci_dss.logging_monitoring.requirement_10.required_events_logged as true with data.pci_dss.logging_monitoring.requirement_10.audit_log_data_elements as true with data.pci_dss.logging_monitoring.requirement_10.audit_log_protection as true with data.pci_dss.logging_monitoring.requirement_10.external_log_server as true with data.pci_dss.logging_monitoring.requirement_10.daily_log_review as true with data.pci_dss.logging_monitoring.requirement_10.automated_log_analysis as true with data.pci_dss.logging_monitoring.requirement_10.log_exceptions_followed_up as true with data.pci_dss.logging_monitoring.requirement_10.log_retention as true with data.pci_dss.logging_monitoring.requirement_10.time_synchronization as true with data.pci_dss.logging_monitoring.requirement_10.time_data_protected as true with data.pci_dss.logging_monitoring.requirement_10.security_control_failure_detection as true with data.pci_dss.logging_monitoring.requirement_10.security_failure_response as true with data.pci_dss.logging_monitoring.requirement_10.siem_deployed as true
}

