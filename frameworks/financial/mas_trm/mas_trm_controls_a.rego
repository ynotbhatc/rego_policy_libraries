# MAS Technology Risk Management Guidelines (January 2021) — control table, part A
# Chapters 3–8: governance, risk framework, projects and security-by-design,
# software development, IT service management, IT resilience.
#
# The METADATA block for package mas_trm.main lives in mas_trm_main.rego.
# Ids are the Guidelines' paragraph numbers; text is a one-line paraphrase of
# the paragraph's "should". Source: mas.gov.sg, TRM Guidelines 18 January 2021.
package mas_trm.main

import rego.v1

controls_a := {
	# ── 3 Technology Risk Governance and Oversight ─────────────────────────
	"3.1.2": {"ch": "3", "text": "Board and senior management include members with the knowledge to understand and manage technology and cyber risks"},
	"3.1.3": {"ch": "3", "text": "A CIO/CTO/Head of IT and a CISO/Head of Information Security with requisite expertise are appointed, approved at least by the CEO"},
	"3.1.4": {"ch": "3", "text": "A technology risk management strategy is established and implemented"},
	"3.1.5": {"ch": "3", "text": "Key IT decisions are made in accordance with the FI's risk appetite"},
	"3.1.6": {"ch": "3", "text": "Board and senior management set the tone from the top and cultivate a culture of technology risk awareness at all levels"},
	"3.1.7": {"ch": "3", "text": "Board (or delegated committee) ensures the TRM framework and independent TRM function, approves the technology risk appetite and tolerance, reviews the strategy, assesses management competency and ensures an independent audit function"},
	"3.1.8": {"ch": "3", "text": "Senior management establishes the TRM framework and strategy, maintains policies/standards/procedures, delineates roles and responsibilities, and apprises the board of adverse technology risk developments in a timely manner"},
	"3.2.1": {"ch": "3", "text": "Technology risk policies, standards and procedures are established, incorporate industry standards, and are reviewed and updated regularly against the evolving threat landscape"},
	"3.2.2": {"ch": "3", "text": "Deviations from policies/standards are risk-assessed, approved by senior management and reviewed periodically for residual risk"},
	"3.2.3": {"ch": "3", "text": "Compliance processes verify adherence to policies, standards and procedures, with follow-up on non-compliance"},
	"3.3.1": {"ch": "3", "text": "Information asset management identifies assets, classifies them by security classification or criticality, assigns ownership and roles, and manages them per classification"},
	"3.3.2": {"ch": "3", "text": "An inventory of all information assets is maintained, reviewed periodically and updated on change"},
	"3.4.2": {"ch": "3", "text": "Technology risk exposure at a third party is assessed and managed before entering a contract or partnership"},
	"3.4.3": {"ch": "3", "text": "Third parties are held, on an ongoing basis, to a high standard of care for data confidentiality, integrity and system resilience"},
	"3.5.1": {"ch": "3", "text": "Personnel, contractors and service providers have the competence and skills to perform IT functions and manage technology risks"},
	"3.5.2": {"ch": "3", "text": "Background checks are performed on personnel with access to the FI's data and IT systems"},
	"3.6.1": {"ch": "3", "text": "An IT security awareness programme covers the threat landscape, the FI's security policies and standards, individual responsibilities, and applicable laws and regulations"},
	"3.6.2": {"ch": "3", "text": "Security awareness training is conducted at least annually for all staff, contractors and service providers with access to information assets"},
	"3.6.3": {"ch": "3", "text": "The board of directors undergoes technology risk awareness training"},
	"3.6.4": {"ch": "3", "text": "The training programme is reviewed periodically for currency against policy changes and emerging threats"},
	# ── 4 Technology Risk Management Framework ─────────────────────────────
	"4.1.1": {"ch": "4", "text": "A technology risk management framework exists with governance structures, defined roles and responsibilities, and clear reporting lines"},
	"4.1.2": {"ch": "4", "text": "Risk management practices and internal controls deliver data confidentiality and integrity, system security and reliability, and stability and resilience"},
	"4.1.3": {"ch": "4", "text": "A risk owner accountable for treatment of each technology risk is identified"},
	"4.1.4": {"ch": "4", "text": "The framework covers risk identification, risk assessment, risk treatment, and risk monitoring, review and reporting to the board and senior management"},
	"4.1.5": {"ch": "4", "text": "The adequacy and effectiveness of the risk management framework is reviewed regularly"},
	"4.2.1": {"ch": "4", "text": "Threats and vulnerabilities applicable to the IT environment are identified, including assets maintained by third-party service providers"},
	"4.3.1": {"ch": "4", "text": "Potential impact and consequences of threats and vulnerabilities are analysed across financial, operational, legal, reputational and regulatory factors"},
	"4.3.2": {"ch": "4", "text": "Criteria for measuring likelihood and impact of risk scenarios are established to prioritise technology risks"},
	"4.4.1": {"ch": "4", "text": "Risk mitigation and control measures are consistent with asset criticality and risk tolerance, and reviewed regularly"},
	"4.4.2": {"ch": "4", "text": "Residual risk is assessed after mitigation; criteria and approving authorities for risk acceptance are defined and commensurate with risk tolerance"},
	"4.4.3": {"ch": "4", "text": "Insurance cover is taken for insurable technology risks"},
	"4.5.1": {"ch": "4", "text": "A process assesses and monitors the design and operating effectiveness of IT controls against identified risks"},
	"4.5.2": {"ch": "4", "text": "A risk register is maintained; significant risks are monitored closely and reported to the board and senior management at a frequency commensurate with risk"},
	"4.5.3": {"ch": "4", "text": "Technology risk metrics highlight the assets with highest risk exposure, informed by risk events, audit observations and regulatory requirements"},
	# ── 5 IT Project Management and Security-by-Design ────────────────────
	"5.1.1": {"ch": "5", "text": "A project management framework covers policies, standards, procedures and activities from initiation to closure"},
	"5.1.2": {"ch": "5", "text": "Detailed IT project plans define scope, activities, milestones, deliverables and roles for all IT projects"},
	"5.1.3": {"ch": "5", "text": "Key project documentation (feasibility, cost-benefit, business case, project and implementation plans) is maintained and approved by business and IT management"},
	"5.1.4": {"ch": "5", "text": "A project risk management process identifies, assesses, treats and monitors risks through the project life cycle"},
	"5.2.1": {"ch": "5", "text": "Large and complex projects have a project steering committee of key stakeholders, including business owners and IT"},
	"5.2.2": {"ch": "5", "text": "Risks and issues unresolved at project level are escalated to the steering committee and senior management"},
	"5.3.1": {"ch": "5", "text": "Vendor evaluation and selection standards ensure vendors are qualified, with due diligence commensurate with deliverable criticality"},
	"5.3.2": {"ch": "5", "text": "Vendor software development and QA practices are assessed; vendor access to IT systems and sensitive data is controlled and monitored"},
	"5.3.3": {"ch": "5", "text": "COTS solutions that do not meet security requirements are risk-assessed with mitigating controls before deployment"},
	"5.3.4": {"ch": "5", "text": "Need for source code escrow is assessed based on software criticality; alternatives identified where escrow is not possible"},
	"5.4.1": {"ch": "5", "text": "An SDLC framework defines processes, procedures and controls for each life-cycle phase, with maintained standards and procedures"},
	"5.4.2": {"ch": "5", "text": "Security-by-design: security specifications in system design, continuous security evaluation and security practices throughout the SDLC"},
	"5.4.3": {"ch": "5", "text": "Security requirements minimally cover access control, authentication, authorisation, data integrity and confidentiality, activity logging, security event tracking and exception handling"},
	"5.4.4": {"ch": "5", "text": "The IT security function is involved in each SDLC phase where relevant"},
	"5.5.1": {"ch": "5", "text": "Functional requirements and key requirements for performance, resilience and security controls are identified, defined and documented"},
	"5.5.2": {"ch": "5", "text": "Security requirements are derived from an assessment of threats and risks to the system and the acceptable level of security"},
	"5.6.1": {"ch": "5", "text": "Proposed architecture and design, including built-in IT controls, are reviewed against requirements before implementation"},
	"5.6.2": {"ch": "5", "text": "Design and implementation are verified against requirements; deviations are endorsed by relevant stakeholders"},
	"5.6.3": {"ch": "5", "text": "Domain experts, including IT security specialists for security design and architecture, participate in design review"},
	"5.7.1": {"ch": "5", "text": "A system testing methodology covers business logic, function, security controls and performance under load/stress, with an approved test plan"},
	"5.7.2": {"ch": "5", "text": "Requirements are traced through testing so each is covered by test cases"},
	"5.7.3": {"ch": "5", "text": "Separate environments exist for unit, system integration and user acceptance testing, with need-to access"},
	"5.7.4": {"ch": "5", "text": "Regression testing validates existing systems after changes"},
	"5.7.5": {"ch": "5", "text": "Testing issues are tracked and addressed; major issues are reported to the steering committee and fixed before production"},
	"5.7.6": {"ch": "5", "text": "Test results are documented in a test report signed off by relevant stakeholders"},
	"5.8.1": {"ch": "5", "text": "Expected quality attributes and assessment metrics for deliverables are defined during project planning"},
	"5.8.2": {"ch": "5", "text": "Quality assurance is performed by an independent QA function"},
	# ── 6 Software Application Development and Management ─────────────────
	"6.1.1": {"ch": "6", "text": "Standards on secure coding, source code review and application security testing are adopted"},
	"6.1.2": {"ch": "6", "text": "Secure coding and code review standards cover secure programming, input validation, output encoding, access control, authentication, cryptography, and error/exception handling"},
	"6.1.3": {"ch": "6", "text": "A policy governs third-party and open-source code: reviewed and tested before integration"},
	"6.1.4": {"ch": "6", "text": "Updates and reported vulnerabilities for incorporated third-party and open-source code are tracked for timely remediation"},
	"6.1.5": {"ch": "6", "text": "Developers are trained in secure coding and application security standards"},
	"6.1.6": {"ch": "6", "text": "An application security validation and testing strategy uses SAST/DAST/IAST as appropriate, with rules reviewed periodically"},
	"6.1.7": {"ch": "6", "text": "Issues from code review and application security testing are tracked; major defects are remediated before production"},
	"6.2.1": {"ch": "6", "text": "Agile development retains the SDLC and security-by-design principles"},
	"6.2.2": {"ch": "6", "text": "Secure coding, code review and application security testing standards apply during Agile development"},
	"6.3.1": {"ch": "6", "text": "DevSecOps activities align with the SDLC framework and IT service management (configuration, change, release management)"},
	"6.3.2": {"ch": "6", "text": "Security measures and segregation of duties are enforced across development, testing and release in DevSecOps"},
	"6.4.2": {"ch": "6", "text": "A vetting process assesses third parties' suitability to connect via APIs and governs their API access"},
	"6.4.3": {"ch": "6", "text": "Risk assessment precedes third-party API connections; each API's implementation matches data sensitivity and criticality"},
	"6.4.4": {"ch": "6", "text": "Secure API design standards protect API keys and access tokens, with an enforced token-expiry timeframe"},
	"6.4.5": {"ch": "6", "text": "Strong encryption and key management secure sensitive data transmitted through APIs"},
	"6.4.6": {"ch": "6", "text": "APIs are security-screened and tested before production; third-party access sessions are logged (identity, time, data accessed)"},
	"6.4.7": {"ch": "6", "text": "Real-time monitoring and alerting cover API usage and performance; API keys/tokens can be revoked promptly on breach"},
	"6.4.8": {"ch": "6", "text": "System capacity handles high API call volumes, with DoS mitigation"},
	"6.5.1": {"ch": "6", "text": "Shadow IT is managed as part of the FI's information assets"},
	"6.5.2": {"ch": "6", "text": "Measures control and monitor the use of shadow IT"},
	"6.5.3": {"ch": "6", "text": "End-user developed or acquired applications are risk-assessed, controlled, approved and tested before use"},
	# ── 7 IT Service Management ───────────────────────────────────────────
	"7.1.1": {"ch": "7", "text": "An IT service management framework covers configuration, technology refresh, patch, change, release, incident and problem management"},
	"7.2.1": {"ch": "7", "text": "A configuration management process maintains accurate hardware and software configuration information"},
	"7.2.2": {"ch": "7", "text": "Configuration information is reviewed and verified regularly"},
	"7.3.1": {"ch": "7", "text": "Outdated and unsupported hardware/software is avoided; end-of-support dates are monitored closely"},
	"7.3.2": {"ch": "7", "text": "A technology refresh plan precedes end-of-support; risk assessment and mitigation cover assets approaching EOS"},
	"7.3.3": {"ch": "7", "text": "Continued use of unsupported hardware/software has a management dispensation with a validity period, reviewed periodically"},
	"7.4.1": {"ch": "7", "text": "A patch management process applies functional and security patches within timeframes commensurate with patch and system criticality"},
	"7.4.2": {"ch": "7", "text": "Patches are tested before production deployment"},
	"7.5.1": {"ch": "7", "text": "A change management process ensures changes are assessed, tested, reviewed and approved before implementation"},
	"7.5.2": {"ch": "7", "text": "A risk and impact analysis, including security implications, precedes each change"},
	"7.5.3": {"ch": "7", "text": "Changes are tested in a test environment with approved test plans; results are signed off before production"},
	"7.5.4": {"ch": "7", "text": "A change advisory board of business and IT management approves and prioritises changes"},
	"7.5.5": {"ch": "7", "text": "Assets are backed up before change implementation and a rollback plan exists"},
	"7.5.6": {"ch": "7", "text": "Emergency change procedures define assessment, approval, implementation and approvers"},
	"7.5.7": {"ch": "7", "text": "Logging records activities performed during the change process"},
	"7.6.1": {"ch": "7", "text": "Segregation of duties in software release: no single individual can develop, compile and move code between environments"},
	"7.6.2": {"ch": "7", "text": "Controls maintain traceability and integrity of all code moved between environments"},
	"7.7.1": {"ch": "7", "text": "An incident management framework restores affected IT services to a secure and stable state as quickly as possible"},
	"7.7.2": {"ch": "7", "text": "Sufficient resources, including external incident response and forensic support where needed, are available for response and recovery"},
	"7.7.3": {"ch": "7", "text": "The incident framework covers handling of IT and cyber incidents, preservation of evidence, and roles across recording, analysis, escalation, decision, resolution and monitoring"},
	"7.7.4": {"ch": "7", "text": "System events and alerts are configured and actively monitored for early indication of performance and security issues"},
	"7.7.5": {"ch": "7", "text": "Senior management is regularly apprised of major incidents so crisis decisions (e.g. DR activation) are timely"},
	"7.7.6": {"ch": "7", "text": "A communications plan covers customer impact notices, media/public queries, spokespersons, subject-matter experts and channels"},
	"7.7.7": {"ch": "7", "text": "Customers receive timely updates on incident progress and protective actions"},
	"7.8.1": {"ch": "7", "text": "Problem management determines and resolves root causes to prevent recurrence"},
	"7.8.2": {"ch": "7", "text": "A record of past incidents with lessons learnt is maintained"},
	"7.8.3": {"ch": "7", "text": "Trend analysis of past incidents identifies patterns and verifies root causes were resolved"},
	# ── 8 IT Resilience ───────────────────────────────────────────────────
	"8.1.1": {"ch": "8", "text": "IT systems are designed and implemented to achieve availability commensurate with business needs"},
	"8.1.2": {"ch": "8", "text": "Redundancy or fault tolerance for high-availability systems; periodic architecture review maps dependencies and single points of failure; resilience is tested regularly"},
	"8.1.3": {"ch": "8", "text": "System resource utilisation is continuously monitored against pre-defined thresholds for capacity management"},
	"8.1.4": {"ch": "8", "text": "Procedures respond to breaches of resource and performance thresholds"},
	"8.2.1": {"ch": "8", "text": "RTO and RPO are established and aligned to business resumption and recovery priorities"},
	"8.2.2": {"ch": "8", "text": "The disaster recovery plan covers recovery procedures for disaster scenarios and roles; reviewed at least annually and on material change"},
	"8.2.3": {"ch": "8", "text": "Recovery follows the tested, approved DR plan; untested measures require risk assessment, controls and senior management approval"},
	"8.2.4": {"ch": "8", "text": "The FI periodically operates from its recovery or alternate site to assure sustained operation"},
	"8.3.1": {"ch": "8", "text": "The DR plan is tested regularly with business and IT stakeholders participating"},
	"8.3.2": {"ch": "8", "text": "DR test plans define objectives, scope, scenarios, scripts, recovery procedures and success criteria"},
	"8.3.3": {"ch": "8", "text": "DR testing covers plausible disruption scenarios including full/partial site incapacitation and major failures, and recovery dependencies including third-party assets"},
	"8.3.4": {"ch": "8", "text": "Service providers' DR capability is assessed; DR arrangements for provider-managed assets are established, tested and verified, with coordinated tests"},
	"8.4.1": {"ch": "8", "text": "A system and data backup strategy and plan enable recovery from disruption, corruption or deletion"},
	"8.4.2": {"ch": "8", "text": "A backup life-cycle policy defines frequency, retention, storage mechanisms and secure destruction"},
	"8.4.3": {"ch": "8", "text": "Restoration of backups is tested periodically"},
	"8.4.4": {"ch": "8", "text": "Confidential backup data is secured (e.g. encrypted); backup media are stored offline or offsite"},
	"8.5.1": {"ch": "8", "text": "A Threat and Vulnerability Risk Assessment is conducted for data centres, considering physical, environmental and country risk, and reviewed on significant change"},
	"8.5.2": {"ch": "8", "text": "Data centres have redundant power, network, cooling, electrical and mechanical systems with no single point of failure"},
	"8.5.3": {"ch": "8", "text": "Data centres have fire detection and suppression systems"},
	"8.5.4": {"ch": "8", "text": "The secondary/DR data centre is geographically separated from the primary"},
	"8.5.5": {"ch": "8", "text": "Data centre physical security and environmental controls are monitored 24x7 with tested escalation and response procedures"},
	"8.5.6": {"ch": "8", "text": "Data centre physical access is need-to-have and promptly revoked, visitors are approved and escorted, access points, racks and keys are secured and monitored, and delivery areas are segregated"},
}
