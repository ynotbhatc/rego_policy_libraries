package iso27701.main_test

import rego.v1

# Generated by the ISO/IEC 27701 rebuild (2026-11-22): one pass, one fail and one evidence-missing test per
# control, then the report contract, scoping, attestation rules and the legacy input paths.
# Helpers take a bound report; none of them uses `with` (the wasm build rejects it inside functions).

_controls := data.iso27701.main.controls

_spec := data.iso27701.main.evidence_spec

_signed := {"attested": true, "by": "Privacy officer", "date": "2026-11-01"}

_refused := {"attested": false, "by": "Privacy officer", "date": "2026-11-01"}

_all_attestations := {id: _signed | some id, _ in _controls; not _spec[id]}

_good_evidence := {"accounts": {"shared_accounts": 0, "dormant_enabled_accounts": 0}, "authentication": {"mfa_for_pii_systems": true, "failed_login_lockout": true}, "encryption": {"pii_at_rest_encrypted": true}, "crypto": {"weak_algorithms_permitted": false}, "backup": {"configured": true, "encrypted": true, "last_success_age_days": 1}, "logging": {"audit_daemon_active": true, "pii_access_logged": true, "central_forwarding": true, "log_access_restricted": true}, "transport": {"tls_min_version": 1.2, "cleartext_services_enabled": 0}}

_good := {"iso27701": {"evidence": _good_evidence, "attestations": _all_attestations}}

_result(rep, id) := r if {
	some r in rep.control_results
	r.id == id
}

_status(rep, id) := _result(rep, id).status

_set_fact(path, value) := {"iso27701": {
	"evidence": _put(_good_evidence, split(path, "."), value),
	"attestations": _all_attestations,
}}

_drop_fact(path) := {"iso27701": {
	"evidence": object.union(object.remove(_good_evidence, [p[0]]), {p[0]: object.remove(_good_evidence[p[0]], [p[1]])}),
	"attestations": _all_attestations,
}} if p := split(path, ".")

_put(obj, p, value) := object.union(obj, {p[0]: object.union(obj[p[0]], {p[1]: value})})

_with_attestation(id, a) := {"iso27701": {
	"evidence": _good_evidence,
	"attestations": object.union(object.remove(_all_attestations, [id]), {id: a}),
}}

_without_attestation(id) := {"iso27701": {
	"evidence": _good_evidence,
	"attestations": object.remove(_all_attestations, [id]),
}}

test_5_2_1_pass if {
	r := data.iso27701.main.compliance_report with input as _good
	_status(r, "5.2.1") == "pass"
}

test_5_2_1_fail if {
	inp := _with_attestation("5.2.1", _refused)
	r := data.iso27701.main.compliance_report with input as inp
	_status(r, "5.2.1") == "fail"
}

test_5_2_1_evidence_missing if {
	inp := _without_attestation("5.2.1")
	r := data.iso27701.main.compliance_report with input as inp
	_status(r, "5.2.1") == "evidence_missing"
}

