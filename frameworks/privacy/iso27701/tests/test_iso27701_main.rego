# ── List shape ───────────────────────────────────────────────────────────────

test_list_has_108_controls_in_four_groups if {
	count(_controls) == 108
	data.iso27701.main.standard_total == 108
	r := data.iso27701.main.compliance_report with input as {}
	r.standard_total == data.iso27701.main.standard_total
	count({id | some id, c in _controls; c.group == "clause_5"}) == 23
	count({id | some id, c in _controls; c.group == "clause_6"}) == 36
	count({id | some id, c in _controls; c.group == "annex_a"}) == 31
	count({id | some id, c in _controls; c.group == "annex_b"}) == 18
}

test_unconfirmed_ids_listed_and_marked if {
	data.iso27701.main.unconfirmed_ids == ["6.3.2.2", "6.12.1.1", "6.14.2.1", "6.15.2.2", "6.15.2.3"]
	every id in data.iso27701.main.unconfirmed_ids {
		_controls[id].id_source == "unconfirmed"
	}
	count({id | some id, c in _controls; c.id_source == "unconfirmed"}) == count(data.iso27701.main.unconfirmed_ids)
	r := data.iso27701.main.compliance_report with input as _good
	_result(r, "6.14.2.1").id_source == "unconfirmed"
	_result(r, "7.2.1").id_source == "confirmed"
}

test_evidence_controls_count if {
	count(_spec) == 8
	r := data.iso27701.main.compliance_report with input as _good
	count([x | some x in r.control_results; x.basis == "evidence"]) == 8
	count([x | some x in r.control_results; x.basis == "attestation"]) == 108 - 8
}

test_control_results_in_clause_order if {
	r := data.iso27701.main.compliance_report with input as _good
	ids := [x.id | some x in r.control_results]
	ids[0] == "5.2.1"
	ids[count(ids) - 1] == "8.5.8"
	some i, j
	ids[i] == "7.3.9"
	ids[j] == "7.3.10"
	i < j
}

test_entrypoint_and_edition if {
	r := data.iso27701.main.compliance_report with input as _good
	r.edition == "2019"
	r.framework_key == "iso27701"
	is_string(r.control_list_basis)
}

# ── Everything supplied: compliant ───────────────────────────────────────────

test_full_evidence_and_attestations_compliant if {
	r := data.iso27701.main.compliance_report with input as _good
	r.compliant == true
	r.overall_compliant == true
	r.total_controls == 108
	r.failed_controls == 0
	r.violation_count == 0
	r.control_result_counts.pass == 108
	r.modules_passing == 4
}

test_overall_compliant_rule if {
	data.iso27701.main.overall_compliant with input as _good
	not data.iso27701.main.overall_compliant with input as {}
}

# ── No data never passes ─────────────────────────────────────────────────────

test_empty_input_fails_closed if {
	r := data.iso27701.main.compliance_report with input as {}
	r.compliant == false
	r.total_controls == 108
	r.failed_controls == 108
	r.control_result_counts.evidence_missing == 108
	r.control_result_counts.not_attested == 0
	r.control_result_counts.pass == 0
}

test_non_object_input_reported if {
	r := data.iso27701.main.compliance_report with input as {"iso27701": "yes"}
	r.compliant == false
	some v in r.violations
	contains(v, "input.iso27701 is missing or not an object")
}

test_string_true_fact_is_not_a_pass if {
	inp := _set_fact("encryption.pii_at_rest_encrypted", "true")
	r := data.iso27701.main.compliance_report with input as inp
	_status(r, "6.7.1.1") == "evidence_missing"
}

test_string_number_fact_is_not_a_pass if {
	inp := _set_fact("backup.last_success_age_days", "1")
	r := data.iso27701.main.compliance_report with input as inp
	_status(r, "6.9.3.1") == "evidence_missing"
}

test_evidence_fail_beats_missing if {
	inp := {"iso27701": {
		"evidence": object.union(object.remove(_good_evidence, ["backup"]), {"backup": {"configured": false}}),
		"attestations": _all_attestations,
	}}
	r := data.iso27701.main.compliance_report with input as inp
	_status(r, "6.9.3.1") == "fail"
}

test_evidence_limits if {
	inp1 := _set_fact("transport.tls_min_version", 1.3)
	r1 := data.iso27701.main.compliance_report with input as inp1
	_status(r1, "7.4.9") == "pass"
	_status(r1, "8.4.3") == "pass"
	inp2 := _set_fact("transport.tls_min_version", 1.1)
	r2 := data.iso27701.main.compliance_report with input as inp2
	_status(r2, "7.4.9") == "fail"
	_status(r2, "8.4.3") == "fail"
}

test_technical_control_ignores_attestation if {
	inp := {"iso27701": {"attestations": {"6.7.1.1": _signed}}}
	r := data.iso27701.main.compliance_report with input as inp
	_status(r, "6.7.1.1") == "evidence_missing"
}

# ── Attestation rules ────────────────────────────────────────────────────────

# The status values are those of nist_800_53.main and tisax.main; there is no separate reason field.
test_status_values_are_the_shared_vocabulary if {
	r1 := data.iso27701.main.compliance_report with input as {}
	r2 := data.iso27701.main.compliance_report with input as _good
	r3 := data.iso27701.main.compliance_report with input as _with_attestation("7.2.1", {"attested": true})
	r4 := data.iso27701.main.compliance_report with input as _with_attestation("7.2.5", _refused)
	every r in [r1, r2, r3, r4] {
		every row in r.control_results {
			row.status in {"pass", "fail", "evidence_missing", "not_attested"}
			not "reason" in object.keys(row)
		}
		object.keys(r.control_result_counts) == {"pass", "fail", "evidence_missing", "not_attested"}
	}
	r3.control_result_counts.not_attested == 1
	r4.control_result_counts.fail == 1
}

test_unsigned_attestation_not_attested if {
	inp := _with_attestation("7.2.1", {"attested": true})
	r := data.iso27701.main.compliance_report with input as inp
	_status(r, "7.2.1") == "not_attested"
}

test_string_attested_is_not_a_pass if {
	inp := _with_attestation("7.2.1", {"attested": "true", "by": "x", "date": "2026-11-01"})
	r := data.iso27701.main.compliance_report with input as inp
	_status(r, "7.2.1") == "not_attested"
}

test_blank_signer_not_a_pass if {
	inp := _with_attestation("5.3.2", {"attested": true, "by": " ", "date": "2026-11-01"})
	r := data.iso27701.main.compliance_report with input as inp
	_status(r, "5.3.2") == "not_attested"
}

test_non_object_attestation_not_a_pass if {
	inp := _with_attestation("5.3.2", true)
	r := data.iso27701.main.compliance_report with input as inp
	_status(r, "5.3.2") == "not_attested"
}

test_unknown_attestation_key_reported if {
	inp := _with_attestation("9.9.9", _signed)
	r := data.iso27701.main.compliance_report with input as inp
	r.compliant == false
	some v in r.violations
	contains(v, "\"9.9.9\" is not a control id")
}

test_failed_control_named_in_violations if {
	inp := _with_attestation("7.2.5", _refused)
	r := data.iso27701.main.compliance_report with input as inp
	r.compliant == false
	r.failed_control_ids == ["7.2.5"]
	some v in r.violations
	startswith(v, "ISO 27701 7.2.5 (")
}

# ── Scope ────────────────────────────────────────────────────────────────────

test_processor_out_of_scope if {
	inp := {"iso27701": {
		"scope": {"pii_processor": false},
		"evidence": _good_evidence,
		"attestations": {id: _signed | some id, c in _controls; not _spec[id]; c.group != "annex_b"},
	}}
	r := data.iso27701.main.compliance_report with input as inp
	r.compliant == true
	r.total_controls == 108 - 18
	r.groups_not_in_scope == ["annex_b"]
	r.modules.pii_processor.details.in_scope == false
	r.modules.pii_processor.compliant == false
}

test_controller_out_of_scope if {
	inp := {"iso27701": {"scope": {"pii_controller": false}}}
	r := data.iso27701.main.compliance_report with input as inp
	r.total_controls == 108 - 31
	r.compliant == false
}

test_scope_string_false_keeps_scope if {
	inp := {"iso27701": {"scope": {"pii_controller": "false", "pii_processor": null}}}
	r := data.iso27701.main.compliance_report with input as inp
	r.total_controls == 108
}

# ── Legacy input paths ───────────────────────────────────────────────────────

test_legacy_true_passes_mapped_control if {
	inp := {"iso27701": {"pii_controller": {"collection_conditions": {"purposes_documented": true}}}}
	r := data.iso27701.main.compliance_report with input as inp
	_status(r, "7.2.1") == "pass"
	r.compliant == false
}

test_legacy_partial_is_not_a_pass if {
	inp := {"iso27701": {"pii_controller": {"collection_conditions": {"privacy_notices_provided": true}}}}
	r := data.iso27701.main.compliance_report with input as inp
	_status(r, "7.3.3") == "evidence_missing"
}

test_legacy_false_beats_signed_attestation if {
	inp := {"iso27701": {
		"evidence": _good_evidence,
		"attestations": _all_attestations,
		"pii_processor": {"pii_sharing": {"subprocessor_disclosures_documented": false}},
	}}
	r := data.iso27701.main.compliance_report with input as inp
	_status(r, "8.5.6") == "fail"
	r.compliant == false
}

test_legacy_string_is_not_a_pass if {
	inp := {"iso27701": {"pii_controller": {"collection_conditions": {"purposes_documented": "true"}}}}
	r := data.iso27701.main.compliance_report with input as inp
	_status(r, "7.2.1") == "evidence_missing"
}

test_area_packages_still_answer if {
	r := data.iso27701.pii_controller.compliance_report with input as _good
	r.compliant == true
	data.iso27701.pims_requirements.compliant with input as _good
	data.iso27701.pii_processor.compliant with input as _good
	data.iso27701.data_subject_rights.compliant with input as _good
	not data.iso27701.data_subject_rights.compliant with input as {}
	v := data.iso27701.pii_processor.violations with input as {}
	count(v) == 18
}
