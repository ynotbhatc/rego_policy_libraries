	{"id": "PE-4", "family": "PE", "kind": "control", "title": "Access Control for Transmission Medium", "text": "The organization controls physical access to information system distribution and transmission lines within organizational facilities.", "implementation_standards": "", "image_lines_not_extracted": 1, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 185},
	{"id": "PE-5", "family": "PE", "kind": "control", "title": "Access Control for Output Devices", "text": "The organization controls physical access to information system output devices to prevent unauthorized individuals from obtaining the output.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 186},
