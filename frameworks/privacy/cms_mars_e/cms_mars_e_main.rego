	{"id": "SC-13", "family": "SC", "kind": "control", "title": "Cryptographic Protection", "text": "", "implementation_standards": "", "image_lines_not_extracted": 6, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 262},
	{"id": "SC-15", "family": "SC", "kind": "control", "title": "Collaborative Computing Device", "text": "The organization prohibits running collaborative computing mechanisms, unless explicitly authorized, in writing, by the organization’s CIO or designated representative. If collaborative computing is authorized, the authorization shall specifically identify allowed mechanisms, allowed purpose, and the information system used on the collaborative computing mechanisms. The information system:", "implementation_standards": "", "image_lines_not_extracted": 2, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 263},
	{"id": "SC-17", "family": "SC", "kind": "control", "title": "Public Key Infrastructure Certificates", "text": "", "implementation_standards": "", "image_lines_not_extracted": 2, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 264},
	{"id": "SC-18", "family": "SC", "kind": "control", "title": "Mobile Code", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 265},
	{"id": "SC-19", "family": "SC", "kind": "control", "title": "Voice Over Internet Protocol", "text": "The organization prohibits the use of Voice over Internet Protocol (VoIP) technologies, unless explicitly authorized, in writing, by the CIO or designated representative. If authorized, the organization:", "implementation_standards": "", "image_lines_not_extracted": 3, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 266},
	{"id": "SC-20", "family": "SC", "kind": "control", "title": "Secure Name/Address Resolution Service", "text": "The information system:", "implementation_standards": "", "image_lines_not_extracted": 6, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 267},
	{"id": "SC-21", "family": "SC", "kind": "control", "title": "Secure Name/Address Resolution Service", "text": "", "implementation_standards": "", "image_lines_not_extracted": 2, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 268},
	{"id": "SC-22", "family": "SC", "kind": "control", "title": "Architecture and Provisioning for Name/Address Resolution Service", "text": "", "implementation_standards": "", "image_lines_not_extracted": 2, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 269},
	{"id": "SC-23", "family": "SC", "kind": "control", "title": "Session Authenticity", "text": "", "implementation_standards": "", "image_lines_not_extracted": 1, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 270},
	{"id": "SC-28", "family": "SC", "kind": "control", "title": "Protection of Information at Rest", "text": "", "implementation_standards": "Sensitive information such as PII should be encrypted while at rest. If information in the service provider environment cannot be encrypted, appropriate data isolation is a potential compensating control. All mechanisms used to encrypt data must be FIPS 140-2 compliant and operate using the FIPS 140-2 compliant module. This requirement must be included in the SLA, if applicable.", "image_lines_not_extracted": 1, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 271},
	{"id": "SC-32", "family": "SC", "kind": "control", "title": "Information System Partitioning", "text": "", "implementation_standards": "When contracting with external service providers, Personally Identifiable Information (PII), as well as software and services that receive, process, store, or transmit PII must be isolated within the service provider environment to the maximum extent possible so that other service provider customers sharing physical or virtual space cannot gain access to such data or applications.", "image_lines_not_extracted": 3, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 272},
	{"id": "SC-39", "family": "SC", "kind": "control", "title": "Process Isolation", "text": "", "implementation_standards": "", "image_lines_not_extracted": 1, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 273},
	{"id": "SC-ACA-1", "family": "SC", "kind": "control", "title": "Electronic Mail", "text": "", "implementation_standards": "", "image_lines_not_extracted": 2, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "not_selected", "mars_e_1_0": "selected", "table": 274},
	{"id": "SC-ACA-2", "family": "SC", "kind": "control", "title": "FAX Usage", "text": "If Personally Identifiable Information (PII) is allowed to be included with fax communications, the organization establishes policies and procedures for handling fax transmissions. The organization must follow specific precautions and Implementation Standards when performing fax transmission of PII:", "implementation_standards": "Fax machines must be located in a locked room with a trusted staff member having custodial coverage over outgoing and incoming transmissions or fax machines must be located in a secured area; Accurate broadcast lists and other preset numbers of frequent fax recipients must be maintained; and A cover sheet must be used that explicitly provides guidance to the recipient that includes a notification of the sensitivity of the data and the need for protection, and a notice to unintended recipients to telephone the sender (collect if necessary) to report the disclosure and confirm destruction of the information.", "image_lines_not_extracted": 2, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "not_selected", "mars_e_1_0": "not_selected", "table": 275},
	{"id": "SI-1", "family": "SI", "kind": "control", "title": "System and Information Integrity Policy and Procedures", "text": "The organization develops, disseminates, and distributes to applicable personnel, and reviews and updates (as necessary), within every three hundred sixty-five (365) days:", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 276},
	{"id": "SI-2", "family": "SI", "kind": "control", "title": "Flaw Remediation", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 10, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 277},
	{"id": "SI-2 (1)", "family": "SI", "kind": "enhancement", "title": "Central Management", "text": "The organization centrally manages the flaw remediation process.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 278},
	{"id": "SI-2 (2)", "family": "SI", "kind": "enhancement", "title": "Automated Flaw Remediation Status", "text": "The organization employs automated mechanisms monthly to determine the state of information system components with regard to flaw remediation.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 279},
	{"id": "SI-3", "family": "SI", "kind": "control", "title": "Malicious Code Protection", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 12, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 280},
	{"id": "SI-3 (1)", "family": "SI", "kind": "enhancement", "title": "Central Management", "text": "The organization centrally manages malicious code protection mechanisms.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 281},
	{"id": "SI-3 (2)", "family": "SI", "kind": "enhancement", "title": "Automatic Updates", "text": "The information system automatically updates malicious code protection mechanisms.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 282},
	{"id": "SI-4", "family": "SI", "kind": "control", "title": "Information System Monitoring", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 29, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 283},
	{"id": "SI-4 (1)", "family": "SI", "kind": "enhancement", "title": "System-Wide Intrusion Detection System", "text": "The organization connects and configures individual intrusion detection tools into an information system-wide intrusion detection system.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 284},
	{"id": "SI-4 (2)", "family": "SI", "kind": "enhancement", "title": "Automated Tools for Real-Time Analysis", "text": "The organization employs automated tools to support near real-time analysis of events.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 285},
	{"id": "SI-4 (4)", "family": "SI", "kind": "enhancement", "title": "Inbound and Outbound Communications Traffic", "text": "The information system monitors inbound and outbound communications traffic at a defined frequency (defined in the applicable security plan) for unusual or unauthorized activities or conditions.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 286},
	{"id": "SI-4 (5)", "family": "SI", "kind": "enhancement", "title": "System-Generated Alerts", "text": "The information system sends alerts to defined personnel or roles (defined in the applicable security plan) when the following indications of compromise or potential compromise occur:", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 287},
	{"id": "SI-4 (14)", "family": "SI", "kind": "enhancement", "title": "Wireless Intrusion Detection", "text": "The organization employs a wireless intrusion detection system to identify rogue wireless devices and to detect attack attempts and potential compromises/breaches to the information system.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "not_selected", "mars_e_1_0": "not_selected", "table": 288},
	{"id": "SI-5", "family": "SI", "kind": "control", "title": "Security Alerts, Advisories, and Directives", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 7, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 289},
	{"id": "SI-6", "family": "SI", "kind": "control", "title": "Security Function Verification", "text": "The information system:", "implementation_standards": "", "image_lines_not_extracted": 6, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 290},
	{"id": "SI-7", "family": "SI", "kind": "control", "title": "Software, Firmware, and Information Integrity", "text": "The organization employs integrity verification tools to detect unauthorized changes to software and information.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 291},
	{"id": "SI-7 (1)", "family": "SI", "kind": "enhancement", "title": "Integrity Checks", "text": "The organization reassesses the integrity of software and information by performing daily integrity scans of the information system.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 292},
	{"id": "SI-7 (7)", "family": "SI", "kind": "enhancement", "title": "Integration of Detection and Response", "text": "The organization incorporates the detection of unauthorized security-relevant changes to the organizational incident response capability of the information system (defined in the applicable security plan).", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 293},
