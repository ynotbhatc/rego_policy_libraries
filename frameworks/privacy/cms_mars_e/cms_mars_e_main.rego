	{"id": "MP-2", "family": "MP", "kind": "control", "title": "Media Access", "text": "The organization restricts access to sensitive information, such as Personally Identifiable Information (PII), residing on digital and non-digital media to authorized individuals using automated mechanisms to control access to media storage areas.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 170},
