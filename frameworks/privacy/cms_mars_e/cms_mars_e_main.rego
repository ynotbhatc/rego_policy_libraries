	{"id": "DM-1", "family": "DM", "kind": "control", "title": "Minimization of Personally Identifiable Information", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 7, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 332},
	{"id": "DM-1 (1)", "family": "DM", "kind": "enhancement", "title": "Minimization of PII/Locate/Remove/Redact/Anonymize PII", "text": "The organization, where feasible and within the limits of technology, locates, and removes/redacts specified PII and/or uses anonymization and de-identification techniques to permit use of the retained information while reducing its sensitivity and reducing the risk resulting from disclosure.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 333},
	{"id": "DM-2", "family": "DM", "kind": "control", "title": "Data Retention and Disposal", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 7, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 334},
	{"id": "DM-2 (1)", "family": "DM", "kind": "enhancement", "title": "Data Retention and Disposal/System Configuration", "text": "The organization configures information systems to record the date PII is collected, created, or updated and when PII is to be deleted or archived under a record retention schedule.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 335},
	{"id": "DM-3", "family": "DM", "kind": "control", "title": "Minimization of PII Used in Testing, Training, and Research", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 2, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 336},
	{"id": "DM-3 (1)", "family": "DM", "kind": "enhancement", "title": "Minimization of PII Used in Testing, Training, and Research/Risk Minimization Techniques", "text": "The organization, where feasible, uses techniques to minimize the risk to privacy of using PII for research, testing, or training.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 337},
	{"id": "IP-1", "family": "IP", "kind": "control", "title": "Consent", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 8, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 338},
	{"id": "IP-1 (1)", "family": "IP", "kind": "enhancement", "title": "Mechanism Supporting Itemized or Tiered Consent", "text": "The organization implements mechanisms to support itemized or tiered consent for specific uses of data.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 339},
	{"id": "IP-2", "family": "IP", "kind": "control", "title": "Individual Access", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 6, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 340},
	{"id": "IP-3", "family": "IP", "kind": "control", "title": "Redress", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 6, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 341},
	{"id": "IP-4", "family": "IP", "kind": "control", "title": "Complaint Management", "text": "The organization implements a process for receiving and responding to complaints, concerns, or questions from individuals about the organizational privacy practices.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 342},
	{"id": "IP-4 (1)", "family": "IP", "kind": "enhancement", "title": "Complaint Management/Response Times", "text": "The organization responds to complaints, concerns, and questions from individuals within an [organization-defined ] time period.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 343},
	{"id": "SE-1", "family": "SE", "kind": "control", "title": "Inventory of Personally Identifiable Information", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 5, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 344},
	{"id": "SE-2", "family": "SE", "kind": "control", "title": "Privacy Incident Response", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 7, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 345},
	{"id": "TR-1", "family": "TR", "kind": "control", "title": "Privacy Notice", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 18, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 346},
	{"id": "TR-1 (1)", "family": "TR", "kind": "enhancement", "title": "Real-time or Layered Notice", "text": "The organization provides real-time and/or layered notice to individuals at the time when any PII is collected.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 347},
	{"id": "TR-2", "family": "TR", "kind": "control", "title": "System of Records Notices and Privacy Act Statements", "text": "The organization: Non-Federal systems are not required to implement this control. State-based systems must adhere to state laws that may require publication of a notice similar to the federal SORN and Privacy Act Statement.", "implementation_standards": "", "image_lines_not_extracted": 5, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 348},
	{"id": "TR-2 (1)", "family": "TR", "kind": "enhancement", "title": "Public Website Publication", "text": "The organization publishes SORNs on its public website. Non-Federal systems are not required to implement this control. State-based systems must adhere to state laws that may require publication of a notice similar to the federal SORN and Privacy Act Statement.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 349},
	{"id": "TR-3", "family": "TR", "kind": "control", "title": "Dissemination of Privacy Program Information", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 3, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 350},
	{"id": "UL-1", "family": "UL", "kind": "control", "title": "Internal Use", "text": "The organization (each AE) uses PII internally only for the authorized purpose(s) identified in the Privacy Act and/or in public notices.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 351},
	{"id": "UL-2", "family": "UL", "kind": "control", "title": "Information Sharing with Third Parties", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 9, "nist_800_53r4_moderate": "n/a", "cms_ars_2_0": "n/a", "mars_e_1_0": "n/a", "table": 352},
]

control_by_id := {r.id: r | some r in control_rows}

default compliant := false

compliant if count(violations) == 0

_in := object.get(input, "cms_mars_e", {})

_given := c if {
	c := _in.controls
	is_object(c)
}

_supplied if _given

_true(id) if _given[id] == true

violations contains "CMS MARS-E 2.0: FAIL-CLOSED - attestations 'input.cms_mars_e.controls' were not supplied (or are not an object); this module cannot be evaluated and is reported non-compliant" if {
	not _supplied
}

violations contains msg if {
	some r in control_rows
	not _true(r.id)
	msg := sprintf("CMS MARS-E %v (%v %v): not attested — %v", [r.id, r.family, families[r.family], r.title])
}

violations contains msg if {
	some id, _ in _given
	not control_by_id[id]
	msg := sprintf("CMS MARS-E Input Contract: unknown control id %v — ids are printed as in Volume III, e.g. AC-2 (1)", [id])
}

family_reports[f] := s if {
	some f, name in families
	ids := {r.id | some r in control_rows; r.family == f}
	s := {
		"name": name,
		"part": family_parts[f],
		"controls_total": count(ids),
		"controls_attested": count({id | some id in ids; _true(id)}),
		"not_attested": sort([id | some id in ids; not _true(id)]),
	}
}

compliance_report := {
	"framework": "CMS MARS-E 2.0",
	"standard": "Minimum Acceptable Risk Standards for Exchanges, Version 2.0 (2015-11-10) — Volume III control catalog",
	"source": source,
	"status": "superseded by ARC-AMPE v1.0 (compliance date 2026-03-04)",
	"compliant": compliant,
	"standard_total": 352, # control and enhancement tables in Volume III (Table 1 .. Table 352)
	"total_controls": count(control_rows),
	"controls_attested": count({r.id | some r in control_rows; _true(r.id)}),
	"security_controls": count({r.id | some r in control_rows; family_parts[r.family] == "security"}),
	"privacy_controls": count({r.id | some r in control_rows; family_parts[r.family] == "privacy"}),
	"families": family_reports,
	"violation_count": count(violations),
	"violations": violations,
}
