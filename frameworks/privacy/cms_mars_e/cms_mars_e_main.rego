	{"id": "PE-11", "family": "PE", "kind": "control", "title": "Emergency Power", "text": "The organization provides a short-term uninterruptible power supply to facilitate an orderly shutdown of the information system in the event of a primary power source loss.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 192},
	{"id": "PE-12", "family": "PE", "kind": "control", "title": "Emergency Lighting", "text": "The organization employs and maintains automatic emergency lighting for the information system that activates in the event of a power outage or disruption and covers emergency exits and evacuation routes within the facility.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 193},
	{"id": "PE-13", "family": "PE", "kind": "control", "title": "Fire Protection", "text": "The organization employs and maintains for the information system fire suppression and detection devices/systems supported by an independent energy source.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 194},
