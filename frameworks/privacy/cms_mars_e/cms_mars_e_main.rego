	{"id": "SC-7 (12)", "family": "SC", "kind": "enhancement", "title": "Host-Based Protection", "text": "The organization implements defined, host-based boundary protection mechanisms at defined information system components, including servers, workstations, and mobile devices.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 253},
