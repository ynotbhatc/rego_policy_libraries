	{"id": "SC-8", "family": "SC", "kind": "control", "title": "Transmission Confidentiality and Integrity", "text": "", "implementation_standards": "", "image_lines_not_extracted": 3, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 256},
	{"id": "SC-8 (1)", "family": "SC", "kind": "enhancement", "title": "Cryptographic or Alternate Physical Protection", "text": "The information system implements cryptographic mechanisms to prevent unauthorized disclosure of information and detect changes to information during transmission unless otherwise protected by defined alternative physical safeguards (defined in the applicable security plan). This control supports and aligns with the provisions of the ACA and the requirements of 45 CFR §155.260, Privacy and security of personally identifiable information, paragraph (a)(6).", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 257},
	{"id": "SC-8 (2)", "family": "SC", "kind": "enhancement", "title": "Pre/Post Transmission Handling", "text": "", "implementation_standards": "", "image_lines_not_extracted": 2, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 258},
	{"id": "SC-10", "family": "SC", "kind": "control", "title": "Network Disconnect", "text": "The information system terminates the network connection associated with a communications session at the end of the session, or:", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 259},
