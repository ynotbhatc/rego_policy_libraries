	{"id": "SI-8 (1)", "family": "SI", "kind": "enhancement", "title": "Central Management", "text": "The organization centrally manages spam protection mechanisms.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 295},
	{"id": "SI-8 (2)", "family": "SI", "kind": "enhancement", "title": "Automatic Updates", "text": "The information system automatically updates spam protection mechanisms.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 296},
	{"id": "SI-10", "family": "SI", "kind": "control", "title": "Information Input Validation", "text": "The information system checks the validity of defined information inputs (defined in the applicable security plan) for accuracy, completeness, validity, and authenticity as close to the point of origin as possible.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 297},
	{"id": "SI-11", "family": "SI", "kind": "control", "title": "Error Handling", "text": "The information system:", "implementation_standards": "", "image_lines_not_extracted": 3, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 298},
	{"id": "SI-12", "family": "SI", "kind": "control", "title": "Information Handling and Retention", "text": "The organization handles and retains information within the information system and information output from the system in accordance with applicable state and federal laws directives, policies, regulations, standards, and operational requirements.", "implementation_standards": "", "image_lines_not_extracted": 3, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 299},
