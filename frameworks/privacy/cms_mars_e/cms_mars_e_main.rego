# ids carry parentheses ("AC-2 (1)"), so the rows are an array; control_by_id is the keyed view
control_rows := [
	{"id": "AC-1", "family": "AC", "kind": "control", "title": "Access Control Policy and Procedures", "text": "The organization develops, documents, disseminates to applicable personnel, and reviews and updates (as necessary) within every three hundred sixty-five (365) days:", "implementation_standards": "", "image_lines_not_extracted": 3, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 1},
	{"id": "AC-2", "family": "AC", "kind": "control", "title": "Account Management", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 28, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 2},
	{"id": "AC-2 (1)", "family": "AC", "kind": "enhancement", "title": "Automated Information System Account Management", "text": "The organization employs automated mechanisms to support the management of information system accounts.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 3},
	{"id": "AC-2 (2)", "family": "AC", "kind": "enhancement", "title": "Removal of Temporary/Emergency Accounts", "text": "The information system automatically disables emergency accounts within twenty-four (24) hours and temporary accounts with a fixed duration not to exceed three hundred sixty-five (365) days.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 4},
	{"id": "AC-2 (3)", "family": "AC", "kind": "enhancement", "title": "Disable Inactive Accounts", "text": "", "implementation_standards": "", "image_lines_not_extracted": 3, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 5},
	{"id": "AC-2 (4)", "family": "AC", "kind": "enhancement", "title": "Automated Audit Actions", "text": "The information system automatically audits account creation, modification, enabling, disabling, and removal actions, and notifies defined personnel or roles (defined in the applicable security plan).", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 6},
	{"id": "AC-2 (7)", "family": "AC", "kind": "enhancement", "title": "Role-Based Schemes", "text": "", "implementation_standards": "", "image_lines_not_extracted": 9, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 7},
	{"id": "AC-3", "family": "AC", "kind": "control", "title": "Access Enforcement", "text": "The information system enforces approved authorizations for logical access to information and system resources in accordance with applicable access control policies.", "implementation_standards": "", "image_lines_not_extracted": 10, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 8},
	{"id": "AC-3 (9)", "family": "AC", "kind": "enhancement", "title": "Access Enforcement – Controlled Release", "text": "The information system does not release information outside of the established system boundary unless:", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "not_selected", "mars_e_1_0": "not_selected", "table": 9},
	{"id": "AC-4", "family": "AC", "kind": "control", "title": "Information Flow Enforcement", "text": "The information system enforces approved authorizations for controlling the flow of information within the system and between interconnected systems in accordance with applicable policy.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 10},
	{"id": "AC-5", "family": "AC", "kind": "control", "title": "Separation of Duties", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 13, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 11},
	{"id": "AC-6", "family": "AC", "kind": "control", "title": "Least Privilege", "text": "The organization employs the principle of least privilege, allowing only authorized accesses for users (or processes acting on behalf of users) that are necessary to accomplish assigned tasks in accordance with the organization’s missions and business functions. This control supports and aligns with the provisions of the ACA and the requirements of 45 CFR §155.260, Privacy and security of personally identifiable information.", "implementation_standards": "", "image_lines_not_extracted": 14, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 12},
	{"id": "AC-6 (1)", "family": "AC", "kind": "enhancement", "title": "Authorize Access to Security Functions", "text": "At a minimum, the organization explicitly authorizes access to the following list of security functions (deployed in hardware, software, and firmware) and security-relevant information for all system components:", "implementation_standards": "", "image_lines_not_extracted": 9, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 13},
	{"id": "AC-6 (2)", "family": "AC", "kind": "enhancement", "title": "Non-Privileged Access for Non-Security Functions", "text": "At a minimum, the organization requires that users of information system accounts, or roles, with access to the following list of security functions or security-relevant information, use non-privileged accounts, or roles, when accessing other system functions, and if feasible, audit any use of privileged accounts, or roles, for such functions:", "implementation_standards": "", "image_lines_not_extracted": 8, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 14},
	{"id": "AC-6 (5)", "family": "AC", "kind": "enhancement", "title": "Privileged Accounts", "text": "The organization restricts privileged accounts on the information system to defined personnel or roles (defined in the applicable security plan).", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 15},
	{"id": "AC-6 (9)", "family": "AC", "kind": "enhancement", "title": "Auditing Use of Privileged Functions", "text": "The information system audits the execution of privileged functions.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 16},
	{"id": "AC-6 (10)", "family": "AC", "kind": "enhancement", "title": "Prohibit Non-Privileged Users from Executing Privileged Functions", "text": "The information system prevents non-privileged users from executing privileged functions to include disabling, circumventing, or altering implemented security safeguards/countermeasures.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 17},
	{"id": "AC-7", "family": "AC", "kind": "control", "title": "Unsuccessful Logon Attempts", "text": "The information system:", "implementation_standards": "", "image_lines_not_extracted": 8, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 18},
	{"id": "AC-8", "family": "AC", "kind": "control", "title": "System Use Notification", "text": "The information system: Warning! This system contains U.S Government information. By using this information system, you are consenting to system monitoring for law enforcement and other purposes. Unauthorized or improper use of, or access to, this computer system may subject you to state and federal criminal prosecution and penalties as well as civil penalties. At any time, the government may intercept, search, and seize any communication or data transiting or stored on this information system.", "implementation_standards": "", "image_lines_not_extracted": 17, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 19},
	{"id": "AC-10", "family": "AC", "kind": "control", "title": "Concurrent Session Control", "text": "The information system limits the number of concurrent sessions for each system account to one (1) session. The number of concurrent application/process sessions is limited and enforced to the number of sessions expressly required for the performance of job duties and any requirement for more than one (1) concurrent application/process session is documented in the security plan.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 20},
	{"id": "AC-11", "family": "AC", "kind": "control", "title": "Session Lock", "text": "The information system:", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 21},
	{"id": "AC-11 (1)", "family": "AC", "kind": "enhancement", "title": "Pattern-Hiding Displays", "text": "The information system conceals, via the session lock, information previously visible on the display with a publicly viewable image.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 22},
	{"id": "AC-12", "family": "AC", "kind": "control", "title": "Session Termination", "text": "The information system automatically terminates a user session after fifteen (15) minutes of inactivity.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 23},
	{"id": "AC-14", "family": "AC", "kind": "control", "title": "Permitted Actions without Identification or Authentication", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 24},
	{"id": "AC-17", "family": "AC", "kind": "control", "title": "Remote Access", "text": "", "implementation_standards": "", "image_lines_not_extracted": 20, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 25},
	{"id": "AC-17 (1)", "family": "AC", "kind": "enhancement", "title": "Automated Monitoring/Control", "text": "The information system monitors and controls remote access methods.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 26},
	{"id": "AC-17 (2)", "family": "AC", "kind": "enhancement", "title": "Protection of Confidentiality/Integrity Using Encryption", "text": "The information system implements cryptographic mechanisms to protect the confidentiality and integrity of remote access sessions.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 27},
	{"id": "AC-17 (3)", "family": "AC", "kind": "enhancement", "title": "Managed Access Control Points", "text": "The information system routes all remote accesses through a limited number of managed access control points.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 28},
	{"id": "AC-17 (4)", "family": "AC", "kind": "enhancement", "title": "Privileged Commands/Access", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 3, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 29},
	{"id": "AC-18", "family": "AC", "kind": "control", "title": "Wireless Access", "text": "The organization:", "implementation_standards": "Encryption protection is enabled; Access points are placed in secure areas; Access points are shut down when not in use (i.e., nights, weekends); A firewall is implemented between the wireless network and the wired infrastructure; MAC address authentication is utilized; Static IP addresses, not DHCP, is utilized; Personal firewalls are utilized on all wireless clients; File sharing is disabled on all wireless clients; Intrusion detection agents are deployed on the wireless side of the firewall; Wireless activity is monitored and recorded, and the records are reviewed on a regular basis; Organizational policy related to wireless client access configuration and use is documented; and Security Control SI-4 (14), Employ a wireless intrusion “detection/prevention” system (WIDS/WIPS).", "image_lines_not_extracted": 9, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 30},
	{"id": "AC-18 (1)", "family": "AC", "kind": "enhancement", "title": "Authentication and Encryption", "text": "If wireless access is explicitly authorized, the information system protects wireless access to the system using encryption and authentication of both users and devices.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 31},
	{"id": "AC-19", "family": "AC", "kind": "control", "title": "Access Control for Mobile Devices", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 19, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 32},
	{"id": "AC-19 (5)", "family": "AC", "kind": "enhancement", "title": "Full-Device / Container-Based Encryption", "text": "The organization employs full-device encryption, or container encryption, to protect the confidentiality and integrity of information on approved mobile devices.", "implementation_standards": "", "image_lines_not_extracted": 2, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 33},
	{"id": "AC-20", "family": "AC", "kind": "control", "title": "Use of External Information Systems", "text": "For organizational users (staff and contractors within the organization), the organization prohibits the use of external information systems, including but not limited to, Internet kiosks, personal desktop computers, laptops, tablet personal computers, personal digital assistant (PDA) devices, cellular telephones, facsimile machines, and equipment available in hotels or airports to store, access, transmit, or process sensitive information, such as Personally identifiable Information (PII), unless explicitly authorized, in writing, by the CIO or designated representative. If authorized, the organization establishes strict terms and conditions for their use. For non-organizational users (such as business partners), the Administering Entity organization establishes terms and conditions, consistent with CMS implementation guidance of HHS Regulation 45 CFR 115.260, and in compliance with legal data sharing agreements signed with CMS, for any trust relationships established with other organizations owning, operating, and/or maintaining external information systems. These terms and conditions allow authorized individuals to:", "implementation_standards": "For Organizational Users:", "image_lines_not_extracted": 7, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 34},
	{"id": "AC-20 (1)", "family": "AC", "kind": "enhancement", "title": "Limits on Authorized Use", "text": "The organization permits authorized individuals to use an external information system to access the information system or to process, store, or transmit organization-controlled information only when the organization:", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 35},
	{"id": "AC-20 (2)", "family": "AC", "kind": "enhancement", "title": "Portable Storage Devices", "text": "The organization restricts the use of organization-controlled portable storage devices by authorized individuals on external information systems.", "implementation_standards": "", "image_lines_not_extracted": 3, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 36},
	{"id": "AC-21", "family": "AC", "kind": "control", "title": "Information Sharing", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 7, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 37},
	{"id": "AC-22", "family": "AC", "kind": "control", "title": "Publicly Accessible Content", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 7, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 38},
	{"id": "AT-1", "family": "AT", "kind": "control", "title": "Security Awareness and Training Policy and Procedures", "text": "The organization develops, documents, and disseminates to applicable personnel, and reviews and updates (as necessary), within every three hundred sixty-five (365) days:", "implementation_standards": "", "image_lines_not_extracted": 15, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 39},
	{"id": "AT-2", "family": "AT", "kind": "control", "title": "Security Awareness Training", "text": "The organization provides basic security and privacy awareness training to information system users (including managers, senior executives, and contractors):", "implementation_standards": "", "image_lines_not_extracted": 9, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 40},
	{"id": "AT-2 (2)", "family": "AT", "kind": "enhancement", "title": "Insider Threat", "text": "The organization includes security and privacy awareness training on recognizing and reporting potential indicators of insider threat.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 41},
	{"id": "AT-3", "family": "AT", "kind": "control", "title": "Role-Based Security Training", "text": "The organization provides role-based security and privacy training to personnel with assigned security and privacy roles and responsibilities:", "implementation_standards": "", "image_lines_not_extracted": 8, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 42},
	{"id": "AT-4", "family": "AT", "kind": "control", "title": "Security Training Records", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 43},
	{"id": "AU-1", "family": "AU", "kind": "control", "title": "Audit and Accountability Policy and Procedures", "text": "The organization develops, documents, and disseminates to applicable personnel, and reviews and updates (as necessary), within every three hundred sixty-five (365) days:", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 44},
	{"id": "AU-2", "family": "AU", "kind": "control", "title": "Audit Events", "text": "The organization:", "implementation_standards": "Server alerts and error messages; Log onto system; Log off system; Change of password; All system administrator commands, while logged on as system administrator; Switching accounts or running privileged actions from another account, (e.g., Linux/UNIX SU or Windows RUNAS); Creation or modification of super-user groups; Subset of security administrator commands, while logged on in the security administrator role; Subset of system administrator commands, while logged on in the user role; Clearing of the audit log file; Startup and shutdown of audit functions; Use of identification and authentication mechanisms (e.g., user ID and password); Change of file or user permissions or privileges (e.g., use of suid/guid, chown, su); Remote access outside of the corporate network communication channels(e.g., modems, dedicated Virtual Private Network ) and all dial-in access to the system; Changes made to an applications or database by a batch file; Application-critical record changes; Changes to database or application records, where the application has been bypassed to produce the change (via a file or other database utility); User log-on and log-off (successful or unsuccessful); System shutdown and reboot; System errors; Application shutdown; Application restart; Application errors; Security policy modifications; and Printing sensitive information. User log-on and log-off (successful or unsuccessful); Log packet-screening denials originating from untrusted networks; All system administration activities; Packet-screening denials originating from trusted networks; Account creation, modification, or deletion of packet filters; System shutdown and reboot; System errors; and Modification of proxy services.", "image_lines_not_extracted": 19, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 45},
	{"id": "AU-2 (3)", "family": "AU", "kind": "enhancement", "title": "Reviews and Updates", "text": "The organization reviews and updates the list of auditable events within every three hundred sixty-five (365) days or whenever there is change in the threat environment.", "implementation_standards": "", "image_lines_not_extracted": 1, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 46},
	{"id": "AU-3", "family": "AU", "kind": "control", "title": "Content of Audit Records", "text": "The information system generates audit records containing information that establishes what type of event occurred, when the event occurred, where the event occurred, the source of the event, the outcome of the event, and the identity of any individuals or subjects associated with the event.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 47},
	{"id": "AU-3 (1)", "family": "AU", "kind": "enhancement", "title": "Additional Audit Information", "text": "The information system provides the capability to include more detailed information in the audit records for audit events that capture:", "implementation_standards": "Additional, more detailed session, connection, transaction, or activity duration information; For client-server transactions, the number of bytes received and bytes sent; Additional informational messages to diagnose or identify the event; and Characteristics that describe or identify the object or resource acted upon in the audit records for audit events identified by type, location, or subject.", "image_lines_not_extracted": 6, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 48},
	{"id": "AU-4", "family": "AU", "kind": "control", "title": "Audit Storage Capacity", "text": "The organization allocates audit record storage capacity and configures auditing to reduce the likelihood that storage capacity will be exceeded.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 49},
	{"id": "AU-5", "family": "AU", "kind": "control", "title": "Response to Audit Processing Failures", "text": "The information system alerts defined personnel or roles (defined in the applicable security plan) in the event of an audit processing failure.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 50},
	{"id": "AU-5 (1)", "family": "AU", "kind": "enhancement", "title": "Audit Storage Capacity", "text": "The information system provides a warning and alerts key personnel, roles, and/or locations (defined in the applicable security plan), within a defined time period (defined in the applicable security plan), when allocated audit record storage volume reaches 80 percent of the repository’s maximum audit record storage capacity.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "not_selected", "mars_e_1_0": "not_selected", "table": 51},
	{"id": "AU-6", "family": "AU", "kind": "control", "title": "Audit Review, Analysis, and Reporting", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 24, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 52},
	{"id": "AU-6 (1)", "family": "AU", "kind": "enhancement", "title": "Process Integration", "text": "The organization employs automated mechanisms to integrate audit review, analysis, and reporting processes to support organizational processes for investigation and response to suspicious activities.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 53},
	{"id": "AU-6 (3)", "family": "AU", "kind": "enhancement", "title": "Correlate Audit Repositories", "text": "The organization analyzes and correlates audit records across different repositories to gain organization-wide situational awareness.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 54},
	{"id": "AU-7", "family": "AU", "kind": "control", "title": "Audit Reduction and Report Generation", "text": "The information system provides an audit reduction and report generation capability that:", "implementation_standards": "", "image_lines_not_extracted": 3, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 55},
	{"id": "AU-7 (1)", "family": "AU", "kind": "enhancement", "title": "Automatic Processing", "text": "The information system provides the capability to process audit records for events of interest based on selectable event criteria.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 56},
	{"id": "AU-8", "family": "AU", "kind": "control", "title": "Time Stamps", "text": "", "implementation_standards": "", "image_lines_not_extracted": 3, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 57},
	{"id": "AU-8 (1)", "family": "AU", "kind": "enhancement", "title": "Synchronization with Authoritative Time Source", "text": "The information system synchronizes the internal clocks to the authoritative time source when the time difference is greater than thirty (30) seconds.", "implementation_standards": "", "image_lines_not_extracted": 9, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 58},
	{"id": "AU-9", "family": "AU", "kind": "control", "title": "Protection of Audit Information", "text": "The information system protects audit information and audit tools from unauthorized access, modification, and deletion.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 59},
	{"id": "AU-9 (4)", "family": "AU", "kind": "enhancement", "title": "Access by Subset of Privileged Users", "text": "The organization authorizes access to management of audit functionality to only those individuals or roles who are not subject to audit by that system, and defines this access in the applicable security plan.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 60},
	{"id": "AU-10", "family": "AU", "kind": "control", "title": "Non-Repudiation", "text": "The information system protects against an individual (or process acting on behalf of an individual) falsely denying having performed a particular action.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 61},
	{"id": "AU-11", "family": "AU", "kind": "control", "title": "Audit Record Retention", "text": "The organization retains audit records online for at least ninety (90) days and archives old records for ten (10) years to provide support for after-the-fact investigations of security incidents and to meet regulatory and organizational information retention requirements.", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 62},
	{"id": "AU-12", "family": "AU", "kind": "control", "title": "Audit Generation", "text": "The information system:", "implementation_standards": "The information system provides audit record generation capability for the list of auditable events defined in AU-2 at all information system components where audit capability is deployed.", "image_lines_not_extracted": 6, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 63},
	{"id": "AU-12 (1)", "family": "AU", "kind": "enhancement", "title": "System-Wide/Time-Correlated Audit Trail", "text": "The information system compiles audit records from defined information system components (defined in the applicable security plan) into a system-wide (logical or physical), time-correlated audit trail.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 64},
	{"id": "AU-16", "family": "AU", "kind": "control", "title": "Cross-Organizational Auditing", "text": "The organization employs organization-defined methods for coordinating organization-defined audit information among external organizations when audit information is transmitted across organizational boundaries.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "not_selected", "mars_e_1_0": "not_selected", "table": 65},
	{"id": "CA-1", "family": "CA", "kind": "control", "title": "Security Assessment and Authorization Policies and Procedures", "text": "The organization develops, documents, and disseminates to applicable personnel, and reviews and updates (as necessary), within three hundred sixty-five (365) days:", "implementation_standards": "", "image_lines_not_extracted": 6, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 66},
	{"id": "CA-2", "family": "CA", "kind": "control", "title": "Security Assessments", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 33, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 67},
	{"id": "CA-2 (1)", "family": "CA", "kind": "enhancement", "title": "Independent Assessors", "text": "The organization employs assessors or assessment teams with CMS-defined level of independence to conduct security and privacy control assessments of the organization’s information system.", "implementation_standards": "CMS provides guidance for employing independent assessors in the Framework of Independent Assessment (IA) of Security and Privacy Controls, located at: https://calt.cms.gov/sf/projects/cms_aca_program_security_privacy/ .", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 68},
	{"id": "CA-3", "family": "CA", "kind": "control", "title": "System Interconnections", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 13, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 69},
	{"id": "CA-3 (5)", "family": "CA", "kind": "enhancement", "title": "Restrictions on External System Connections", "text": "The organization employs, and documents, in the applicable security plan a “deny all, allow-by-exception” policy for allowing defined information systems that receive, process, store, or transmit Personally Identifiable Information (PII) to connect to external information systems.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 70},
	{"id": "CA-5", "family": "CA", "kind": "control", "title": "Plan of Action and Milestones", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 12, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 71},
	{"id": "CA-5 (1)", "family": "CA", "kind": "enhancement", "title": "Automation Support for Accuracy/Currency", "text": "The organization employs automated mechanisms to help ensure that the plan of action and milestones for the information system is accurate, up to date, and readily available.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 72},
	{"id": "CA-6", "family": "CA", "kind": "control", "title": "Security Authorization", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 19, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 73},
	{"id": "CA-7", "family": "CA", "kind": "control", "title": "Continuous Monitoring", "text": "The organization develops a continuous monitoring strategy and implements a continuous monitoring program that includes:", "implementation_standards": "", "image_lines_not_extracted": 26, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 74},
	{"id": "CA-7 (1)", "family": "CA", "kind": "enhancement", "title": "Independent Assessment", "text": "The use of independent security assessment agents or teams to monitor security controls is not required; however, if the organization employs assessors or assessment teams with CMS-defined level of independence to monitor the security controls in the information system on an ongoing basis, this can be used to satisfy security control assessment requirements.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 75},
	{"id": "CA-9", "family": "CA", "kind": "control", "title": "Internal System Connections", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 76},
	{"id": "CM-1", "family": "CM", "kind": "control", "title": "Configuration Management Policy and Procedures", "text": "The organization develops, documents, disseminates to applicable personnel, and reviews and updates (as necessary), within every three hundred sixty-five (365) days:", "implementation_standards": "The organization documents the configuration management process and procedures to:", "image_lines_not_extracted": 10, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 77},
	{"id": "CM-2", "family": "CM", "kind": "control", "title": "Baseline Configuration", "text": "The organization develops, documents, and maintains under configuration control a current baseline configuration of the information system.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 78},
	{"id": "CM-2 (1)", "family": "CM", "kind": "enhancement", "title": "Reviews and Updates", "text": "The organization reviews and updates the baseline configuration of the information system:", "implementation_standards": "The Service Provider reviews and updates the baseline configuration of the information system:", "image_lines_not_extracted": 11, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 79},
	{"id": "CM-2 (3)", "family": "CM", "kind": "enhancement", "title": "Retention of Previous Configurations", "text": "The organization retains older versions of baseline configurations of the information system as deemed necessary to support rollback.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 80},
	{"id": "CM-3", "family": "CM", "kind": "control", "title": "Configuration Change Control", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 29, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 81},
	{"id": "CM-3 (2)", "family": "CM", "kind": "enhancement", "title": "Test/Validate/Document Changes", "text": "The organization tests, validates, and documents changes to the information system before implementing the changes on the operational system.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 82},
	{"id": "CM-4", "family": "CM", "kind": "control", "title": "Security Impact Analysis", "text": "The organization analyzes changes to the information system to determine potential security and privacy impacts prior to change implementation. Activities associated with configuration changes to the information system are audited.", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 83},
	{"id": "CM-4 (1)", "family": "CM", "kind": "enhancement", "title": "Separate Test Environments", "text": "The organization analyzes changes to the information system in a separate test environment before implementation in an operational environment, looking for security impacts due to flaws, weaknesses, incompatibility, or intentional malice. Processing or storing of Personally Identifiable Information (PII) in test environments is prohibited.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 84},
	{"id": "CM-4 (2)", "family": "CM", "kind": "enhancement", "title": "Verification of Security Functions", "text": "The organization checks the security functions after the information system is changed to verify that the functions are implemented correctly, operating as intended, and producing the desired outcome for meeting the system’s security requirements.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 85},
	{"id": "CM-5", "family": "CM", "kind": "control", "title": "Access Restrictions for Change", "text": "The organization defines, documents, approves, and enforces physical and logical access restrictions associated with changes to the information system. Records reflecting all such changes shall be generated, reviewed, and retained.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 86},
	{"id": "CM-5 (1)", "family": "CM", "kind": "enhancement", "title": "Automated Access Enforcement/Auditing", "text": "The organization employs automated mechanisms to enforce access restrictions to configuration change information and support auditing of the enforcement actions.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 87},
	{"id": "CM-5 (5)", "family": "CM", "kind": "enhancement", "title": "Limit Production/Operational Privileges", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 3, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 88},
	{"id": "CM-6", "family": "CM", "kind": "control", "title": "Configuration Settings", "text": "The organization:", "implementation_standards": "National Institute of Standards and Technology (NIST) CMS Defense Information Systems Agency (DISA) Office of Management and Budget (OMB)", "image_lines_not_extracted": 17, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 89},
	{"id": "CM-6 (1)", "family": "CM", "kind": "enhancement", "title": "Automated Central Management/ Application/Verification", "text": "The organization employs automated mechanisms to centrally manage, apply, and verify configuration settings for information technology products.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 90},
	{"id": "CM-7", "family": "CM", "kind": "control", "title": "Least Functionality", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 12, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 91},
	{"id": "CM-7 (1)", "family": "CM", "kind": "enhancement", "title": "Periodic Review", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 92},
	{"id": "CM-7 (2)", "family": "CM", "kind": "enhancement", "title": "Prevent Program Execution", "text": "The information system prevents program execution in accordance with the list of authorized or unauthorized software programs and rules authorizing the terms and conditions of software program usage.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 93},
	{"id": "CM-7 (4)", "family": "CM", "kind": "enhancement", "title": "Unauthorized Software/Blacklisting", "text": "The organization:", "implementation_standards": "", "image_lines_not_extracted": 6, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 94},
