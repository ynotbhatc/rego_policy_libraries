	{"id": "CP-6 (1)", "family": "CP", "kind": "enhancement", "title": "Separation from Primary Site", "text": "The organization identifies an alternate storage site that is separated from the primary storage site to reduce susceptibility to the same threats.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 113},
	{"id": "CP-6 (3)", "family": "CP", "kind": "enhancement", "title": "Accessibility", "text": "The organization identifies potential accessibility problems to the alternate storage site in the event of an area-wide disruption or disaster and outlines explicit mitigation actions.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 114},
