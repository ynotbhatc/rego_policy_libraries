	{"id": "SC-1", "family": "SC", "kind": "control", "title": "System and Communications Protection Policy and Procedures", "text": "The organization develops, documents, and disseminates to applicable personnel, and reviews and updates (as necessary), within every three hundred sixty-five (365) days:", "implementation_standards": "", "image_lines_not_extracted": 4, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 242},
	{"id": "SC-2", "family": "SC", "kind": "control", "title": "Application Partitioning", "text": "The information system separates user functionality, including user interface services (e.g., web services), from information system management (e.g., database management systems) functionality.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 243},
	{"id": "SC-4", "family": "SC", "kind": "control", "title": "Information in Shared Resources", "text": "The information system prevents unauthorized and unintended information transfer via shared system resources.", "implementation_standards": "", "image_lines_not_extracted": 5, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 244},
	{"id": "SC-5", "family": "SC", "kind": "control", "title": "Denial of Service Protection", "text": "The information system protects against or limits the effects of the types of denial of service attacks defined on the following websites by employing security safeguards (defined in the applicable security plan):", "implementation_standards": "The organization defines a list of types of denial of service attacks (including but not limited to flooding attacks and software/logic attacks) or provides a reference to source for current list.", "image_lines_not_extracted": 9, "nist_800_53r4_moderate": "selected", "cms_ars_2_0": "selected", "mars_e_1_0": "selected", "table": 245},
	{"id": "SC-6", "family": "SC", "kind": "control", "title": "Resource Availability", "text": "The information system protects the availability of resources by allocating resources by priority and/or quota.", "implementation_standards": "", "image_lines_not_extracted": 0, "nist_800_53r4_moderate": "not_selected", "cms_ars_2_0": "selected", "mars_e_1_0": "not_selected", "table": 246},
